  "body": {
    "format": "articles",
    "article_count": 6,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 검찰수사의 전문화를 도모하고 검찰수사력을 강화하기 위하여 일정기간의 경력을 쌓아 경험이 풍부한 중견검사를 부부장검사로 근무하게 하는데 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:부부장검사의인사와운용에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "임명",
        "chapter": "",
        "content": "제2조(임명) 법무부장관은 법조경력 10년 이상의 검사로 하여금 지방검찰청 또는 지청의 부부장검사로 근무할 것을 명할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:부부장검사의인사와운용에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "직무",
        "chapter": "",
        "content": "제3조(직무) ① 부부장검사는 부장검사를 보좌하여 전문수사체제의 운영에 필요한 기획, 수사, 연구, 자료관리 등을 총괄하고, 신임 검사를 지도한다.② 부부장검사는 제1항에 규정된 업무 외에 사회의 이목을 끌거나 중요한 사건을 담당하여 직접 처리하고, 사법경찰관이 신청한 구속영장 등 신병에 관한 수사지휘, 유치장감찰, 항고사건 처리 등의 업무를 담당한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:부부장검사의인사와운용에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "부부장검사의 배치",
        "chapter": "",
        "content": "제4조(부부장검사의 배치) 부부장검사에 대한 청내 배치는 자질, 경험, 전문분야 등을 고려하여 검사장 또는 지청장이 행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:부부장검사의인사와운용에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "사무대결",
        "chapter": "",
        "content": "제5조(사무대결) 부장검사가 직무를 행할 수 없을 때에는 선임 부부장 검사가 소속부의 검찰사무를 대결한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:부부장검사의인사와운용에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "근무시간외 수사지휘 당번검사 지정 면제",
        "chapter": "",
        "content": "제6조(근무시간외 수사지휘 당번검사 지정 면제) 부부장검사에 대하여는 근무시간외 수사지휘 당번검사의 지정을 면제한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:부부장검사의인사와운용에관한규정#JO0006"
      }
    ]
  },
