      {
        "article_no": "제10조",
        "article_title": "안전ㆍ보건상의 조치",
        "chapter": "",
        "content": "제10조(안전ㆍ보건상의 조치) 병원은 자원봉사자의 활동과정에서 일어날 수 있는 사고 및 재해 등의 예방에 최선을 다해야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립공주병원자원봉사규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "비밀유지의무",
        "chapter": "",
        "content": "제11조(비밀유지의무) 자원봉사자는 활동과정에서 알게 된 병원운영 및 환자에 대한 비밀ㆍ보안등의 중요한 사항에 관해서는 일체 누설하여서는 아니되며, 만일 누설할 경우 관련법에 의거 처벌을 받는다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립공주병원자원봉사규정#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "손해배상",
        "chapter": "",
        "content": "제12조(손해배상) 자원봉사자가 자신의 고의나 중과실 등 귀책사유로 인해 환자의 신상이나 병원의 기물 등에 손상을 입혔을 때에는 그 손해를 배상하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립공주병원자원봉사규정#JO0012"
      }
    ]
