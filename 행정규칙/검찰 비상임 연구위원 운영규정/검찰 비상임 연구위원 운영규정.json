    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적)  이 규정은 검찰 비상임 연구위원 제도를 운영함에 있어 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검찰비상임연구위원운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "검찰 비상임 연구위원",
        "chapter": "",
        "content": "제2조(검찰 비상임 연구위원)  대검찰청에 검찰 비상임 연구위원(이하 ‘비상임 연구위원’)을 둔다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검찰비상임연구위원운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "비상임 연구위원의 업무",
        "chapter": "",
        "content": "제3조(비상임 연구위원의 업무)  비상임 연구위원은 대검찰청 각 부서의 요청이 있을 경우 세미나, 회의, 교육에 참석하는 등 적절한 방식으로 연구과제 수행을 지원한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검찰비상임연구위원운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "자격 및 위촉",
        "chapter": "",
        "content": "제4조(자격 및 위촉) 비상임 연구위원은 형법, 형사소송법, 형사정책 분야의 교수·부교수 또는 조교수의 직에 5년 이상 재직한 사람 중에서 검찰총장이 위촉한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검찰비상임연구위원운영규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "임기",
        "chapter": "",
        "content": "제5조(임기)  비상임 연구위원의 임기는 1년으로 하되, 연임할 수 있다. 다만, 본인의 희망 또는 그 밖의 불가피한 사정이 있는 경우에는 임기만료 이전에 해촉할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검찰비상임연구위원운영규정#JO0005"
      },
      {
        "article_no": "제7조",
        "article_title": "수당",
        "chapter": "",
        "content": "제7조(수당)  비상임 연구위원에게 예산의 범위 내에서 수당을 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검찰비상임연구위원운영규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "비밀준수의무",
        "chapter": "",
        "content": "제8조(비밀준수의무)  비상임 연구위원은 업무 수행 과정에서 알게 된 내용을 외부에 공개하거나 누설하여서는 아니 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검찰비상임연구위원운영규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "운영세칙",
        "chapter": "",
        "content": "제9조(운영세칙)  이 지침에서 정한 사항 외에 검찰 비상임 연구위원 제도의 운영에 관하여 필요한 사항은 검찰총장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검찰비상임연구위원운영규정#JO0009"
      }
    ]
  },
