            "target_article_no": "",
            "target_article_title": "",
            "target_mst": "",
            "target_url": "https://www.law.go.kr/행정규칙/정책자문위원회규정",
            "resolve_method": "html",
            "source_provision_id": "admrul:기상청정책자문위원회규정#JO0001",
