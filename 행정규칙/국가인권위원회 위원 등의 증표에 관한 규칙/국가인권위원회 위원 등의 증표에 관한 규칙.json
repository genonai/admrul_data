      "enforcement_date": "",
      "content": "[별지 제1호서식]<개정 2012.11.23., 2017.5.29.>\n증표 발급대장\n┏━━┯━━━┯━━━┯━━━┯━━┯━━┯━━┯━━┯━━━┯━━━┯━━━┯━━┯━━┓\n┃결재│증번호│발 급 │소속  │직급│성명│생년│사진│신규  │재발급│회수  │일시│반환┃\n┃    │      │연월일│및    │    │    │월일│    │재발급│사유  │여부  │회수│    ┃\n┃    │      │      │직위  │    │    │    │    │      │      │      │    │    ┃\n┣━━┿━━━┿━━━┿━━━┿━━┿━━┿━━┿━━┿━━━┿━━━┿━━━┿━━┿━━┫\n┃    │      │      │      │    │    │    │    │      │      │      │    │    ┃\n┠──┼───┼───┼───┼──┼──┼──┼──┼───┼───┼───┼──┼──┨\n┃    │      │      │      │    │    │    │    │      │      │      │    │    ┃\n┠──┼───┼───┼───┼──┼──┼──┼──┼───┼───┼───┼──┼──┨\n┃    │      │      │      │    │    │    │    │      │      │      │    │    ┃\n┠──┼───┼───┼───┼──┼──┼──┼──┼───┼───┼───┼──┼──┨\n┃    │      │      │      │    │    │    │    │      │      │      │    │    ┃\n┠──┼───┼───┼───┼──┼──┼──┼──┼───┼───┼───┼──┼──┨\n┃    │      │      │      │    │    │    │    │      │      │      │    │    ┃\n┠──┼───┼───┼───┼──┼──┼──┼──┼───┼───┼───┼──┼──┨\n┃    │      │      │      │    │    │    │    │      │      │      │    │    ┃\n┠──┼───┼───┼───┼──┼──┼──┼──┼───┼───┼───┼──┼──┨\n┃    │      │      │      │    │    │    │    │      │      │      │    │    ┃\n┠──┼───┼───┼───┼──┼──┼──┼──┼───┼───┼───┼──┼──┨\n┃    │      │      │      │    │    │    │    │      │      │      │    │    ┃\n┠──┼───┼───┼───┼──┼──┼──┼──┼───┼───┼───┼──┼──┨\n┃    │      │      │      │    │    │    │    │      │      │      │    │    ┃\n┠──┼───┼───┼───┼──┼──┼──┼──┼───┼───┼───┼──┼──┨\n┃    │      │      │      │    │    │    │    │      │      │      │    │    ┃\n┠──┼───┼───┼───┼──┼──┼──┼──┼───┼───┼───┼──┼──┨\n┃    │      │      │      │    │    │    │    │      │      │      │    │    ┃\n┠──┼───┼───┼───┼──┼──┼──┼──┼───┼───┼───┼──┼──┨\n┃    │      │      │      │    │    │    │    │      │      │      │    │    ┃\n┠──┼───┼───┼───┼──┼──┼──┼──┼───┼───┼───┼──┼──┨\n┃    │      │      │      │    │    │    │    │      │      │      │    │    ┃\n┠──┼───┼───┼───┼──┼──┼──┼─