      "enforcement_date": "",
      "content": "┏━┳━━━━━━━━┯━━━━━━━━━━┓\n당직 / 보안일지                                                     ┃결┃담 당 자        │운영지원과장        ┃\n┃  ┠────────┼──────────┨\n┃재┃                │                    ┃\n20    .    .    .   요일                                            ┃  ┃                │                    ┃\n┏━━━┳━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━┳┻━┻━━━━━━━┳┷━━━━━━━━━━┫\n┃당직  ┃소속부서                          ┃직급                  ┃성명                ┃서명                  ┃\n┃근무자┣━━━━━━━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━╋━━━━━━━━━━━┫\n┃      ┃                                  ┃                      ┃                    ┃                      ┃\n┣━━━╋━━━━━━━━━━━━━━━━━┻━━━━┳━━━━━━╋━━━━━━━━━━┻━━━━━━━━━━━┫\n┃지 시 ┃?청사내 순찰근무 철저                      ┃조 치       ┃                                            ┃\n┃사 항 ┃?당직전화 수신(대기) 철저                  ┃사 항       ┃                                            ┃\n┣━━━╋━━━━━━━━━━━━━━━━┳━━━━┯┻━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━┫\n┃순    ┃구     분                       ┃순찰시각│잔류 근무인원 │특이사항                                    ┃\n┃찰    ┃                                ┃        │              ┝━━━━━━━━━┯━━━━━━━━┯━━━┫\n┃결    ┃                                ┃        │              │전열기?전원 관리 │비품?문서 관리 │출입문┃\n┃과    ┣━━┯━━━━━━━━━━━━━╋━━━━┿━━━━━━━┿━━━━━━━━━┿━━━━━━━━┿━━━┫\n┃      ┃10층│인권상담조정센터          ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │배움터/기사송고실         ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │인권교육센터              ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │국장실/군인권보호총괄과   ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │군인권조사과              ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │군인권협력지원과          ┃        │              │                  │                │      ┃\n┃      ┣━━┿━━━━━━━━━━━━━╋━━━━┿━━━━━━━┿━━━━━━━━━┿━━━━━━━━┿━━━┫\n┃      ┃11층│국장실/차별시정총괄과     ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │장애차별조사1과           ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │장애차별조사2과           ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │성차별시정과              ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │혐오표현대응과            ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │인권도서관                ┃        │              │                  │                │      ┃\n┃      ┣━━┿━━━━━━━━━━━━━╋━━━━┿━━━━━━━┿━━━━━━━━━┿━━━━━━━━┿━━━┫\n┃      ┃12층│국장실/조사총괄과         ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │인권침해조사과            ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │아동청소년인권과          ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │기획조사팀                ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │이주인권팀                ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │행정법무담당관/기록관     ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │직원휴게실                ┃        │              │                  │                │      ┃\n┃      ┣━━┿━━━━━━━━━━━━━╋━━━━┿━━━━━━━┿━━━━━━━━━┿━━━━━━━━┿━━━┫\n┃      ┃13층│국장실/인권정책과         ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │사회인권과                ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │국제인권과                ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │홍보협력과                ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │정보화관리팀/정보화교육실 ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │몸?땀?휴                ┃        │              │                  │                │      ┃\n┃      ┣━━┿━━━━━━━━━━━━━╋━━━━┿━━━━━━━┿━━━━━━━━━┿━━━━━━━━┿━━━┫\n┃      ┃14층│사무총장실/소회의실       ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │국장실/기획재정담당관     ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │운영지원과                ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │기사실                    ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │전원위실/중회의실         ┃        │              │                  │                │      ┃\n┃      ┣━━┿━━━━━━━━━━━━━╋━━━━┿━━━━━━━┿━━━━━━━━━┿━━━━━━━━┿━━━┫\n┃      ┃15층│위원장실                  ┃        │              │                  │                │      ┃\n┃      ┃    ├─────────────╂────┼───────┼─────────┼────────┼───┨\n┃      ┃    │상임위원실                ┃        │              │                  │                │      ┃\n┗━━━┻━━┷━━━━━━━━━━━━━┻━━━━┷━━━━━━━┷━━━━━━━━━┷━━━━━━━━┷━━━┛\n┏━━━━━━━━┳━━━━━━━━┓\n┃특 이 사 항     ┃(앞면에서 계속) ┃\n┃(순찰결과, 전화 ┃                ┃\n┃통화 내용 등)   ┃                ┃\n┗━━━━━━━━┻━━━━━━━━┛\n[별지 제1호서식] <개정 2022. 6. 21., 2026. 5. 7.>",
