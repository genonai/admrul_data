  "appendices": [
    {
      "no": "0001",
      "branch": "00",
      "kind": "별지",
      "title": "국제회의참가계획서",
      "enforcement_date": "",
      "content": "[별지 제1호서식]\n국 제 회 의 참 가 계 획 서\n\n시행년도 :\n부 처 명 :\n┌─────┬─────────┬──────┬──────┬───┐\n│국제회의명│ 회의기간 및 장소 │주관국제기구│참가예정인원│비  고│\n├─────┼─────────┼──────┼──────┼───┤\n│          │                  │            │            │      │\n└─────┴─────────┴──────┴──────┴───┘\n주:비고난에는 아국의 이사국등 입후보 희망여부 및 차기회의의 아국유치 문제등\n중요사항을 기술함.",
      "is_file_only": false,
      "view_url": "",
      "file_url": "https://www.law.go.kr/LSW/flDownload.do?flSeq=127330601",
