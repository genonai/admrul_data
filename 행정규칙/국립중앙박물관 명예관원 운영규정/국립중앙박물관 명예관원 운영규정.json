    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 국립중앙박물관(이하 ‘박물관’이라 한다) 명예관원 운영에 관련한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙박물관명예관원운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "임명",
        "chapter": "",
        "content": "제2조(임명) 명예관원은 다음 각 호의 요건을 갖춘 사람으로서 제6조에 따른 명예관원 임명 심사위원회의 심의를 거쳐 국립중앙박물관장(이하 ‘관장’이라 한다)이 임명한다.①국립박물관에 10년 이상 재직하고 퇴직한 사람 중 그 재직 중의 업적이 커 다른 직원의 모범이 되는 사람② 명예관원으로서 적당하다고 인정되는 사회적 지위와 역량이 있는 사람",
        "enforcement_date": "",
