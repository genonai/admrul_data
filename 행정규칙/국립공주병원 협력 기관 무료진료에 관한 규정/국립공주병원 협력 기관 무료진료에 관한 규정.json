    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 국립공주병원과 협력 기관으로 협약을 체결한 기관 중 동협약 내용에서 무료진료 대상으로 지정하고 있는 자들의 무료진료에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립공주병원협력기관무료진료에관한규정#JO0001"
