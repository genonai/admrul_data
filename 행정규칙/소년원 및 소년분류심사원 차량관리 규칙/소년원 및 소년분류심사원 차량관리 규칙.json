      "content": "〔별표 1〕\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┯━━━━┯━━━━━━━━┯━━━━━━━┯━━━━━━━━━━┓\n┃                                                                          │결 재   │담  당          │과  장        │원  장              ┃\n┃차  량  운  행  및  점  검  부                                            │        ├────────┼───────┼──────────┨\n┃20   년     월     일     요일                                            │        │                │전  결        │                    ┃\n┣━━━━┯━━━━┯━━━━━┯━━━━━┯━━━━┯━━━━━━━━━━┿━━━━┿━━━━━━━━┷━━┯━━━━┷━━━━━━━━━━┫\n┃    구분│운 전 원│사 용 자  │용    무  │목 적 지│운 행 시 간         │운행거리│운 행 거 리 ( ㎞ )    │유 류 소 모 량（ ℓ )         ┃\n┃ 차량   │        │          │          │        │                    │( ㎞ )  ├───┬───┬───┼───┬───┬───┬───┨\n┃        │        │          │          │        │                    │        │전 일 │금 일 │누 계 │주입량│전일량│소모량│재고량┃\n┣━━━━┿━━━━┿━━━━━┿━━━━━┿━━━━┿━━━━━━━━━━┿━━━━┿━━━┿━━━┿━━━┿━━━┿━━━┿━━━┿━━━┫\n┃        │        │          │          │        │∼                  │        │      │      │      │      │      │      │      ┃\n┃        ├────┼─────┼─────┼────┼──────────┼────┼───┼───┼───┼───┼───┼───┼───┨\n┃        │        │          │          │        │∼                  │        │      │      │      │      │      │      │      ┃\n┃        ├────┼─────┼─────┼────┼──────────┼────┼───┼───┼───┼───┼───┼───┼───┨\n┃        │        │          │          │        │∼                  │        │      │      │      │      │      │      │      ┃\n┃        ├────┼─────┼─────┼────┼──────────┼────┼───┼───┼───┼───┼───┼───┼───┨\n┃        │        │          │          │        │∼                  │        │      │      │      │      │      │      │      ┃\n┣━━━━┿━━━━┿━━━━━┿━━━━━┿━━━━┿━━━━━━━━━━┿━━━━┿━━━┿━━━┿━━━┿━━━┿━━━┿━━━┿━━━┫\n┃        │        │          │          │        │∼                  │        │      │      │      │      │      │      │      ┃\n┃        ├────┼─────┼─────┼────┼──────────┼────┼───┼───┼───┼───┼───┼───┼───┨\n┃        │        │          │          │        │∼                  │        │      │      │      │      │      │      │      ┃\n┃        ├────┼─────┼─────┼────┼──────────┼────┼───┼───┼───┼───┼───┼───┼───┨\n┃        │        │          │          │        │∼                  │        │      │      │      │      │      │      │      ┃\n┃        ├────┼─────┼─────┼────┼──────────┼────┼───┼───┼───┼───┼───┼───┼───┨\n┃        │        │          │          │        │∼                  │        │      │      │      │      │      │      │      ┃\n┣━━━━┿━━━━┿━━━━┯┷━━━━┯┷━━━┯┷━━━┯━━━━━┯┷━━━┯┷━━━┿━━━┷━━━┷━━━┷━━━┷━━━┷━━━┫\n┃일일    │각종기기│브레이크│타이어    │조향장치│등화장치│냉각수 및 │연료누유│밧데리  │기타 특이사항                                 ┃\n┃점검    │작동상태│작동상태│공기압상태│작동상태│작동상태│오일상태  │여부    │상태    │                                              ┃\n┠────┼────┼────┼─────┼────┼────┼─────┼────┼────┼───────────────────────┨\n┃        │        │        │          │        │        │          │        │        │                                              ┃\n┠────┼────┼────┼─────┼────┼────┼─────┼────┼────┤                                              ┃\n┃        │        │        │          │        │        │          │        │        │                                              ┃\n┗━━━━┷━━━━┷━━━━┷━━━━━┷━━━━┷━━━━┷━━━━━┷━━━━┷━━━━┷━━━━━━━━━━━━━━━━━━━━━━━┛",
