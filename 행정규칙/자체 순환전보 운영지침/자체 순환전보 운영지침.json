      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 지침은 동해지방해양수산청 소속 공무원의 순환전보와 관련하여 필요한 사항을 구체적으로 정함으로써 인사관리의 공정과 능률을 기함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:자체순환전보운영지침#JO0001"
      },
