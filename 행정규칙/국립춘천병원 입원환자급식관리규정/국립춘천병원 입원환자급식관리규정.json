      "content": "[별지 제8호서식]\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n┃(  )월 위생교육 일지                                              ┃\n┣━━━━┯━━━━━━━━━━━━━━┯━┯━━━┯━━━┯━━━┫\n┃교육주제│                            │결│담 당 │주 무 │과 장 ┃\n┃        │                            │  ├───┼───┼───┨\n┠────┼──────────────┤재│      │전 결 │      ┃\n┃교육일시│     년    월     일    요일│  │      │      │      ┃\n┠────┼┬────┬────────┤  │      │      │      ┃\n┃교 육 자││교육장소│                │  │      │      │      ┃\n┠────┼┴────┴┬───────┴─┴───┴───┴───┨\n┃참 석 자│            │                                          ┃\n┃명    단├──────┼─────────────────────┨\n┃        │            │                                          ┃\n┃        ├──────┼─────────────────────┨\n┃        │            │                                          ┃\n┃        ├──────┼─────────────────────┨\n┃        │            │                                          ┃\n┣━━━━┷━━━━━━┷━━━━━━━━━━━━━━━━━━━━━┫\n┃                                                                  ┃\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
