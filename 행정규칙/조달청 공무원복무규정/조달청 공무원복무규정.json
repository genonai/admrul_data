    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총칙",
        "content": "제1조(목적)이 규정은 「공무원 복무규정」에서 정한 사항 이외에 조달공무원으로서 복무상 준수하여야 할 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
