      "content": "<수용ㆍ사용할 토지의 권리명세서 : 산청관리소>\n[당초]\n┌─┬───┬───┬─┬───────┬─────────────┬─────────────────┬──┐\n│번│소재지│지 번 │지│지 적(㎡)     │토 지 소 유 자            │관 계 인                          │비고│\n│호│      │      │목├───┬───┼───┬─────────┼────┬───────┬────┤    │\n│  │      │      │  │공부상│편입  │성 명 │주 소             │성 명   │주 소         │내 용   │    │\n│  │      │      │  │면적  │면적  │(명칭)│                  │(명칭)  │              │        │    │\n├─┼───┼───┼─┼───┼───┼───┼─────────┼────┼───────┼────┼──┤\n│1 │경남  │산92-2│임│3,589 │3,589 │홍석인│산청군 산청읍 지리│        │              │        │    │\n│  │산청군│      │  │      │      │      │327-12            │        │              │        │    │\n│  │금서면│      │  │      │      │      │대진타워맨션 604호│        │              │        │    │\n├─┤매촌리├───┼─┼───┼───┼───┼─────────┼────┼───────┼────┼──┤\n│2 │      │산91-2│임│696   │696   │안형진│서울특별시 광진구 │산청군  │경상남도      │근저당권│    │\n│  │      │      │  │      │      │      │자양로 109, 101동 │농업    │산청군 산청읍 │        │    │\n│  │      │      │  │      │      │      │1602호(자양동,    │협동조합│산청리 168-4  │        │    │\n│  │      │      │  │      │      │      │구의현대홈시티)   │        │              │        │    │\n├─┤      ├───┼─┼───┼───┼───┼─────────┼────┼───────┼────┼──┤\n│3 │      │1094-1│답│2,840 │2,840 │전영배│마산시 회원동     │        │              │        │    │\n│  │      │      │  │      │      │      │60-4              │        │              │        │    │\n├─┼───┼───┼─┼───┼───┼───┼─────────┼────┼───────┼────┼──┤\n│4 │경남  │1094-2│답│2,189 │2,189 │안형진│서울특별시 광진구 │산청군  │경상남도      │근저당권│    │\n│  │산청군│      │  │      │      │      │자양로 109, 101동 │농업    │산청군 산청읍 │        │    │\n│  │금서면│      │  │      │      │      │1602호(자양동,    │협동조합│산청리 168-4  │        │    │\n│  │매촌리│      │  │      │      │      │구의현대홈시티)   │        │              │        │    │\n├─┴───┼───┼─┼───┼───┼───┼─────────┼────┼───────┼────┼──┤\n│합 계     │4필지 │  │9,314 │9,314 │      │                  │        │              │        │    │\n└─────┴───┴─┴───┴───┴───┴─────────┴────┴───────┴────┴──┘\n[변경]\n┌─┬───┬───┬─┬───────┬──────────────┬───────────┬──┐\n│번│소재지│지 번 │지│지 적(㎡)     │토 지 소 유 자              │관 계 인              │비고│\n│호│      │      │목├───┬───┼────┬─────────┼───┬───┬───┤    │\n│  │      │      │  │공부상│편입  │성 명   │주 소             │성 명 │주 소 │내 용 │    │\n│  │      │      │  │면적  │면적  │(명칭)  │                  │(명칭)│      │      │    │\n├─┼───┼───┼─┼───┼───┼────┼─────────┼───┼───┼───┼──┤\n│1 │경남  │산92-2│임│3,589 │3,589 │한국    │대구광역시 동구   │      │      │      │    │\n│  │산청군│      │  │      │      │가스공사│첨단로 120(신서동)│      │      │      │    │\n├─┤금서면├───┼─┼───┼───┼────┼─────────┼───┼───┼───┼──┤\n│2 │매촌리│산91-2│임│696   │696   │한국    │대구광역시 동구   │      │      │      │    │\n│  │      │      │  │      │      │가스공사│첨단로 120(신서동)│      │      │      │    │\n├─┤      ├───┼─┼───┼───┼────┼─────────┼───┼───┼───┼──┤\n│3 │      │산91-8│임│793   │793   │한국    │대구광역시 동구   │      │      │      │    │\n│  │      │      │  │      │      │가스공사│첨단로 120(신서동)│      │      │      │    │\n├─┤      ├───┼─┼───┼───┼────┼─────────┼───┼───┼───┼──┤\n│4 │      │1094-1│답│2,840 │2,840 │한국    │대구광역시 동구   │      │      │      │    │\n│  │      │      │  │      │      │가스공사│첨단로 120(신서동)│      │      │      │    │\n├─┤      ├───┼─┼───┼───┼────┼─────────┼───┼───┼───┼──┤\n│5 │      │1094-2│답│2,189 │2,189 │한국    │대구광역시 동구   │      │      │      │    │\n│  │      │      │  │      │      │가스공사│첨단로 120(신서동)│      │      │      │    │\n├─┴───┼───┼─┼───┼───┼────┼─────────┼───┼───┼───┼──┤\n│합 계     │5필지 │  │10,107│10,107│        │                  │      │      │      │    │\n└─────┴───┴─┴───┴───┴────┴─────────┴───┴───┴───┴──┘",
