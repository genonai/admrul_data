      {
        "article_no": "제7조",
        "article_title": "경비용역업체 근무상태의 점검",
        "chapter": "",
        "content": "제7조(경비용역업체 근무상태의 점검) 재택당직근무를 실시하는 기관의 장은 경비용역업체의 비상 시 대응상태 등을 매분기 1회 이상 점검하여 그 결과를 당직근무일지에 기록 유지하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
