    "article_count": 20,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 삭제<2018. 10. 12.>",
        "content": "제1조(목적) 이 훈령은 국가유공자와 그 유가족 등에게 명예와 자긍심을 함양토록 하기 위하여 발행하는 나라사랑 신문의 발행 및 운영에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:나라사랑신문운영규정#JO0001"
