    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 부산지방식품의약품안전청 관사의 관리유지 및 운영에  필요한 사항을 정함을 목적으로 한다.<개정 2011. 12. 26.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:(부산지방식품의약품안전청)관사관리규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "입주대상",
        "chapter": "",
        "content": "제2조(입주대상) 관사에 입주할 수 있는 대상은 타 지역에서 전보되어 온 자로서 자가에서 통근이 불가능하여 관사입주를 희망하는 직원에 한한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:(부산지방식품의약품안전청)관사관리규정#JO0002"
      },
