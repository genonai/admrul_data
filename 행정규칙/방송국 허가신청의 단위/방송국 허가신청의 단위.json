      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 고시는 전파법시행령 제30조제4항의 규정에 의한 방송국 허가신청의 단위를 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "citation",
            "delegation_type": null,
            "target_category": "법령",
            "source_article_no": "제1조",
