│      │      │○    │    │\n│    │                        ├────┴──────────┼───┼───┼───┼──┤\n│    │                        │결정통지                      │      │      │○    │    │\n│    │                        ├───────────────┼───┼───┼───┼──┤\n│    │                        │정보공개업무 기록ㆍ관리       │      │      │      │○  │\n├──┼────────────┼───────────────┼───┼───┼───┼──┤\n│20  │각종 간행물 발간        │발간계획 수립                 │      │○    │      │    │\n│    │                        ├───────────────┼───┼───┼───┼──┤\n│    │                        │원고작성 및 발간ㆍ배부        │      │      │○    │    │\n├──┼────────────┼───────────────┼───┼───┼───┼──┤\n│21  │각종 통계 보고          │중요사항                      │      │      │○    │    │\n│    │및 자료 수집            ├───────────────┼───┼───┼───┼──┤\n│    │                        │일반사항                      │      │      │      │○  │\n│    │                        ├───────────────┼───┼───┼───┼──┤\n│    │                        │각종 자료 수집                │      │      │      │○  │\n├──┼────────────┼───────────────┼───┼───┼───┼──┤\n│22  │보안업무                │대외비 문서 관리              │      │      │○    │    │\n│    │                        ├───────────────┼───┼───┼───┼──┤\n│    │                        │일일 보안점검 및 보안진단     │      │      │      │○  │\n├──┼────────────┼───────────────┼───┼───┼───┼──┤\n│23  │세출예산                │예산요구                      │      │      │○    │    │\n│    │                        ├───────────────┼───┼───┼───┼──┤\n│    │                        │예산심의                      │      │      │○    │    │\n│    │                        ├───────────────┼───┼───┼───┼──┤\n│    │                        │예산결산                      │      │      │○    │    │\n├──┼────────────┼────┬──────────┼───┼───┼───┼──┤\n│24  │예산집행                │집행    │1,000만원 이상      │      │○    │      │    │\n│    │                        │        ├──────────┼───┼───┼───┼──┤\n│    │                        │        │1,000만원 미만      │      │      │○    │    │\n│    │                        ├────┴──────────┼───┼───┼───┼──┤\n│    │                        │관서운영경비출납계산서 제출   │      │      │○    │    │\n├──┼────────────┴───────────────┼───┼───┼───┼──┤\n│25  │자금요구                                                │      │      │○    │    │\n├──┼────────────┬───────────────┼───┼───┼───┼──┤\n│26  │물품관리                │수급관리(변경)계획            │      │○    │      │    │\n│    │                        ├────┬──────────┼───┼───┼───┼──┤\n│    │                        │불용결정│500만원 이상        │      │○    │      │    │\n│    │                        │        ├──────────┼───┼───┼───┼──┤\n│    │                        │        │500만원 미만        │      │      │○    │    │\n│    │                        ├────┴──────────┼───┼───┼───┼──┤\n│    │                        │불용처분                      │      │      │○    │    │\n│    │                        ├───────────────┼───┼───┼───┼──┤\n│    │                        │재물조사 실시 및 보고         │      │      │○    │    │\n│    │                        ├───────────────┼───┼───┼───┼──┤\n│    │                        │물품운영 및 청구              │      │      │      │○  │\n├──┼────────────┼───────────────┼───┼───┼───┼──┤\n│27  │국유재산 관리           │관리계획                      │      │○    │      │    │\n│    │                        ├───────────────┼───┼───┼───┼──┤\n│    │                        │취득ㆍ처분(승인요청)          │      │      │○    │    │\n│    │                        ├───────────────┼───┼───┼───┼──┤\n│    │                        │임대차 및 사용허가            │      │      │○    │    │\n├──┼────────────┴───────────────┼───┼───┼───┼──┤\n│28  │청사 관리                                               │      │      │○    │    │\n├──┼────────────────────────────┼───┼───┼───┼──┤\n│29  │일반서무                                                │      │      │○    │    │\n├──┼────────────┬───────────────┼───┼───┼───┼──┤\n│30  │사무관리                │관인관수                      │      │      │      │○  │\n│    │                        ├───────────────┼───┼───