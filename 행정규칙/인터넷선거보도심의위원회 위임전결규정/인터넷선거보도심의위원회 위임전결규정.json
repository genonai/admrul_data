                    │(의결)│      │      │    │\n│    │                        │        ├──────────┼───┼───┼───┼──┤\n│    │                        │        │일반사항            │      │○    │      │    │\n│    │                        ├────┴──────────┼───┼───┼───┼──┤\n│    │                        │위원회의 상정                 │○    │      │      │    │\n│    │                        ├───────────────┼───┼───┼───┼──┤\n│    │                        │결정사항 통지                 │      │      │○    │    │\n├──┼────┬───────┴───────────────┼───┼───┼───┼──┤\n│8   │불공정  │심의대상 인터넷언론사 결정                    │○    │      │      │    │\n│    │선거보도├───────┬───────────────┼───┼───┼───┼──┤\n│    │모니터링│모니터링      │기본계획                      │      │○    │      │    │\n│    │및 안내 │              ├───────────────┼───┼───┼───┼──┤\n│    │        │              │검토보고                      │      │○    │      │    │\n│    │        ├───────┼───────────────┼───┼───┼───┼──┤\n│    │        │공정선거보도  │중요사항                      │      │○    │      │    │\n│    │        │안내          ├───────────────┼───┼───┼───┼──┤\n│    │        │              │일반사항                      │      │      │○    │    │\n├──┼────┴───────┼───────────────┼───┼───┼───┼──┤\n│9   │국회업무                │중요사항                      │      │○    │      │    │\n│    │                        ├───────────────┼───┼───┼───┼──┤\n│    │                        │일반사항                      │      │      │○    │    │\n├──┼────────────┴───────────────┼───┼───┼───┼──┤\n│10  │보도자료 제공                                           │      │○    │      │    │\n├──┼────────────────────────────┼───┼───┼───┼──┤\n│11  │감사자료 제출                                           │      │      │○    │    │\n├──┼────────────┬───────────────┼───┼───┼───┼──┤\n│12  │관계기관과의            │중요사항                      │      │○    │      │    │\n│    │업무협조                ├───────────────┼───┼───┼───┼──┤\n│    │                        │일반사항                      │      │      │○    │    │\n├──┼──────