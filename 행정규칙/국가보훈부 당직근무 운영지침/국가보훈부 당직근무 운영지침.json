    │    │    ┃\n┃      │      │    │      │    │    │    │문서│수신처│제목│    │    │    ┃\n┃      │      │    │      │    │    │    │번호│      │    │    │    │    ┃\n┃      ├───┼──┼───┼──┼──┼──┼──┼───┼──┼──┼──┼──┨\n┃      │      │    │      │    │    │    │    │      │    │    │    │    ┃\n┠───┼───┴──┼───┼──┴──┼──┼──┼───┼──┼──┼──┼──┨\n┃지시  │            │조치  │          │    │    │      │    │    │    │    ┃\n┃받은  │            │사항  │          ├──┼──┼───┼──┼──┼──┼──┨\n┃사항  │            │      │          │    │    │      │    │    │    │    ┃\n┃      │            │      │          ├──┼──┼───┼──┼──┼──┼──┨\n┃      │            │      │          │    │    │      │    │    │    │    ┃\n┠───┼──────┼───┼─────┼──┴──┴───┴──┴──┴──┴──┨\n┃지시한│            │조치  │          │특근자 현황                               ┃\n┃사항  │            │결과  │          ├──────┬──────┬───────┨\n┃      │            │확인  │          │소속ㆍ부서  │근무자      │특근시간      ┃\n┃      │            │      │          ├──────┼──────┼───────┨\n┃      │            │      │          │            │외   명     │              ┃\n┃      │            │      │          ├──────┼──────┼───────┨\n┃      │            │      │          │            │외   명     │              ┃\n┠───┼──────┼───┼─────┼──────┼──────┼───────┨\n┃보고  │            │인계  │1.물품    │            │외   명     │              ┃\n┃사항  │            │사항  │2.문서    ├──────┼──────┼───────┨\n┃      │            │      │3.기타    │            │외   명     │              ┃\n┃      │            │      │          ├──────┼──────┼───────┨\n┃      │            │      │          │            │외   명     │              ┃\n┗━━━┷━━━━━━┷━━━┷━━━━━┷━━━━━━┷━━━━━━┷━━━━━━━┛\n\n\n\n(뒤 쪽)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n┃청사 내의 순찰점검사항                                                    ┃\n┠─────┬──────┬────┬──────┬──────┬─────┨\n┃순찰시간  │발견사실 및 │순찰자  │순찰시간    │발견사실 및 │순찰자    ┃\n┃          │처리개요    │        │            │ 처리 개요  │          ┃\n┠─────┼──────┼────┼──────┼──────┼─────┨\n┃ 시 분부터│            │(서명)  │  시  분부터│            │(서명)    ┃\n┃ 시 분까지│            │        │  시  분까지│            │          ┃\n┠─────┼──────┼────┼──────┼──────┼─────┨\n┃ 시 분부터│            │(서명)  │  시  분부터│            │(서명)    ┃\n┃ 시 분까지│            │        │  시  분까지│            │          ┃\n┠─────┼────┬─┴────┼──────┼──────┼─────┨\n┃연락사항  │연락기관│수화자 소속 │수화자 성명 │송화자 성명 │이상 유무 ┃\n┃          │        │ㆍ직위(직급)│            │            │          ┃\n┠─────┼────┼──────┼──────┼──────┼─────┨\n┃          │        │            │            │            │          ┃\n┠─────┼────┼──────┼──────┼──────┼─────┨\n┃          │        │            │            │            │          ┃\n┠─────┼────┼──────┼──────┼──────┼─────┨\n┃          │        │            │            │            │          ┃\n┠─────┼────┼──────┼──────┼──────┼─────┨\n┃          │        │            │            │            │          ┃\n┠─────┼────┼──────┼──────┼──────┼─────┨\n┃          │        │            │            │            │          ┃\n┠─────┼────┼──────┼──────┼──────┼─────┨\n┃          │        │            │            │            │          ┃\n┠─────┼────┼──────┼──────┼──────┼─────┨\n┃          │        │            │            │            │          ┃\n┠─────┼────┼──────┼──────┼──────┼─────┨\n┃          │        │            │            │            │          ┃\n┠─────┼────┼──────┼──────┼──────┼─────┨\n┃          │        │            │            │            │          ┃\n┠─────┼────┼──────┼──────┼──────┼─────┨\n┃          │        │            │            │            │          ┃\n┠─────┴────┴──────┴──────┴──────┴─────┨\n┃ 비고                                                                     ┃\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n\n",
