        "article_no": "제12조",
        "article_title": "회의록",
        "chapter": "제2장 위원회의 운영",
        "content": "제12조(회의록) 위원회는 기록보존이 필요한 사항에 대해 회의록을 작성ㆍ보관하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방규제혁신위원회운영지침#JO0012"
