┯━━━━━━━┓\n┃EMPLOYMENT    │EMPLOYER/ │DATES EMPLOYED                  │POSITION              │LOCATION      ┃\n┃HISTORY       │REFERENCE │(MM/YY-MM/YY)                   │                      │(Street       ┃\n┃              │          │                                │                      │Address &     ┃\n┃              │          │                                │                      │City/Country) ┃\n┃              ├─────┼────────────────┼───────────┼───────┨\n┃              │          │                                │                      │              ┃\n┃              ├─────┼────────────────┼───────────┼───────┨\n┃              │          │                                │                      │              ┃\n┃              ├─────┼────────────────┼───────────┼───────┨\n┃              │          │                                │                      │              ┃\n┃              ├─────┼────────────────┼───────────┼───────┨\n┃              │          │                                │                      │              ┃\n┠───────┼────┬┴────────┬───────┼─────┬─────┼───────┨\n┃FAMILY        │RELATION│FULL NAME         │DATE OF       │EDUCATION │OCCUPATION│ADDRESS       ┃\n┃INFORMATION   │        │Last/First/Middle │BIRTH         │          │          │              ┃\n┃              ├────┼─────────┼───────┼─────┼─────┼───────┨\n┃              │        │                  │              │          │          │              ┃\n┃              ├────┼─────────┼───────┼─────┼─────┼───────┨\n┃              │        │                  │              │          │          │              ┃\n┃              ├────┼─────────┼───────┼─────┼─────┼───────┨\n┃              │        │                  │              │          │          │              ┃\n┃              ├────┼─────────┼───────┼─────┼─────┼───────┨\n┃              │        │                  │              │          │          │              ┃\n┠───────┼────┼─────────┼───────┼─────┼─────┼───────┨\n┃RELATIVES     │RELATION│FULL NAME         │DATES KNOWN   │OCCUPATION│TITLE     │PHONE         ┃\n┃&             │        │Last/First/Middle │(MM/YY-MM/YY) │          │          │NUMBER        ┃\n┃ACQUAINTANCES ├────┼─────────┼───────┼─────┼─────┼───────┨\n┃IN KOREA      │        │                  │              │          │          │              ┃\n┃              ├────┼─────────┼───────┼─────┼─────┼───────┨\n┃              │        │                  │              │          │          │              ┃\n┃              ├────┼─────────┼───────┼─────┼─────┼───────┨\n┃              │        │                  │              │          │          │              ┃\n┠───────┴────┴─────────┴───────┴─────┴─────┴───────┨\n┃I understand that the information provided in this form may be submitted for verification           ┃\n┃against the criminal records and credit agencies in accordance with the security clearance          ┃\n┃policy. I declare that the information I have provided is true and complete to the best of my       ┃\n┃knowledge and belief. I understand that any false statement or deliberate omission in the           ┃\n┃information I have given in this form may disqualify me from employment or make me liable to        ┃\n┃disciplinary action which may include dismissal.                                                    ┃\n┃                                                                                                    ┃\n┃     DATE :                                                                                         ┃\n┃          SIGNATURE :                                                                               ┃\n┃                                                                                                    ┃\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n210mm×297mm[백상지(120g/㎡) 또는 백상지(80g/㎡)]",
