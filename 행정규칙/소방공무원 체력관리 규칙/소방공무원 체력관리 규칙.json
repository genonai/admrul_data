      {
        "article_no": "제7조의2",
        "article_title": "체력검정 실시의 예외",
        "chapter": "",
        "content": "제7조의2(체력검정 실시의 예외) 체력관리기관의 장은 「재난 및 안전관리 기본법」 제3조제1호의 사유로 체력검정을 실시하기 곤란한 경우에 소속 소방공무원의 전체 또는 일부에 대하여 체력검정을 실시하지 않을 수 있다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "citation",
            "delegation_type": null,
            "target_category": "법령",
            "source_article_no": "제7조의2",
            "source_clause": "제7조의2",
