      "content": "【붙  임】\n수용 또는 사용할 토지 조서\n┌──┬───┬───┬──┬─────┬─────────┬───────┬───────┐\n│연번│소재지│지번  │지목│공부상면적│면적              │소유자        │주소          │\n│    │      │      │    │          ├────┬────┤              │              │\n│    │      │      │    │          │일시점용│영구점용│              │              │\n├──┼───┼───┼──┼─────┼────┼────┼───────┼───────┤\n│1   │안정면│323   │천  │74,747    │3,564.28│34.39   │국토해양부    │              │\n│    │일원리│      │    │          │        │        │              │              │\n├──┼───┼───┼──┼─────┼────┼────┼───────┼───────┤\n│2   │영주시│368-63│천  │91,838    │8,056.61│660.13  │국토해양부    │              │\n│    │창진동│      │    │          │        │        │              │              │\n├──┼───┼───┼──┼─────┼────┼────┼───────┼───────┤\n│3   │영주시│625-1 │천  │65,430    │9,136.41│323.33  │국토해양부    │              │\n│    │상줄동│      │    │          │        │        │              │              │\n├──┼───┼───┼──┼─────┼────┼────┼───────┼───────┤\n│4   │영주시│1-1   │답  │545       │7.15    │3.90    │사회복지법인  │대구시        │\n│    │상줄동│      │    │          │        │        │호동원        │봉덕동 84     │\n├──┼───┼───┼──┼─────┼────┼────┼───────┼───────┤\n│5   │영주시│2-2   │답  │945       │43.78   │23.88   │사회복지법인  │대구시        │\n│    │상줄동│      │    │          │        │        │호동원        │봉덕동 84     │\n├──┼───┼───┼──┼─────┼────┼────┼───────┼───────┤\n│6   │영주시│3-2   │답  │1,015     │41.60   │22.70   │사회복지법인  │대구시        │\n│    │상줄동│      │    │          │        │        │호동원        │봉덕동 84     │\n├──┼───┼───┼──┼─────┼────┼────┼───────┼───────┤\n│7   │영주시│4-2   │답  │1,431     │25.18   │13.74   │사회복지법인  │대구시        │\n│    │상줄동│      │    │          │        │        │호동원        │봉덕동 84     │\n├──┼───┼───┼──┼─────┼────┼────┼───────┼───────┤\n│8   │영주시│368-85│천  │71,058    │1,749.88│574.44  │국토해양부    │              │\n│    │창진동│      │    │          │        │        │              │              │\n├──┼───┼───┼──┼─────┼────┼────┼───────┼───────┤\n│9   