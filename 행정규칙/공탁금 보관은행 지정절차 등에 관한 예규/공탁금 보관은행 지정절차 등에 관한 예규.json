  "addenda": [
    {
      "promulgation_date": "20091231",
      "promulgation_no": "844",
      "content": "부 칙(2009. 12. 31. 제844호)이 예규는 2009년 12월 31일부터 시행한다."
    },
    {
      "promulgation_date": "20111102",
      "promulgation_no": "911",
      "content": "부 칙(2011. 11. 2. 제911호)이 예규는 2011년 11월 2일부터 시행한다."
    },
    {
      "promulgation_date": "20130909",
      "promulgation_no": "974",
      "content": "부 칙(2013. 9. 9. 제974호)제1조(시행일) 이 예규는 2013년 9월 23일부터 시행한다.제2조(경과조치) 제6조제2항의 개정규정에 따라 2013년도 보관은행 평가서를 작성할 때에는 평가기간을 해당 공탁금 보관은행의 지정일(재지정한 경우에는 재지정일)부터 평가일까지로 하여 평가한다."
    },
    {
      "promulgation_date": "20170215",
      "promulgation_no": "1117",
      "content": "부 칙(2017. 2. 15. 제1117호)이 예규는 2017년 3월 2일부터 시행한다."
    },
    {
      "promulgation_date": "20171227",
      "promulgation_no": "1144",
      "content": "부 칙(2017. 12. 27. 제1144호)이 예규는 2018년 3월 2일부터 시행한다."
    },
    {
      "promulgation_date": "20250729",
      "promulgation_no": "1441",
      "content": "부 칙(2025. 7. 29. 제1441호)이 예규는 즉시 시행한다."
    },
    {
      "promulgation_date": "99991231",
      "promulgation_no": "9998",
      "content": "부 칙제1조(시행일) 이 예규는 2008년 1월 1일부터 시행한다.제2조(경과조치) 이 예규 시행 전에 지정된 보관은행은 이 예규에 따라 지정된 것으로 본다."
    },
    {
      "promulgation_date": "99991231",
      "promulgation_no": "9999",
      "content": "부 칙① (시행일) 이 예규는 2005. 1. 1.부터 시행한다. 다만 제6조의 규정은 2006. 1. 1.부터 시행한다.② (경과규정) 이 예규 시행 전에 지정된 보관은행은 이 예규에 따라 지정된 것으로 본다."
    }
  ],
