      "content": "\n■ 관광도로 지정 절차 및 평가 지침[별지 제2호서식]\n┌───────────────────────────────────────────────────┐\n│서면평가서                                                                                            │\n├───────────┬──────────────────────────┬────┬───────┤\n│관광도로명            │                                                    │신청기관│              │\n├─────┬─────┼──────────────────────────┼────┴────┬──┤\n│항목      │세부평가  │평가지표                                            │배점              │점수│\n│(배점)    │항목(배점)│                                                    │                  │    │\n├─────┼─────┼──────────────────────────┼─┬─┬─┬─┬─┼──┤\n│관광도로  │경관      │?? 관광도로 또는 관광도로 주변의 경관, 조망시설   │10│8 │6 │4 │2 │    │\n│기본요건  │(10)      │ - 자연환경, 자연경관, 조경, 시가지경관, 산업       │  │  │  │  │  │    │\n│(25)      │          │경관,  농어촌경관, 관광휴양경관, 역사문화경관,      │  │  │  │  │  │    │\n│          │          │생태경관 등                                         │  │  │  │  │  │    │\n│          │          │ - 조망시설: 전망대, 쉼터 등 유무 및 조망시설 경관  │  │  │  │  │  │    │\n│          ├─────┼──────────────────────────┼─┼─┼─┼─┼─┼──┤\n│          │관광자원  │?? 관광도로 주변지역 관광 자원                    │10│8 │6 │4 │2 │    │\n│          │(10)      │ - 역사 자원: 유적지, 사적지, 옛 건축물             │  │  │  │  │  │    │\n│          │          │ - 문화 자원: 풍속, 행사, 생활, 스포츠, 야외활동    │  │  │  │  │  │    │\n│          │          │ - 예술 자원: 미술, 음악, 공연, 전시                │  │  │  │  │  │    │\n│          │          │ - 생태 자원: 천연자원, 휴양자원, 동식물            │  │  │  │  │  │    │\n│          ├─────┼──────────────────────────┼─┼─┼─┼─┼─┼──┤\n│          │접근성    │?? 관광도로 접근 용이성                           │5 │4 │3 │2 │1 │    │\n│          │(5)       │ - 도로 연계성: 고속도로, 국도 등 타 도로와 연계성  │  │  │  │  │  │    │\n│          │          │ - 교통수단 연계성: 철도역, 공항, 버스터미널 등     │  │  │  │  │  │    │\n│          │          │타 교통 수단과 연계성                               │  │  │  │  │  │    │\n├─────┼─────┼──────────────────────────┼─┼─┼─┼─┼─┼──┤\n│관광도로  │필요성    │?? 지정 목적과 필요성                             │5 │4 │3 │2 │1 │    │\n│관리계획  │(5)       │ - 관광도로 적합성, 활용 가능성 및 효과성 등        │  │  │  │  │  │    │\n│(20)      ├─────┼──────────────────────────┼─┼─┼─┼─┼─┼──┤\n│          │경관 및   │?? 경관 및 관광자원 개선방안                      │5 │4 │3 │2 │1 │    │\n│          │관광자원  │ - 경관 위해요소 차폐, 디자인 특화 등               │  │  │  │  │  │    │\n│          │개선방안  │ - 경관 또는 조경 등 조성 또는 보존                 │  │  │  │  │  │    │\n│          │(5)       │                                                    │  │  │  │  │  │    │\n│          ├─────┼──────────────────────────┼─┼─┼─┼─┼─┼──┤\n│          │편의시설  │?? 이용자 편의시설 설치 및 정비                   │5 │4 │3 │2 │1 │    │\n│          │(5)       │ - 휴게소, 주차장, 화장실 등 관광도로 이용자 편의시설│  │  │  │  │  │    │\n│          ├─────┼──────────────────────────┼─┼─┼─┼─┼─┼──┤\n│          │관리?운영│?? 관광도로 관리?운영에 관한 사항                │5 │4 │3 │2 │1 │    │\n│          │(5)       │ - 관광도로 운영 및 관리, 홍보 방안                 │  │  │  │  │  │    │\n│          │          │ - 관광도로 인력 및 조직, 재원확보(예산)            │  │  │  │  │  │    │\n├─────┼─────┼──────────────────────────┼─┼─┼─┼─┼─┼──┤\n│지역발전  │지역      │?? 관광도로 지정을 통한 지역경제 활성화 효과      │5 │4 │3 │2 │1 │    │\n│효과      │활성화    │ - 일자리 창출, 관광상품 기획?판매 수익 증대,      │  │  │  │  │  │    │\n│(5)       │(5)       │주민소득 증대 등 지역발전 효과                      │  │  │  │  │  │    │\n│          │          │ - 고용유발효과, 부가가치유발효과, 생산유발효과 등  │  │  │  │  │  │    │\n├─────┴─────┴──────────────────────────┴─┴─┴─┴─┴─┼──┤\n│ 서면평가 합계(50점)                                                                            │    │\n├─────┬─────┬──────────────────────────┬─────────┼──┤\n│가산점(5  │타 사업   │국토교통부 추진 사업과의 연계                       │1                 │    │\n│)         │연계      ├──────────────────────────┼─────────┼──┤\n│          │          │정부 사업(타부처)과의 연계                          │1                 │    │\n│          ├─────┼──────────────────────────┼─────────┼──┤\n│          │타 시?도 │2개 이상 시?도가 합동으로 신청                     │2                 │    │\n│          │연계      │                                                    │                  │    │\n│          ├─────┼──────────────────────────┼─────────┼──┤\n│          │지역발전  │낙후지역, 인구소멸지역 등에 위치한 도로             │1                 │    │\n│          │          │(KDI 지역낙후도 지수 활용)                          │                  │    │\n├─────┴─────┴──────────────────────────┴─────────┼──┤\n│가산점 합계                                                                                     │    │\n├─────┬─────┬┬──┬────────────────────────────────┴──┤\n│위원      │소속      ││성명│              (서명)                                                  │\n└─────┴─────┴┴──┴───────────────────────────────────┘\n┌─────┬┬────┬──────────┐\n│관광도로명││신청기관│                    │\n├──┬──┴┴────┴──────────┤\n│서면│                                      │\n│평가│※ 평가의견을 구체적으로 작성         │\n│의견│                                      │\n├──┼──┬┬────┬──────────┤\n│위원│소속││성명    │              (서명)│\n└──┴──┴┴────┴──────────┘",
