   ├───────────────────────┼──┼───┼──┨\n┃    │                            │사법경찰관리 운영에 관한 사항                 │○  │      │    ┃\n┠──┼──────────────┼───────────────────────┼──┼───┼──┨\n┃7   │야생동물 질병 병성감정      │중요사항                                      │    │      │○  ┃\n┃    │                            ├───────────────────────┼──┼───┼──┨\n┃    │                            │일반사항                                      │    │○    │    ┃\n┠──┼──────────────┼───────────────────────┼──┼───┼──┨\n┃8   │수입 야생동물 검역 통계     │중요사항 조치?지시                           │    │○    │    ┃\n┃    │                            ├───────────────────────┼──┼───┼──┨\n┃    │                            │단순사항 이첩 및 지시 등                      │○  │      │    ┃\n┃    │                            ├───────────────────────┼──┼───┼──┨\n┃    │                            │수출입 검역 통계 관리                         │○  │      │    ┃\n┠──┼──────────────┼───────────────────────┼──┼───┼──┨\n┃9   │시험연구 및 검사장비        │구입계획 수립에 관한 사항                     │    │○    │    ┃\n┃    │                            ├───────────────────────┼──┼───┼──┨\n┃    │                            │구입계획 관리?운영에 관한 사항               │    │○    │    ┃\n┠──┼──────────────┼───────────────────────┼──┼───┼──┨\n┃10  │야생동물 질병 수입위험평가  │기본계획 수립                                 │    │      │○  ┃\n┃    │                            ├───────────────────────┼──┼───┼──┨\n┃    │                            │결과보고                                      │    │○    │    ┃\n┃    │                            ├─────────┬─────────────┼──┼───┼──┨\n┃    │                            │관련 연구 및 용역 │계획, 최종보고            │    │○    │    ┃\n┃    │                            │사업              ├─────────────┼──┼───┼──┨\n┃    │                            │                  │중간보고                  │    │○    │    ┃\n┃    │                            ├─────────┼─────────────┼──┼───┼──┨\n┃    │                            │자문위원 운영     │구성 및 기본계획 수립     │    │○    │    ┃\n┃    │                            │                  ├─────────────┼──┼───┼──┨\n┃    │                            │                  │운영에 관한 사항          │○  │      │    ┃\n┠──┼──────────────┼─────────┴─────────────┼──┼───┼──┨\n┃11  │야생동물 검역 관련 국가간   │공식회의 대응 계획 및 결과 보고               │    │      │○  ┃\n┃    │협력(국제협력 업무)         ├───────────────────────┼──┼───┼──┨\n┃    │                            │기타 일반 협력                                │    │○    │    ┃\n┠──┼──────────────┼───────────────────────┼──┼───┼──┨\n┃12  │해외 정보수집               │해외 야생동물 질병?검역 주요 정보(분석) 보고 │    │○    │    ┃\n┃    │                            ├───────────────────────┼──┼───┼──┨\n┃    │                            │해외 야생동물 질병?검역 일반 동향 보고       │    │○    │    ┃\n┠──┼──────────────┼───────────────────────┼──┼───┼──┨\n┃13  │지정검역시행장 지정·관리에 │지정?취소 사항                               │    │      │○  ┃\n┃    │관한 사항                   ├───────────────────────┼──┼───┼──┨\n┃    │                            │운영?관리 사항                               │    │○    │    ┃\n┃    │                            ├───────────────────────┼──┼───┼──┨\n┃    │                            │검역관리인?보관관리인 지정 등에 관한 사항    │    │○    │    ┃\n┠──┼──────────────┼───────────────────────┼──┼───┼──┨\n┃14  │야생동물 검역 관련 정보시   │계획수립 및 조정                              │    │      │○  ┃\n┃    │스템 운영?관리             ├─────────┬─────────────┼──┼───┼──┨\n┃    │                            │사업수행 및       │중요사항                  │    │○    │    ┃\n┃    │                            │관리              ├─────────────┼──┼───┼──┨\n┃    │                            │                  │일반사항                  │○  │      │    ┃\n┃    │                            ├─────────┼─────────────┼──┼───┼──┨\n┃    │                            │결과보고          │최종보고                  │    │      │○  ┃\n┃    │                            │                  ├─────────────┼──┼───┼──┨\n┃    │                            │                  │중간보고                  │    │○    │    ┃\n┗━━┷━━━━━━━━━━━━━━┷━━━━━━━━━┷━━━━