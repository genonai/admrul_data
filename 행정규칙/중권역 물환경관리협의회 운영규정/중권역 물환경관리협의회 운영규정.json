      "enforcement_date": "",
      "content": "[별표 1]\n┏━━┯━━━━━┯━━━━━━━━━┯━━━━━━━━━━━━━━━━━━━┯━━━━┯━━┓\n┃연번│중권역명  │시?군명(면적비율)│소권역명                              │소권역수│비고┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃1   │금호강    │경산시(19%)       │영천댐, 자호천, 고촌천, 고현천,       │19      │    ┃\n┃    │          │대구광역시(25%)   │신령천, 금호강시점, 금호강상류,       │        │    ┃\n┃    │          │영천시(43%)       │청통천, 오목천, 남천, 동촌수위표,     │        │    ┃\n┃    │          │칠곡군(6%)        │공산댐, 동화천, 금호강중류, 신천      │        │    ┃\n┃    │          │포항시(7%)        │상류, 신천하류, 팔거천, 이언천,       │        │    ┃\n┃    │          │                  │금호강하류                            │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃2   │형산강    │경주시(74%)       │형산강상류, 대천, 남천, 덕동댐,       │9       │    ┃\n┃    │          │울산광역시(5%)    │북천, 칠평천, 기계천, 안강수위표,     │        │    ┃\n┃    │          │포항시(21%)       │형산강하류                            │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃3   │대종천    │경주시(38%)       │동해면, 냉천, 대화천, 대종천, 하서천, │6       │    ┃\n┃    │          │울산광역시(15%)   │수렴천                                │        │    ┃\n┃    │          │포항시(46%)       │                                      │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃4   │강정고령보│고령군(1%)        │칠곡보, 한천, 강정고령보, 성주수      │8       │    ┃\n┃    │          │구미시(29%)       │위표, 백천상류, 이천, 백천하류,       │        │    ┃\n┃    │          │김천시(3%)        │한천합류후                            │        │    ┃\n┃    │          │대구광역시(5%)    │                                      │        │    ┃\n┃    │          │성주군(35%)       │                                      │        │    ┃\n┃    │          │칠곡군(27%)       │                                      │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃5   │임하댐    │안동시(23%)       │반변천상류, 장파천, 동천합류전,       │16      │    ┃\n┃    │          │영양군(34%)       │동천, 화매천합류전, 화매천, 임하      │        │    ┃\n┃    │          │청송군(41%)       │댐상류, 용전천상류, 성덕댐, 용전      │        │    ┃\n┃    │          │포항시(1%)        │천하류, 임하댐, 길안천상류, 길안      │        │    ┃\n┃    │          │                  │수위표, 길안천하류, 반변천하류,       │        │    ┃\n┃    │          │                  │괘천합류후                            │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃6   │위천      │구미시(2%)        │화북댐, 미성교수위표, 병천교수위표,   │10      │    ┃\n┃    │          │군위군(44%)       │남천, 쌍계천합류전, 쌍계천상류,       │        │    ┃\n┃    │          │의성군(52%)       │남대천, 쌍계천하류, 용곡수위표,       │        │    ┃\n┃    │          │칠곡군(2%)        │위천                                  │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃7   │감천      │구미시(13%)       │감천상류, 감천중류, 직지사천, 김천    │8       │    ┃\n┃    │          │김천시(87%)       │수위표, 아천, 율곡천, 감천하류,       │        │    ┃\n┃    │          │                  │부항댐                                │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃연번│중권역명  │시군명            │소권역명                              │소권역수│비고┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃8   │내성천    │문경시(14%)       │낙화암천, 내성천상류, 토일천, 서천    │17      │    ┃\n┃    │          │봉화군(17%)       │상류, 죽계천, 서천하류, 내성천중류,   │        │    ┃\n┃    │          │안동시(4%)        │옥계천, 월포수위표, 한천상류, 예천    │        │    ┃\n┃    │          │영주시(34%)       │수위표, 한천하류, 경천댐, 대하리천,   │        │    ┃\n┃    │          │예천군(30%)       │금천, 내성천하류, 영주댐              │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃9   │병성천    │상주시(100%)      │병성천상류, 북천, 병성천하류          │3       │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃10  │구미보    │구미시(79%)       │구미보, 낙단보                        │2       │    ┃\n┃    │          │상주시(9%)        │                                      │        │    ┃\n┃    │          │의성군(12%)       │                                      │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃11  │낙동상주  │문경시(2%)        │영강합류전, 위천합류전, 상주보        │3       │    ┃\n┃    │          │상주시(66%)       │                                      │        │    ┃\n┃    │          │예천군(23%)       │                                      │        │    ┃\n┃    │          │의성군(8%)        │                                      │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃12  │창녕합천보│고령군(23%)       │진천천, 고령교수위표, 현풍수위표,     │7       │    ┃\n┃    │          │대구광역시(57%)   │달창댐, 차천, 달성보, 창녕합천보      │        │    ┃\n┃    │          │창녕군(13%)       │                                      │        │    ┃\n┃    │          │합천군(6%)        │                                      │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃13  │안동댐    │봉화군(53%)       │황지천, 낙동강상류, 소천수위표,       │12      │    ┃\n┃    │          │안동시(29%)       │현동천, 재산천합류전, 운곡천합류전,   │        │    ┃\n┃    │          │영양군(1%)        │운곡천, 도산수위표, 안동댐상류,       │        │    ┃\n┃    │          │울진군(5%)        │동계천, 안동댐, 안동댐역조정지        │        │    ┃\n┃    │          │태백시(12%)       │                                      │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃14  │안동댐하류│안동시(53%)       │송야천, 미천상류, 미천하류, 안동      │8       │    ┃\n┃    │          │영주시(1%)        │댐역조정지하류, 신역천, 광산천합      │        │    ┃\n┃    │          │예천군(6%)        │류전, 광산천, 내성천합류전            │        │    ┃\n┃    │          │의성군(40%)       │                                      │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃15  │회천      │고령군(32%)       │성주댐, 대가천, 회천상류, 가야천,     │7       │    ┃\n┃    │          │김천시(22%)       │묘산천, 안림천, 회천하류              │        │    ┃\n┃    │          │성주군(29%)       │                                      │        │    ┃\n┃    │          │합천군(27%)       │                                      │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃16  │영강      │문경시(65%)       │영강상류, 영강중류, 조령천, 점촌      │7       │    ┃\n┃    │          │상주시(35%)       │수위표, 이안천상류, 이안천하류,       │        │    ┃\n┃    │          │                  │영강하류                              │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃17  │영덕오십천│영덕군(51%)       │축산천, 영덕오십천상류, 대서천,       │8       │    ┃\n┃    │          │청송군(3%)        │영덕오십천하류, 장사천, 광천, 용      │        │    ┃\n┃    │          │포항시(45%)       │연댐, 곡강천                          │        │    ┃\n┠──┼─────┼─────────┼───────────────────┼────┼──┨\n┃18  │왕피천    │영덕군(20%)       │부구천, 울진 남대천, 장수포천, 매     │11      │    ┃\n┃    │          │영양군(10%)       │화천, 광천, 왕피천, 척산천, 평해      │        │    ┃\n┃    │          │울릉군(4%)        │남대천, 삼율천, 송천, 울릉도          │        │    ┃\n┃    │          │울진군(65%)       │                                      │        │    ┃\n┗━━┷━━━━━┷━━━━━━━━━┷━━━━━━━━━━━━━━━━━━━┷━━━━┷━━┛\n중권역별 협의회 관할구역",
