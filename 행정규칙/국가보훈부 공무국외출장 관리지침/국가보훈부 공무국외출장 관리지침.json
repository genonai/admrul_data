      "content": "[별지 제1호서식]\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n┃(       )년도 공무국외출장계획                                                    ┃\n┃                                                                                  ┃\n┃                                                                                  ┃\n┣━━━┯━━┯━━━━━━━━━┯━━━━┯━━━━━━┯━━━━┯━━━━┯━━┫\n┃부서명│제목│출장목적          │출장지역│출장인원    │출장경비│예산과목│기타┃\n┃      │    │(구체적으로 기술) │(기간)  │(직급ㆍ인원)│(천원)  │        │    ┃\n┣━━━┿━━┿━━━━━━━━━┿━━━━┿━━━━━━┿━━━━┿━━━━┿━━┫\n┃      │    │                  │        │            │        │        │    ┃\n┠───┼──┼─────────┼────┼──────┼────┼────┼──┨\n┃      │    │                  │        │            │        │        │    ┃\n┠───┼──┼─────────┼────┼──────┼────┼────┼──┨\n┃      │    │                  │        │            │        │        │    ┃\n┠───┼──┼─────────┼────┼──────┼────┼────┼──┨\n┃      │    │                  │        │            │        │        │    ┃\n┠───┼──┼─────────┼────┼──────┼────┼────┼──┨\n┃      │    │                  │        │            │        │        │    ┃\n┠───┼──┼─────────┼────┼──────┼────┼────┼──┨\n┃      │    │                  │        │            │        │        │    ┃\n┠───┼──┼─────────┼────┼──────┼────┼────┼──┨\n┃      │    │                  │        │            │        │        │    ┃\n┠───┼──┼─────────┼────┼──────┼────┼────┼──┨\n┃      │    │                  │        │            │        │        │    ┃\n┠───┼──┼─────────┼────┼──────┼────┼────┼──┨\n┃      │    │                  │        │            │        │        │    ┃\n┠───┼──┼─────────┼────┼──────┼────┼────┼──┨\n┃      │    │                  │        │            │        │        │    ┃\n┗━━━┷━━┷━━━━━━━━━┷━━━━┷━━━━━━┷━━━━┷━━━━┷━━┛",
