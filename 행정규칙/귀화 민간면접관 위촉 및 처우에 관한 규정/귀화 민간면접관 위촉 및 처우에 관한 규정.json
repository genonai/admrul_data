      "content": "(별지 제3호 서식)┌───────────────────┐\n│확 인 서                              │\n├─────┬─────────────┤\n│성  명    │    (서명)                │\n├─────┼┬────┬───────┤\n│연락처    ││일  시  │              │\n├─────┴┴────┴───────┤\n│                                      │\n│(사유는 구체적으로 기재하시기 바랍니다.)│\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n│                                      │\n├─────┬─────────────┤\n│ 확 인 자 │    (서명)                │\n├─────┴─────────────┤\n│ＯＯ출입국·외국인청장(사무소장) 귀하 │\n└───────────────────┘",
