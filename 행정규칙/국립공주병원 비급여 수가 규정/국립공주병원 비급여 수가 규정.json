                 │10,000    │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │카드분류검사                        │10,000    │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │개념형성검사                        │10,000    │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │숫자따라하기                        │10,000    │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │시각단기기억검사                    │ 10,000   │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │조건언어지속검사                    │ 10,000   │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │시각지속검사                        │ 10,000   │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │조건시각지속검사                    │ 10,000   │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │크로스오버테스트                    │ 10,000   │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │Modality Shift Test                 │ 10,000   │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │단어색채검사                        │ 10,000   │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │수지력검사                          │ 10,000   │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │색채도형성검사                      │ 25,000   │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │지능검사                            │ 25,000   │                            ┃\n┃              ├──────────────────┼─────┼──────────────┨\n┃              │CERAD(치매척도검사)                 │100,000   │                           ┃\n┠───────┼──────────────────┼─────┼──────────────┨\n┃주의력검사    │종합주의력검사(CAT)                 │ 40,000   │                           ┃\n┠───────┼──────────────────┼─────┼──────────────┨\n┃스트레스진단검│스트레스진단검사                    │10,000    │                            ┃\n┃사            │                                    │          │                            ┃\n┠───────┼──────────────────┼─────┼──────────────┨\n┃              │통합스트레스검사                    │15,000    │                            ┃\n┠───────┼──────────────────┼─────┼──────────────┨\n┃심리검사      │Kims 전두엽관리기능 신경심리검사    │50,000    │                            ┃\n┃              ├──────────────────┼─────┼──────────────┨\n┃              │아스퍼거증후군진단척도(ASDS)        │10,000    │아동청소년                  ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │한국판 학습장애 평가척도(K-LEDS)    │10,000    │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │기초학습기능수행평가체계            │20,000    │                            ┃\n┃              │(BASA:Reading)                      │          │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │기초학습기능수행평가체계(BASA:Math) │20,000    │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │기초학습기능수행평가체계(BASA:WE)   │20,000    │                            ┃\n┠───────┼──────────────────┼─────┼──────────────┨\n┃처치 및       │주조금관                            │340,000   │                           ┃\n┃수술          ├──────────────────┼─────┤                           ┃\n┃              │도재금관                            │300,000   │                           ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │편악국소의치                        │600,000   │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │레진의치                            │1,000,000 │치과                        ┃\n┃              ├──────────────────┼─────┤                           ┃\n┃              │메탈의치                            │1,200,000 │                           ┃\n┃              ├──────────────────┼─────┤                           ┃\n┃              │메탈관                              │ 240,000  │                           ┃\n┃              ├──────────────────┼─────┤                           ┃\n┃              │의치의장                            │ 200,000  │                           ┃\n┃              ├──────────────────┼─────┤                           ┃\n┃              │금인레이                            │ 200,000  │                           ┃\n┃              ├──────────────────┼─────┤                           ┃\n┃              │스케일링(전악)                      │42,000    │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │광중합레진                          │ 50,000   │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │의치수리(치아1개당)                 │ 50,000   │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │임플란트                            │1,200,000 │                            ┃\n┃              ├──────────────────┼─────┤                            ┃\n┃              │Botuilnum 주                        │100,000   │                            ┃\n┖───────┶━━━━━━━━━━━━━━━━━━┷━━━━━┷━━━━━━━━━━━━━━┛\n※  치과 비급여 적용기준\n\n1. 치과 비급여 수가는 건강보험수가를  준용하되, 건강보험에 없는 수가는 산재보험수가의 ±20% 범\n위내에서 수가위원회에서 결정한다.\n\n2. 비급여 진료비는 원무계에 선납하여야하며, 기공료는 치과재료비 예산에서 지출한다.\n\n3. 환자의 변심이나 환자의 상황변화에 따른 보철물 미장착시는 50%환불한다.\n\n4. 비급여인 경우 보철 및 임플란트의 무상수리와 유지관리는 1년으로 한다.\n\n\n",
