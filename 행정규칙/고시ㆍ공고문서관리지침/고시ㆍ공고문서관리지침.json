    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 지침은 고시 . 공고문서 관리에 대한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:고시공고문서관리지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "관리부서",
        "chapter": "",
        "content": "제2조 (관리부서) 고시.공고문서의 관리는 문서과에서 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:고시공고문서관리지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "관리번호부여",
        "chapter": "",
        "content": "제3조 (관리번호부여) ① 고시 .공고문서의 결재를 받은 처리과는 그 문서를 문서등폭대장에 등록한 후 문서과로 송부하여 관리번호를 부여받은 후에 시행한다.② 제1항에 의거 문서를 송부받은 문서과에서는 고시문서의 경우에는 별지1 고시문서관리대장에, 공고문서의 경우에는 별지 2 공고문서관리대장에 각각 등록하여 관리번호를 부여한 후 그 원본은 처리과로 송부하고, 사본을 하여 보관한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:고시공고문서관리지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "관리번호의 표시",
        "chapter": "",
        "content": "제4조 (관리번호의 표시) 고시 공고문서의 관리번호는 문서의 상단 왼쪽에 표시하며, 표시요령은 다음 예시와 같이 한다.<예시>법원행정처 고시(공고) 제1994-1호",
        "enforcement_date": "",
