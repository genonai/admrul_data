      "enforcement_date": "",
      "content": "[별표 1]\n별  치  기  호\n┌─────┬─────────────────────────┬──────┬──┐\n│구    분  │자      료                                        │별치기호    │비고│\n│          ├────────┬────────────────┤            │    │\n│          │종    류        │자    료                        │            │    │\n├─────┼────────┼────────────────┼──────┼──┤\n│일반자료  │정책자료        │일반도서                        │ 정책       │    │\n│(점자자료 │                │잡지                            │            │    │\n│제외)     ├────────┼────────────────┼──────┤    │\n│          │서양자료        │일반도서(서양서)                │W           │    │\n│          ├────────┼────────────────┼──────┤    │\n│          │열람제한도서    │특수자료                        │특수        │    │\n│          │                │열람제한도서                    │            │    │\n│          ├────────┼────────────────┼──────┼──┤\n│          │학위논문        │석사학위논문                    │DM          │    │\n│          │                │박사학위논문                    │DP          │    │\n│          │                │석사학위논문(서양서)            │WDM         │    │\n│          │                │박사학위논문(서양서)            │WDP         │    │\n│          ├────────┼────────────────┼──────┼──┤\n│          │정부간행물      │입법부간행물                    │GP          │    │\n│          │                │사법부간행물                    │            │    │\n│          │                │행정부간행물                    │            │    │\n│          │                │정부간행물(서양서)              │WGP         │    │\n│          ├────────┼────────────────┼──────┼──┤\n│          │만화            │만화                            │만          │    │\n│          ├────────┼────────────────┼──────┼──┤\n│          │귀중자료        │일반도서(동양서)                │동귀        │    │\n│          │                │일반도서(서양서)                │서귀        │    │\n│          │                │잡지                            │연귀        │    │\n│          │                │신문                            │신귀        │    │\n│          │                │비도서자료                      │비귀        │    │\n│          ├────────┼────────────────┼──────┼──┤\n│          │국제기구 간행물 │유엔자료                        │UN          │    │\n│          ├────────┼────────────────┼──────┼──┤\n│          │실물자료        │실물(Realia)                    │LA          │    │\n│          │                │?박제(Specimen)                │            │    │\n│          │                │?견본(Sample)                  │            │    │\n│          │                │?유물(Remains)                 │            │    │\n│          │                ├────────────────┼──────┼──┤\n│          │                │오브젝트(Object)                │LB          │    │\n│          │                │?투시화(Diorama)               │            │    │\n│          │                │?모형(Model)                   │            │    │\n│          │                │?플라네타륨(Planetarium)       │            │    │\n│          ├────────┼────────────────┼──────┼──┤\n│일반자료  │실물자료        │시각 및 그래픽자료              │LC          │    │\n│(점자자료 │                │?미술품(Art original)          │            │    │\n│제외)     │                │?미술복제품(Artreproduction)   │            │    │\n│          │                │?미술인쇄물(Artist’s print)   │            │    │\n│          │                │?플래시카드(Frash card)        │            │    │\n│          │                │?플립도표(Flipchart)           │            │    │\n│          │                │?사진(Photograph)              │            │    │\n│          │                │?그림(Picture)                 │            │    │\n│          │                │?그림엽서(Post card)           │            │    │\n│          │                │?입체카드(Stereographcard)     │            │    │\n│          │                │?입체릴(Stereograph reel)      │            │    │\n│          │                │?포스트(Poster)                │            │    │\n│          │                │?Hologram film                 │            │    │\n│          │                │?Hologram plate                │            │    │\n│          │                ├────────────────┼──────┼──┤\n│          │                │키트(Kit)                       │            │    │\n│          │                │?Constructional set            │            │    │\n│          │                │?Game                          │            │    │\n│          │                │?Jigsaw puzzle                 │LE          │    │\n│          │                │?Kit                           │            │    │\n│          │                │?laboratory kit                │            │    │\n│          ├────────┼────────────────┼──────┼──┤\n│          │지도            │낱장지도(Map)                   │MA          │    │\n│          │                │벽지도(Wall map)                │MB          │    │\n│          │                │지구의(Globe)                   │MC          │    │\n│          ├────────┼────────────────┼──────┼──┤\n│          │악보            │총보(Score)                     │NA          │    │\n│          │                │피스(Part)                      │NB          │    │\n│          ├────────┼────────────────┼──────┼──┤\n│          │컴퓨터 매체     │Digital tape                    │OA          │    │\n│          │자료            │Digital disc                    │OB          │    │\n│          │                │Digital cassette                │OC          │    │\n│          │                │Digital cartridge               │OD          │    │\n│          │                ├────────────────┼──────┼──┤\n│          │                │CD-I                            │PA          │    │\n│          │                │CD-G                            │PB          │    │\n│          │                │Combined A&V material           │PC          │    │\n│          │                │(Video CD)                      │            │    │\n│          │                │Digital video disc(DVD)         │PD          │    │\n│          │                │블루레이디스크                  │PE          │    │\n│          │                │4K Ultra HD(4K UHD, 4K 블루레이)│PF          │    │\n│          ├────────┼────────────────┼──────┼──┤\n│일반자료  │음향자료        │릴테이프(오픈)                  │RT          │    │\n│(점자자료 │                ├────────────────┼──────┼──┤\n│제외)     │                │음향카트리지                    │DASA        │    │\n│          │                │(Sound cartridge)               │            │    │\n│          │                │음향카세트                      │SB          │    │\n│          │                │(Sound cassette)                │            │    │\n│          │                │Digital audio tape              │SC          │    │\n│          │                │컴팩트디스크                    │SD          │    │\n│          │                │(Compact disc)                  │            │    │\n│          │                │음향테이프(Sound reel)          │SE          │    │\n│          │                │음향트랙필름                    │SF          │    │\n│          │                │(Sound track film)              │            │    │\n│          │                │음반(Sound disc)                │SG          │    │\n│          ├────────┼────────────────┼──────┼──┤\n│          │영상자료        │필름 카트리지                   │VA          │    │\n│          │                │(Cine jcartridge)               │            │    │\n│          │                │필름 카세트                     │VB          │    │\n│          │                │(Cine cassette)                 │            │    │\n│          │                │필름 루우프                     │VC          │    │\n│          │                │(Cine loop)                     │            │    │\n│          │                │필름 릴(Cine reel)              │VD          │    │\n│          │                │Video cartridge                 │VS          │    │\n│          │                │Video cassette                  │VT          │    │\n│          │                │Video disc                      │VU          │    │\n│          │                │Video reel                      │VW    