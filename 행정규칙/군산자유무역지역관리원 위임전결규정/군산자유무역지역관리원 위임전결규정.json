        ],
        "images": [],
        "provision_id": "admrul:군산자유무역지역관리원위임전결규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용",
        "chapter": "",
        "content": "제2조 (적용) 군산자유무역지역관리원 위임전결사항은 다른 법령에 별도 규정이 있는 것을 제외하고는 이 규정에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:군산자유무역지역관리원위임전결규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "전결권자의 구분",
        "chapter": "",
        "content": "제3조 (전결권자의 구분) 이 규정에서의 전결권자는 원장, 과장, 담당자로 구분한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:군산자유무역지역관리원위임전결규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "전결사항",
        "chapter": "",
        "content": "제4조 (전결사항) ① 과장의 위임전결사항은 별표와 같다.② 별표에 열거되지 아니한 사항은 이 영에 준하여 유사사항의 전결권자가  전결할 수 있다.  다만, 전결권자를 판단하기 어려운 사항에 대하여는 원장의 지시에 따라 처리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:군산자유무역지역관리원위임전결규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "전결권자의 책임",
        "chapter": "",
        "content": "제5조 (전결권자의 책임) 위임전결 된 문서에 대하여는 그 전결권자가 원장에 대하여 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:군산자유무역지역관리원위임전결규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "합의사항",
        "chapter": "",
        "content": "제6조 (합의사항) 위임전결사항 중 다른 과와 관련되는 사항은 해당 과와 협의하여야 하며,  협의되지 않은 경우에는 원장의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:군산자유무역지역관리원위임전결규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "중요사항 등의 결재",
        "chapter": "",
        "content": "제7조 (중요사항 등의 결재) ① 전결권자는 그의 전결사항이라 할지라도 그 내용이 특히 중요하거나 성질상 필요하다고 인정되는 때에는 원장의 결재를 받아야 한다.② 원장이 특히 필요하다고 인정하여 지시하는 사항에 대하여는 이 영의 규정에도 불구하고 그 지시에 따라 전결권자를 변경할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:군산자유무역지역관리원위임전결규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "전결권자의 부재",
        "chapter": "",
        "content": "제8조 (전결권자의 부재) 전결권자가 결원, 출장, 휴가 기타의 사유로 부재중이거나 사정에 의하여 결재할 수 없을 때에는 그 직무를 대리하는 자가 대결할 수 있으며, 그 내용이 중요한 사항은 결재권자에게 사후에 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:군산자유무역지역관리원위임전결규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "보고",
        "chapter": "",
        "content": "제9조 (보고) 전결권자가 전결 시행한 사항중 원장이 알아야 한다고 인정되는 사항은 사후에 그 처리내용을 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:군산자유무역지역관리원위임전결규정#JO0009"
      }
    ]
  },
