      "title": "위임전결사항",
      "enforcement_date": "",
      "content": "<별표>\n1. 공 통 사 항\n┌──┬────────┬─────────────────────┬─────┬──┐\n│번호│단위업무        │사무 내용                                 │전결권자  │원장│\n│    │                │                                          ├──┬──┤결재│\n│    │                │                                          │담당│과장│    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│1   │주요업무계획    │기본계획 수립                             │    │    │○  │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │시행 및 집행감독                          │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│2   │훈령ㆍ예규      │제ㆍ개정 및 폐지                          │    │    │○  │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │훈령ㆍ예규집 발간                         │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│3   │질의응답        │중요사항                                  │    │    │○  │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │일반사항                                  │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│4   │고시 및 공고    │중요사항                                  │    │    │○  │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │일반사항                                  │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│5   │관련 기관과     │중요사항                                  │    │    │○  │\n│    │업무협조        ├─────────────────────┼──┼──┼──┤\n│    │                │일반사항                                  │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│6   │위원회운영      │위원장이 원장인 위원회                    │    │    │○  │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │위원장이 과장인 위원회                    │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│7   │복무            │국외출장 및 국외여행                      │    │    │○  │\n│    │                ├────────┬────────────┼──┼──┼──┤\n│    │                │국내출장, 휴가, │과장                    │    │    │○  │\n│    │                │조퇴, 외출 등   ├────────────┼──┼──┼──┤\n│    │                │                │5급이하                 │    │○  │    │\n│    │                │                ├────────────┼──┼──┼──┤\n│    │                │                │비정규직(공무직,기간제) │○  │    │    │\n├──┼────────┼────────┴────────────┼──┼──┼──┤\n│8   │민원사무처리    │중요사항 및 상부기관 이첩사항             │    │    │○  │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │일반사항                                  │    │○  │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │사실 확인 및 증명                         │○  │    │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│9   │각종행사        │중요행사                                  │    │    │○  │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │일반행사                                  │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│10  │간행물          │발간                                      │    │    │○  │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │배포                                      │    │○  │    │\n├──┼────────┴─────────────────────┼──┼──┼──┤\n│11  │시설 및 장비 운영ㆍ관리                                     │    │○  │    │\n├──┼──────────────────────────────┼──┼──┼──┤\n│12  │개인별 사무분장 지정                                        │    │○  │    │\n├──┼──────────────────────────────┼──┼──┼──┤\n│13  │제 증명서 및 확인서 발급                                    │○  │    │    │\n├──┼──────────────────────────────┼──┼──┼──┤\n│14  │경미한 사항의 조회, 회신 및 통지 등 처리                    │    │○  │    │\n├──┼──────────────────────────────┼──┼──┼──┤\n│15  │문서 이송                                                   │○  │    │    │\n├──┼────────┬─────────────────────┼──┼──┼──┤\n│16  │교육생 선발     │교육안내 및 교육생 선발                   │    │○  │    │\n│    │                ├─────────┬───────────┼──┼──┼──┤\n│    │                │교육훈련계획 변경 │ 중요사항             │    │    │○  │\n│    │                │                  ├───────────┼──┼──┼──┤\n│    │                │                  │ 일반사항             │    │○  │    │\n│    │                ├─────────┴───────────┼──┼──┼──┤\n│    │                │교육생 학사관리프로그램 입력ㆍ관리        │○  │    │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│17  │교육생          │교육생 분임편성                           │○  │    │    │\n│    │분임편성 및     ├─────────────────────┼──┼──┼──┤\n│    │등록            │교육생 등록                               │○  │    │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │교육과정 임원선출 및 등록결과 보고        │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│18  │입교 및 수료식  │입교 및 수료 행사 계획 수립               │    │○  │    │\n│    │등의 행사       ├─────────────────────┼──┼──┼──┤\n│    │                │행사 안내 및 진행                         │○  │    │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │교육유공자 및 성과평가 우수분임 시상      │○  │    │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│19  │교육수료 통보   │교육과정 수료 통보                        │    │○  │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │교육성적 조회 통보                        │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│20  │학적관리 및     │과정별 교육이수대장 작성 및 학적부 관리   │○  │    │    │\n│    │제증명 발급     ├─────────────────────┼──┼──┼──┤\n│    │                │성적 및 제증명 발급                       │○  │    │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│21  │산림교육원      │산림교육원 정보시스템 운영ㆍ관리          │    │○  │    │\n│    │정보시스템운영  ├─────────────────────┼──┼──┼──┤\n│    │                │교육훈련 자료 관리                        │○  │    │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│22  │교육경비 지출   │원고료, 강사수당 및 강사여비 지급결의     │    │○  │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │원고료, 강사수당 및 강사여비 지출요청     │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│23  │강사 선정       │과정별 강사 선정                          │    │    │○  │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │과정별 강사 섭외                          │    │○  │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │겸임교수 강의 교과목 선정 및 운영         │    │○  │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │강사 DB 구축 및 자료관리                  │○  │    │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│24  │실습지 선정     │교과목별 실습지 선정                      │    │○  │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │실습지 현장 확인                          │    │○  │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │실습지 DB구축 및 자료관리                 │○  │    │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│25  │교육훈련 편성   │교육시간표 편성 협의                      │○  │    │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │교육시간표 확정                           │    │○  │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │교육시간표 및 강사 변경                   │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│26  │교육교재 편찬   │교과목별 교재원고 작성의뢰 및 검토        │○  │    │    │\n│    │및 발행         ├─────────────────────┼──┼──┼──┤\n│    │                │교육교재 편찬                             │    │○  │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │교육교재 수집 및 보관ㆍ관리               │○  │    │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│27  │교육생 규율 및  │퇴교심사위원회 개최                       │    │    │○  │\n│    │생활지도        ├─────────────────────┼──┼──┼──┤\n│    │                │교육생 결강, 조퇴, 결석의 허가            │    │○  │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │교육생 위반사항의 처리                    │○  │    │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │근태 평가                                 │○  │    │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│28  │현지 실습 및    │현지 실습 및 견학계획 수립                │    │○  │    │\n│    │견학            ├─────────────────────┼──┼──┼──┤\n│    │                │현지 실습 및 견학의 운영                  │○  │    │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │현지 실습 및 견학 결과보고                │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│29  │방문형          │방문형 교육과정 계획수립                  │    │    │○  │\n│    │교육운영        ├─────────────────────┼──┼──┼──┤\n│    │                │방문형 교육과정 기관협조 요청             │    │○  │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │방문형 교육과정 결과보고                  │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│30  │분임연구 운영   │분임연구 운영계획 수립                    │    │    │○  │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │분임연구 운영 및 지도                     │○  │    │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │분임연구 평가 실시                        │○  │    │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │분임연구 평가결과 보고                    │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│31  │교육훈련        │실습ㆍ실기평가 실시 및 결과보고           │    │○  │    │\n│    │성과평가        ├─────────────────────┼──┼──┼──┤\n│    │                │학습성취도향상평가 실시 및 결과보고       │    │○  │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │인터뷰평가 실시 및 결과보고               │    │○  │    │\n├──┼────────┼─────────────────────┼──┼──┼──┤\n│32  │실습 장비 및    │실습장비 및 기자재 장기운영계획 수립      │    │    │○  │\n│    │기자재 활용     ├─────────────────────┼──┼──┼──┤\n│    │                │실습장비 및 기자재 활용계획 수립          │    │○  │    │\n│    │                ├─────────────────────┼──┼──┼──┤\n│    │                │장비 및 기자재 운영 및 관리               │○  │    │    │\n└──┴────────┴─────────────────────┴──┴──┴──┘\n2. 교육기획과 소관사항\n┌──┬──────────┬─────────────────────┬─────┬──┐\n│번호│단위업무            │사무 내용                                 │전결권자  │원장│\n│    │                    │                                          ├──┬──┤결재│\n│    │                    │                                          │담당│과장│    │\n├──┼──────────┼─────────────────────┼──┼──┼──┤\n│1   │인사                │공무원 임용                               │    │    │○  │\n│    │                    ├─────────────────────┼──┼──┼──┤\n│    │                    │승진후보자 명부 작성 조정(8급이하)        │    │    │○  │\n│    │                    ├─────────────────────┼──┼──┼──┤\n│    │                    │공무원 정기 승급(5급이하)                 │    │○  │    │\n│    │                    ├─────────────────────┼──┼──┼──┤\n│    │                    │징계 요구 및 처분, 징계말소               │    │    │○  │\n│    │                    ├─────────────────────┼──┼──┼──┤\n│    │                    │인사기록관리 및 제증명 발급               │○  │    │    │\n├──┼──────────┼─────────────────────┼──┼──┼──┤\n│2   │포상                │포상계획                                  │    │    │○  │\n│    │                    ├─────────────────────┼──┼──┼──┤\n│    │                    │포상 추천, 통지 및 보고                   │    │○  │    │\n├──┼──────────┼─────────────────────┼──┼──┼──┤\n│3   │소속 공무원         │직장교육 등 교육계획 수립                 │    │    │○  │\n│    │교육훈련            ├─────────────────────┼──┼──┼──┤\n│    │                    │교육대상자 추천 및 직장교육 실시          │    │○  │    │\n├──┼──────────┼─────────────────────┼──┼──┼──┤\n│4   │복무                │공무원 휴가계획                           │    │    │○  │\n│    │                    ├─────────────────────┼──┼──┼──┤\n│    │                    │복무 일반                                 │    │○  │    │\n├──┼──────────┼─────────────────────┼──┼──┼──┤\n│5   │후생복지            │후생복지 운영                             │    │○  │    │\n├──┼──────────┼─────────────────────┼──┼──┼──┤\n│6   │관인                │관인의 등록(재등록) 및 공고  