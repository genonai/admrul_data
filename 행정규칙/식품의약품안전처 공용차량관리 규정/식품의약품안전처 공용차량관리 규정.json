      "content": "\n[별지 제6서식]\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n┃유류수불대장                                                ┃\n┣━━┯━━┯━━━┯━━━┯━━┯━━━┯━━┯━━━┯━━┫\n┃월일│차량│수령량│불출량│잔량│수령인│담당│사무관│과장┃\n┃    │번호│      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┠──┼──┼───┼───┼──┼───┼──┼───┼──┨\n┃    │    │      │      │    │      │    │      │    ┃\n┗━━┷━━┷━━━┷━━━┷━━┷━━━┷━━┷━━━┷━━┛\n210mm×297mm(일반용지 60g/㎡(재활용품))\n",
