  "addenda": [
    {
      "promulgation_date": "20040922",
      "promulgation_no": "1085",
      "content": "부  칙(2004. 9. 22. 제1085호)[다른 예규의 폐지] 주택건설촉진법 제32조의3제3항의 규정에 의한 금지사항의 부기등기에 관한 예규(등기예규 제971호)를 폐지한다."
    },
    {
      "promulgation_date": "20111011",
      "promulgation_no": "1379",
      "content": "부  칙(2011. 10. 11. 제1379호)이 예규는 2011년 10월 13일부터 시행한다."
    },
    {
      "promulgation_date": "20140521",
      "promulgation_no": "1523",
      "content": "부  칙(2014. 5. 21. 제1523호)이 예규는 즉시 시행한다."
    },
    {
      "promulgation_date": "20160704",
      "promulgation_no": "1600",
      "content": "부  칙(2016. 7. 4. 제1600호)제1조(시행일) 이 예규는 즉시 시행한다.제2조(경과규정) 「민간임대주택에 관한 특별법」의 부칙에 따라 종전의「임대주택법」제18조제2항에 따른 임대주택에 대한 금지사항의 부기등기는 종전의 예규에 의한다."
    },
    {
      "promulgation_date": "20170320",
      "promulgation_no": "1616",
      "content": "부  칙(2017. 3. 20. 제1616호)이 예규는 즉시 시행한다."
    }
  ],
