        "images": [],
        "provision_id": "admrul:법제처회계관계공무원재정보증규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "보험료의 납부",
        "chapter": "",
        "content": "제7조 (보험료의 납부) 처장은 회계관계공무원의 보험 가입에 따른 보험료를 그 해의 세출예산에서 납부한다.",
        "enforcement_date": "",
        "relations": [],
