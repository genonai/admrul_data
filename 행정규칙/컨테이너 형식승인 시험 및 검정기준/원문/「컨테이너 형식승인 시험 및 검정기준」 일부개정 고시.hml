tterType="LeftOnly" Height="84188" Landscape="0" Width="59528"><PAGEMARGIN Bottom="2835" Footer="2835" Gutter="0" Header="2834" Left="5669" Right="5669" Top="2835"/></PAGEDEF><FOOTNOTESHAPE><AUTONUMFORMAT SuffixChar=")" Superscript="false" Type="Digit"/><NOTELINE Color="3012261515" Length="5cm" Type="Solid" Width="0.12mm"/><NOTESPACING AboveLine="852" BelowLine="568" BetweenNotes="284"/><NOTENUMBERING NewNumber="1" Type="Continuous"/><NOTEPLACEMENT BeneathText="false" Place="EachColumn"/></FOOTNOTESHAPE><ENDNOTESHAPE><AUTONUMFORMAT SuffixChar=")" Superscript="false" Type="Digit"/><NOTELINE Color="973879564" Length="0" Type="None" Width="0.12mm"/><NOTESPACING AboveLine="864" BelowLine="576" BetweenNotes="0"/><NOTENUMBERING NewNumber="1" Type="Continuous"/><NOTEPLACEMENT BeneathText="false" Place="EndOfDocument"/></ENDNOTESHAPE><PAGEBORDERFILL BorferFill="1" FillArea="Paper" FooterInside="false" HeaderInside="false" TextBorder="true" Type="Both"><PAGEOFFSET Bottom="1417" Left="1417" Right="1417" Top="1417"/></PAGEBORDERFILL><PAGEBORDERFILL BorferFill="1" FillArea="Paper" FooterInside="false" HeaderInside="false" TextBorder="true" Type="Even"><PAGEOFFSET Bottom="1417" Left="1417" Right="1417" Top="1417"/></PAGEBORDERFILL><PAGEBORDERFILL BorferFill="1" FillArea="Paper" FooterInside="false" HeaderInside="false" TextBorder="true" Type="Odd"><PAGEOFFSET Bottom="1417" Left="1417" Right="1417" Top="1417"/></PAGEBORDERFILL></SECDEF><COLDEF Count="1" Layout="Left" SameGap="0" SameSize="true" Type="Newspaper"/><PAGENUM FormatType="Digit" Pos="None" SideChar="-"/></TEXT><TEXT CharShape="1"><TABLE BorderFill="4" CellSpacing="0" ColCount="1" PageBreak="Cell" RepeatHeader="true" RowCount="3"><SHAPEOBJECT InstId="1444940884" Lock="false" NumberingType="Table" ZOrder="0"><SIZE Height="17086" HeightRelTo="Absolute" Protect="false" Width="47907" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="283" Left="283" Right="283" Top="283"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/><ROW><CELL BorderFill="3" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1682" Protect="true" RowAddr="0" RowSpan="1" Width="47907"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="17" Style="0"><TEXT CharShape="3"><CHAR>해양수산부 고시 제2023-118호</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="3" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="11222" Protect="false" RowAddr="1" RowSpan="1" Width="47907"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="17" Style="0"><TEXT CharShape="16"/></P><P ParaShape="19" Style="0"><TEXT CharShape="17"><CHAR>「컨테이너 형식승인 시험 및 검정기준」일부를 다음과 같이 개정 고시합니다.</CHAR></TEXT></P><P ParaShape="18" Style="0"><TEXT CharShape="14"/></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="3" ColAddr="0" ColSpan="1" Dirty="false" Editable="true" HasMargin="true" Header="false" Height="0" Name="11111" Protect="true" RowAddr="2" RowSpan="1" Width="47907"><CELLMARGIN Bottom="802" Left="0" Right="802" Top="0"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="18" Style="0"><TEXT CharShape="14"><CHAR>2023년 07월 27일</CHAR></TEXT></P><P ParaShape="18" Style="0"><TEXT CharShape="14"><CHAR>해양수산부장관</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="17" Style="0"><TEXT CharShape="15"/></P><P ParaShape="20" Style="18"><TEXT CharShape="19"><CHAR>1. 개정이유</CHAR></TEXT><TEXT CharShape="18"><PAGENUM FormatType="Digit" Pos="BottomCenter" SideChar="-"/><NEWNUM Number="1" NumberType="Page"/><CHAR/></TEXT></P><P ParaShape="20" Style="19"><TEXT CharShape="22"><CHAR>   컨테이너 안전관리를 강화하기 위한 「선박안전법」 개정(법률 제19134호, 2022. 12. 27 공포, 2023. 6. 28 시행예정)을 반영해 컨테이너의 형식승인 변경승인 시 별도의 형식승인시험을 거쳐야 할 사항을 세부적으로 정하려는 것임</CHAR></TEXT></P><P ParaShape="2" Style="0"><TEXT CharShape="13"/></P><P ParaShape="20" Style="18"><TEXT CharShape="19"><CHAR>2. 주요내용</CHAR></TEXT></P><P ParaShape="21" Style="20"><TEXT CharShape="22"><CHAR>가. 컨테이너 형식승인 변경승인 시 별도의 형식승인시험을 거쳐야 할 사항(안 제8조의2 신설)</CHAR></TEXT></P><P ParaShape="22" Style="20"><TEXT CharShape="22"><CHAR>   컨테이너의 형식승인을 받은 자가 그 내용을 변경하고자 해양수산부로부터 변경승인을 받을 경우, 별도의 형식승인시험을 거쳐야 할 “컨테이너의 성능에 영향을 미치는 사항”을 주요부, 형식, 질량의 변경 등 현장에서 이미 적용 중인 사항으로 정해 기준에 명시함</CHAR></TEXT></P><P ParaShape="21" Style="20"><TEXT CharShape="22"><CHAR>나. 법령 개정에 따른 조문의 변경을 반영하고 알기쉬운 법령 입안기준에 따라 용어를 일부 수정함</CHAR></TEXT></P><P ParaShape="36" Style="0"><TEXT CharShape="23"/></P><P ParaShape="20" Style="18"><TEXT CharShape="19"><CHAR>3. 참고사항</CHAR></TEXT></P><P ParaShape="21" Style="20"><TEXT CharShape="22"><CHAR>가. 관계법령 : 「선박안전법」</CHAR></TEXT></P><P ParaShape="21" Style="20"><TEXT CharShape="22"><CHAR>나. 예산조치 : 별도조치 필요 없음</CHAR></TEXT></P><P ParaShape="21" Style="20"><TEXT CharShape="22"><CHAR>다. 합    의 : 해당기관 없음</CHAR></TEXT></P><P ParaShape="21" Style="20"><TEXT CharShape="22"><CHAR>라. 기    타 : 신․구조문대비표, 별첨</CHAR></TEXT></P></SECTION><SECTION Id="1"><P ColumnBreak="false" PageBreak="false" ParaShape="23" Style="0"><TEXT CharShape="20"><SECDEF CharGrid="0" FirstBorder="false" FirstFill="false" LineGrid="0" SpaceColumns="1134" TabStop="8000" TextDirection="0" TextVerticalWidthHead="0"><STARTNUMBER Equation="0" Figure="0" Page="0" PageStartsOn="Both" Table="0"/><HIDE Border="false" EmptyLine="false" Fill="false" Footer="false" Header="false" MasterPage="false" PageNumPos="false"/><PAGEDEF GutterType="LeftOnly" Height="84188" Landscape="0" Width="59528"><PAGEMARGIN Bottom="4535" Footer="3600" Gutter="0" Header="3600" Left="7086" Right="7086" Top="4535"/></PAGEDEF><FOOTNOTESHAPE><AUTONUMFORMAT SuffixChar=")" Superscript="false" Type="Digit"/><NOTELINE Color="178322448" Length="5cm" Type="Solid" Width="0.12mm"/><NOTESPACING AboveLine="852" BelowLine="568" BetweenNotes="284"/><NOTENUMBERING NewNumber="2720" Type="Continuous"/><NOTEPLACEMENT BeneathText="false" Place="EachColumn"/></FOOTNOTESHAPE><ENDNOTESHAPE><AUTONUMFORMAT SuffixChar=")" Superscript="false" Type="Digit"/><NOTELINE Color="178325640" Length="0" Type="None" Width="0.12mm"/><NOTESPACING AboveLine="864" BelowLine="576" BetweenNotes="0"/><NOTENUMBERING NewNumber="2721" Type="Continuous"/><NOTEPLACEMENT BeneathText="false" Place="EndOfDocument"/></ENDNOTESHAPE><PAGEBORDERFILL BorferFill="1" FillArea="Paper" FooterInside="false" HeaderInside="false" TextBorder="true" Type="Both"><PAGEOFFSET Bottom="1417" Left="1417" Right="1417" Top="1417"/></PAGEBORDERFILL><PAGEBORDERFILL BorferFill="1" FillArea="Paper" FooterInside="false" HeaderInside="false" TextBorder="true" Type="Even"><PAGEOFFSET Bottom="1417" Left="1417" Right="1417" Top="1417"/></PAGEBORDERFILL><PAGEBORDERFILL BorferFill="1" FillArea="Paper" FooterInside="false" HeaderInside="false" TextBorder="true" Type="Odd"><PAGEOFFSET Bottom="1417" Left="1417" Right="1417" Top="1417"/></PAGEBORDERFILL></SECDEF><COLDEF Count="1" Layout="Left" SameGap="0" SameSize="true" Type="Newspaper"/><PAGENUM FormatType="Digit" Pos="BottomCenter" SideChar="-"/><CHAR>해양수산부고시</CHAR></TEXT><TEXT CharShape="21"><CHAR>  제        호</CHAR></TEXT></P><P ParaShape="23" Style="0"><TEXT CharShape="21"/></P><P ParaShape="25" Style="21"><TEXT CharShape="25"><CHAR>컨테이너 형식승인 시험 및 검정기준 일부개정고시안</CHAR></TEXT></P><P ParaShape="26" Style="21"><TEXT CharShape="22"/></P><P ParaShape="26" Style="21"><TEXT CharShape="22"><CHAR>컨테이너 형식승인 시험 및 검정기준 일부를 다음과 같이 개정한다.</CHAR></TEXT></P><P ParaShape="26" Style="21"><TEXT CharShape="22"><CHAR>제1조 중 “제23조제4항, 제23조제7항”을 “제23조제3항ㆍ제7항 및 제10항”으로, “시행규칙 제58조제2항”을 “시행규칙 제58조제2항 및 제58조의2제1항”으로, “시험 및 검정기준 등에 대해 필요한 사항을 규정함”을 “시험과 검정의 기준을 정하는 것”으로 한다.</CHAR></TEXT></P><P ParaShape="26" Style="21"><TEXT CharShape="22"><CHAR>제2조제1호다목 중 “용이하도록”을 “쉽도록”으로 하고, 같은 조 제6호 각 목 외의 부분 중 “산적 고체화물”을 “산적(散積) 고체화물”로 하며, 같은 호 나목 중 “초래되는”을 “가해지는”으로 하고, 같은 조 제11호부터 제13호까지를 각각 다음과 같이 한다.</CHAR></TEXT></P><P ParaShape="27" Style="22"><TEXT CharShape="22"><CHAR>  11. “자체질량(이하 “T”라 한다)”이란 일반적인 조건에서 항구적으로 부착된 부속 부품을 포함하는 빈 컨테이너의 질량을 의미한다.</CHAR></TEXT></P><P ParaShape="27" Style="22"><TEXT CharShape="22"><CHAR>  12. “최대총질량(이하 “R”이라 한다)”이란 컨테이너와 화물의 최대 허용통합중량을 말한다.</CHAR></TEXT></P><P ParaShape="27" Style="22"><TEXT CharShape="22"><CHAR>  13. “최대적재질량(이하 “P”라 한다)”이란 해당 컨테이너에 수납할 수 있는 화물의 최대질량을 말한다.(P = R - T)</CHAR></TEXT></P><P ParaShape="26" Style="21"><TEXT CharShape="22"><CHAR>제4조 제목 외의 부분을 제2항으로 하고, 같은 조에 제1항을 다음과 같이 신설한다.</CHAR></TEXT></P><P ParaShape="28" Style="23"><TEXT CharShape="22"><CHAR>  ① 컨테이너의 종류별 외부 치수, 내부 치수, 문의 치수 및 R 등은 ISO 668 및 ISO 1496-2에 따른다.</CHAR></TEXT></P><P ParaShape="26" Style="21"><TEXT CharShape="22"><CHAR>제4조제2항(종전의 제목 외의 부분) 각 호 외의 부분 본문 중 “컨테이너의 종류별”을 “제1항에도 불구하고 다음 각 호의 경우에는”으로, “등은 ISO 668 및 ISO 1496-2에 따른다”를 “등을 다르게 할 수 있다”로 하고, 같은 조 제목 외의 부분 단서를 삭제하며, 같은 조 제목 외의 부분 단서의 후단을 삭제하고, 같은 조 제2항(종전의 제목 외의 부분) 각 호 외의 부분 본문에 각 호 외의 부분 후단을 다음과 같이 신설한다.</CHAR></TEXT></P><P ParaShape="28" Style="23"><TEXT CharShape="22"><CHAR>  이 경우 그 외형치수보다 밖으로 돌출되는 것을 부착해서는 안 되며 내부 치수를 측정할 경우 컨테이너의 안쪽으로 돌출된 상부 모서리끼움쇠는 포함하지 않는다.</CHAR></TEXT></P><P ParaShape="26" Style="21"><TEXT CharShape="22"><CHAR>제7조제1항 본문 중 ““ ft””를 ““ft””로 한다.</CHAR></TEXT></P><P ParaShape="26" Style="21"><TEXT CharShape="22"><CHAR>제8조제1항 각 호 외의 부분 단서 중 “해양수산부장관”을 “해양수산부장관(이하 “장관”이라 한다)”으로 하고, 같은 항 제5호 중 “플렛폼컨테이너”를 “플랫폼컨테이너”로 한다.</CHAR></TEXT></P><P ParaShape="26" Style="21"><TEXT CharShape="22"><CHAR>제8조의2를 다음과 같이 신설한다.</CHAR></TEXT></P><P ParaShape="28" Style="24"><TEXT CharShape="22"><CHAR>제8조의2(별도의 형식승인 시험을 거쳐야 하는 사항) 법 제23조제3항 및 같은 법 시행규칙 제58조의2제1항에 따라 별도의 형식승인 시험을 거쳐야 하는 사항은 다음 각 호와 같다.</CHAR></TEXT></P><P ParaShape="27" Style="22"><TEXT CharShape="22"><CHAR>  1. 「컨테이너 안전점검 기준」 제2조제4호에 따른 컨테이너 주요부의 길이, 크기 및 재질에 변경이 발생한 경우</CHAR></TEXT></P><P ParaShape="27" Style="22"><TEXT CharShape="22"><CHAR>  2. 제2조제10호부터 제12호까지에서 정하는 컨테이너 형식, 자체질량 또는 최대총질량에 변경이 발생한 경우</CHAR></TEXT></P><P ParaShape="26" Style="21"><TEXT CharShape="22"><CHAR>제10조 중 “법 제23조제3항”을 “법 제23조제7항”으로 한다.</CHAR></TEXT></P><P ParaShape="26" Style="21"><TEXT CharShape="22"><CHAR>제11조 중 “해양수산부장관”을 “장관”으로, “2021년 1월 1일”을 “2023년 7월 1일”로, “12월 31일”을 “6월 30일”로 한다.</CHAR></TEXT></P><P ParaShape="26" Style="21"><TEXT CharShape="22"><CHAR>별표 4 및 별표 5를 각각 삭제한다.</CHAR></TEXT></P><P ParaShape="26" Style="21"><TEXT CharShape="22"/></P><P ParaShape="29" Style="24"><TEXT CharShape="26"><CHAR>부      칙</CHAR></TEXT></P><P ParaShape="28" Style="24"><TEXT CharShape="22"/></P><P ParaShape="28" Style="24"><TEXT CharShape="22"/></P><P ParaShape="28" Style="24"><TEXT CharShape="22"><CHAR>이 고시는 발령한 날부터 시행한다.</CHAR></TEXT></P></SECTION><SECTION Id="2"><P ColumnBreak="false" PageBreak="false" ParaShape="24" Style="0"><TEXT CharShape="24"><SECDEF CharGrid="0" FirstBorder="false" FirstFill="false" LineGrid="0" SpaceColumns="1134" TabStop="8000" TextDirection="0" TextVerticalWidthHead="0"><STARTNUMBER Equation="0" Figure="0" Page="0" PageStartsOn="Both" Table="0"/><HIDE Border="false" EmptyLine="false" Fill="false" Footer="false" Header="false" MasterPage="false" PageNumPos="false"/><PAGEDEF GutterType="LeftOnly" Height="84188" Landscape="0" Width="59528"><PAGEMARGIN Bottom="4535" Footer="3600" Gutter="0" Header="3600" Left="7086" Right="7086" Top="4535"/></PAGEDEF><FOOTNOTESHAPE><AUTONUMFORMAT SuffixChar=")" Superscript="false" Type="Digit"/><NOTELINE Length="5cm" Type="Solid" Width="0.12mm"/><NOTESPACING AboveLine="852" BelowLine="568" BetweenNotes="284"/><NOTENUMBERING NewNumber="1" Type="Continuous"/><NOTEPLACEMENT BeneathText="false" Place="EachColumn"/></FOOTNOTESHAPE><ENDNOTESHAPE><AUTONUMFORMAT SuffixChar=")" Superscript="false" Type="Digit"/><NOTELINE Length="0" Type="None" Width="0.12mm"/><NOTESPACING AboveLine="864" BelowLine="576" BetweenNotes="0"/><NOTENUMBERING NewNumber="1" Type="Continuous"/><NOTEPLACEMENT BeneathText="false" Place="EndOfDocument"/></ENDNOTESHAPE><PAGEBORDERFILL BorferFill="1" FillArea="Paper" FooterInside="false" HeaderInside="false" TextBorder="true" Type="Both"><PAGEOFFSET Bottom="1417" Left="1417" Right="1417" Top="1417"/></PAGEBORDERFILL><PAGEBORDERFILL BorferFill="1" FillArea="Paper" FooterInside="false" HeaderInside="false" TextBorder="true" Type="Even"><PAGEOFFSET Bottom="1417" Left="1417" Right="1417" Top="1417"/></PAGEBORDERFILL><PAGEBORDERFILL BorferFill="1" FillArea="Paper" FooterInside="false" HeaderInside="false" TextBorder="true" Type="Odd"><PAGEOFFSET Bottom="1417" Left="1417" Right="1417" Top="1417"/></PAGEBORDERFILL></SECDEF><COLDEF Count="1" Layout="Left" SameGap="0" SameSize="true" Type="Newspaper"/><PAGENUM FormatType="Digit" Pos="BottomCenter" SideChar="-"/><CHAR>신ㆍ구조문대비표</CHAR></TEXT></P><P ParaShape="30" Style="0"><TEXT CharShape="27"><TABLE BorderFill="4" CellSpacing="0" ColCount="2" PageBreak="Cell" RepeatHeader="true" RowCount="31"><SHAPEOBJECT InstId="1277078417" Lock="false" NumberingType="Table" TextWrap="TopAndBottom" ZOrder="1"><SIZE Height="63274" HeightRelTo="Absolute" Protect="false" Width="44789" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="false" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="283" Left="283" Right="283" Top="283"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2415" Protect="false" RowAddr="0" RowSpan="1" Width="22393"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="34" Style="0"><TEXT CharShape="28"><CHAR>현        행</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="2415" Protect="false" RowAddr="0" RowSpan="1" Width="22396"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="34" Style="0"><TEXT CharShape="28"><CHAR>개   정   안</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="283" Protect="false" RowAddr="1" RowSpan="1" Width="22393"><CELLMARGIN Bottom="0" Left="566" Right="566" Top="0"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="2" Style="0"><TEXT CharShape="34"/></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="283" Protect="false" RowAddr="1" RowSpan="1" Width="22393"><CELLMARGIN Bottom="0" Left="566" Right="566" Top="0"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="2" Style="0"><TEXT CharShape="34"/></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="2" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제1조(목적) 이 기준은 「선박안전법」 </CHAR></TEXT><TEXT CharShape="31"><CHAR>제23조제4항, 제23조제7항</CHAR></TEXT><TEXT CharShape="29"><CHAR>, 같은 법 </CHAR></TEXT><TEXT CharShape="31"><CHAR>시행규칙 제58조제2항</CHAR></TEXT><TEXT CharShape="29"><CHAR>, 「안전한 컨테이너를 위한 국제협약」 부속서Ⅰ 및 Ⅱ에 따른 컨테이너 형식승인 </CHAR></TEXT><TEXT CharShape="31"><CHAR>시험 및 검정기준 등에 대해 필요한 사항을 규정함</CHAR></TEXT><TEXT CharShape="29"><CHAR>을 목적으로 한다.</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="2" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제1조(목적) -------------------- </CHAR></TEXT><TEXT CharShape="31"><CHAR>제23조제3항·제7항 및 제10항</CHAR></TEXT><TEXT CharShape="29"><CHAR>---- </CHAR></TEXT><TEXT CharShape="31"><CHAR>시행규칙 제58조제2항 및 제58조의2제1항</CHAR></TEXT><TEXT CharShape="29"><CHAR>-------------------------------------------------- </CHAR></TEXT><TEXT CharShape="31"><CHAR>시험과 검정의 기준을 정하는 것</CHAR></TEXT><TEXT CharShape="29"><CHAR>----------------------------.</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="3" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제2조(정의) 이 기준에서 사용하는 용어의 뜻은 다음과 같다.</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="3" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제2조(정의) --------------------------------------.</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="4" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  1. “컨테이너(Container)“란 「선박안전법」(이하 “법“이라 한다) 제2조제14호에 따른 것으로 다음 각 목을 만족하는 운송용 장비를 말한다.</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="4" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  1. --------------------------------------------------------------------------------------------------------------.</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="5" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="33" Style="27"><TEXT CharShape="32"><CHAR>    가.ㆍ나. (생  략)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="5" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="33" Style="27"><TEXT CharShape="32"><CHAR>    가.ㆍ나. (현행과 같음)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="6" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="33" Style="27"><TEXT CharShape="32"><CHAR>    다. 고정 및 취급이 </CHAR></TEXT><TEXT CharShape="33"><CHAR>용이하도록</CHAR></TEXT><TEXT CharShape="32"><CHAR> 설계되어 있고, 이러한 목적을 위하여 모서리끼움쇠를 가질 것</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="6" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="33" Style="27"><TEXT CharShape="32"><CHAR>    다. ----------- </CHAR></TEXT><TEXT CharShape="33"><CHAR>쉽도록</CHAR></TEXT><TEXT CharShape="32"><CHAR> ----------------------------------------------------</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="7" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="33" Style="27"><TEXT CharShape="32"><CHAR>    라. (생  략)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="7" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="33" Style="27"><TEXT CharShape="32"><CHAR>    라. (현행과 같음)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="8" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  2. ∼ 5. (생  략)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="8" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  2. ∼ 5. (현행과 같음)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="9" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  6. “비가압식 </CHAR></TEXT><TEXT CharShape="31"><CHAR>산적 고체화물</CHAR></TEXT><TEXT CharShape="29"><CHAR>(Drybulk) 컨테이너”란 산적 고체화물을 운송하기 위한 컨테이너로 다음 각 목을 만족하는 컨테이너를 말한다.</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="9" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  6. ------- </CHAR></TEXT><TEXT CharShape="31"><CHAR>산적(散積) 고체화물</CHAR></TEXT><TEXT CharShape="29"><CHAR>------------------------------------------------------------------------------------.</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="10" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="33" Style="27"><TEXT CharShape="32"><CHAR>    가. (생  략)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="10" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="33" Style="27"><TEXT CharShape="32"><CHAR>    가. (현행과 같음)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="11" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="33" Style="27"><TEXT CharShape="32"><CHAR>    나. 운송 및 하역(荷役) 작업 시 </CHAR></TEXT><TEXT CharShape="33"><CHAR>초래되는</CHAR></TEXT><TEXT CharShape="32"><CHAR> 하중에 견딜 수 있을 것</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="11" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="33" Style="27"><TEXT CharShape="32"><CHAR>    나. --------------------- </CHAR></TEXT><TEXT CharShape="33"><CHAR>가해지는</CHAR></TEXT><TEXT CharShape="32"><CHAR> -------------------</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="12" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="33" Style="27"><TEXT CharShape="32"><CHAR>    다. (생  략)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="12" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="33" Style="27"><TEXT CharShape="32"><CHAR>    다. (현행과 같음)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="13" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  7. ∼ 10. (생  략)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="13" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  7. ∼ 10. (현행과 같음)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="14" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  </CHAR></TEXT><TEXT CharShape="31"><CHAR>11. “자체질량(이하 “T“라 한다)“이란 일반적인 조건에서 항구적으로 부착된 부속 부품을 포함하는 빈 컨테이너의 질량을 의미한다.</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="14" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  </CHAR></TEXT><TEXT CharShape="31"><CHAR>11. “자체질량(이하 “T”라 한다)”이란 일반적인 조건에서 항구적으로 부착된 부속 부품을 포함하는 빈 컨테이너의 질량을 의미한다.</CHAR></TEXT><TEXT CharShape="29"/></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="15" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  </CHAR></TEXT><TEXT CharShape="31"><CHAR>12. “최대총질량(이하 “R“이라 한다)“이란 컨테이너와 화물의 최대 허용통합중량을 말한다.</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="15" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  </CHAR></TEXT><TEXT CharShape="31"><CHAR>12. “최대총질량(이하 “R”이라 한다)”이란 컨테이너와 화물의 최대 허용통합중량을 말한다.</CHAR></TEXT><TEXT CharShape="29"/></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="16" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  </CHAR></TEXT><TEXT CharShape="31"><CHAR>13. “최대적재질량(이하 “P“라 한다)“이란 해당 컨테이너에 수납할 수 있는 화물의 최대질량을 말한다.(P = R – T)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="16" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  </CHAR></TEXT><TEXT CharShape="31"><CHAR>13. “최대적재질량(이하 “P”라 한다)”이란 해당 컨테이너에 수납할 수 있는 화물의 최대질량을 말한다.(P = R - T)</CHAR></TEXT><TEXT CharShape="29"/></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="17" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  14. (생  략)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="17" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  14. (현행과 같음)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="18" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제4조(컨테이너의 주요치수) </CHAR></TEXT><TEXT CharShape="31"><CHAR>&lt;신  설&gt;</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="18" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제4조(컨테이너의 주요치수) </CHAR></TEXT><TEXT CharShape="31"><CHAR>① 컨테이너의 종류별 외부 치수, 내부 치수, 문의 치수 및 R 등은 ISO 668 및 ISO 1496-2에 따른다.</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="19" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="28"><TEXT CharShape="29"><CHAR>  </CHAR></TEXT><TEXT CharShape="31"><CHAR>컨테이너의 종류별</CHAR></TEXT><TEXT CharShape="29"><CHAR> 외부 치수, 내부 치수, 문의 치수 및 R </CHAR></TEXT><TEXT CharShape="31"><CHAR>등은 ISO 668 및 ISO 1496-2에 따른다</CHAR></TEXT><TEXT CharShape="29"><CHAR>.  </CHAR></TEXT><TEXT CharShape="31"><CHAR>다만, 다음 각 호의 경우에는 외부 치수, 내부 치수, 문의 치수 및 R 등을 다르게 할 수 있다. 이 경우 그 외형치수보다 밖으로 돌출되는 것을 부착해서는 안 되며 내부 치수를 측정할 경우 컨테이너의 안쪽으로 돌출된 상부 모서리끼움쇠는 포함하지 않는다.</CHAR></TEXT><TEXT CharShape="29"><CHAR> </CHAR></TEXT><TEXT CharShape="31"><CHAR>&lt;후단 신설&gt;</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="19" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="28"><TEXT CharShape="29"><CHAR>  ② </CHAR></TEXT><TEXT CharShape="31"><CHAR>제1항에도 불구하고 다음 각 호의 경우에는</CHAR></TEXT><TEXT CharShape="29"><CHAR> ----------------------------------------- </CHAR></TEXT><TEXT CharShape="31"><CHAR>등을 다르게 할 수 있다</CHAR></TEXT><TEXT CharShape="29"><CHAR>. </CHAR></TEXT><TEXT CharShape="31"><CHAR>&lt;단서 삭제&gt;</CHAR></TEXT><TEXT CharShape="29"><CHAR> -----------------------------------------------------------------------------------------------------------------------------------------------------------------------. </CHAR></TEXT><TEXT CharShape="31"><CHAR>이 경우 그 외형치수보다 밖으로 돌출되는 것을 부착해서는 안 되며 내부 치수를 측정할 경우 컨테이너의 안쪽으로 돌출된 상부 모서리끼움쇠는 포함하지 않는다.</CHAR></TEXT><TEXT CharShape="29"/></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="20" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  1.ㆍ2. (생  략)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="20" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  1.ㆍ2. (현행과 같음)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="21" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제7조(지게발구멍(Fork Pocket) 및 터널리세스(Tunnel Recess)의 설치) ① 길이가 20피트(이하 </CHAR></TEXT><TEXT CharShape="31"><CHAR>“ ft”</CHAR></TEXT><TEXT CharShape="29"><CHAR>라 한다) 이하인 컨테이너에는 화물이 적재된 컨테이너의 하역용으로 사용되는 지게발구멍(Fork Pocket)을 설치할 수 있으며 이에 추가해 빈 컨테이너의 하역용으로만 사용되는 지게발구멍을 설치할 수 있다. 다만, 탱크컨테이너에는 지게발구멍을 설치해서는 안 된다.</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="21" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제7조(지게발구멍(Fork Pocket) 및 터널리세스(Tunnel Recess)의 설치) ①  ---------------- </CHAR></TEXT><TEXT CharShape="31"><CHAR>“ft”</CHAR></TEXT><TEXT CharShape="29"><CHAR>----------------------------------------------------------------------------------------------------------------------------------------------------------------. ---------------------------------------------. </CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="22" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="28"><TEXT CharShape="29"><CHAR>  ②ㆍ③ (생  략)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="22" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="28"><TEXT CharShape="29"><CHAR>  ②ㆍ③ (현행과 같음)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="23" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제8조(형식승인 시험) ① 컨테이너는 종류별로 다음 각 호의 시험기준에 적합해야 하며, 시험 후에도 사용상에 지장을 주는 변경 또는 손상이 발생되지 않아야 한다. 다만, 컨테이너의 형상이나 사용목적 등에 따라 시험기준이 적합하지 않은 때에는 </CHAR></TEXT><TEXT CharShape="31"><CHAR>해양수산부장관</CHAR></TEXT><TEXT CharShape="29"><CHAR>이 정하는 바에 따른다.</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="23" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제8조(형식승인 시험) ①  ------------------------------------------------------------------------------------------------------------. ---------------------------------------------------------------- </CHAR></TEXT><TEXT CharShape="31"><CHAR>해양수산부장관(이하 “장관”이라 한다)</CHAR></TEXT><TEXT CharShape="29"><CHAR>----------------------.   </CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="24" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  1. ∼ 4. (생  략)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="24" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  1. ∼ 4. (현행과 같음)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="25" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  5. </CHAR></TEXT><TEXT CharShape="31"><CHAR>플렛폼컨테이너</CHAR></TEXT><TEXT CharShape="29"><CHAR> 및 플랫폼 베이스 컨테이너는 ISO 1496-5에 따른 시험기준에 적합해야 한다.</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="25" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  5. </CHAR></TEXT><TEXT CharShape="31"><CHAR>플랫폼컨테이너</CHAR></TEXT><TEXT CharShape="29"><CHAR> ------------------------------------------------------------.</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="26" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="28"><TEXT CharShape="29"><CHAR>  ② (생  략)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="26" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="28"><TEXT CharShape="29"><CHAR>  ② (현행과 같음)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="27" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>  </CHAR></TEXT><TEXT CharShape="31"><CHAR>&lt;신  설&gt;</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="27" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="31"><CHAR>제8조의2(별도의 형식승인 시험을 거쳐야 하는 사항) 법 제23조제3항 및 같은 법 시행규칙 제58조의2제1항에 따라 별도의 형식승인 시험을 거쳐야 하는 사항은 다음 각 호와 같다.</CHAR></TEXT><TEXT CharShape="29"/></P><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  </CHAR></TEXT><TEXT CharShape="31"><CHAR>1. 「컨테이너 안전점검 기준」 제2조제4호에 따른 컨테이너 주요부의 길이, 크기 및 재질에 변경이 발생한 경우</CHAR></TEXT><TEXT CharShape="29"/></P><P ParaShape="32" Style="26"><TEXT CharShape="29"><CHAR>  </CHAR></TEXT><TEXT CharShape="31"><CHAR>2. 제2조제10호부터 제12호까지에서 정하는 컨테이너 형식, 자체질량 또는 최대총질량에 변경이 발생한 경우</CHAR></TEXT><TEXT CharShape="29"/></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="28" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제10조(검정) </CHAR></TEXT><TEXT CharShape="31"><CHAR>법 제23조제3항</CHAR></TEXT><TEXT CharShape="29"><CHAR>에 따른 컨테이너 검정기준은 별표 6과 같다.</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="28" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제10조(검정) </CHAR></TEXT><TEXT CharShape="31"><CHAR>법 제23조제7항</CHAR></TEXT><TEXT CharShape="29"><CHAR>---------------------------------.</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="7" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="29" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제11조(재검토기한) </CHAR></TEXT><TEXT CharShape="31"><CHAR>해양수산부장관</CHAR></TEXT><TEXT CharShape="29"><CHAR>은 이 고시에 대하여 「훈령ㆍ예규 등의 발령 및 관리에 관한 규정」에 따라 </CHAR></TEXT><TEXT CharShape="31"><CHAR>2021년 1월 1일</CHAR></TEXT><TEXT CharShape="29"><CHAR>을 기준으로 매 3년이 되는 시점(매 3년째의 </CHAR></TEXT><TEXT CharShape="31"><CHAR>12월 31일</CHAR></TEXT><TEXT CharShape="29"><CHAR>까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 해야 한다.</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="8" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="2416" Protect="false" RowAddr="29" RowSpan="1" Width="22393"><CELLMARGIN Bottom="566" Left="566" Right="566" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="31" Style="25"><TEXT CharShape="29"><CHAR>제11조(재검토기한) </CHAR></TEXT><TEXT CharShape="31"><CHAR>장관</CHAR></TEXT><TEXT CharShape="29"><CHAR>-------------------------------------------------------------------- </CHAR></TEXT><TEXT CharShape="31"><CHAR>2023년 7월 1일</CHAR></TEXT><TEXT CharShape="29"><CHAR>----------------------------------- </CHAR></TEXT><TEXT CharShape="31"><CHAR>6월 30일</CHAR></TEXT><TEXT CharShape="29"><CHAR>--------------------------------------------------------.</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="9" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="383" Protect="false" RowAddr="30" RowSpan="1" Width="22393"><CELLMARGIN Bottom="0" Left="566" Right="566" Top="0"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="2" Style="0"><TEXT CharShape="30"/></P></PARALIST></CELL><CELL BorderFill="10" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="383" Protect="false" RowAddr="30" RowSpan="1" Width="22393"><CELLMARGIN Bottom="0" Left="566" Right="566" Top="0"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="2" Style="0"><TEXT CharShape="30"/></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="17" Style="0"/></SECTION></BODY><TAIL><SCRIPTCODE Type="JScript" Version="1.0"><SCRIPTHEADER></SCRIPTHEADER><SCRIPTSOURCE></SCRIPTSOURCE></SCRIPTCODE></TAIL></HWPML>