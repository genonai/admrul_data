    "articles": [
      {
        "article_no": "제1조",
        "article_title": "민속 소싸움 경기명칭 사용원칙",
        "chapter": "",
        "content": "제1조(민속 소싸움 경기명칭 사용원칙) ① 전국 규모 민속 소싸움 경기의 명칭은 경기명칭의 무분별한 사용 및 유사 명칭 사용으로 인한 업무혼선을 방지하기 위하여 \"개회횟수, 지역 명칭 및 전국민속소싸움대회\"의 단어를 포함하여 통일되게 사용하여야 한다.예시) 제○회 ○○시(군) 전국민속소싸움대회② 지방자치단체장이 주관(주최)하는 민속 소싸움 경기가 일부 다른 목적의 행사에 부속하는 경우 또는 상설경기 등으로 제1항의 민속 소싸움 경기를 실시하는 경우 부제의 경기명칭을 사용 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방자치단체장이주관(주최)하는민속소싸움경기#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "민속 소싸움 경기 개최지역의 범위",
        "chapter": "",
        "content": "제2조(민속 소싸움 경기 개최지역의 범위) 지방자치단체장이 주관(주최)하고 농림축산식품부장관이 정하는 고시하는 민속 소싸움 경기는 당해 지방자치단체의 관할 구역 내에서 실시하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:지방자치단체장이주관(주최)하는민속소싸움경기#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "민속 소싸움 경기",
        "chapter": "",
        "content": "제3조(민속 소싸움 경기) 농림축산식품부장관이 정하여 고시하는 민속 소싸움 경기는 대구광역시 달성군, 충청북도 보은군, 전라북도 정읍시, 전라북도 완주군, 경상북도 청도군, 경상남도 창원시, 경상남도 진주시, 경상남도 김해시, 경상남도 의령군, 경상남도 함안군, 경상남도 창녕군의 지방자치단체장이 주관(주최)하는 민속 소싸움으로 한다.",
        "enforcement_date": "",
