    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총 칙",
        "content": "제1조(목적) 이 규칙은 국가공무원인재개발원(이하 \"국가인재원\"이라 한다.)에서 운영하는 합숙교육이 포함된 교육과정의 합숙생활에 관한 제반사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국가공무원인재개발원합숙교육운영규칙#JO0001"
      },
      {
