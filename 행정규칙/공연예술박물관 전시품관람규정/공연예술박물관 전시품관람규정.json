        "article_no": "제4조",
        "article_title": "관람료",
        "chapter": "",
        "content": "제4조(관람료) 관람료는 극장장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:공연예술박물관전시품관람규정#JO0004"
