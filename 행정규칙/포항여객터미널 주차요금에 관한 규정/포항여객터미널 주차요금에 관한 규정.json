            "link_text": "「환경친화적 자동차의 개발 및 보급촉진에 관한 법률」",
            "line_text": "",
            "target_law_name": "환경친화적 자동차의 개발 및 보급촉진에 관한 법률",
            "target_article_no": "",
            "target_article_title": "",
