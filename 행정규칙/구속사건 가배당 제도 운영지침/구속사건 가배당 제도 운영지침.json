  "body": {
    "format": "articles",
    "article_count": 5,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 지침은 형사절차의 효율성을 제고하고 구속피의자의 인권을 보호하기 위하여 구속사건 송치전 가배당 제도의 운영에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:구속사건가배당제도운영지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "content": "제2조(정의) 가배당이라 함은 사법경찰관(이하 특별사법경찰관을 포함한다.)으로부터 구속사건의 수사서류와 피의자를 송치받기 전에 지방검찰청 검사장 또는 지청장이 먼저 주임검사를 결정하여 사건을 임시로 배당하는 것을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:구속사건가배당제도운영지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "가배당 대상사건",
        "chapter": "",
        "content": "제3조(가배당 대상사건) ① 지방검찰청 검사장 또는 지청장은 구속송치사건의 효율적인 조사를 위해 필요한 경우 모든 구속사건에 대해 송치 전에 가배당 제도를 실시할 수 있다.② 지방검찰청 검사장 또는 지청장은 가배당 제도를 실시하는 경우 관할 구역내 각 경찰서에 이 사실을 미리 통보하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:구속사건가배당제도운영지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "가배당 사건의 송치 통보",
        "chapter": "",
        "content": "제4조(가배당 사건의 송치 통보) 사법경찰관은 구속사건 송치 전날 검찰청 구속사건 배당업무 담당자에게 유선으로 구속사건을 송치할 예정이라는 사실 및 송치일을 통보한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:구속사건가배당제도운영지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "가배당 사건의 접수 및 배당",
        "chapter": "",
        "content": "제5조(가배당 사건의 접수 및 배당) ① 검찰청 구속사건 배당업무 담당자는 구속영장부본 사본을 첨부하여 지방검찰청 검사장 또는 지청장에게 구속사건이 송치될 예정임을 보고한다.② 지방검찰청 검사장 또는 지청장은 구속영장부본 사본을 토대로 전담, 사건의 난이도, 영장청구 검사 등을 고려하여 구속사건 송치 전에 사건을 가배당한다.③ 주임검사는 구속사건을 가배당 받은 후 수사 일정을 미리 조정하고 사전에 구속 사건 내용 파악하여 직접 조사에 대비한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:구속사건가배당제도운영지침#JO0005"
