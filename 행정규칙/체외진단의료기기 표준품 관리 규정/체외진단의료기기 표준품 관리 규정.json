      {
        "article_no": "제7조",
        "article_title": "분양가격 등",
        "chapter": "",
        "content": "제7조(분양가격 등) 식약처장은 체외진단의료기기 표준품의 포장단위별 단가를 정하고 별표 3에 따른 보유한 표준품의 분양 가능한 수량 및 분양가격표를 연 1회 이상 식품의약품안전처 인터넷 홈페이지에 게재해야 한다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "appendix_ref",
            "delegation_type": null,
            "target_category": "별표",
            "source_article_no": "제7조",
            "source_clause": "제7조",
