    "article_count": 1,
    "articles": [
      {
        "article_no": "전문",
        "article_title": "",
        "chapter": "",
        "content": "전세권의 목적인 부동산은 1필의 토지 또는 1동의 건물의 전부라야 할 필요는 없고 그 일부라도 무방하나, 부동산의 일부에 대하여 전세권설정등기를 신청하고자 할 경우에는 전세권의 범위를 특정하고 그 부분을 표시한 지적도나 건물도면을 첨부정보로 제공하여야 하므로( 「부동산등기법」 제72조, 「부동산등기규칙」 제128조제2항 참조), 건물의 특정부분이 아닌 공유지분에 대한 전세권은 등기할 수 없다.",
        "enforcement_date": "",
