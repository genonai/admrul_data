      {
        "article_no": "제13조",
        "article_title": "분과위원장의 직무",
        "chapter": "제3장  시설자재가격 분과심의위원회",
        "content": "제13조(분과위원장의 직무) 분과위원장은 분과위원회의 직무를 총괄하고 대표한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:시설자재가격심의위원회설치및운영규정#JO0013"
