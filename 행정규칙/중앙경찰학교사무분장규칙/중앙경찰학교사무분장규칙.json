      "content": "〔별표〕\n중앙경찰학교공무원정원표\n2008. 8. 8\n┏━━━━┳━━┳━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━━━┓\n┃직급별  ┃총  ┃경   찰   관                        ┃일  반  직            ┃기  능  직                ┃\n┃        ┃    ┠──┬─┬─┬─┬─┬─┬─┬─┬─╂─┬─┬─┬─┬─┬─╂─┬─┬─┬─┬─┬─┬─┨\n┃        ┃    ┃소  │치│총│경│경│경│경│경│순┃소│간│사│공│시│전┃소│9 │10│10│10│10│10┃\n┃        ┃    ┃    │  │  │  │  │  │  │  │  ┃  │  │  │  │설│  ┃  │급│급│급│급│급│급┃\n┃        ┃계  ┃    │  │  │  │  │  │  │  │  ┃  │  │  │  │주│산┃  │  │  │  │  │  │  ┃\n┃        ┃    ┃    │  │  │  │  │  │  │  │  ┃  │  │서│업│사│  ┃  │통│기│운│간│사│난┃\n┃        ┃    ┃    │  │  │  │  │  │  │  │  ┃  │호│  │  │보│  ┃  │  │  │  │호│  │  ┃\n┃ 과별   ┃    ┃    │안│  │  │  │  │  │  │  ┃  │  │  │  │또│서┃  │신│계│전│조│무│방┃\n┃        ┃    ┃    │  │  │  │  │  │  │  │  ┃  │  │주│주│는│  ┃  │  │  │  │무│  │  ┃\n┃        ┃    ┃    │  │  │  │  │  │  │  │  ┃  │  │  │  │환│기┃  │원│원│원│원│원│원┃\n┃        ┃    ┃    │  │  │  │  │  │  │  │  ┃  │주│  │  │경│  ┃  │  │  │  │  │  │  ┃\n┃        ┃    ┃    │  │  │  │  │  │  │  │  ┃  │  │사│사│주│  ┃  │  │  │  │  │  │  ┃\n┃        ┃    ┃계  │감│경│정│감│위│사│장│경┃계│  │  │  │사│  ┃  │  │  │  │  │  │  ┃\n┃        ┃    ┃    │  │  │  │  │  │  │  │  ┃  │  │  │  │보│  ┃계│  │  │  │  │  │  ┃\n┃        ┃    ┃    │  │  │  │  │  │  │  │  ┃  │사│보│보│  │  ┃  │  │  │  │  │  │  ┃\n┣━━━━╋━━╋━━┿━┿━┿━┿━┿━┿━┿━┿━╋━┿━┿━┿━┿━┿━╋━┿━┿━┿━┿━┿━┿━┫\n┃총   계 ┃172 ┃154 │1 │2 │3 │21│68│24│23│12┃5 │1 │1 │1 │1 │1 ┃13│1 │1 │2 │1 │7 │1 ┃\n┣━━━━╋━━╋━━┿━┿━┿━┿━┿━┿━┿━┿━╋━┿━┿━┿━┿━┿━╋━┿━┿━┿━┿━┿━┿━┫\n┃운  영  ┃44  ┃31  │1 │1 │1 │3 │5 │8 │6 │6 ┃4 │1 │  │1 │1 │1 ┃9 │1 │  │2 │1 │4 │1 ┃\n┃지원과  ┃    ┃    │  │  │  │  │  │  │  │  ┃  │  │  │  │  │  ┃  │  │  │  │  │  │  ┃\n┠────╂──╂──┼─┼─┼─┼─┼─┼─┼─┼─╂─┼─┼─┼─┼─┼─╂─┼─┼─┼─┼─┼─┼─┨\n┃교무과  ┃83  ┃78  │  │1 │1 │13│44│9 │7 │3 ┃1 │  │1 │  │  │  ┃4 │  │1 │  │  │3 │  ┃\n┠────╂──╂──┼─┼─┼─┼─┼─┼─┼─┼─╂─┼─┼─┼─┼─┼─╂─┼─┼─┼─┼─┼─┼─┨\n┃학생과  ┃45  ┃45  │  │  │1 │5 │19│7 │10│3 ┃  │  │  │  │  │  ┃  │  │  │  │  │  │  ┃\n┗━━━━┻━━┻━━┷━┷━┷━┷━┷━┷━┷━┷━┻━┷━┷━┷━┷━┷━┻━┷━┷━┷━┷━┷━┷━┛",
