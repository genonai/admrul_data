      {
        "article_no": "제12조",
        "article_title": "결재 단계의 탄력적 운영",
        "chapter": "",
        "content": "제12조(결재 단계의 탄력적 운영) ① 결재 단계는 업무의 책임과 권한을 명확히 하면서 적정하고 신속하게 업무가 처리될 수 있도록 기안자가 자율적으로 판단하여 정한다.② 전결권자는 특별한 사유가 없으면 해당 업무에 대한 전결권을 상향 또는 하향 전결하여 처리하지 않도록 해야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:해양수산부위임전결규정#JO0012"
      },
