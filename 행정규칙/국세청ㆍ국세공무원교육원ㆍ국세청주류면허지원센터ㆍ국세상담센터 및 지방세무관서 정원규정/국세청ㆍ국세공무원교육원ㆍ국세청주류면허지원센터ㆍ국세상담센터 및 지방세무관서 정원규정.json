      │3         │        │       │       │       │1       │       │2       │\n├─────────────┼─────┼────┼────┼────┼────┼────┼────┼────┤\n│본               청       │3         │        │       │       │       │1       │       │2       │\n├─────────────┼─────┼────┼────┼────┼────┼────┼────┼────┤\n│청 ·차  장  실           │3         │        │       │       │       │1       │       │2       │\n├─────────────┼─────┼────┼────┼────┼────┼────┼────┼────┤\n│대변인                    │         │       │       │       │       │       │       │       │\n├─────────────┼─────┼────┼────┼────┼────┼────┼────┼────┤\n│기획조정관                │         │       │       │       │       │       │       │       │\n├─────────────┼─────┼────┼────┼────┼────┼────┼────┼────┤\n│정보화관리관              │         │       │       │       │       │       │       │       │\n├─────────────┼─────┼────┼────┼────┼────┼────┼────┼────┤\n│감사관                    │         │       │       │       │       │       │       │       │\n├─────────────┼─────┼────┼────┼────┼────┼────┼────┼────┤\n│납세자보호관              │         │       │       │       │       │       │       │       │\n├─────────────┼─────┼────┼────┼────┼────┼────┼────┼────┤\n│국제조세관리관            │         │       │       │       │       │       │       │       │\n├─────────────┼─────┼────┼────┼────┼────┼────┼────┼────┤\n│인사기획과                │          │        │        │        │        │        │        │        │\n├─────────────┼─────┼────┼────┼────┼────┼────┼────┼────┤\n│운영지원과                │         │       │       │       │       │       │       │       │\n├─────────────┼─────┼────┼────┼────┼────┼────┼────┼────┤\n│징세법무국                │         │       │       │       │       │       │       │       │\n├─────────────┼─────┼────┼────┼────┼────┼────┼────┼────┤\n│개 인 납 세 국            │         │       │       │       │       │       │       │       │\n├─────────────┼─────┼────┼────┼────┼────┼────┼────┼────┤\n│법 인 납 세 국            │         │       │       │       