      {
        "article_no": "제18조",
        "article_title": "변상책임",
        "chapter": "",
        "content": "제18조 (변상책임) 운전원은 고의 또는 중대한 과실로 인하여 인적, 물적 손해를 발생케 하였을 때에는 이에 대한 일체의 변상책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립수산과학원차량운영규정#JO0018"
