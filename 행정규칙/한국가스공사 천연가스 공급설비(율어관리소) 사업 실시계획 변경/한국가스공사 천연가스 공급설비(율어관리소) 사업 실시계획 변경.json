      "content": "<수용ㆍ사용할 토지의 권리명세서 : 율어관리소>\n(당초)\n┌─┬─────┬───┬─┬─────────┬──────────────────┬───────────┬──┐\n│번│소재지    │지 번 │지│지 적(㎡)         │토 지 소 유 자                      │관 계 인              │비고│\n│호│          │      │목├────┬────┼─────┬────────────┼───┬───┬───┤    │\n│  │          │      │  │공부상  │편입    │성 명     │주 소                   │성 명 │주 소 │내 용 │    │\n│  │          │      │  │면적    │면적    │(명칭)    │                        │(명칭)│      │      │    │\n├─┼─────┼───┼─┼────┼────┼─────┼────────────┼───┼───┼───┼──┤\n│1 │전라남도  │1009-1│답│1,559.6 │1,559.6 │선**      │인천 남동구 만수동      │      │      │      │    │\n│  │보성군    │      │  │        │        │          │1044 뉴서울 아파트      │      │      │      │    │\n│  │율어면    │      │  │        │        │          │106-1210                │      │      │      │    │\n├─┤유신리    ├───┼─┼────┼────┼─────┼────────────┼───┼───┼───┼──┤\n│2 │          │1009-2│답│2,447.0 │2,447.0 │이**      │전라남도 보성군 율어면  │      │      │      │    │\n│  │          │      │  │        │        │          │율어로 983-24           │      │      │      │    │\n├─┤          ├───┼─┼────┼────┼─────┼────────────┼───┼───┼───┼──┤\n│3 │          │1009-3│답│3,782.3 │3,782.3 │전**      │전라남도 담양군 봉산면  │      │      │      │    │\n│  │          │      │  │        │        │          │신학리 70-1             │      │      │      │    │\n├─┤          ├───┼─┼────┼────┼─────┼────────────┼───┼───┼───┼──┤\n│4 │          │835-3 │도│410.0   │410.0   │김**      │서울특별시 금천구       │      │      │      │    │\n│  │          │      │  │        │        │          │벚꽃로40, 101동         │      │      │      │    │\n│  │          │      │  │        │        │          │2101호(독산동,          │      │      │      │    │\n│  │          │      │  │        │        │          │금천롯데캐슬골드파크1   │      │      │      │    │\n│  │          │      │  │        │        │          │차)                     │      │      │      │    │\n├─┤          ├───┼─┼────┼────┼─────┼────────────┼───┼───┼───┼──┤\n│5 │          │835-4 │전│261.0   │261.0   │배**      │전라남도 보성군 보성읍  │      │      │      │    │\n│  │          │      │  │        │        │          │주봉리 696              │      │      │      │    │\n├─┤          ├───┼─┼────┼────┼─────┼────────────┼───┼───┼───┼──┤\n│6 │          │1032-2│구│358.5   │358.5   │국(농림축 │                        │      │      │      │    │\n│  │          │      │  │        │        │산식품부) │                        │      │      │      │    │\n├─┴─────┼───┼─┼────┼────┼─────┼────────────┼───┼───┼───┼──┤\n│합 계         │6필지 │  │8,818.4 │8,818.4 │          │                        │      │      │      │    │\n└───────┴───┴─┴────┴────┴─────┴────────────┴───┴───┴───┴──┘\n(변경)\n┌─┬─────┬───┬─┬─────────┬──────────────────┬───────────┬──┐\n│번│소재지    │지 번 │지│지 적(㎡)         │토 지 소 유 자                      │관 계 인              │비고│\n│호│          │      │목├────┬────┼─────┬────────────┼───┬───┬───┤    │\n│  │          │      │  │공부상  │편입    │성 명     │주 소                   │성 명 │주 소 │내 용 │    │\n│  │          │      │  │면적    │면적    │(명칭)    │                        │(명칭)│      │      │    │\n├─┼─────┼───┼─┼────┼────┼─────┼────────────┼───┼───┼───┼──┤\n│1 │전라남도  │1009-1│답│1,559.6 │1,559.6 │한국가스  │대구광역시 동구 첨단로  │      │      │      │    │\n│  │보성군    │      │  │        │        │공사      │120 (신서동)            │      │      │      │    │\n├─┤율어면    ├───┼─┼────┼────┼─────┼────────────┼───┼───┼───┼──┤\n│2 │유신리    │1009-2│답│2,447.0 │2,447.0 │한국가스  │대구광역시 동구 첨단로  │      │      │      │    │\n│  │          │      │  │        │        │공사      │120 (신서동)            │      │      │      │    │\n├─┤          ├───┼─┼────┼────┼─────┼────────────┼───┼───┼───┼──┤\n│3 │          │835-3 │도│410.0   │410.0   │한국가스  │대구광역시 동구 첨단로  │      │      │      │    │\n│  │          │      │  │        │        │공사      │120 (신서동)            │      │      │      │    │\n├─┤          ├───┼─┼────┼────┼─────┼────────────┼───┼───┼───┼──┤\n│4 │          │835-17│전│201.0   │201.0   │한국가스  │대구광역시 동구 첨단로  │      │      │      │    │\n│  │          │      │  │        │        │공사      │120 (신서동)            │      │      │      │    │\n├─┤          ├───┼─┼────┼────┼─────┼────────────┼───┼───┼───┼──┤\n│5 │          │1032-2│구│358.5   │358.5   │국(농림축 │                        │      │      │      │    │\n│  │          │      │  │        │        │산식품부) │                        │      │      │      │    │\n├─┴─────┼───┼─┼────┼────┼─────┼────────────┼───┼───┼───┼──┤\n│합 계         │5필지 │  │4,976.1 │4,976.1 │          │                        │      │      │      │    │\n└───────┴───┴─┴────┴────┴─────┴────────────┴───┴───┴───┴──┘",
