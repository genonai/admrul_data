   │목재제품의 규격과       │\n│                    ├──────────┼─────────┤품질기준                │\n│                    │질소(N)             │1.0% 이하         │(국립산림과학원고시)    │\n│                    ├──────────┼─────────┤                        │\n│                    │황(S)               │0.05% 이하        │                        │\n│                    ├──────────┼─────────┤                        │\n│                    │구리(Cu)            │10 ㎎/㎏ 이하     │                        │\n│                    ├──────────┼─────────┤                        │\n│                    │납(Pb)              │10 ㎎/㎏ 이하     │                        │\n│                    ├──────────┼─────────┤                        │\n│                    │니켈(Ni)            │10 ㎎/㎏ 이하     │                        │\n│                    ├──────────┼─────────┤                        │\n│                    │비소(As)            │1.0 ㎎/㎏ 이하    │                        │\n│                    ├──────────┼─────────┤                        │\n│                    │수은(Hg)            │0.1 ㎎/㎏ 이하    │                        │\n│                    ├──────────┼─────────┤                        │\n│                    │아연(Zn)            │100 ㎎/㎏ 이하    │                        │\n│                    ├──────────┼─────────┤                        │\n│                    │카드뮴(Cd)          │0.5 ㎎/㎏ 이하    │                        │\n│                    ├──────────┼─────────┤                        │\n│                    │크로뮴(Cr)          │10 ㎎/㎏ 이하     │                        │\n├──────────┼──────────┼─────────┼────────────┤\n│목재칩              │세슘방사능          │30 Bq/kg 이하     │환경방사능 측정- 토양 - │\n│                    │(Cs-137과 Cs-134 합)│                  │제3부: 감마 방출        │\n│                    │                    │                  │방사성 핵종 측정(KS A   │\n│                    │                    │                  │ISO 18589-3)            │\n│                    ├──────────┼─────────┼────────────┤\n│                    │염소(Cl)            │0.1% 이하         │목재제품의 규격과       │\n│                    ├──────────┼─────────┤품질기준                │\n│                    │질소(N)             │1.5% 이하         │(국립산림과학원고시)    │\n│                    ├──────────┼─────────┤                        │\n│                    │황(S)               │0.15% 이하        │                        │\n│                    ├──────────┼─────────┤                        │\n│                    │납(Pb)              │20 ㎎/㎏ 이하     │                        │\n│                    ├──────────┼─────────┤                        │\n│                    │비소(As)            │2 ㎎/㎏ 이하      │                        │\n│                    ├──────────┼─────────┤                        │\n│                    │수은(Hg)            │0.1 ㎎/㎏ 이하    │                        │\n│                    ├──────────┼─────────┤                        │\n│                    │카드뮴(Cd)          │2.0 ㎎/㎏ 이하    │                        │\n│                    ├──────────┼─────────┤                        │\n│                    │크로뮴(Cr)          │20 ㎎/㎏ 이하     │                        │\n├──────────┼──────────┼─────────┼────────────┤\n│목재브리켓          │세슘방사능          │30 Bq/kg 이하     │환경방사능 측정- 토양 - │\n│                    │(Cs-137과 Cs-134 합)│                  │제3부: 감마 방출        │\n│                    │                    │                  │방사성 핵종 측정(KS A   │\n│                    │                    │                  │ISO 18589-3)            │\n│                    ├──────────┼─────────┼────────────┤\n│                    │염소(Cl)            │0.05% 이하        │목재제품의 규격과       │\n│                    ├──────────┼─────────┤품질기준                │\n│                    │질소(N)             │1.0% 이하         │(국립산림과학원고시)    │\n│                    ├──────────┼─────────┤                        │\n│                    │황(S)               │0.05% 이하        │                        │\n│                    ├──────────┼─────────┤                        │\n│                 