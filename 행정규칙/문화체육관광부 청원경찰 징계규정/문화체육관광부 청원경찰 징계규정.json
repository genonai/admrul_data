      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 문화체육관광부에서 근무하는 청원경찰(이하 \"청경”이라 한다)의 징계에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:문화체육관광부청원경찰징계규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 문화체육관광부에 배치된 청경의 징계는 다른 법령이나 규정에 정해진 경우를 제외하고 이 규정에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:문화체육관광부청원경찰징계규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "징계의 종류",
        "chapter": "",
        "content": "제3조(징계의 종류) 징계는 파면·해임·정직·감봉·견책으로 구분한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:문화체육관광부청원경찰징계규정#JO0003"
