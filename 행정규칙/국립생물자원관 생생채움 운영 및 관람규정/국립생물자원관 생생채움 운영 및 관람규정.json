      "content": "[별지 2호 서식]\n┏━┯━━━━━━━┯━━━┯━━━━━━━━━━━━┓\n휴 일 생 생 채 움 근 무 일 지                                               ┃결│담 당         │팀 장 │과 장                   ┃\n┃재├───────┼───┼────────────┨\n┃  │              │      │                        ┃\n┃  │              │      │                        ┃\n┃  │              │      │                        ┃\n20  .   .   (  요일)                                                        ┃  │              │      │                        ┃\n┏━┯━━━━┯━━━━━━━━━┯━━━━━━━┯━━━━━━━━┯━━━━┹─┴───────┴───┴────────────┨\n┃근│소 속   │직 급             │성 명         │서 명           │생생채움 근무자 현황                                          ┃\n┃무├────┼─────────┼───────┼────────┼───────┬───────┬───────────────┨\n┃자│생물다양성│                  │              │                │안내데스크    │시설?전시해설│자원봉사                      ┃\n┃  │교육과  │                  │              │                ├───────┼───────┼───┬───────────┨\n┃  │        │                  │              │                │              │              │오전  │오후                  ┃\n┃  │        │                  │              │                ├───────┼───────┼───┼───────────┨\n┃  │        │                  │              │                │              │              │명    │명                    ┃\n┃  │        │                  │              │                ├───────┼───────┼───┴───────────┨\n┃  │        │                  │              │                │              │              │1365자원봉사                  ┃\n┃  │        │                  │              │                ├───────┼───────┼───┬───────────┨\n┃  │        │                  │              │                │              │              │오전  │오후                  ┃\n┃  │        │                  │              │                ├───────┼───────┼───┼───────────┨\n┃  │        │                  │              │                │              │              │명    │명                    ┃\n┃  │        │                  │              │                ├──────┬┴───────┴───┴───────────┨\n┃  │        │                  │              │                │관람객 수   │  명                                            ┃\n┠─┴────┴─────────┴───────┴────────┴──────┴────────────────────────┨\n┃전  시  관    순  찰  표                                                                                                          ┃\n┠───┰──────────────────────────────────────┰───────┰──────────────┨\n┃점검  ┃생생채움 1층                                                                ┃생생채움 2~3층┃편의시설                    ┃\n┃시간  ┠─────┰────┰─────┰─────┰─────┰────┰────╂────┰──╂──────┰───────┨\n┃      ┃중앙 로비 ┃기획    ┃체험학습실┃대강당    ┃제 1전시실┃기획    ┃곶자왈  ┃제 2, 3 ┃3층 ┃교육실(2층) ┃유아휴게실,   ┃\n┃      ┃          ┃전시실Ⅰ┃          ┃          ┃          ┃전시실Ⅱ┃생태관  ┃전시실  ┃    ┃            ┃편의시설 복도 ┃\n┃      ┃          ┃        ┃          ┃          ┃          ┃        ┃        ┃        ┃    ┃            ┃등            ┃\n┠───╂─────╂────╂─────╂─────╂─────╂────╂────╂────╂──╂──────╂───────┨\n┃09:30 ┃          ┃        ┃          ┃          ┃          ┃        ┃        ┃        ┃    ┃            ┃              ┃\n┠───╂─────╂────╂─────╂─────╂─────╂────╂────╂────╂──╂──────╂───────┨\n┃11:30 ┃          ┃        ┃          ┃          ┃          ┃        ┃        ┃        ┃    ┃            ┃              ┃\n┠───╂─────╂────╂─────╂─────╂─────╂────╂────╂────╂──╂──────╂───────┨\n┃14:30 ┃          ┃        ┃          ┃          ┃          ┃        ┃        ┃        ┃    ┃            ┃              ┃\n┠───╂─────╂────╂─────╂─────╂─────╂────╂────╂────╂──╂──────╂───────┨\n┃17:30 ┃          ┃        ┃          ┃          ┃          ┃        ┃        ┃        ┃    ┃            ┃              ┃\n┠───┸─────┸────┸─────┸─────┸─────┸────┸────┸────┸──┸──────┸───────┨\n┃비    고(문제발생시 상세히 기재)                                                                                                  ┃\n┠─────────────────────────────────────────────────────────────────┨\n┃                                                                                                                                  ┃\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
