  "body": {
    "format": "articles",
    "article_count": 6,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규칙은 세월호 선체조사위원회 규칙(이하 \"규칙\"이라 한다)의 공포에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:세월호선체조사위원회규칙의공포에관한규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "전문",
        "chapter": "",
        "content": "제2조(전문) ① 규칙에는 전문을 붙여야 한다.② 제1항의 전문에는 세월호 선체조사위원회의 의결을 얻은 뜻을 기재하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:세월호선체조사위원회규칙의공포에관한규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "규칙번호",
        "chapter": "",
        "content": "제3조(규칙번호) 규칙은 일련번호를 붙여서 공포한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:세월호선체조사위원회규칙의공포에관한규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "공포절차",
        "chapter": "",
        "content": "제4조(공포절차) ① 세월호 선체조사위원회 회의에서 의결된 규칙은 행정예고 등의 특별한 절차를 거치는 경우를 제외하고는 의결된 후 15일 이내에 세월호 선체조사위원회 위원장이 공포절차를 취한다.② 규칙은 관보에 게재하여 공포한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:세월호선체조사위원회규칙의공포에관한규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "공포일",
        "chapter": "",
        "content": "제5조(공포일) 규칙의 공포일은 그 규칙을 게재한 관보가 발행된 날로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:세월호선체조사위원회규칙의공포에관한규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "시행일",
        "chapter": "",
        "content": "제6조(시행일) 규칙은 특별한 규정이 없으면 공포한 날부터 효력을 발생한다.",
        "enforcement_date": "",
