      {
        "article_no": "제2조",
        "article_title": "기준의 적용범위",
        "chapter": "",
        "content": "제2조(기준의 적용범위) 이 기준은 방염도료에 한하여 적용한다.",
        "enforcement_date": "",
        "relations": [],
