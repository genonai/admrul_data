\n│    │이행여부 확인?지도           ├─────────────┼─┼─┼─┼─────┤\n│    │                              │세부계획 및 현장조사      │  │  │○│기안      │\n├──┼───────────────┼─────────────┼─┼─┼─┼─────┤\n│5   │과도한 사행행위 유발의 광고   │조사계획 및 평가, 시정권고│  │○│  │기안      │\n│    │및                            ├─────────────┼─┼─┼─┼─────┤\n│    │영업행위 등에 대한 지도?감독 │세부계획 및 현장조사      │  │  │○│기안      │\n├──┼───────────────┼─────────────┼─┼─┼─┼─────┤\n│6   │과도한 사행행위에 대한 신고의 │중요사항                  │  │○│  │기안      │\n│    │처리 등에 관한 사항           ├─────────────┼─┼─┼─┼─────┤\n│    │                              │일반사항                  │  │  │○│기안      │\n├──┼───────────────┼─────────────┼─┼─┼─┼─────┤\n│7   │그 밖에 사행산업사업자의      │중요사항                  │  │○│  │기안      │\n│    │감독에 관한 사항              ├─────────────┼─┼─┼─┼─────┤\n│    │                              │일반사항                  │  │  │○│기안      │\n└──┴───────────────┴─────────────┴─┴─┴─┴─────┘\n5. 조사홍보과\n┌──┬────────────────────────────┬─┬─────────┐\n│일련│단  위  업  무  명                                      │위│기안자 및 전결권자│\n│번호│                                                        │원├─┬─┬─────┤\n│    │                                                        │장│처│과│과        │\n│    │                                                        │  │장│장│원        │\n├──┼───────────────┬────────────┼─┼─┼─┼─────┤\n│1   │사행산업 주요정책에 관한      │기본계획                │○│  │  │기안      │\n│    │대국민                        ├────────────┼─┼─┼─┼─────┤\n│    │홍보계획의 수립?조정 및 시행 │세부계획                │  │○│  │기안      │\n│    │                              ├────────────┼─┼─┼─┼─────┤\n│    │                              │계획시행                │  │  │○│기안      │\n├──┼───────────────┼────────────┼─┼─┼─┼─────┤\n│2   │사행산업 전반의 조사?연구에  │기본계획                │○│  │  │기안      │\n│    │관한 종합계획 수립            ├────────────┼─┼─┼─┼─────┤\n│    │                              │세부계획                │  │○│  │기안      │\n│    │                              ├────────────┼─┼─┼─┼─────┤\n│    │                              │계획시행                │  │  │○│기안      │\n├──┼───────────────┼────────────┼─┼─┼─┼─────┤\n│3   │사행산업 통계생산 및 관리     │중요사항                │  │○│  │기안      │\n│    │                              ├────────────┼─┼─┼─┼─────┤\n│    │                              │통계관리 및 일반사항    │  │  │○│기안      │\n├──┼───────────────┼────────────┼─┼─┼─┼─────┤\n│4   │세계 주요국가의 사행산업      │조사계획                │  │○│  │기안      │\n│    │현황 및 정책사례 조사?분석   ├────────────┼─┼─┼─┼─────┤\n│    │                              │계획시행 및 분석평가    │  │  │○│기안      │\n├──┼───────────────┼────────────┼─┼─┼─┼─────┤\n│5   │사행산업의 정보화 기반 구축   │정보화 구축 및 운영계획 │  │○│  │기안      │\n│    │                              ├────────────┼─┼─┼─┼─────┤\n│    │                              │정보화 관리             │  │  │○│기안      │\n├──┼───────────────┼────────────┼─┼─┼─┼─────┤\n│6   │사행산업 백서발간             │발간계획                │  │○│  │기안      │\n│    │                              ├────────────┼─┼─┼─┼─────┤\n│    │                              │계획시행 및 정산        │  │  │○│기안      │\n├──┼───────────────┼────────────┼─┼─┼─┼─────┤\n│7   │사행산업 관련 기관?단체      │중요사항                │  │○│  │기안      │\n│    │등과의 교류 및 협력에 관한    ├────────────┼─┼─┼─┼─────┤\n│    │사항                          │일반사항                │  │  │○│기안      │\n├──┼───────────────┼────────────┼─┼─┼─┼─────┤\n│8   │사행산업의 사회적 인식전환    │기본계획                │○│  │  │기안      │\n│    │대책 수립                     ├────────────┼─┼─┼─┼─────┤\n│    │                              │세부계획                │  │○│  │기안      │\n│    │                              ├────────────┼─┼─┼─┼─────┤\n│    │                              │계획시행 및 추진관리    │  │  │○│기안      │\n├──┼───────────────┼────────────┼─┼─┼─┼─────┤\n│9   │언론취재 지원 및 브리핑에     │중요사항                │○│  │  │기안      │\n│    │관한 사항                     ├────────────┼─┼─┼─┼─────┤\n│    │                              │일반사항                │  │  │○│기안      │\n└──┴───────────────┴────────────┴─┴─┴─┴─────┘\n6. 불법사행산업 감시신고센터\n┌──┬─────────────────────────────┬─┬─────────┐\n│일련│단  위  업  무  명                                        │위│기안자 및 전결권자│\n│번호│                                                          │원├─┬─┬─────┤\n│    │                                                          │장│처│센│과        │\n│    │                                                          │  │장│터│원        │\n│    │                                                          │  │  │장│          │\n├──┼──────────────┬──────────────┼─┼─┼─┼─────┤\n│1   │불법사행산업 근절 대책 및   │기본계획                    │○│  │  │기안      │\n│    │제도개선 수립               ├──────────────┼─┼─┼─┼─────┤\n│    │                            │세부계획                    │  │○│  │기안      │\n│    │                            ├──────────────┼─┼─┼─┼─────┤\n│    │                            │계획시행 및 관리            │  │  │○│기안      │\n│    │                            ├──────────────┼─┼─┼─┼─────┤\n│    │                            │제도평가                    │  │  │○│기안      │\n├──┼──────────────┼──────────────┼─┼─┼─┼─────┤\n│2   │불법사행산업에 대한         │현장감시 여부 및 현장 확인  │  │  │○│기안      │\n│    │감시?고발  및 수사의뢰에   ├──────────────┼─┼─┼─┼─────┤\n│    │관한 사항                   │수사기관에 고발 및 수사의뢰 │  │  │○│기안      │\n├──┼──────────────┼──────────────┼─┼─┼─┼─────┤\n│3   │불법사행산업 신고 접수      │중요사항                    │  │○│  │기안      │\n│    │처리에 관한 사항            ├──────────────┼─┼─┼─┼─────┤\n│    │                            │일반사항                    │  │  │○│기안      │\n├──┼──────────────┼──────────────┼─┼─┼─┼─────┤\n│4   │불법도박사이트 모니터링에   │중요사항                    │  │○│  │기안      │\n│    │관한 사항                   ├──────────────┼─┼─┼─┼─────┤\n│    │                            │일반사항                    │  │  │○│기안      │\n├──┼──────────────┼──────────────┼─┼─┼─┼─────┤\n│5   │수사기관 등 불법사행산업    │중요사항                    │  │○│  │기안      │\n│    │관련 유관기관 업무 협력에   ├──────────────┼─┼─┼─┼─────┤\n│    │관한 사항                   │일반사항                    │  │  │○│기안      │\n├──┼──────────────┼──────────────┼─┼─┼─┼─────┤\n│6   │불법사행