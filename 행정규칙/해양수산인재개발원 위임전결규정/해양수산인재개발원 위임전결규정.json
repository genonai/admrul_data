      "content": "【별 표】\n1. 공통사항\n┌───┬──────────────────────────┬──┬──┬───────┐\n│번호  │단  위  업  무                                      │원장│과장│담당자        │\n│      │                                                    │    │    ├───┬───┤\n│      │                                                    │    │    │담 당 │실 무 │\n├───┼────────┬─────────────────┼──┼──┼───┼───┤\n│1     │주요업무계획    │주요 업무계획의 수립 및 조정      │○  │    │기안  │      │\n│      │                ├─────────────────┼──┼──┼───┼───┤\n│      │                │세부 집행계획 수립                │    │○  │      │기안  │\n├───┼────────┼─────────────────┼──┼──┼───┼───┤\n│2     │지시사항의 처리 │차관이상 지시사항                 │○  │    │기안  │기안  │\n│      │                ├─────────────────┼──┼──┼───┼───┤\n│      │                │원장 지시사항                     │○  │    │      │기안  │\n│      │                ├─────────────────┼──┼──┼───┼───┤\n│      │                │기타 지시사항(훈시 등)            │    │    │○    │기안  │\n├───┼────────┼─────────────────┼──┼──┼───┼───┤\n│3     │법령 및 제도    │법령 및 제도의 개선               │○  │    │기안  │      │\n│      │                ├─────────────────┼──┼──┼───┼───┤\n│      │                │법령 및 제도의 운영               │    │○  │      │기안  │\n├───┼────────┼─────────────────┼──┼──┼───┼───┤\n│4     │훈령ㆍ예규 등   │제ㆍ개정 및 폐지                  │○  │    │      │기안  │\n│      │                ├─────────────────┼──┼──┼───┼───┤\n│      │                │중요사항의 해석ㆍ질의응답         │    │○  │기안  │      │\n│      │                ├─────────────────┼──┼──┼───┼───┤\n│      │                │일반사항의 해석ㆍ질의응답         │    │    │○    │기안  │\n├───┼────────┴─────────────────┼──┼──┼───┼───┤\n│5     │각종 고시 및 공고사항                               │○  │    │      │기안  │\n├───┼────────┬─────────────────┼──┼──┼───┼───┤\n│6     │민원사무처리    │중요사항                          │○  │    │기안  │      │\n│      │                ├─────────────────┼──┼──┼───┼───┤\n│      │                │일반사항                          │    │○  │      │기안  │\n│      │                ├─────────────────┼──┼──┼───┼───┤\n│      │                │경미사항                          │    │    │○    │기안  │\n├───┼────────┼──┬──────────────┼──┼──┼───┼───┤\n│7     │출장 등 복무관리│국내│5급이상                     │○  │    │      │기안  │\n│      │                │    ├──────────────┼──┼──┼───┼───┤\n│      │                │    │6급이하                     │    │○  │      │기안  │\n│      │                ├──┴──────────────┼──┼──┼───┼───┤\n│      │                │국외출장                          │○  │    │      │기안  │\n├───┼────────┴─────────────────┼──┼──┼───┼───┤\n│8     │직원사무분장                                        │    │○  │      │기안  │\n├───┼────────┬─────────────────┼──┼──┼───┼───┤\n│9     │각종 정기보고   │중요사항(장ㆍ차관 및 국회의원 등) │○  │    │      │기안  │\n│      │                ├─────────────────┼──┼──┼───┼───┤\n│      │                │일반 및 경미사항                  │    │○  │      │기안  │\n└───┴────────┴─────────────────┴──┴──┴───┴───┘\n┌──┬──────────────────────┬──┬──┬───────┐\n│번호│단  위  업  무                              │원장│과장│담당자        │\n│    │                                            │    │    ├───┬───┤\n│    │                                            │    │    │담 당 │실 무 │\n├──┼────────┬─────────────┼──┼──┼───┼───┤\n│10  │행정 간행물 관리│발간 계획의 수립          │○  │    │      │기안  │\n│    │                ├─────────────┼──┼──┼───┼───┤\n│    │                │수집 및 배포              │    │○  │      │기안  │\n│    │                ├─────────────┼──┼──┼───┼───┤\n│    │                │폐기                      │    │    │○    │기안  │\n├──┼────────┼─────────────┼──┼──┼───┼───┤\n│11  │행사 및 회의    │중요사항(외부인사 초청 등)│○  │    │      │기안  │\n│    │                ├─────────────┼──┼──┼───┼───┤\n│    │                │일반사항                  │    │○  │      │기안  │\n├──┼────────┴─────────────┼──┼──┼───┼───┤\n│12  │감사원 및 본부 감사결과 처리                │○  │    │기안  │      │\n├──┼────────┬─────────────┼──┼──┼───┼───┤\n│13  │본부, 국회 자료 │중요사항                  │○  │    │      │기안  │\n│    │제출            ├─────────────┼──┼──┼───┼───┤\n│    │                │일반사항                  │    │○  │      │기안  │\n│    │                ├─────────────┼──┼──┼───┼───┤\n│    │                │경미사항(단순 자료협조 등)│    │    │○    │기안  │\n├──┼────────┼─────────────┼──┼──┼───┼───┤\n│14  │각종 위원회     │원장이 위원장인 경우      │○  │    │기안  │      │\n│    │위원의 위ㆍ해촉 ├─────────────┼──┼──┼───┼───┤\n│    │및              │과장이 위원장인 경우      │    │○  │      │기안  │\n│    │의안 상정ㆍ집행 │                          │    │    │      │      │\n├──┼────────┼─────────────┼──┼──┼───┼───┤\n│15  │정보공개        │중요사항                  │○  │    │      │기안  │\n│    │                ├─────────────┼──┼──┼───┼───┤\n│    │                │일반사항                  │    │○  │      │기안  │\n├──┼────────┼─────────────┼──┼──┼───┼───┤\n│16  │기록물 관리     │기록물 관련지침의 수립    │    │○  │      │기안  │\n│    │                ├─────────────┼──┼──┼───┼───┤\n│    │                │기록물 분류 및 보존ㆍ보관 │    │○  │      │기안  │\n│    │                ├─────────────┼──┼──┼───┼───┤\n│    │                │문서수발ㆍ경유 및 심사    │    │    │○    │기안  │\n├──┼────────┴─────────────┼──┼──┼───┼───┤\n│17  │인쇄 및 물품 조달 요구                      │    │○  │      │기안  │\n└──┴──────────────────────┴──┴──┴───┴───┘\n┌──┬───────────────────────┬──┬──┬───────┐\n│번호│단  위  업  무                                │원장│과장│담당자        │\n│    │                                              │    │    ├───┬───┤\n│    │                                              │    │    │담 당 │실 무 │\n├──┼─────────┬─────────────┼──┼──┼───┼───┤\n│18  │책임운영기관 관련 │책인운영기관 운영 및 사업 │○  │    │      │기안  │\n│    │업무              │계획수립(소관사항)        │    │    │      │      │\n│    │                  ├─────────────┼──┼──┼───┼───┤\n│    │                  │책임운영기관 종합평가 관  │    │○  │      │기안  │\n│    │                  │련사항(소관사항)          │    │    │      │      │\n│    │                  ├─────────────┼──┼──┼───┼───┤\n│    │                  │기타 책임운영기관 일반사항│    │    │○    │기안  │\n│    │                  │(소관사항)                │    │    │      │      │\n├──┼─────────┼─────────────┼──┼──┼───┼───┤\n│19  │조직혁신 및 성과  │조직목표 및 성과관리      │○  │    │      │기안  │\n│    │관리              │                          │    │    │      │      │\n├──┼─────────┼─────────────┼──┼──┼───┼───┤\n│20  │홍보업무          │홍보자료 작성 및 배포     │    │○  │      │기안  │\n└──┴─────────┴─────────────┴──┴──┴───┴───┘\n2. 교육지원과\n┌──┬──────────────────────────┬──┬──┬───────┐\n│번호│단  위  업  무                                      │원장│과장│담당자        │\n│    │                                                    │    │    ├───┬───┤\n│    │                                                    │    │    │담 당 │실 무 │\n├──┼─────────┬────────────────┼──┼──┼───┼───┤\n│1   │조직 및 정원 관리 │직제개편 기본방침               │○  │    │기안  │      │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │정원 요구ㆍ배정ㆍ조정 등        │○  │    │기안  │      │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │직제개정 및 기능조정 방안       │○  │    │기안  │      │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │직제(조직, 정원) 일반사항       │    │○  │      │기안  │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │직제 자료요구 및 업무협조       │    │    │○    │기안  │\n├──┼─────────┼────────────────┼──┼──┼───┼───┤\n│2   │직무성과계약      │운영계획의 수립 및 평가         │○  │    │      │기안  │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │평가 관련자료 수집              │    │○  │      │기안  │\n├──┼─────────┼────────────────┼──┼──┼───┼───┤\n│3   │공직기강 및       │추진계획의 수립                 │○  │    │      │기안  │\n│    │부패 방지         ├────────────────┼──┼──┼───┼───┤\n│    │                  │추진실적 평가 및 보고           │    │○  │      │기안  │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │비위에 관한 사항 처리           │○  │    │      │기안  │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │공직자 재산등록                 │    │○  │      │기안  │\n├──┼─────────┼────────────────┼──┼──┼───┼───┤\n│4   │보안 및 비상계획  │보안업무시행ㆍ자체충무계획 수립 │○  │    │      │기안  │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │보안감사 수감                   │○  │    │      │기안  │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │직원비상소집 및 결과보고        │○  │    │      │기안  │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │비밀문서(Ⅱ, Ⅲ) 발간 통제      │○  │    │      │기안  │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │비밀취급인가 및 해제            │○  │    │      │기안  │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │음어자재관리 및 수령ㆍ반납      │    │○  │      │기안  │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │기타 보안에 관한 사항           │    │    │○    │기안  │\n├──┼─────────┼────────────────┼──┼──┼───┼───┤\n│5   │사무관리          │관인관리(등록ㆍ폐기)            │○  │    │      │기안  │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │행정정보공개 운영관리           │    │○  │      │기안  │\n├──┼─────────┼────────────────┼──┼──┼───┼───┤\n│6   │직장상조회 관리   │운영위원회 개최 및 결과보고     │○  │    │기안  │      │\n│    │                  ├────────────────┼──┼──┼───┼───┤\n│    │                  │상조금 모급 및 집행             │    │○  │      │기안  │\n└──┴─────────┴────────────────┴──┴──┴───┴───┘\n┌──┬─────────────────────────────┬──┬──┬───────┐\n│번호│단  위  업  무                                            │원장│과장│담  당 자     │\n│    │                                                          │    │    ├───┬───┤\n│    │                                                          │    │    │담 당 │실 무 │\n├──┼──────┬──────────────────────┼──┼──┼───┼───┤\n│7   │제안제도    │중요사항                                    │○  │    │      │기안  │\n│    │            ├──────────────────────┼──┼──┼───┼───┤\n│    │            │일반사항                                    │    │○  │      │기안  │\n├──┼──────┼──────────────────────┼──┼──┼───┼───┤\n│8   │상훈        │공무원 포상계획 수립 및 집행                │○  │    │기안  │      │\n│    │ㆍ          ├──────────────────────┼──┼──┼───┼───┤\n│    │징계        │공무원 포상대상자 추천                      │○  │    │      │기안  │\n│    │            ├──────────────────────┼──┼──┼───┼───┤\n│    │            │6급이하 공무원의 징계 및 소청               │○  │    │      │기안  │\n│    │            ├──────────────────────┼──┼──┼───┼───┤\n│    │            │6급이하 공무원 징계기록 말소                │    │○  │      │기안  │\n├──┼──────┼──────────────────────┼──┼──┼───┼───┤\n│9   │교육        │5급이상 공무원 교육훈련계획 및 파견         │○  │    │기안  │      │\n│    │ㆍ          ├──────────────────────┼──┼──┼───┼───┤\n│    │훈련        │6급이하 공무원 교육훈련계획 및 파견         │    │○  │      │기안  │\n│    │            ├──────────────────────┼──┼──┼───┼───┤\n│    │            │직장교육 기본계획의 수립                    │○  │    │      │기안  │\n│    │            ├──────────────────────┼──┼──┼───┼───┤\n│    │            │직장교육 실시                               │    │○  │      │기안  │\n├──┼──────┴──────────────────────┼──┼──┼───┼───┤\n│10  │ 소방계획의 수립ㆍ시행                                    │○  │    │      │기안  │\n├──┼─────────────────────────────┼──┼──┼───┼───┤\n│11  │ 각종 출입증 발급                                         │    │    │○    │기안  │\n├──┼─────────────────────────────┼──┼──┼───┼───┤\n│12  │ 당직근무 명령                                            │    │○  │      │기안  │\n├──┼─────────────────────────────┼──┼──┼───┼───┤\n│13  │ 비상연락망 정비                                          │    │    │○    │기안  │\n├──┼─────────────────────────────┼──┼──┼───┼───┤\n│14  │ 각종 행사시 인력 동원                                    │    │○  │      │기안  │\n├──┼─────────────────────────────┼──┼──┼───┼───┤\n│15  │ 직원 후생 및 복지                                        │    │○  │      │기안  │\n├──┼─────────────────────────────┼──┼──┼───┼───┤\n│16  │연금, 대부 및 건강보험관리                                │    │    │○    │기안  │\n├──┼──────┬──────────────────────┼──┼──┼───┼───┤\n│17  │근무평정 및 │공무원 근무성적 평정에 관한 사항     