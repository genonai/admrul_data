    {
      "no": "0002",
      "branch": "00",
      "kind": "별지",
      "title": "잔류조사 대장",
      "enforcement_date": "",
      "content": "[별지 제2호서식]\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n┃                                                                                      ┃\n┃                                                                                      ┃\n┃  잔류조사 대장                                                                       ┃\n┃                                                                                      ┃\n┃                                                                                      ┃\n┃━━━┳━━┳━━┳━━━┳━━━┳━━━━━┳━━━━━━━━━━━┳━━┳━━━━┃\n┃  일련┃시료┃품명┃규격  ┃생산지┃수거      ┃검사                  ┃판정┃비 고   ┃\n┃  번호┃번호┃    ┃및    ┃(해역)┣━━┳━━╋━━┳━━┳━━┳━━┫    ┃        ┃\n┃      ┃    ┃    ┃수량  ┃      ┃일자┃장소┃의뢰┃항목┃완료┃결과┃    ┃        ┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃일자┃    ┃일자┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━╋━━╋━━╋━━━╋━━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━╋━━━━┃\n┃      ┃    ┃    ┃      ┃      ┃    ┃    ┃    ┃    ┃    ┃    ┃    ┃        ┃\n┃━━━┻━━┻━━┻━━━┻━━━┻━━┻━━┻━━┻━━┻━━┻━━┻━━┻━━━━┃\n┃  210mm×297mm[일반용지 60g/㎡(재활용품)]                                             ┃\n┃                                                                                      ┃\n┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛",
