  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 울산지방해양항만청(이하\"우리청〃이라 한다) 보유 공용차량의 효율적인 관리운영에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산지방해양항만청공용차량관리운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 이 규정은 우리청이 관리·운행하는 모든 차량에 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산지방해양항만청공용차량관리운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "이용범위",
        "chapter": "",
        "content": "제3조(이용범위) 공용차량은 우리청 모든 직원이 공용업무로 이용할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산지방해양항만청공용차량관리운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "관리책임자 지정",
        "chapter": "",
        "content": "제4조(관리책임자 지정) 공용차량의 관리책임자는 운영지원과장으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산지방해양항만청공용차량관리운영규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "운행범위",
        "chapter": "",
        "content": "제5조(운행범위) 공용차량은 다음 각호의 경우에 사용할 수 있으며 사적 목적으로 이용할 수 없다.1. 공식적인 행사에 참석하는 경우2. 업무와 관련하여 청사 밖으로 나가는 경우3. 동호회 모임 활성화를 위한 행사 지원4. 기타 공용차량의 관리에 지장이 없고 관리책임자가 인정하는 경우",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산지방해양항만청공용차량관리운영규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "이용절차",
        "chapter": "",
        "content": "제6조 (이용절차) ①공용차량을 이용하고자 하는자는 차량의 관리책임자로부터 사전에 승인받은 후 사용하여야 한다. 단, 긴급히 차량을 사용한 경우에는 사후에 보고를 하여야 한다.②청장은 정부의 에너지 수급 상황 등을 고려하여 필요한 경우에 공용차량의 운행을 제한할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산지방해양항만청공용차량관리운영규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "차량운행일지 작성",
        "chapter": "",
        "content": "제7조 (차량운행일지 작성) ①공용차량을 운행하는 자는 차량일지에 이를 기록 유지하여야 한다② 공용차량 차량일지 정리는 운영지원과 차량관리 담당자로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산지방해양항만청공용차량관리운영규정#JO0007"
      }
    ]
  },
