      "content": "<수용·사용할 토지의 권리명세서 : 광탄관리소>\n┌─┬───┬───┬─┬───────┬─────────────┬───────────┬──┐\n│번│소재지│지 번 │지│지 적(㎡)     │토 지 소 유 자            │관 계 인              │비고│\n│호│      │      │목├───┬───┼───┬─────────┼───┬───┬───┤    │\n│  │      │      │  │공부상│편입  │성 명 │주 소             │성 명 │주 소 │내 용 │    │\n│  │      │      │  │면적  │면적  │(명칭)│                  │(명칭)│      │      │    │\n├─┼───┼───┼─┼───┼───┼───┼─────────┼───┼───┼───┼──┤\n│1 │경기도│166-1 │답│1,505 │1,505 │윤경영│경기도 파주시     │      │      │      │    │\n│  │파주시│      │  │      │      │      │광탄면 발랑리 184 │      │      │      │    │\n├─┤광탄면├───┼─┼───┼───┼───┼─────────┼───┼───┼───┼──┤\n│2 │발랑리│166-11│답│1,653 │1,653 │윤경영│경기도 파주시     │      │      │      │    │\n│  │      │      │  │      │      │      │광탄면 발랑리 184 │      │      │      │    │\n└─┴───┴───┴─┴───┴───┴───┴─────────┴───┴───┴───┴──┘\n┌─┬───┬───┬─┬───────┬────────────┬────────────────────┬─┐\n│번│소재지│지 번 │지│지 적(㎡)     │토 지 소 유 자          │관 계 인                                │비│\n│호│      │      │목├───┬───┼───┬────────┼────┬──────┬────────┤고│\n│  │      │      │  │공부상│편입  │성 명 │주 소           │성 명   │주 소       │내 용           │  │\n│  │      │      │  │면적  │면적  │(명칭)│                │(명칭)  │            │                │  │\n├─┼───┼───┼─┼───┼───┼───┼────────┼────┼──────┼────────┼─┤\n│3 │경기도│166-3 │답│4,255 │4,255 │소정례│경기도 고양시   │일산농업│경기도      │근저당권        │  │\n│  │파주시│      │  │      │      │      │일산서구 일중로 │협동조합│고양시      │채권최고액      │  │\n│  │광탄면│      │  │      │      │      │30, 507동       │        │일산서구    │금390,000,000   │  │\n│  │발랑리│      │  │      │      │      │404호(일산동,   │        │일청로      │원              │  │\n│  │      │      │  │      │      │      │산들마을)       │        │30(일산동)  │채무자 소정례   │  │\n│  │      │      │  │      │      │      │                │        │(산들지점)  │                │  │\n│  │      │      │  │      │      │      │                │        │            │지상권          │  │\n│  │      │      │  │      │      │      │                │        │            │목적:건물 기타  │  │\n│  │      │      │  │      │      │      │                │        │            │공작물이나      │  │\n│  │      │      │  │      │      │      │                │        │            │수목의 소유     │  │\n│  │      │      │  │      │      │      │                │        │            │범위:토지의     │  │\n│  │      │      │  │      │      │      │                │        │            │전부            │  │\n│  │      │      │  │      │      │      │                │        │            │존속기간:설정   │  │\n│  │      │      │  │      │      │      │                │        │            │등기일로부터30  │  │\n│  │      │      │  │      │      │      │                │        │            │년              │  │\n│  │      │      │  │      │      │      │                │        │            │자료:없음       │  │\n├─┴───┼───┼─┼───┼───┼───┼────────┼────┼──────┼────────┼─┤\n│합 계     │3필지 │  │7,413 │7,413 │      │                │        │            │                │  │\n└─────┴───┴─┴───┴───┴───┴────────┴────┴──────┴────────┴─┘",
