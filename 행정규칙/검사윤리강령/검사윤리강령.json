    "articles": [
      {
        "article_no": "제1조",
        "article_title": "사명",
        "chapter": "",
        "content": "제1조(사명) 검사는 공익의 대표자로서 국법질서를 확립하고 국민의 인권을 보호하며 정의를 실현함을 그 사명으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검사윤리강령#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "국민에 대한 봉사",
        "chapter": "",
        "content": "제2조(국민에 대한 봉사) 검사는 직무상의 권한이 국민으로부터 위임된 것임을 명심하여 성실하고 겸손한 자세로 국민에게 봉사한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검사윤리강령#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "정치적 중립과 공정",
        "chapter": "",
        "content": "제3조(정치적 중립과 공정) ① 검사는 정치 운동에 관여하지 아니하며, 직무 수행을 할 때 정치적 중립을 지킨다.②검사는 피의자나 피해자, 기타 사건 관계인에 대하여 정당한 이유 없이 차별 대우를 하지 아니하며 어떠한 압력이나 유혹, 정실에도 영향을 받지 아니하고 오로지 법과 양심에 따라 엄정하고 공평하게 직무를 수행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검사윤리강령#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "청렴과 명예",
        "chapter": "",
        "content": "제4조(청렴과 명예) 검사는 공·사생활에서 높은 도덕성과 청렴성을 유지하고, 명예롭고 품위 있게 행동한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검사윤리강령#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "자기계발",
        "chapter": "",
        "content": "제5조(자기계발) 검사는 변화하는 사회현상을 직시하고 높은 식견과 시대가 요구하는 새로운 지식을 쌓아 직무를 수행함에 부족함이 없도록 하기 위하여 끊임없이 자기계발에 노력한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검사윤리강령#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "인권보장과 적법절차의 준수",
        "chapter": "",
        "content": "제6조(인권보장과 적법절차의 준수) 검사는 피의자·피고인, 피해자 기타 사건 관계인의 인권을 보장하고 헌법과 법령에 규정된 절차를 준수한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검사윤리강령#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "검찰권의 적정한 행사",
        "chapter": "",
        "content": "제7조(검찰권의 적정한 행사) 검사는 적법한 절차에 의하여 증거를 수집하고 법령의 정당한 적용을 통하여 공소권이 남용되지 않도록 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:검사윤리강령#JO0007"
      },
