  "addenda": [
    {
      "promulgation_date": "20050627",
      "promulgation_no": "590",
      "content": "부   칙(2005. 6. 27. 제590호)이 예규는 2005.  7.  4.부터 시행한다."
    },
    {
      "promulgation_date": "20090529",
      "promulgation_no": "816",
      "content": "부   칙(2009. 5. 29. 제816호)이 예규는 2009년 5월 29일부터 시행한다."
    },
    {
      "promulgation_date": "20140807",
      "promulgation_no": "1024",
      "content": "부   칙(2014. 8. 7. 제1024호)이 예규는 2014년 9월 1일부터 시행한다."
    },
    {
      "promulgation_date": "20191129",
      "promulgation_no": "1201",
      "content": "부   칙(2019. 11. 29. 제1201호)이 예규는 2019년 12월 5일부터 시행한다."
    },
    {
      "promulgation_date": "20220808",
      "promulgation_no": "1311",
      "content": "부   칙(2022. 8. 8. 제1311호)이 예규는 2022년 8월 9일부터 시행한다."
    },
    {
      "promulgation_date": "99991231",
      "promulgation_no": "9999",
      "content": "부   칙제1조(시행일자) 이 예규는 2003. 2. 10. 부터 시행한다.제2조(폐지예규) 집행관의수수료기타비용예납금의관리및정산에따른잔액환급절차에관한예규(행정예규 제367호)는 이를 폐지한다.제3조(경과조치) 「정보처리시스템에 의한 집행관 사무처리규칙」에 따라 지정집행관사무소로 지정되기 이전에 접수된 사건에 대하여는 종전 규정에 의하여 처리한다."
    }
  ],
