산화아연+칼라민)           │                        │          │      │                      │      │      │    │\n├─┤수렴,   ├──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│6 │소염제  │Hydrocortisone 1% cream     │제이알히드로코르티손    │cream     │15g   │allergy               │4     │-     │    │\n│  │        │(히드로코르티손 1% 크림)    │연고 1%                 │크림      │      │skin inflammation     │      │      │    │\n│  │        │                            │                        │          │      │알레르기/             │      │      │    │\n│  │        │                            │                        │          │      │염증성피부질환        │      │      │    │\n├─┤        ├──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│7 │        │Betamethasone               │Celestone-G Cream       │cream     │15g   │allergy               │2     │1     │    │\n│  │        │Valerate + Gentamicin       │쎄레스톤지크림,         │크림      │      │skin inflammation     │      │      │    │\n│  │        │Sulfate                     │베타덤지크림            │          │      │알레르기/             │      │      │    │\n│  │        │(베타메타손발레레이트       │                        │          │      │염증성피부질환        │      │      │    │\n│  │        │+겐타마이신 황산염)         │                        │          │      │                      │      │      │    │\n├─┼────┼──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│8 │국소    │Mupirocin (무피로신)        │에스로반 연고           │oint      │10g   │minor skin infection  │5     │2     │    │\n│  │항생제  │또는 Fusidic Acic(후시딘산) │또는 후시딘 연고        │연고      │      │경증 피부 감염        │      │      │    │\n├─┼────┼──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│9 │기관지  │Salbutamol aerosol          │Albuterol, Ventolinⓡ   │evohaler  │200회/│asthma 천식           │1     │-     │    │\n│  │확장제  │(살부타몰 에어로졸)         │evohaler                │에보할러  │통    │bronchitis 기관지염   │      │      │    │\n│  │        │                            │(벤토린 에보할러)       │          │      │emphysema 폐기종      │      │      │    │\n├─┼────┼──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│10│비충혈  │Oxymetazoline 0.5%          │Drixineⓡ               │nasal     │15ml  │nasal obstruction     │2     │-     │    │\n│  │제거제  │nasal drop                  │레스피비엔액,           │drop      │      │코막힘                │      │      │    │\n│  │        │(옥시메타졸린 비액)         │옥시졸나잘액            │비액      │      │sinusitis 부비동염    │      │      │    │\n├─┼────┼──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│11│세정제  │Sodium chloride 0.9%        │크린조                  │bot       │1L    │sterile eye irrigation│1     │1     │    │\n│  │        │solution                    │                        │병        │      │오염된 눈의 세척      │      │      │    │\n│  │        │(염화나트륨 0.9% 용액)      │                        │          │      │                      │      │      │    │\n├─┼────┼──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│12│소독제  │Ethanol 70%,                │에탄올(알코올)손소독제  │gel       │70%   │hand cleaning         │1     │1     │    │\n│  │        │hand cleanser gel           │                        │겔        │500mL │손소독                │      │      │    │\n│  │        │(에탄올 손소독제)           │                        │          │      │                      │      │      │    │\n├─┤        ├──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│13│        │Ethanol 70%, liquid         │소독용에탄올(알코올)    │liq       │70%   │disinfect instruments │1     │-     │    │\n│  │        │(70% 알코올 용액)           │용액                    │용액      │500mL │의료기구 소독         │      │      │    │\n├─┤        ├──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│14│        │Povidone iodine 10%         │Betadineⓡ, Povidineⓡ, │liq       │50mL  │disinfect             │2     │1     │    │\n│  │        │ointment, solution          │베타딘액, 포타딘연고    │용액      │      │skin/wounds           │      │      │    │\n├─┤        │(포비돈 요오드 10%          │                        ├─────┼───┤피부 및 상처소독      ├───┼───┼──┤\n│15│        │연고, 용액)                 │                        │oint      │450g  │                      │1     │-     │    │\n│  │        │                            │                        │연고      │      │                      │      │      │    │\n├─┼────┼──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│16│안과용  │Proparacaine eye drop       │Alcaineⓡ, Diocaineⓡ   │tube      │0.8mL │local anesthesis      │20    │-     │    │\n│  │국소    │(프로파라카인 점안액)       │파라카인 점안액         │튜브      │      │for eye               │      │      │    │\n│  │마취제  │                            │                        │          │      │안과용                │      │      │    │\n│  │        │                            │                        │          │      │국소마취제            │      │      │    │\n├─┼────┼──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│17│안과용  │Ofloxacin eye oint          │에펙신안연고            │eye oint  │3.5g  │minor eye infections  │2     │1     │    │\n│  │항염제  │or Dexamethasone +          │포러스안연고            │안연고    │      │경증 눈의 감염        │      │      │    │\n│  │        │Neomycin Sulfate +          │                        │          │      │                      │      │      │    │\n│  │        │Polymyxin B Sulfate         │                        │          │      │                      │      │      │    │\n│  │        │eye oint                    │                        │          │      │                      │      │      │    │\n│  │        │(오플록사신안연고           │                        │          │      │                      │      │      │    │\n│  │        │또는 덱사메타손 +           │                        │          │      │                      │      │      │    │\n│  │        │네오마이신 황산염 +         │                        │          │      │                      │      │      │    │\n│  │        │폴리마이신 비 황산염        │                        │          │      │                      │      │      │    │\n│  │        │안연고)                     │                        │          │      │                      │      │      │    │\n├─┤        ├──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│18│        │fluorometholone             │옵티브이점안액0.1%      │bot       │5mg/  │ocular inflammation   │2     │-     │    │\n│  │        │(플루오로메톨론)            │                        │병        │5mL   │눈의 염증성 질환      │      │      │    │\n├─┼────┼──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│19│안과용  │levofloxacin                │레복사신점안액          │bot       │75mg/ │minor eye infections  │2     │-     │    │\n│  │항생제  │(레보플록사신)              │                        │병        │5mL   │경증 눈의 감염        │      │      │    │\n├─┼────┼──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│20│이비과용│ofloxacin                   │에펙신이용액            │bot       │15mg/ │otic infection        │2     │-     │    │\n│  │항생제  │(오플록사신)                │                        │병        │5mL   │귀의 감염증           │      │      │    │\n├─┼────┼──────────────┼────────────┼─────┼───┼───────────┼───┼───┼──┤\n│21│피부    │Petroleum jelly             │Vaseline                │oint      │100g  │treat chapped skin    │3     │-     │    │\n│  │보호제  │광유                        │바셀린                  │연고      │      │피부 보습             │      │      │    │\n└─┴────┴──────────────┴────────────┴─────┴───┴───────────┴───┴───┴──┘\n\n비고\n가. 위 별표에서 규정하는 비치기준은 성분명을 기준으로 하며, 병기된 상품명은 해당 성분이 포함된 의약품의\n예시이다.\n나. 위 별표에서 규정하는 비치기준은 20명의 승선인원이 3개월(90일)의 항행기간 동안 선박에서 사용할 수\n있는 품목과 수량을 기본으로 한다.\n다. 다만, 항행시간이 24시간 이내인 국제선의 경우에는 국내선 비치기준에 따라 의약품을 갖추어 둘 수 있다.\n라. 선박에 승선하는 승선인원이 나목에 따른 기준과 다를 경우에는 승선인원의 비례에 따라 환산하여 비치\n수량을 더하거나 뺀다. 이 경우 소수점 이하는 올림하여 계산한다.\n마. 선박소유자는 출항 전에 규정하는 수량의 1/2에 미치지 못할 때에는 의약품을 보충해야 한다.\n바. 위 별표에서 규정하는 성분명 이외에도, 의사ㆍ치과의사의 처방전 없이 구매할 수 있는 일반의약품 또는\n의약외품을 선내에 갖추어 둘 수 있다.\n",
