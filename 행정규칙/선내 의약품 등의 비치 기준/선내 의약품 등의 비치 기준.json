독      │      │      │        │\n├─┼────┼────────────┼──────────────┼───┼───┼────────────┼───┼───┼────┤\n│11│천식 및 │Adrenaline              │epinephrine                 │amp   │1mg/1 │anaphylaxis             │10    │5     │        │\n│  │만성폐  │(아드레날린)            │에피네프린 주사액           │앰플  │mL    │과민성쇼크 시 혈압      │      │      │        │\n│  │쇄성    │                        │                            │      │      │상승과                  │      │      │        │\n│  │폐질환  │                        │                            │      │      │기도 확장               │      │      │        │\n│  │치료    │                        │                            │      │      │                        │      │      │        │\n│  │혈관    │                        │                            │      │      │                        │      │      │        │\n│  │수축제  │                        │                            │      │      │                        │      │      │        │\n├─┼────┼────────────┼──────────────┼───┼───┼────────────┼───┼───┼────┤\n│12│항생제, │Ceftriaxone             │Rocephinⓡ 로세핀주,        │vial  │2 g   │infections              │15    │-     │        │\n│  │항화학  │(세프트리악손)          │트리악손주                  │바이알│      │감염                    │      │      │        │\n│  │요법제  │                        │                            │      │      │                        │      │      │        │\n├─┼────┼────────────┼──────────────┼───┼───┼────────────┼───┼───┼────┤\n│13│항정신  │Haloperidol             │Haldolⓡ                    │amp   │5mg/1 │psychosis               │5     │-     │        │\n│  │용제    │(할로페리돌)            │할로페리돌주                │앰플  │mL    │severe agitation        │      │      │        │\n│  │        │                        │                            │      │      │환각/중증 동요          │      │      │        │\n├─┼────┼────────────┼──────────────┼───┼───┼────────────┼───┼───┼────┤\n│14│진통제  │Diclofenan              │디클로페낙주                │amp   │75mg/ │inflammation, severe    │20    │5     │        │\n│  │        │(디클로페낙)            │                            │앰플  │2mL   │pain, fever             │      │      │        │\n│  │        │                        │                            │      │      │소염, 진통(중증통증),   │      │      │        │\n│  │        │                        │                            │      │      │해열                    │      │      │        │\n├─┼────┼────────────┼──────────────┼───┼───┼────────────┼───┼───┼────┤\n│15│중독    │Fomepizole              │포메피졸 주사               │vial  │1.5g/ │methanol poisoning      │2     │1     │메탄올  │\n│  │치료제  │(포메피졸)              │                            │바이알│1.5ml │메탄올 중독             │      │      │취급    │\n│  │        │                        │                            │      │      │                        │      │      │선박에  │\n│  │        │                        │                            │      │      │                        │      │      │한정함  │\n└─┴────┴────────────┴──────────────┴───┴───┴────────────┴───┴───┴────┘\n\n□ 제2호 내용약(Internal medicines)\n┌─┬────┬─────────────┬────────────┬────┬────┬───────────┬───────┬────┐\n│번│분류    │성분명                    │상품명, 별칭            │제형    │함량    │효능ㆍ효과            │비치기준      │비고    │\n│호│        │                          │                        │        │        │                      ┝━━━┯━━━┥        │\n│  │        │                          │                        │        │        │                      │국제선│국내선│        │\n┝━┿━━━━┿━━━━━━━━━━━━━┿━━━━━━━━━━━━┿━━━━┿━━━━┿━━━━━━━━━━━┿━━━┿━━━┿━━━━┥\n│1 │전해질  │Oral rehydration salts    │Repolyteⓡ,             │liquid  │125mL   │dehydration due to    │50    │10    │        │\n│  │보급제  │(경구용 전해질 보급제)    │링거라이트 액           │액상    │        │diarrhea              │      │      │        │\n│  │        │                          │                        │        │        │설사로 인한 탈수      │      │      │        │\n├─┼────┼─────────────┼────────────┼────┼────┼────────