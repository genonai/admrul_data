────────┼──┼──┼──┼──┼──┨\n┃  │              │사. 적정진료(의료질, 환자안전, 고객만족,      │    │    │    │    │○  ┃\n┃  │              │인증 등)에 관한 사항                          │    │    │    │    │    ┃\n┠─┼───────┼───────────────────────┼──┼──┼──┼──┼──┨\n┃2 │정신재활치료과│가. 정신재활 및 직업재활 업무                 │    │    │○  │    │    ┃\n┃  │업무          ├───────────────────────┼──┼──┼──┼──┼──┨\n┃  │              │나. 정신보건의료 사회사업 업무                │    │    │○  │    │    ┃\n┃  │              ├───────────────────────┼──┼──┼──┼──┼──┨\n┃  │              │다. 작업치료, 오락 및 집단 재활치료 업무      │    │    │○  │    │    ┃\n┃  │              ├───────────────────────┼──┼──┼──┼──┼──┨\n┃  │              │라. 정신재활시설 운영에 관한 사항             │    │    │○  │    │    ┃\n┠─┼───────┼───────────────────────┼──┼──┼──┼──┼──┨\n┃3 │임상심리과    │가. 임상심리실 및 관련 검사실 관리·          │    │    │○  │    │    ┃\n┃  │업무          │운영에 관한 사항                              │    │    │    │    │    ┃\n┃  │              ├───────────────────────┼──┼──┼──┼──┼──┨\n┃  │              │나. 임상심리 및 신경심리 장비의 관리·        │    │    │○  │    │    ┃\n┃  │              │운영에 관한 사항                              │    │    │    │    │    ┃\n┃  │              ├───────────────────────┼──┼──┼──┼──┼──┨\n┃  │              │다. 심리치료 및 심리재활 운영에 관한 사항     │    │    │○  │    │    ┃\n┃  │              ├────────┬──────────────┼──┼──┼──┼──┼──┨\n┃  │              │라. 임상심리수련│수련생 모집 및 선발         │    │    │    │    │○  ┃\n┃  │              │과정 운영에     ├──────────────┼──┼──┼──┼──┼──┨\n┃  │              │관한 사항       │운영계획 수립               │    │    │○  │    │    ┃\n┃  │              │                ├──────────────┼──┼──┼──┼──┼──┨\n┃  │              │                │수련생 교육                 │    │    │○  │    │    ┃\n┃  │              │                ├──────────────┼──┼──┼──┼──┼──┨\n┃  │              │                │수련생 복무관리             │    │    │○  │    │    ┃\n┃  │              │                ├──────────────┼──┼──┼──┼──┼──┨\n┃  │              │                │수련평가 실시               │    │    │○  │    │    ┃\n┃  │              ├────────┴──────────────┼──┼──┼──┼──┼──┨\n┃  │              │마. 임상심리에 관한 조사·연구 및 지표 개발   │    │    │○  │    │    ┃\n┗━┷━━━━━━━┷━━━━━━━━━━━━━━━━━━━━━━━┷━━┷━━┷━━┷━━┷━━┛\n┏━┯━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┯━━━━━━━━━━━┯━━┓\n┃번│단  위  업  무  명                                          │전 결 권 자           │원장┃\n┃호│                                                            ├─────┬──┬──┤    ┃\n┃  │                                                            │담당자    │과장│부장│    ┃\n┃  │                                                            ├──┬──┤    │    │    ┃\n┃  │                                                            │담당│팀장│    │    │    ┃\n┠─┼──────┬───────────────────────┼──┼──┼──┼──┼──┨\n┃4 │간호과 업무 │가. 입원 및 외래환자 간호 전반에 관한 사항    │    │    │○  │    │    ┃\n┃  │            ├───────────────────────┼──┼──┼──┼──┼──┨\n┃  │            │나. 병동 운영 관리에 관한 사항                │    │    │○  │    │    ┃\n┃  │            ├───────────────────────┼──┼──┼──┼──┼──┨\n┃  │            │다. 환자 및 보호자 상담·교육·치료적 간호    │    │    │○  │    │    ┃\n┃  │            │활동에  관한 사항                             │    │    │    │    │    ┃\n┃  │            ├───────────────────────┼──┼──┼──┼──┼──┨\n┃  │            │라. 간호 질 향상 조사·연구 및 지표           │    │    │○  │    │    ┃\n┃  │            │개발에 관한 사항                              │    │    │    │    │    ┃\n┃  │            ├───────────────────────┼──┼──┼──┼──┼──┨\n┃  │            │마. 간호 관련 교육 및 수련에 관한 사항        │    │    │○  │    │    ┃\n┃  │            ├───────────────────────┼──┼──┼──┼──┼──┨\n┃  │            │바. 간호사 및 간호조무사 병동근무 배치 및 이동│    │    │○  │    │    ┃\n┠─┼──────┼───────────────────────┼──┼──┼──┼──┼──┨\n┃5 │약제과      │가. 의약품 통제 및 수급조정에 관한 사항       │    │    │    │    │○  ┃\n┃  │            ├───────────────────────┼──┼──┼──┼──┼──┨\n┃  │            │나. 의약품 등 출급                            │    │    │○  │    │    ┃\n┃  │            ├───────────────────────┼──┼──┼──┼──┼──┨\n┃  │            │다. 마약류 등 관리에 관한 사항   