  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 공무원교육훈련법 제11조 규정에 의하여 지방자치인재개발원(이하 \"자치인재원\"이라 한다)의 겸임교수의 효율적인 운영 및 교육훈련업무의 원활한 수행을 위하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "citation",
            "delegation_type": null,
            "target_category": "법령",
            "source_article_no": "제1조",
            "source_clause": "제1조",
            "link_text": "제11조",
            "line_text": "",
            "target_law_name": "공무원교육훈련법",
            "target_article_no": "제11조",
            "target_article_title": "",
            "target_mst": "",
            "target_url": "https://www.law.go.kr/법령/공무원교육훈련법/제11조",
            "resolve_method": "text_supplement",
            "source_provision_id": "admrul:지방자치인재개발원겸임교수운영규정#JO0001",
