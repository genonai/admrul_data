  "appendices": [
    {
      "no": "0001",
      "branch": "00",
      "kind": "별표",
      "title": "전국규모연구대회",
      "enforcement_date": "",
      "content": "[별표 1]\n┏━━┯━━━━━━━━━━━━━━━━┯━━━━━━━━━━━━┯━━━━━━━━━┓\n┃연번│대회명                          │개최 조직               │주무부서          ┃\n┣━━┿━━━━━━━━━━━━━━━━┿━━━━━━━━━━━━┿━━━━━━━━━┫\n┃1   │전국학교체육연구대회            │대한체육회              │민주시민교육과    ┃\n┠──┼────────────────┼────────────┼─────────┨\n┃2   │전국교육자료전                  │한국교원단체총연합회    │교원양성연수과    ┃\n┠──┼────────────────┼────────────┼─────────┨\n┃3   │전국현장교육연구대회            │한국교원단체총연합회    │교원양성연수과    ┃\n┠──┼────────────────┼────────────┼─────────┨\n┃4   │전국초등교육연구대회            │한국교원단체총연합회    │교원양성연수과    ┃\n┠──┼────────────────┼────────────┼─────────┨\n┃5   │인성교육실천사례연구발표대회    │교육부                  │민주시민교육과    ┃\n┃    │                                │한국교육개발원          │                  ┃\n┠──┼────────────────┼────────────┼─────────┨\n┃6   │수업혁신사례연구대회            │교육부                  │교육과정운영지원과┃\n┠──┼────────────────┼────────────┼─────────┨\n┃7   │전국과학전람회 관련             │과학기술정보통신부      │인공지능교육진흥과┃\n┃    │학생작품지도논문연구대회        │국립중앙과학관          │                  ┃\n┠──┼────────────────┼────────────┼─────────┨\n┃8   │전국학생과학발명품경진대회 관련 │과학기술정보통신부      │인공지능교육진흥과┃\n┃    │학생작품지도논문연구대회        │국립중앙과학관          │                  ┃\n┠──┼────────────────┼────────────┼─────────┨\n┃9   │전국교원발명연구대회            │특허청                  │인공지능교육진흥과┃\n┠──┼────────────────┼────────────┼─────────┨\n┃10  │과학교육연구대회                │한국과학교육단체총연합회│인공지능교육진흥과┃\n┠──┼────────────────┼────────────┼─────────┨\n┃11  │전국농업교사현장연구대회        │한국농업교육협회        │직업교육정책과    ┃\n┠──┼────────────────┼────────────┼─────────┨\n┃12  │교육방송연구대회                │한국교육방송공사        │인공지능교육진흥과┃\n┠──┼────────────────┼────────────┼─────────┨\n┃13  │디지털교육연구대회              │한국교육학술정보원      │인공지능교육진흥과┃\n┠──┼────────────────┼────────────┼─────────┨\n┃14  │전국특수교육연구대회            │한국특수교육총연합회    │특수교육정책과    ┃\n┠──┼────────────────┼────────────┼─────────┨\n┃15  │진로연계교육발표대회            │교육부                  │공교육진흥과      ┃\n┠──┼────────────────┼────────────┼─────────┨\n┃16  │학교통일교육연구대회            │교육부                  │민주시민교육과    ┃\n┃    │                                │국립통일교육원          │                  ┃\n┠──┼────────────────┼────────────┼─────────┨\n┃17  │학교환경교육연구대회            │교육부                  │민주시민교육과    ┃\n┗━━┷━━━━━━━━━━━━━━━━┷━━━━━━━━━━━━┷━━━━━━━━━┛",
