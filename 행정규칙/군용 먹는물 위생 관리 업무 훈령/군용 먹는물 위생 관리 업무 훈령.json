      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총칙",
        "content": "제1조(목적) 이 훈령은 군이 개발하거나 지정한 급수원으로부터 공급하는 군용 먹는 물(일반 수돗물을 제외한다)의 위생관리에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:군용먹는물위생관리업무훈령#JO0001"
