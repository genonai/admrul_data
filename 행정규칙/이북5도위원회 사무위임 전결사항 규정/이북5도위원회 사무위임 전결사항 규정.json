n┃    │              ├──────────────────┼───┼────┼──┼──┼───┨\n┃    │              │각종 인사통계보고 및 인사기록 이관  │     │       │●  │   │      ┃\n┃    │              ├──────────────────┼───┼────┼──┼──┼───┨\n┃    │              │공무원 신원조사 의뢰                │      │       │●  │    │      ┃\n┃    │              ├──────────────────┼───┼────┼──┼──┼───┨\n┃    │              │공무원 인사발령 통지                │      │        │●  │    │      ┃\n┃    │              ├──────────────────┼───┼────┼──┼──┼───┨\n┃    │              │회계직 공무원 임면                  │      │●      │    │   │      ┃\n┠──┼───────┼──────────────────┼───┼────┼──┼──┼───┨\n┃3   │포상          │포상계획 수립                       │      │●     │   │   │      ┃\n┃    │              ├──────────────────┼───┼────┼──┼──┼───┨\n┃    │              │포상관련 자료수집                   │     │        │●  │   │      ┃\n┠──┼───────┴──────────────────┼───┼────┼──┼──┼───┨\n┃4   │이북5도위원회 연두업무계획 수립                     │●    │       │   │   │      ┃\n┠──┼──────────────────────────┼───┼────┼──┼──┼───┨\n┃5   │행정자문위원회                                      │      │●      │   │   │      ┃\n┠──┼───────┬──────────────────┼───┼────┼──┼──┼───┨\n┃6   │해외이북도민  │기본계획                            │●    │       │   │   │      ┃\n┃    │고국방문      ├──────────────────┼───┼────┼──┼──┼───┨\n┃    │              │용역수행                            │     │●      │   │   │      ┃\n┃    │              ├──────────────────┼───┼────┼──┼──┼───┨\n┃    │              │세부실행계획                        │     │       │●  │   │      ┃\n┠──┼───────┴──────────────────┼───┼────┼──┼──┼───┨\n┃7   │국회 자료제출                                       │     │●      │   │   │      ┃\n┠──┼───────┬──────────────────┼───┼────┼──┼──┼───┨\n┃8   │무형문화재    │종목 지정·보유자 등                │●    │       │   │   │      ┃\n┃    │보전 및 진흥  │인정 및 문화재위원 위촉             │      │        │    │    │      ┃\n┃    │              ├──────────────────┼───┼────┼──┼──┼───┨\n┃    │              │문화재위원회 개최                   │      │●      │    │    