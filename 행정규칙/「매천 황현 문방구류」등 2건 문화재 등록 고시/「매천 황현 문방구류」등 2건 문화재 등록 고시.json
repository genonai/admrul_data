      "content": "<붙임2> 매천황현 생활유물 목록\n┌──┬─────────┬───┬────────────────────┐\n│연번│세부명칭          │수량  │규격(cm)                                │\n├──┼─────────┼───┼────────────────────┤\n│1   │안경              │1     │(안경길이는 다리를 제외한 길이)         │\n│    │                  │      │길이10.5, 안경알지름3.5                 │\n├──┤                  ├───┼────────────────────┤\n│2   │                  │1     │길이12, 안경알지름4                     │\n├──┤                  ├───┼────────────────────┤\n│3   │                  │1     │길이11.2, 안경알지름4                   │\n├──┼─────────┼───┼────────────────────┤\n│4   │안경집            │1     │지름8, 두께1.8                          │\n├──┤                  ├───┼────────────────────┤\n│5   │                  │1     │지름7.5, 두께1.3                        │\n├──┤                  ├───┼────────────────────┤\n│6   │                  │1     │길이13.6, 폭4.8                         │\n├──┤                  ├───┼────────────────────┤\n│7   │                  │1     │길이16.2, 폭7.6                         │\n├──┤                  ├───┼────────────────────┤\n│8   │                  │1     │길이18.5, 폭8.2                         │\n├──┼─────────┼───┼────────────────────┤\n│9   │호패              │2     │1) 길이10  /  2) 길이10                 │\n├──┼─────────┼───┼────────────────────┤\n│10  │합죽선            │1     │(펼친 상태)                             │\n│    │                  │      │가로43.4, 세로29.5                      │\n├──┼─────────┼───┼────────────────────┤\n│11  │선추              │2     │1) 길이8.2                              │\n│    │*부채 장식품      │      │2) 길이9.2,  전체길이27(장식포함)       │\n├──┼─────────┼───┼────────────────────┤\n│12  │상투관            │1     │길이6, 높이4                            │\n├──┼─────────┼───┼────────────────────┤\n│13  │갓솔              │1     │가로4.5, 세로3.2, 높이6.8               │\n├──┼─────────┼───┼────────────────────┤\n│14  │얼레빗            │1     │가로10.5, 세로6.5                       │\n├──┼─────────┼───┼────────────────────┤\n│15  │참빗              │1     │가로9, 세로5                            │\n├──┼─────────┼───┼────────────────────┤\n│16  │동곳              │2     │길이4.8, 길이3.5                        │\n│    │*상투머리 손질도구│      │                                        │\n├──┼─────────┼───┼────────────────────┤\n│17  │휴대용목침        │1     │세로11.5, 가로14.2, 높이7               │\n├──┼─────────┼───┼────────────────────┤\n│18  │진신              │1켤레 │길이25.5, 폭7                           │\n│    │*신발             │      │                                        │\n├──┼─────────┼───┼────────────────────┤\n│19  │담배 쌈지         │1     │가로11.5, 세로12.5                      │\n├──┼─────────┼───┼────────────────────┤\n│20  │패철              │1     │지름11.3, 높이1.6                       │\n│    │*나침반           │      │                                        │\n├──┼─────────┼───┼────────────────────┤\n│21  │패철 주머니       │1     │가로21, 세로24                          │\n├──┼─────────┼───┼────────────────────┤\n│22  │향로              │1     │높이16.5, 너비12.5                      │\n├──┼─────────┼───┼────────────────────┤\n│23  │향합              │1     │지름8.7, 높이6.5                        │\n├──┼─────────┼───┼────────────────────┤\n│24  │합                │2     │1) 지름7.3, 높이5.3 / 2) 지름7, 높이3.4 │\n├──┼─────────┼───┼────────────────────┤\n│25  │지승 자라병       │1     │길이19, 너비18.5                        │\n├──┼─────────┼───┼────────────────────┤\n│26  │소쿠리            │1     │길이18.5, 폭15, 높이7                   │\n├──┼─────────┼───┼────────────────────┤\n│27  │곱돌 화로         │1     │지름16, 높이15                          │\n├──┼─────────┼───┼────────────────────┤\n│28  │표주박            │2     │1) 길이12.5  /   2) 길이10.5            │\n├──┼─────────┼───┼────────────────────┤\n│29  │가죽제품          │1     │지름6, 두께2                            │\n├──┼─────────┼───┼────────────────────┤\n│30  │책장              │1     │가로102.1, 높이160.2, 폭36.2            │\n├──┴─────────┼───┼────────────────────┤\n│총 계                   │35점  │                                        │\n└─────