─────┼──┼──────────────┤\n│11  │도장                                      │1   │(양면인)3×3                │\n├──┤                                          ├──┼──────────────┤\n│12  │                                          │1   │1.9×1.7×2.2               │\n├──┤                                          ├──┼──────────────┤\n│13  │                                          │1   │1.4×1.4×2.6               │\n├──┤                                          ├──┼──────────────┤\n│14  │                                          │1   │1.8×0.8×1.4               │\n├──┤                                          ├──┼──────────────┤\n│15  │                                          │1   │(양면인)1.1×0.8, 둘레1.6   │\n├──┤                                          │    │                            │\n│16  │                                          │    │                            │\n├──┤                                          ├──┼──────────────┤\n│17  │                                          │1   │(양면인)1.2×0.9, 둘레1.9   │\n├──┤                                          │    │                            │\n│18  │                                          │    │                            │\n├──┤                                          ├──┼──────────────┤\n│19  │                                          │1   │지름4.5, 높이3.3            │\n├──┴─────────────────────┼──┼──────────────┤\n│총 계                                           │19점│                            │\n└────────────────────────┴──┴──────────────┘\n",
