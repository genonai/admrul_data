      "content": "[붙임1]\n토지 등의 소유자와 이해관계인의 성명 및 주소\n┏━━┯━━━━┯━━━━┯━━┯━━━━━━━━━┯━━━━━━━━━━━━━━━━━━━━┯━━━━━━━━━━━━━━┯━━━━┓\n┃연번│소재지  │지번    │지목│면적(㎥)          │소유자                                  │소유권 이외의 권리          │비고    ┃\n┃    │        │        │    ├────┬────┼───────┬────────────┼─────┬────────┤        ┃\n┃    │        │        │    │지적면적│편입면적│성명          │주소                    │성명      │주소            │        ┃\n┣━━┿━━━━┿━━━━┿━━┿━━━━┿━━━━┿━━━━━━━┿━━━━━━━━━━━━┿━━━━━┿━━━━━━━━┿━━━━┫\n┃계  │        │        │    │129,586 │11,986  │              │                        │          │                │        ┃\n┣━━┿━━━━┿━━━━┿━━┿━━━━┿━━━━┿━━━━━━━┿━━━━━━━━━━━━┿━━━━━┿━━━━━━━━┿━━━━┫\n┃소계│        │        │    │70,160  │4,106   │              │                        │          │                │진입    ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤도로    ┃\n┃1   │평택시  │산29    │임  │35,878  │324     │임OO          │여의도동28, 광장아파트  │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │3동 1107호              │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃2   │평택시  │산42-1  │임  │13,733  │399     │평택개발      │평택시 원평로25번길     │새마을    │전라북도 정읍시 │        ┃\n┃    │장당동  │        │    │        │        │주식회사      │상가동 105호            │금고      │중앙1길 76      │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃3   │평택시  │620     │수  │5,410   │167     │국(평택시)    │                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃4   │평택시  │620-1   │도  │4,406   │2,457   │국(평택시)    │                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃5   │평택시  │411-12  │잡  │86      │11      │국(평택시)    │                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃6   │평택시  │411-15  │임  │137     │133     │국(평택시)    │                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃7   │평택시  │산49-6  │임  │1,674   │113     │국(국토부)    │                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃8   │평택시  │산44-19 │임  │65      │57      │국(평택시)    │                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃9   │평택시  │산44-10 │임  │44      │21      │국(국토부)    │                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃10  │평택시  │420-8   │도  │48      │48      │신OO외7인     │서정동 13, 주공아파트   │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │212동 403호             │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃11  │평택시  │산44-12 │임  │23      │19      │국(평택시)    │                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃12  │평택시  │산44-20 │구  │42      │42      │국(평택시)    │                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃13  │평택시  │산44-11 │구  │25      │24      │한국농어촌공사│                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃14  │평택시  │산43-3  │구  │5,059   │35      │한국농어촌공사│                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃15  │평택시  │52-40   │창  │363     │10      │변OO          │평택시 세교동 224-1     │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃16  │평택시  │산44-2  │임  │198     │15      │국(국토부)    │                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃17  │평택시  │산44-23 │임  │27      │27      │변OO          │평택시 세교동24-1       │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃18  │평택시  │산45-2  │도  │2,942   │204     │국(국토부)    │                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┣━━┿━━━━┿━━━━┿━━┿━━━━┿━━━━┿━━━━━━━┿━━━━━━━━━━━━┿━━━━━┿━━━━━━━━┿━━━━┫\n┃소계│        │        │    │59,427  │7,880   │              │                        │          │                │배수지  ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃19  │평택시  │620     │수  │5,410   │5,170   │국(평택시)    │                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃20  │평택시  │620-1   │도  │4,406   │90      │국(평택시)    │                        │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │                        │          │                │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃21  │평택시  │산42-1  │임  │13,733  │157     │평택개발      │평택시 원평로25번길     │새마을금고│전라북도 정읍시 │        ┃\n┃    │장당동  │        │    │        │        │주식회사      │상가동 105호            │          │중앙1길 76      │        ┃\n┠──┼────┼────┼──┼────┼────┼───────┼────────────┼─────┼────────┤        ┃\n┃22  │평택시  │산29    │임  │35,878  │2,463   │임OO          │영등포구 여의도동 28,   │          │                │        ┃\n┃    │장당동  │        │    │        │        │              │광장아파트 3동 1107호   │          │                │        ┃\n┗━━┷━━━━┷━━━━┷━━┷━━━━┷━━━━┷━━━━━━━┷━━━━━━━━━━━━┷━━━━━┷━━━━━━━━┷━━━━┛",
