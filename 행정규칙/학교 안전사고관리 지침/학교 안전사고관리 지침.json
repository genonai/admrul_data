    "article_count": 5,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 지침은 「학교안전사고 예방 및 보상에 관한 법률」  10조제3항에 따라 학교 안팎의 교육활동 중에 발생한 사고와 위급상황에 효율적으로 대처하기 위하여 필요한 사항에 대해 규정함을 목적으로 한다.",
        "enforcement_date": "",
