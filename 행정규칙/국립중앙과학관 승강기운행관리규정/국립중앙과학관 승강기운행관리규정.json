      "content": "[별지 제3호 서식]\n일일운행일지\n┏━━━━━┳━━━┳━━━┳━━━━┳━━━━━━━┳━━┓\n┃년·월·일┃운전자┃시  간┃운행층수┃사         유 ┃비고┃\n┣━━━━━╋━━━╋━━━╋━━━━╋━━━━━━━╋━━┫\n┃          ┃      ┃      ┃        ┃              ┃    ┃\n┣━━━━━╋━━━╋━━━╋━━━━╋━━━━━━━╋━━┫\n┃          ┃      ┃      ┃        ┃              ┃    ┃\n┣━━━━━╋━━━╋━━━╋━━━━╋━━━━━━━╋━━┫\n┃          ┃      ┃      ┃        ┃              ┃    ┃\n┣━━━━━╋━━━╋━━━╋━━━━╋━━━━━━━╋━━┫\n┃          ┃      ┃      ┃        ┃              ┃    ┃\n┣━━━━━╋━━━╋━━━╋━━━━╋━━━━━━━╋━━┫\n┃          ┃      ┃      ┃        ┃              ┃    ┃\n┣━━━━━╋━━━╋━━━╋━━━━╋━━━━━━━╋━━┫\n┃          ┃      ┃      ┃        ┃              ┃    ┃\n┣━━━━━╋━━━╋━━━╋━━━━╋━━━━━━━╋━━┫\n┃          ┃      ┃      ┃        ┃              ┃    ┃\n┣━━━━━╋━━━╋━━━╋━━━━╋━━━━━━━╋━━┫\n┃          ┃      ┃      ┃        ┃              ┃    ┃\n┣━━━━━╋━━━╋━━━╋━━━━╋━━━━━━━╋━━┫\n┃          ┃      ┃      ┃        ┃              ┃    ┃\n┣━━━━━╋━━━╋━━━╋━━━━╋━━━━━━━╋━━┫\n┃          ┃      ┃      ┃        ┃              ┃    ┃\n┣━━━━━╋━━━╋━━━╋━━━━╋━━━━━━━╋━━┫\n┃          ┃      ┃      ┃        ┃              ┃    ┃\n┣━━━━━╋━━━╋━━━╋━━━━╋━━━━━━━╋━━┫\n┃          ┃      ┃      ┃        ┃              ┃    ┃\n┗━━━━━┻━━━┻━━━┻━━━━┻━━━━━━━┻━━┛",
