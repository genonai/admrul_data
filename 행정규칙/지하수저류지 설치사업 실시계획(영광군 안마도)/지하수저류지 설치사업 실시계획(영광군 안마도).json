      "content": "□ 붙 임\n- 토지세목조서(변경)\n━━┯━━━━━━━━┯━━━━━━━━┯━━━━━━━━━━━┯━━━━━━━━━┯━━━━━━━━━━━━━━\n연│소재지          │                │당  초                │변  경(1회)       │소유자\n번│                ├──────┬─┼─────┬─────┼────┬────┼──────┬───────\n│                │지번        │지│공부      │편입      │공부    │편입    │당초        │변경\n│                │            │목│면적      │면적      │면적    │면적    │            │\n│                │            │  │(㎡)      │(㎡)      │(㎡)    │(㎡)    │            │\n━━┿━━━━━━━━┷━━━━━━┷━┿━━━━━┿━━━━━┿━━━━┿━━━━┿━━━━━━┿━━━━━━━\n│총    계                          │          │8,184.0   │        │8,440.6 │            │\n──┼────────┬──────┬─┼─────┼─────┼────┼────┼──────┼───────\n1 │전라남도 영광군 │576   -   1 │답│1,567.0   │295.0     │1,272.0 │        │김**        │김**\n│낙월면  월촌리  │            │  │          │          │        │        │            │\n──┼────────┼──────┼─┼─────┼─────┼────┼────┼──────┼───────\n2 │전라남도 영광군 │576   -   9 │답│         │          │ 295.0  │295.0   │김**        │영광군\n│낙월면 월촌리   │            │  │          │          │        │        │            │\n──┼────────┼──────┼─┼─────┼─────┼────┼────┼──────┼───────\n3 │전라남도 영광군 │576   -   2 │답│ 928.0    │49.0      │879.0   │        │이**        │이**\n│낙월면 월촌리   │            │  │          │          │        │        │            │\n──┼────────┼──────┼─┼─────┼─────┼────┼────┼──────┼───────\n4 │전라남도 영광군 │576   -   10│답│         │          │ 49.0   │49.0    │이**        │이**\n│낙월면 월촌리   │            │  │          │          │        │        │            │\n──┼────────┼──────┼─┼─────┼─────┼────┼────┼──────┼───────\n5 │전라남도 영광군 │576   -   4 │답│ 1,140.0  │48.0      │1,092.1 │        │김**        │김**\n│낙월면 월촌리   │            │  │          │          │        │        │            │\n──┼────────┼──────┼─┼─────┼─────┼────┼────┼──────┼───────\n6 │전라남도 영광군 │576      11│답│         │          │ 47.9   │47.9    │김**        │김**\n│낙월면 월촌리   │            │  │          │          │        │        │            │\n──┼────────┼