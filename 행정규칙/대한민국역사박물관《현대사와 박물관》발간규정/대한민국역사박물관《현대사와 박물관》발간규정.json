    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 본 규정은 대한민국역사박물관에서 발간하는 정기간행물인《현대사와 박물관》의 편집 및 발간에 관한 제반 사항을 규정하는 것을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관《현대사와박물관》발간규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "발간 내용",
        "chapter": "",
        "content": "제2조(발간 내용)《현대사와 박물관》은 한국 근현대사 연구 및 근현대사 박물관의 전시ㆍ연구ㆍ교육ㆍ자료수집 등의 분야의 내용으로 구성한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관《현대사와박물관》발간규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "발간 일정",
        "chapter": "",
        "content": "제3조(발간 일정)《현대사와 박물관》은 연 1회 발간하며, 발간월은 12월로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:대한민국역사박물관《현대사와박물관》발간규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "판권 및 배포",
        "chapter": "",
        "content": "제4조(판권 및 배포) ① 《현대사와 박물관》의 배포권 및 판권은 대한민국역사박물관에 귀속된다. [별지 1호 서식]② 《현대사와 박물관》은 국내외 주요 박물관, 도서관, 연구기관, 대학 및 유관기관 등에 무상으로 배포한다.",
        "enforcement_date": "",
