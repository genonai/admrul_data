    "article_count": 6,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 국립중앙도서관의 각종 업무처리에 관한 통계를 정례적으로 작성 보고함으로써 실태파악에 정확을 기하고 정책 수립과 업무처리 개선에 기여함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙도서관통계규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "통계의 종류",
        "chapter": "",
        "content": "제2조(통계의 종류) 통계의 종류, 보고구분, 작성과 서식은 별표와 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙도서관통계규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "작성기간",
        "chapter": "",
        "content": "제3조(작성기간) 통계는 보고 구분에 따라 다음 기간의 사실을 기준으로 작성한다.1. 월보는 월1일부터 말일까지2. 분기보는 매 분기 시작일부터 종료일까지3. 연보는 1월 1일부터 12월 31까지",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙도서관통계규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "통계작성",
        "chapter": "",
        "content": "제4조(통계작성) ① 통계는 통계작성부서에서 관련 부서의 자료를 종합하여 작성한다.② 통계작성부서의 장은 통계의 작성, 통계 자료 관리, 통계 관련 업무 협조 등의 원활한 수행을 위하여 통계 전담자를 지정하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙도서관통계규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "통계총괄부서 지정 및 임무",
        "chapter": "",
        "content": "제5조(통계총괄부서 지정 및 임무) 기획총괄과는 통계 총괄을 담당하며, 다음 각 호의 사항을 총괄한다.1. 도서관 관련 통계의 대외 보고 또는 제출2. 통계작성부서의 통계 종합ㆍ조정 및 품질 관리3. 그 밖에 소관 통계의 작성ㆍ보급, 이용에 관한 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙도서관통계규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "통계변경",
        "chapter": "",
        "content": "제6조(통계변경) 통계작성부서의 장이 새로운 통계를 작성하고자 하거나 이미 작성된 통계의 내용을 변경하고자 할 때에는 기획총괄과장과 협의하여야 하며, 그 명칭, 종류, 목적, 조사 대상, 조사 방법, 통계표 서식 등의 사항에 관하여 관장의 승인을 받아야 한다. 다만, 대외적으로 제공 또는 공표되지 않았거나 정기 보고에 포함되지 않은 내부 사용 목적의 통계는 협의하지 않을 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙도서관통계규정#JO0006"
      }
    ]
  },
