      {
        "article_no": "제17조",
        "article_title": "보칙",
        "chapter": "",
        "content": "제17조(보칙) 이 규정에서 정한 사항 외에 심의회의 운영에 관하여 필요한 사항은 위원장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:기준판매비율심의회운영규정#JO0017"
