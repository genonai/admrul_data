        │                                  │(의결)│      │      │      │\n│    │                            ├─────────────────┼───┼───┼───┼───┤\n│    │                            │결정사항 통지                     │      │      │○    │      │\n├──┼──────┬───────┼─────────────────┼───┼───┼───┼───┤\n│9   │선거범죄    │예방·단속    │기본계획                          │      │○    │      │      │\n│    │예방·단속  │              ├─────────────────┼───┼───┼───┼───┤\n│    │            │              │특별단속계획                      │      │○    │      │      │\n│    │            │              ├─────┬───────────┼───┼───┼───┼───┤\n│    │            │              │예방·단속│중요사항              │      │○    │      │      │\n│    │            │              │지시      ├───────────┼───┼───┼───┼───┤\n│    │            │              │          │일반사항              │      │      │○    │      │\n│    │            ├───────┼─────┴───────────┼───┼───┼───┼───┤\n│    │            │업무실태      │실태파악                          │      │      │○    │      │\n│    │            │파악 및       ├─────────────────┼───┼───┼───┼───┤\n│    │            │지도·점검    │지도점검                          │      │      │○    │      │\n│    │            │              ├─────────────────┼───┼───┼───┼───┤\n│    │            │              │결과보고                          │      │      │○    │      │\n│    │            ├───────┼─────────────────┼───┼───┼───┼───┤\n│    │            │안내 및       │중요사항                          │      │○    │      │      │\n│    │            │협조요청      ├─────────────────┼───┼───┼───┼───┤\n│    │            │              │일반사항                          │      │      │○    │      │\n│    │            │              ├─────────────────┼───┼───┼───┼───┤\n│    │            │              │경미사항                          │      │      │      │○    │\n├──┼──────┴───────┼───────┬─────────┼───┼───┼───┼───┤\n│10  │공직선거법 및 선거여론      │고발          │중요사항          │○    │      │      │      │\n│    │조사기준 위반행위 관련 조치 │              │                 