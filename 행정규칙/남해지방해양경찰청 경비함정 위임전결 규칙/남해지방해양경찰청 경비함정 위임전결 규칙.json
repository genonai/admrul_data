      "content": "[별표 2]\n소형 경비정 및 특수함정 위임전결사항\n┌──┬──┬──────────────────────┬───┬───┬──┐\n│일련│부서│사 무 내 용                                 │담당자│부서장│정장│\n│번호│    │                                            │      │      │    │\n├──┼──┼────┬───────────┬─────┼───┼───┼──┤\n│1   │공  │복무    │출장                  │근무지 내 │      │○    │    │\n│    │통  │        │                      ├─────┼───┼───┼──┤\n│    │사  │        │                      │근무지 외 │      │      │○  │\n│    │항  │        ├───────────┼─────┼───┼───┼──┤\n│    │    │        │휴가?조퇴?외출?지각│부서원    │      │○    │    │\n│    │    │        │                      ├─────┼───┼───┼──┤\n│    │    │        │                      │부서장    │      │      │○  │\n├──┤    ├────┴───────────┴─────┼───┼───┼──┤\n│2   │    │비품 및 소모품 등 각종 물품 신청            │      │      │○  │\n├──┤    ├──────────────────────┼───┼───┼──┤\n│3   │    │공사감독 일지(각종 물품 수리 관련)          │      │○    │    │\n├──┤    ├──────────────────────┼───┼───┼──┤\n│4   │    │PMS 계획 및 결과보고                        │      │○    │    │\n├──┤    ├──────────────────────┼───┼───┼──┤\n│5   │    │각종 물품 청구 및 수령                      │      │      │○  │\n├──┤    ├──────────────────────┼───┼───┼──┤\n│6   │    │각종 장비 보수 및 관리                      │      │○    │    │\n├──┼──┼──────────────────────┼───┼───┼──┤\n│7   │행  │함정운영계획 수립 및 시행                   │      │      │○  │\n├──┤정  ├──────────────────────┼───┼───┼──┤\n│8   │부  │교육훈련계획 수립 및 결과보고               │      │      │○  │\n├──┤서  ├────┬─────────────────┼───┼───┼──┤\n│9   │    │복무    │당직명령(정박?출동)              │      │      │○  │\n│    │    │?      ├─────────────────┼───┼───┼──┤\n│    │    │인사    │후생?복지 관련 업무              │      │      │○  │\n│    │    │        ├─────────────────┼───┼───┼──┤\n│    │    │        │공?사상 관련 업무                │      │      │○  │\n│    │    │        ├─────────────────┼───┼───┼──┤\n│    │    │        │징계 사항                         │      │      │○  │\n│    │    │        ├─────────────────┼───┼───┼──┤\n│    │    │        │승조원 근무지정                   │      │      │○  │\n│    │    │        ├─────────────────┼───┼───┼──┤\n│    │    │        │각종 표창 상신                    │      │      │○  │\n├──┤    ├────┼─────────────────┼───┼───┼──┤\n│    │    │보안    │전산장비 비밀번호 지정?변경      │      │      │○  │\n│0   │    │        ├─────────────────┼───┼───┼──┤\n│    │    │        │보안교육 및 보안진단              │      │      │○  │\n│    │    │        ├─────────────────┼───┼───┼──┤\n│    │    │        │각종 비밀문서 관리                │      │      │○  │\n│    │    │        ├─────────────────┼───┼───┼──┤\n│    │    │        │비밀소유현황 조사                 │      │      │○  │\n├──┤    ├────┼─────────────────┼───┼───┼──┤\n│11  │    │비상소집│소집 실시 및 결과보고             │      │      │○  │\n├──┤    ├────┼─────────────────┼───┼───┼──┤\n│12  │    │문서    │문서 통제 및 수?발 업무          │      │○    │    │\n│    │    │        ├─────────────────┼───┼───┼──┤\n│    │    │        │문서 정리 계획                    │      │      │○  │\n├──┤    ├────┼─────────────────┼───┼───┼──┤\n│13  │    │ 경리   │급량비 신청 및 집행               │      │      │○  │\n│    │    │        ├─────────────────┼───┼───┼──┤\n│    │    │        │각종 수당 신청 및 집행            │      │      │○  │\n│    │    │        ├─────────────────┼───┼───┼──┤\n│    │    │        │관서운영비 출납관련 제반업무      │      │      │○  │\n└──┴──┴────┴─────────────────┴───┴───┴──┘\n┌──┬──┬──────────────────────────┬───┬───┬──┐\n│일련│부서│사 무 내 용                                         │담당자│부서장│정장│\n│번호│    │                                                    │      │      │    │\n├──┼──┼──────┬───────────────────┼───┼───┼──┤\n│14  │항  │함정운용    │기본작전 및 출동명령                  │      │      │○  │\n│    │해  │            ├───────────────────┼───┼───┼──┤\n│    │부  │            │경비함정 행동                         │      │      │○  │\n│    │서  │            ├───────────────────┼───┼───┼──┤\n│    │    │            │그 밖에 경미사항                      │      │○    │    │\n├──┤    ├──────┼───────────────────┼───┼───┼──┤\n│15  │    │선박검문검색│일반 검문검색                         │      │○    │    │\n│    │    │            ├───────────────────┼───┼───┼──┤\n│    │    │            │정밀 검문검색                         │      │      │○  │\n├──┤    ├──────┼───────────────────┼───┼───┼──┤\n│16  │    │해상경비    │출동 계획 및 결과보고                 │      │      │○  │\n│    │    │            ├───────────────────┼───┼───┼──┤\n│    │    │            │그 밖에 일반사항                      │      │○    │    │\n├──┤    ├──────┴───────────────────┼───┼───┼──┤\n│17  │    │해난사고 발생 및 구조사항                           │      │      │○  │\n├──┤    ├──────┬───────────────────┼───┼───┼──┤\n│18  │    │병기        │사격훈련계획 및 사격실시 결과보고     │      │      │○  │\n│    │    │            ├───────────────────┼───┼───┼──┤\n│    │    │            │무기?탄약 관리 및 점검               │      │      │○  │\n│    │    │            ├───────────────────┼───┼───┼──┤\n│    │    │            │무기?탄약 사용계획 및 결과보고       │      │      │○  │\n├──┤    ├──────┼───────────────────┼───┼───┼──┤\n│19  │    │통신        │통신장비 정비 및 관리                 │      │      │    │\n│    │    │            ├───────────────────┼───┼───┼──┤\n│    │    │            │긴급상황 통신훈련                     │      │      │○  │\n│    │    │            ├────┬──────────────┼───┼───┼──┤\n│    │    │            │암호장비│중요사항                    │      │      │○  │\n│    │    │            │        ├──────────────┼───┼───┼──┤\n│    │    │            │        │일반사항                    │      │○    │    │\n│    │    │            ├────┴──────────────┼───┼───┼──┤\n│    │    │            │암호자재취급 인가 및 해제             │      │      │○  │\n├──┤    ├──────┼───────────────────┼───┼───┼──┤\n│20  │    │방제        │해양오염신고 및 방제조치 결과보고     │      │      │○  │\n│    │    │            ├───────────────────┼───┼───┼──┤\n│    │    │            │방제장비?자재 점검 계획 및 결과보고  │      │○    │    │\n├──┤    ├──────┼───────────────────┼───┼───┼──┤\n│21  │    │치안        │형사기동정 운항실적 및 활동사항 보고  │      │      │○  │\n│    │    │            ├───────────────────┼───┼───┼──┤\n│    │    │            │형사기동정 출동계획 및 결과보고       │      │      │○  │\n├──┤    ├──────┼───────────────────┼───┼───┼──┤\n│22  │    │예인        │함정 출·입항 보조 및 예인            │      │      │○  │\n│    │    │            ├───────────────────┼───┼───┼──┤\n│    │    │            │구조선박 및 유류바지 등 안전지대 예인 │      │      │○  │\n├──┼──┼──────┼───────────────────┼───┼───┼──┤\n│23  │기  │함정정비    │함정수리 시행계획                     │      │      │○  │\n│    │관  │            ├───────────────────┼───┼───┼──┤\n│    │부  │            │함정수리 완료 보고                    │      │      │○  │\n│    │서  │            ├───────────────────┼───┼───┼──┤\n│    │    │            │함정수리 예량 및 검사보고             │      │      │○  │\n│    │    │            ├───────────────────┼───┼───┼──┤\n│    │    │            │함정수리(정기?상가)                  │      │      │○  │\n│    │    │            ├───────────────────┼───┼───┼──┤\n│    │    │            │장비 상태 보고                        │      │      │○  │\n├──┤    ├──────┼───────────────────┼───┼───┼──┤\n│24  │    │함정보급    │기관부속(PLL) 신청                    │      │○    │    │\n│    │    │            ├─────┬─────────────┼───┼───┼──┤\n│    │    │            │함정유류  │경유 또는 휘발유          │      │      │○  │\n│    │    │            │신청      ├─────────────┼───┼───┼──┤\n│    │    │            │          │잡   유                   │      │○    │    │\n│    │    │            ├─────┴─────────────┼───┼───┼──┤\n│    │    │            │함정유류 검수                         │      │      │○  │\n│    │    │            ├───────────────────┼───┼───┼──┤\n│    │    │            │윤활유 취환 신청                      │      │      │○  │\n│    │    │            ├──────┬────────────┼───┼───┼──┤\n│    │    │            │함정        │처리계획                │      │○    │    │\n│    │    │            │폐기물처리  ├────────────┼───┼───┼──┤\n│    │    │            │            │처리결과                │      │○    │    │\n│    │    │            ├──────┴────────────┼───┼───┼──┤\n│    │    │            │함정 먹는 물 관리                     │      │○    │    