  "appendices": [
    {
      "no": "0001",
      "branch": "00",
      "kind": "별표",
      "title": "중·대형 경비함정 위임전결사항",
      "enforcement_date": "",
      "content": "[별표 1]\n중ㆍ대형 경비함정 위임전결사항\n1. 행정부서\n┏━━┯━━━━━━━━━━━━━━━━━━━━━┯━━━┯━━━┯━━┓\n┃일련│사    무    내    용                      │직별장│부서장│함장┃\n┃번호│                                          │      │      │    ┃\n┣━━┿━━━━━━━━━━━━━━━━━━━━━┿━━━┿━━━┿━━┫\n┃1   │함정운영계획 수립 및 시행                 │      │      │○  ┃\n┠──┼─────────────────────┼───┼───┼──┨\n┃2   │교육훈련계획 수립 및 결과보고             │      │      │○  ┃\n┠──┼──────┬────────┬─────┼───┼───┼──┨\n┃3   │경찰관 복무 │출장            │근무지외  │      │      │○  ┃\n┃    │            │                ├─────┼───┼───┼──┨\n┃    │            │                │근무지내  │      │○    │    ┃\n┃    │            ├────────┼─────┼───┼───┼──┨\n┃    │            │휴가?조퇴?외출│부서장    │      │      │○  ┃\n┃    │            │                ├─────┼───┼───┼──┨\n┃    │            │                │부서원    │      │○    │    ┃\n┃    │            ├────────┴─────┼───┼───┼──┨\n┃    │            │당직명령(정박?출동)        │      │      │○  ┃\n┃    │            ├──────────────┼───┼───┼──┨\n┃    │            │순찰표 작성                 │      │○    │    ┃\n┃    │            ├──────────────┼───┼───┼──┨\n┃    │            │후생?복지 관련 업무        │      │      │○  ┃\n┃    │            ├──────────────┼───┼───┼──┨\n┃    │            │공?사상 관련 업무          │      │      │○  ┃\n┃    │            ├──────────────┼───┼───┼──┨\n┃    │            │징계 사항                   │      │      │○  ┃\n┠──┼──────┼──────────────┼───┼───┼──┨\n┃4   │인사        │경찰관 근무지정             │      │      │○  ┃\n┃    │            ├──────────────┼───┼───┼──┨\n┃    │            │총원명부                    │      │○    │    ┃\n┃    │            ├──────────────┼───┼───┼──┨\n┃    │            │인사자료 파악               │      │○    │    ┃\n┃    │            ├──────────────┼───┼───┼──┨\n┃    │            │각종 표창 상신              │      │      │○  ┃\n┠──┼──────┼──────────────┼───┼───┼──┨\n┃5   │보안        │전산장비 비밀번호 지정?변경│      │      │○  ┃\n┃    │            ├──────────────┼───┼───┼──┨\n┃    │            │보안교육 및 보안진단        │      │      │○  ┃\n┃    │            ├──────────────┼───┼───┼──┨\n┃    │            │각종 비밀문서 관리          │      │      │○  ┃\n┃    │            ├──────────────┼───┼───┼──┨\n┃    │            │비밀소유현황 조사           │      │      │○  ┃\n┗━━┷━━━━━━┷━━━━━━━━━━━━━━┷━━━┷━━━┷━━┛\n┏━━┯━━━━━━━━━━━━━━━━━━━━━┯━━━┯━━━┯━━┓\n┃일련│사    무    내    용                      │직별장│부서장│함장┃\n┃번호│                                          │      │      │    ┃\n┣━━┿━━━━━┯━━━━━━━━━━━━━━━┿━━━┿━━━┿━━┫\n┃6   │비상소집  │소집 실시 및 결과보고         │      │      │○  ┃\n┠──┼─────┼───────────────┼───┼───┼──┨\n┃7   │문서      │문서 통제 및 수?발 업무      │      │○    │    ┃\n┃    │          ├─────┬─────────┼───┼───┼──┨\n┃    │          │문서정리  │중요사항(폐기 등) │      │      │○  ┃\n┃    │          │계획      ├─────────┼───┼───┼──┨\n┃    │          │          │일반 사항         │      │○    │    ┃\n┠──┼─────┼─────┴─────────┼───┼───┼──┨\n┃8   │해상치안  │위반선박검거                  │      │      │○  ┃\n┃    │(수?형사)│(범죄인지보고서 작성)         │      │      │    ┃\n┃    │          ├───────────────┼───┼───┼──┨\n┃    │          │음주운항선박검거              │      │      │○  ┃\n┃    │          │(적발보고서 작성)             │      │      │    ┃\n┠──┼─────┴───────────────┼───┼───┼──┨\n┃9   │함정 연혁사 및 법정일지 기록관리          │      │      │○  ┃\n┠──┼───┬─────────────────┼───┼───┼──┨\n┃10  │ 경리 │급량비 신청 및 집행               │      │      │○  ┃\n┃    │      ├─────────────────┼───┼───┼──┨\n┃    │      │각종 수당 신청 및 집행            │      │      │○  ┃\n┃    │      ├─────────────────┼───┼───┼──┨\n┃    │      │관서운영비 출납관련 제반업무      │      │      │○  ┃\n┠──┼───┴─────────────────┼───┼───┼──┨\n┃11  │비품 및 소모품 등 각종 물품 신청          │      │      │○  ┃\n┠──┼─────────────────────┼───┼───┼──┨\n┃12  │각종 월보 및 정기보고                     │      │○    │    ┃\n┠──┼─────────────────────┼───┼───┼──┨\n┃13  │PMS 계획 및 결과보고                      │      │○    │    ┃\n┗━━┷━━━━━━━━━━━━━━━━━━━━━┷━━━┷━━━┷━━┛\n2. 항해?안전?구조?병기부서\n┏━━┯━━━━━━━━━━━━━━━━━━━━━━━━━┯━━━┯━━━┯━━┓\n┃일련│사    무    내    용                              │직별장│부서장│함장┃\n┃번호│                                                  │      │      │    ┃\n┣━━┿━━━━━━┯━━━━━━━━━━━━━━━━━━┿━━━┿━━━┿━━┫\n┃1   │함정운용    │기본작전 및 출동명령                │      │      │○  ┃\n┃    │            ├──────────────────┼───┼───┼──┨\n┃    │            │경비함정 행동                       │      │      │○  ┃\n┃    │            ├──────────────────┼───┼───┼──┨\n┃    │            │그 밖에 경미사항                    │      │○    │    ┃\n┠──┼──────┼──────────────────┼───┼───┼──┨\n┃2   │선박검문검색│일반 검문검색                       │      │○    │    ┃\n┃    │            ├──────────────────┼───┼───┼──┨\n┃    │            │정밀 검문검색                       │      │      │○  ┃\n┠──┼──────┼──────────────────┼───┼───┼──┨\n┃3   │해상경비    │출동 계획 및 결과보고               │      │      │○  ┃\n┃    │            ├──────────────────┼───┼───┼──┨\n┃    │            │해상경비일보                        │      │      │○  ┃\n┃    │            ├───────────┬──────┼───┼───┼──┨\n┃    │            │출동 중 전문 수?발신 │주요상황보고│      │      │○  ┃\n┃    │            │                      ├──────┼───┼───┼──┨\n┃    │            │                      │일상보고사항│      │○    │    ┃\n┃    │            ├───────────┴──────┼───┼───┼──┨\n┃    │            │그 밖에 일반사항                    │      │○    │    ┃\n┠──┼──────┴──────────────────┼───┼───┼──┨\n┃4   │수로도지(해도?수로서지) 수정 및 교환 청구        │      │○    │    ┃\n┠──┼─────────────────────────┼───┼───┼──┨\n┃5   │해난사고 발생 및 구조사항                         │      │      │○  ┃\n┠──┼─────────────────────────┼───┼───┼──┨\n┃6   │침실배정                                          │○    │      │    ┃\n┠──┼──────┬──────────────────┼───┼───┼──┨\n┃7   │병기        │사격훈련계획 및 사격실시결과보고    │      │      │○  ┃\n┃    │            ├──────────────────┼───┼───┼──┨\n┃    │            │무기?탄약 관리 및 점검             │      │      │○  ┃\n┃    │            ├──────────────────┼───┼───┼──┨\n┃    │            │무기?탄약 사용계획 및 결과보고     │      │      │○  ┃\n┠──┼──────┴──────────────────┼───┼───┼──┨\n┃8   │각종 물품 청구 및 수령                            │      │      │○  ┃\n┠──┼─────────────────────────┼───┼───┼──┨\n┃9   │각종 장비 보수 및 관리                            │      │○    │    ┃\n┠──┼─────────────────────────┼───┼───┼──┨\n┃10  │각종 월보 및 정기보고                             │      │○    │    ┃\n┠──┼─────────────────────────┼───┼───┼──┨\n┃11  │PMS 계획 및 결과보고                              │      │○    │    ┃\n┗━━┷━━━━━━━━━━━━━━━━━━━━━━━━━┷━━━┷━━━┷━━┛\n3. 통신부서\n┏━━┯━━━━━━━━━━━━━━━━━━━━┯━━━┯━━━┯━━┓\n┃일련│사    무    내    용                    │직별장│부서장│함장┃\n┃번호│                                        │      │      │    ┃\n┣━━┿━━━━━━━━━━━━━━━━━━━━┿━━━┿━━━┿━━┫\n┃1   │통신장비 정비 및 관리                   │      │○    │    ┃\n┠──┼────────────────────┼───┼───┼──┨\n┃2   │통신 및 보안기자재 운용                 │      │      │○  ┃\n┠──┼────────────────────┼───┼───┼──┨\n┃3   │통신망 운용에 관한 일반사항             │      │○    │    ┃\n┠──┼────────────────────┼───┼───┼──┨\n┃4   │긴급상황통신훈련 시행                   │      │○    │    ┃\n┠──┼──────┬────┬────────┼───┼───┼──┨\n┃5   │통신보안관리│암호장비│중요사항        │      │      │○  ┃\n┃    │            │        ├────────┼───┼───┼──┨\n┃    │            │        │일반사항        │      │○    │    ┃\n┃    │            ├────┴────────┼───┼───┼──┨\n┃    │            │암호자재취급 인가 및 해제 │      │      │○  ┃\n┠──┼──────┴─────────────┼───┼───┼──┨\n┃6   │각종 물품 청구 및 수령                  │      │      │○  ┃\n┠──┼────────────────────┼───┼───┼──┨\n┃7   │각종 장비 보수 및 관리                  │      │○    │    ┃\n┠──┼────────────────────┼───┼───┼──┨\n┃8   │각종 월보 및 정기보고                   │      │○    │    ┃\n┠──┼────────────────────┼───┼───┼──┨\n┃9   │PMS 계획 및 결과보고                    │      │○    │    ┃\n┗━━┷━━━━━━━━━━━━━━━━━━━━┷━━━┷━━━┷━━┛\n4. 기관부서\n┏━━┯━━━━━━━━━━━━━━━━━━┯━━━┯━━━┯━━┓\n┃일련│사    무    내    용                │직별장│부서장│함장┃\n┃번호│                                    │      │      │    ┃\n┣━━┿━━━━┯━━━━━━━━━━━━━┿━━━┿━━━┿━━┫\n┃1   │함정정비│함정수리 시행계획         │      │      │○  ┃\n┃    │        ├─────────────┼───┼───┼──┨\n┃    │        │함정수리 완료 보고        │      │      │○  ┃\n┃    │        ├─────────────┼───┼───┼──┨\n┃    │        │함정수리 예량 및 검사보고 │      │○    │    ┃\n┃    │        ├─────────────┼───┼───┼──┨\n┃    │        │함정수리(정기?상가?중간)│      │○    │    ┃\n┃    │        ├────────┬────┼───┼───┼──┨\n┃    │        │장비 상태 보고  │중요장비│      │      │○  ┃\n┃    │        │                ├────┼───┼───┼──┨\n┃    │        │                │일반장비│      │○    │    ┃\n┠──┼────┼────────┴────┼───┼───┼──┨\n┃2   │함정보급│기관부속(PLL) 신청        │      │○    │    ┃\n┃    │        ├─────────────┼───┼───┼──┨\n┃    │        │함정유류 신청             │      │      │○  ┃\n┃    │        ├─────────────┼───┼───┼──┨\n┃    │        │함정유류 검수             │      │      │○  ┃\n┃    │        ├─────────────┼───┼───┼──┨\n┃    │        │윤활유 취환 신청          │      │○    │    ┃\n┃    │        ├────────┬────┼───┼───┼──┨\n┃    │        │함정 폐기물처리 │처리계획│      │○    │    ┃\n┃    │        │                ├────┼───┼───┼──┨\n┃    │        │                │처리결과│      │○    │    ┃\n┃    │        ├────────┴────┼───┼───┼──┨\n┃    │        │함정 먹는 물 관리         │      │○    │    ┃\n┠──┼────┴─────────────┼───┼───┼──┨\n┃3   │각종 물품 청구 및 수령              │      │      │○  ┃\n┠──┼──────────────────┼───┼───┼──┨\n┃4   │각종 장비 보수 및 관리              │      │○    │    ┃\n┠──┼──────────────────┼───┼───┼──┨\n┃5   │각종 월보 및 정기보고               │      │○    │    ┃\n┠──┼──────────────────┼───┼───┼──┨\n┃6   │PMS 계획 및 결과보고                │      │○    │    ┃\n┗━━┷━━━━━━━━━━━━━━━━━━┷━━━┷━━━┷━━┛",
