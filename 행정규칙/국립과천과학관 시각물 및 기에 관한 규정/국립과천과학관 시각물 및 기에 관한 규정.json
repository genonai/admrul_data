    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총 칙",
        "content": "제1조(목적) 이 규정은 국립과천과학관(이하 \"과학관\"이라 한다)의 상징시각물인 과학관심벌, 과학관로고의 활용 및 과학관기의 제작ㆍ게양방법 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립과천과학관시각물및기에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "심벌",
        "chapter": "제2장 심벌 및 로고",
        "content": "제2조(심벌) 과학관의 심벌은 세계 일류 첨단과학관이자, 체험위주의 열린 과학문화 체험공간으로서 ‘비상하는 과학의 날개’ 형상을 통해 국립과천과학관의 가치를 역동적으로 표현하여 사용하며 제작사양은 별표1과 같다",
        "enforcement_date": "",
