      },
      {
        "article_no": "제5조",
        "article_title": "심사요소",
        "chapter": "",
        "content": "제5조(심사요소) 위원회는 승진후보자 명부의 적정여부와 임용권자의 추천서열 및 심사대상자의 평소 능력, 경력, 인품 등 제반사항을 고려하여 심사하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
