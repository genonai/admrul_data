      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 우주항공청 후원명칭의 사용을 승인함에 있어 그 대상, 신청 및 승인절차 등을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:우주항공청후원명칭사용승인규정#JO0001"
