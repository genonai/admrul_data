│          │          │분야 국가전문자격증 제출시  │\n│                                        │        │          │          │이공계로 본다.              │\n├────────────────────┼────┼─────┼─────┼──────────────┤\n│H52 창고 및 운송관련 서비스업           │        │          │○        │단, 전공과 관련된 운송      │\n│                                        │        │          │          │분야 국가전문자격증 제출시  │\n│                                        │        │          │          │이공계로 본다.              │\n├────────────────────┼────┼─────┼─────┼──────────────┤\n│I55 숙박업                              │        │          │○        │                            │\n├────────────────────┼────┼─────┼─────┼──────────────┤\n│I56 음식점 및 주점업                    │        │          │○        │                            │\n├────────────────────┼────┼─────┼─────┼──────────────┤\n│J58 출판업                              │        │○        │          │                            │\n├────────────────────┼────┼─────┼─────┼──────────────┤\n│J59 영상ㆍ오디오 기록물 제작 및         │        │○        │          │                            │\n│배급업                                  │        │          │          │                            │\n├────────────────────┼────┼─────┼─────┼──────────────┤\n│J60 방송업                              │        │○        │          │                            │\n├────────────────────┼────┼─────┼─────┼──────────────┤\n│J61 우편 및 통신업                      │○      │          │          │                            │\n├────────────────────┼────┼─────┼─────┼──────────────┤\n│J62 컴퓨터 프로그래밍, 시스템 통합      │○      │          │          │                            │\n│및 관리업                               │        │          │          │                            │\n├────────────────────┼────┼─────┼─────┼──────────────┤\n│J63 정보서비스업                        │○      │          │          │                            │\n├────────────────────┼────┼─────┼─────┼──────────────┤\n│K64 금융업                              │        │○      