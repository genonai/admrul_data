      "content": "별표 2. 품종심사과\n┏━━┯━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┯━━━━━┯━━┓\n┃번호│단 위 사 무 명                                                        │전결권자  │센터┃\n┃    │                                                                      ├──┬──┤장  ┃\n┃    │                                                                      │담당│과장│    ┃\n┠──┼───────┬────────┬──────────────────┼──┼──┼──┨\n┃1   │품종보호제도  │품종보호제도    │품종보호제도 기본계획 수립          │    │    │○  ┃\n┃    │운영          │관련            ├──────────────────┼──┼──┼──┨\n┃    │              │계획수립        │국제회의 및 협력 계획수립           │    │    │○  ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │기본계획 수립을 위한 자료수집·분석 │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │제도 운영 세부계획 수립             │    │○  │    ┃\n┃    │              ├────────┼──────────────────┼──┼──┼──┨\n┃    │              │특성조사요령    │특성조사요령 제·개정 및 공포       │    │    │○  ┃\n┃    │              │제·개정        ├──────────────────┼──┼──┼──┨\n┃    │              │                │특성조사요령 계획수립 및 개발       │    │○  │    ┃\n┃    │              ├────────┼──────────────────┼──┼──┼──┨\n┃    │              │품종보호 관련   │품종보호 관련 법규 제·개정안 제출  │    │    │○  ┃\n┃    │              │법규 제·개정   ├──────────────────┼──┼──┼──┨\n┃    │              │                │품종보호 관련 법규 제·개정안 검토  │    │○  │    ┃\n┃    │              ├────────┼──────────────────┼──┼──┼──┨\n┃    │              │신품종 심사     │품종보호출원 설정등록 및 관리       │    │    │○  ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │품종보호 관련 심사 및 계획 수립     │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │자체 심사관 합동회의 운영           │    │○  │    ┃\n┃    │              ├────────┼──────────────────┼──┼──┼──┨\n┃    │              │품종보호 관련   │심사관 지정                         │    │    │○  ┃\n┃    │              │자격지정 및 교육├──────────────────┼──┼──┼──┨\n┃    │              │                │품종보호 관련 심사관 교육           │    │○  │    ┃\n┃    │              ├────────┼──────────────────┼──┼──┼──┨\n┃    │              │UPOV 및         │국내·외 회의 참석 및 대응          │    │    │○  ┃\n┃    │              │국내·외 협력   ├──────────────────┼──┼──┼──┨\n┃    │              │                │국내·외 협력 관련 일반             │    │○  │    ┃\n┠──┼───────┼────────┼──────────────────┼──┼──┼──┨\n┃    │              │품종심사 지원   │품종보호공보발행                    │    │    │○  ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │품종보호출원 접수·처리             │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │품종생산·수입판매신고              │    │    │○  ┃\n┃    │              │                │접수·등록·처리                    │    │    │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃2   │품종보호      │                │종자관리사 접수·등록·처리         │    │    │○  ┃\n┃    │              ├────────┼──────────────────┼──┼──┼──┨\n┃    │              │심사료 징수 및  │품종보호관리시스템 운영 일반        │    │○  │    ┃\n┃    │              │시스템 운영     ├──────────────────┼──┼──┼──┨\n┃    │              │                │심사료 징수 및 세입조치             │    │    │○  ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │DB관리 및 전산 시스템 운영          │    │○  │    ┃\n┃    │              ├────────┼──────────────────┼──┼──┼──┨\n┃    │              │품종보호 컨설팅 │품종보호출원 관련 컨설팅            │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │품종보호 관련 대외 홍보 및 교육     │    │○  │    ┃\n┃    │              ├────────┼──────────────────┼──┼──┼──┨\n┃    │              │산림품종유통?  │산림품종 유통조사 계획수립          │    │    │○  ┃\n┃    │              │단속            ├──────────────────┼──┼──┼──┨\n┃2   │품종보호      │                │유통조사 공무원 증표 발행           │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │특별사법경찰관리 업무               │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │관련 법규위반 행정고치 및           │    │○  │    ┃\n┃    │              │                │과태료 부과                         │    │    │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │수입적응성시험 신청 접수·요건 확인 │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │종자수입요건 확인 및 신청서 심사    │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │분쟁 대상종자 접수 및               │    │○  │    ┃\n┃    │              │                │종자분쟁조정협의회 운영             │    │    │    ┃\n┃    │              ├────────┼──────────────────┼──┼──┼──┨\n┃    │              │육종가 지원     │개인육종가 지원계획 수립            │    │    │○  ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │개인육종가 지원 및 사후관리         │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │직무육성 보상금                     │    │    │○  ┃\n┃    │              │                │(실시료, 포상금 등)                 │    │    │    ┃\n┠──┼───────┼────────┼──────────────────┼──┼──┼──┨\n┃3   │재배시험      │재배시험        │재배시험지 확보계획 수립            │    │    │○  ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │재배시험지 조성 및 관리             │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │기존품종 수집 및 보존               │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │DUS test를 위한 재배시험            │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │수입적응성 시험                     │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │LMO 품종의 격리재배시험             │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │특수검정에 의한 분쟁조정            │    │    │○  ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │국내외 유통품종의 DNA지문 작성      │    │○  │    ┃\n┃    │              ├────────┼──────────────────┼──┼──┼──┨\n┃    │              │재배단지        │공동산림협약 업무                   │    │    │○  ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │시설물 유지·관리                   │    │○  │    ┃\n┃    │              │                ├──────────────────┼──┼──┼──┨\n┃    │              │                │기타 업무협의                       │    │○  │    ┃\n┗━━┷━━━━━━━┷━━━━━━━━┷━━━━━━━━━━━━━━━━━━┷━━┷━━┷━━┛",
