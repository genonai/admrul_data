  "addenda": [
    {
      "promulgation_date": "20201127",
      "promulgation_no": "1715",
      "content": "부   칙(2020. 11. 27. 제1715호)이 예규는 2020년 12월 10일부터 시행한다."
    },
    {
      "promulgation_date": "20220621",
      "promulgation_no": "1746",
      "content": "부   칙(2022. 6. 21. 제1746호)이 예규는 즉시 시행한다."
    },
    {
      "promulgation_date": "20220720",
      "promulgation_no": "1751",
      "content": "부   칙(2022. 7. 20. 제1751호)이 예규는 2022년 7월 22일부터 시행한다."
    },
    {
      "promulgation_date": "20250721",
      "promulgation_no": "1855",
      "content": "부   칙(2025. 7. 21. 제1855호)제1조(시행일) 이 예규는 2025년 8월 1일부터 시행한다.제2조(적용례) 개정 규정은 이 예규 시행 이후 신청부터 적용한다.제3조(경과규정) 이 예규 개정 이전에 사용자등록을 신청한 자는 신청 당시 예규의 유효기간을 적용한다.제4조(다른 예규의 개정) 상업등기 및 법인등기의 전자신청 절차 등에 관한 업무처리지침 일부를 다음과 같이 개정한다.제4조제1항 중 “관하여는”을 “관하여는 6. 가.를 제외하고”로 한다."
    },
    {
      "promulgation_date": "20260428",
      "promulgation_no": "1879",
      "content": "부   칙(2026. 4. 28. 제1879호)이 예규는 2026년 5월 8일부터 시행한다."
    },
    {
      "promulgation_date": "99991231",
      "promulgation_no": "9996",
      "content": "부  칙(2016. 7. 27. 제1601-3호)제1조(시행일) 이 예규는 2016년 8월 4일부터 시행한다.제2조(다른 예규의 개정) ③ 사용자등록절차에 관한 업무처리지침 일부를 다음과 같이 개정한다.제1항 중 \"법무사합동법인\"을  \"법무사법인ㆍ법무사법인(유한)\"으로 한다.① ~ ②, ④ ~ ⑥ 생략"
    },
    {
      "promulgation_date": "99991231",
      "promulgation_no": "9997",
      "content": "부  칙(2011. 10. 11. 제1391호)이 예규는 2011년 10월 13일부터 시행한다."
    },
    {
      "promulgation_date": "99991231",
      "promulgation_no": "9998",
      "content": "부  칙(2009. 3. 19. 제1278호)이 예규는 2009. 7. 1.부터 시행한다."
    },
    {
      "promulgation_date": "99991231",
      "promulgation_no": "9999",
      "content": "부  칙이 예규는 2006. 6. 1.부터 시행한다."
    }
