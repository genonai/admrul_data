  "appendices": [
    {
      "no": "0001",
      "branch": "00",
      "kind": "별표",
      "title": "입주자의 우선순위 배점표",
      "enforcement_date": "",
      "content": "[별표 1]\n입주자의 우선순위 배점표\n━━━━━━━━━┯━━┯━━━━━━━━━━━━━━━━┯━━━━━━━━━━━━\n평점요소        │총  │배점기준                        │비고\n│배점├─────────────┬──┤\n│    │기준                      │점수│\n━━━━━━━━━┿━━┿━━━━━━━━━━━━━┿━━┿━━━━━━━━━━━━\n계              │30  │                          │    │\n─────────┴──┴─────────────┴──┴────────────\n\n─────────┬──┬─────────────┬──┬────────────\n국가유산청      │5   │20년 이상                 │5   │인사시스템 확인\n근무기간        │    ├─────────────┼──┤\n│    │15년 ~ 20년 미만          │4   │\n│    ├─────────────┼──┤\n│    │10년 ~ 15년미만           │3   │\n│    ├─────────────┼──┤\n│    │ 5년~ 10년미만            │2   │\n│    ├─────────────┼──┤\n│    │ 5년 미만                 │1   │\n─────────┴──┴─────────────┴──┴────────────\n\n─────────┬──┬─────────────┬──┬────────────\n국립문화유산연구│5   │10년 이상                 │5   │인사시스템 확인\n원본원 근무기간 │    ├─────────────┼──┤\n│    │5년 ~ 10년미만            │4   │\n│    ├─────────────┼──┤\n│    │2년 ～ 5년미만            │3   │\n│    ├─────────────┼──┤\n│    │1년 ~ 2년미만             │2   │\n│    ├─────────────┼──┤\n│    │ 1년 미만                 │1   │\n─────────┴──┴─────────────┴──┴────────────\n\n─────────┬──┬─────────────┬──┬────────────\n부양가족        │5   │3자녀 이상                │5   │가족관계증명서 등\n(미성년 자녀)   │    ├─────────────┼──┤\n│    │2자녀                     │3   │\n│    ├─────────────┼──┤\n│    │1자녀                     │1   │\n─────────┴──┴─────────────┴──┴────────────\n\n─────────┬──┬─────────────┬──┬────────────\n초임발령자      │5   │최초 임용 후 5년 미만     │5   │인사시스템 확인\n(6급 이하)      │    │근무자                    │    │\n─────────┴──┴─────────────┴──┴────────────\n\n─────────┬──┬─────────────┬──┬────────────\n출·퇴근시간    │5   │120분 이상                │5   │대중교통 기준\n(편도기준)      │    ├─────────────┼──┤\n│    │90분 이상 ~ 120분 미만    │3   │\n│    ├─────────────┼──┤\n│    │60분 이상 ~ 90분 미만     │2   │\n│    ├─────────────┼──┤\n│    │60분 미만                 │1   │\n─────────┴──┴─────────────┴──┴────────────\n\n─────────┬──┬─────────────┬──┬────────────\n사회적 배려     │5   │장애·질병·임신 및 파산  │5   │장애인 증명, 진단서 등\n│    │등으로 우선 배려가 필요한 │    │\n│    │직원                      │    │\n─────────┴──┴─────────────┴──┴────────────\n\n─────────┬──┬─────────────┬──┬────────────\n기 관사 수혜자  │감점│                          │-5  │\n─────────┴──┴─────────────┴──┴────────────\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n유의사항\n──────────────────────────────────────────\n※ 동점자 처리\n① 연구원 관사에 입주한 사실이 없는 자\n② 미성년 자녀수가 많은 자\n③ 연구원 근무기간이 많은 자\n④ 국가유산청 근무기간이 많은 자\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
