  "addenda": [
    {
      "promulgation_date": "20080519",
      "promulgation_no": "2008-71",
      "content": "부칙 <제2008-71호,2008. 5. 19.>이 고시는 고시한 날부터 시행한다."
    },
    {
      "promulgation_date": "20120210",
      "promulgation_no": "2012-9",
      "content": "부칙 <제2012-9호,2012. 2. 10.>이 고시는 2012년 7월 1일부터 시행한다. 다만, 부산광역시ㆍ울산광역시ㆍ경상남도지역의 창원 통화권은 2012년 3월 1일부터 시행한다."
    },
    {
      "promulgation_date": "20130814",
      "promulgation_no": "2013-60",
      "content": "부칙 <제2013-60호,2013. 8. 14.>제1조(시행일) 이 고시는 고시한 날부터 시행한다.제2조(다른 고시의 폐지) 「통화권별 행정구역」(방송통신위원회고시 2012-9호)는 이 고시 시행일로부터 폐지한다."
    },
    {
      "promulgation_date": "20201211",
      "promulgation_no": "2020-76",
      "content": "부칙 <제2020-76호,2020. 12. 11.>이 고시는 2020년 12월 11일부터 시행한다."
    },
    {
      "promulgation_date": "20221206",
      "promulgation_no": "2022-71",
      "content": "부칙 <제2022-71호, 2022. 12. 6.>제1조(시행일) 이 고시는 고시한 날부터 시행한다.제2조(적용례) 이 고시의 통화권은「지방자치법」에 근거한 2022년 4월 15일자 기준 행정구역을 인용하였으나,「지방자치법」에 근거한 행정구역 현황과 다르더라도 영향을 받지 않고 이 고시 내에서 효력을 유지한다."
    }
  ],
