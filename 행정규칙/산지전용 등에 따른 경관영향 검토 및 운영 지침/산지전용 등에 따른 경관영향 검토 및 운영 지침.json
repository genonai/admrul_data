      "content": "[별표4]\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n┃산 지 경 관   영 향   검 토   개 요 서                                                                            ┃\n┣━━━━━┯━━━━━━━━━┯━┯━━━━━┯━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\n┃사업 개요 │사업명            │  │시행자    │                                                                  ┃\n┃          ├─────────┼─┼─────┼─────────────────────────────────┨\n┃          │위치              │  │면적      │㎡                                                                ┃\n┃          ├─────────┼─┼─────┼─────────────────────────────────┨\n┃          │기간              │∼│사업비    │천원                                                              ┃\n┃          ├─────────┼─┴─────┴─────────────────────────────────┨\n┃          │제안 사항         │                                                                                  ┃\n┣━━━━━┿━━━━━━━━━┿━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\n┃주변 현황 │경관유형          │  산림경관 / 자연경관 / 농촌경관 / 역사문화경관 / 수변경관 / 도시경관 / 기타      ┃\n┃          ├─────────┼┬─────┬──────────────────────────────────┨\n┃          │표고 분포         ││경사 분포 │                                                                    ┃\n┃          ├─────────┼┴─────┴──────────────────────────────────┨\n┃          │주요 임상         │                                                                                  ┃\n┃          ├─────────┼─────────────────────────────────────────┨\n┃          │특기 사항         │                                                                                  ┃\n┣━━━━━┿━━━━━━━━━┿━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\n┃산지 전용 │배경              │                                                                                  ┃\n┃          ├─────────┼─────────────────────────────────────────┨\n┃          │목적              │                                                                                  ┃\n┃          ├─────────┼─────────────────────────────────────────┨\n┃          │예측되는 주요 변화│                                                                                  ┃\n┃          ├─────────┼─────────────────────────────────────────┨\n┃          │검토 범위         │                                                                                  ┃\n┗━━━━━┷━━━━━━━━━┷━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n┏━━━━━━━┯━━━━┯━━┯━━━━┯━━━━━━━┓\n┃산지경관      │구분    │현황│모의실험│경관변화 기술 ┃\n┃영향          ├────┼──┼────┼───────┨\n┃모의실험      │조망점1 │    │        │              ┃\n┃요약          ├────┼──┼────┼───────┨\n┃              │조망점2 │    │        │              ┃\n┃              ├────┼──┼────┼───────┨\n┃              │조망점3 │    │        │              ┃\n┃              ├────┼──┼────┼───────┨\n┃              │조망점4 │    │        │              ┃\n┃              ├────┼──┼────┼───────┨\n┃              │조망점5 │    │        │              ┃\n┃              ┝━━━━┿━━┷━━━━┷━━━━━━━┫\n┃              │종합    │                              ┃\n┣━━━━━━━┿━━━━┷━━━━━━━━━━━━━━━┫\n┃저감 방안 및  │                                        ┃\n┃불가피한 영향 │                                        ┃\n┗━━━━━━━┷━━━━━━━━━━━━━━━━━━━━┛",
