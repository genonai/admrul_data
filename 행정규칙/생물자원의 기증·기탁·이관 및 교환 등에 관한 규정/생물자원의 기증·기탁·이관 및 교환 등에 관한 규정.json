      "content": "\n■ 생물자원의 기증?기탁?이관 및 교환 등에 관한 규정[별지 제5호서식]\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n┃기탁 생물자원 관리대장                                                                        ┃\n┣━━━━┳━━┳━━┳━━━━┳━━━━┳━━━━━━━━━━━━━━━┳━━━━┳━━┳━━┫\n┃수탁번호┃학명┃수량┃기탁자  ┃인수자  ┃취득경위                      ┃보관장소┃유형┃비고┃\n┃        ┃    ┃    ┃(기관명)┃(추진단)┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┗━━━━┻━━┻━━┻━━━━┻━━━━┻━━━━━━━━━━━━━━━┻━━━━┻━━┻━━┛\n210㎜×297㎜[백상지 80g/㎡]\n* 비고란에는 멸종위기 야생생물(Ⅰ급,Ⅱ급), 천념기념물 및 기타사항을 기재합니다.\n",
