      "content": "\n■ 생물자원의 기증?기탁?이관 및 교환 등에 관한 규정[별지 제4호서식]\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n┃기증 생물자원 관리대장                                                                        ┃\n┣━━━━┳━━┳━━┳━━━━┳━━━━┳━━━━━━━━━━━━━━━┳━━━━┳━━┳━━┫\n┃수증번호┃학명┃수량┃기증자  ┃인수자  ┃취득경위                      ┃보관장소┃유형┃비고┃\n┃        ┃    ┃    ┃(기관명)┃(추진단)┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫\n┃        ┃    ┃    ┃        ┃        ┃                              ┃        ┃    ┃    ┃\n┣━━━━╋━━╋━━╋━━━━╋━━━━╋━━━━━━━━━━━━━━━╋━━━━╋━━╋━━┫