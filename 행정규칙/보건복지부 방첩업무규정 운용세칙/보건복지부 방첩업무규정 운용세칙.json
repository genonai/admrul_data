    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 세칙은 「방첩업무규정」에서 정한 방첩업무의 적절한 운용을 위하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
