      "title": "공통사항 및 부서별 전결사항",
      "enforcement_date": "",
      "content": "■ 공통사항 및 부서별 전결사항 [별표]\n1. 공통사항\n┌─┬────────────────────────────┬─────────────┬─┐\n│번│단      위      업      무                              │전결권자                  │원│\n│  │                                                        ├─┬─┬────┬─┬──┤  │\n│호├───────┬────────┬───────────┤주│팀│조      │  │^   │장│\n│  │대표사무      │단위과제        │상세과제              │무│장│사      │수│선  │  │\n│  │              │                │                      │관│급│관      │석│임  │  │\n│  │              │                │                      │  │  │        │조│심  │  │\n│  │              │                │                      │  │  │        │사│판  │  │\n│  │              │                │                      │  │  │        │관│관  │  │\n│  │              │                │                      │  │  │        │  │∨  │  │\n├─┼───────┼────────┴───────────┼─┼─┼────┼─┴──┼─┤\n│1 │주요정책사항  │주요정책 및 기본계획의 수립             │  │  │        │        │○│\n│  │              ├────────┬───────────┼─┼─┼────┼────┼─┤\n│  │              │세부계획의 수립 │중요한 사항           │  │  │        │        │○│\n│  │              │및 집행         ├───────────┼─┼─┼────┼────┼─┤\n│  │              │                │일반적인 사항         │  │  │○      │        │  │\n│  │              ├────────┴───────────┼─┼─┼────┼────┼─┤\n│  │              │장관등 지시사항                         │  │  │        │        │○│\n│  │              ├────────────────────┼─┼─┼────┼────┼─┤\n│  │              │장·차관 회의자료                       │  │  │        │        │○│\n│  │              ├────────────────────┼─┼─┼────┼────┼─┤\n│  │              │국회 답변자료                           │  │  │        │        │○│\n├─┼───────┼────────────────────┼─┼─┼────┼────┼─┤\n│2 │정책 홍보     │인터뷰ㆍ방송 출연ㆍ기고                 │  │  │        │        │○│\n│  │              │(간담회ㆍ설명회 포함)                   │  │  │        │        │  │\n│  │              ├────────────────────┼─┼─┼────┼────┼─┤\n│  │              │브리핑ㆍ보도자료 작성 배포              │  │  │        │        │○│\n├─┼───────┼────────┬───────────┼─┼─┼────┼────┼─┤\n│3 │간행물발간    │발간기본계획    │신규발간              │  │  │        │        │○│\n│  │(해양안전지ㆍ │                ├───────────┼─┼─┼────┼────┼─┤\n│  │영문책자)     │                │정기발간              │  │  │        │○      │  │\n│  │              ├────────┴───────────┼─┼─┼────┼────┼─┤\n│  │              │간행물 조정심의 요구 및 배포            │  │  │○      │        │  │\n│  │              ├────────────────────┼─┼─┼────┼────┼─┤\n│  │              │자료 수집                               │  │○│        │        │  │\n├─┼───────┼───────┬────────────┼─┼─┼────┼────┼─┤\n│4 │복무,         │국내ㆍ외 출장,│4급 이상                │  │  │        │        │○│\n│  │근무상황      │조퇴,외출,휴가├────────────┼─┼─┼────┼────┼─┤\n│  │              │              │사무관급 이하           │  │  │○      │○      │  │\n│  │              │              │                        │  │  │조사관실│심판관실│  │\n├─┼───────┼───────┼────────────┼─┼─┼────┼────┼─┤\n│5 │민원사무      │민원처리      │상당한 판단력이         │  │  │        │○      │  │\n│  │              │              │요구되는 사항           │  │  │        │        │  │\n│  │              │              ├────────────┼─┼─┼────┼────┼─┤\n│  │              │              │단순, 반복사항          │  │○│        │        │  │\n│  │              ├───────┴────────────┼─┼─┼────┼────┼─┤\n│  │              │사실확인ㆍ증명 및 증명발급, 중간회신    │  │○│        │        │  │\n│  │              ├────────────────────┼─┼─┼────┼────┼─┤\n│  │              │민원처리현황 보고                       │  │○│        │        │  │\n│  │              ├────────────────────┼─┼─┼────┼────┼─┤\n│  │              │민원사무처리기준표 개정                 │  │○│        │        │  │\n├─┼─┬─────┼────────────────────┼─┼─┼────┼────┼─┤\n│6 │법│법률,     │제정ㆍ개정 및 폐지 기본방침             │  │  │        │        │○│\n│  │령│시행령,   ├────────────────────┼─┼─┼────┼────┼─┤\n│  │  │시행      │의견조회, 입법예고, 규제심사            │  │  │○      │        │  │\n│  │등│규칙      ├────────┬───────────┼─┼─┼────┼────┼─┤\n│  │  │          │기본방침 변경   │중요한 사항           │  │  │        │        │○│\n│  │  │          │                ├───────────┼─┼─┼────┼────┼─┤\n│  │  │          │                │경미한 사항           │  │  │        │○      │  │\n│  │  │          ├────────┴───────────┼─┼─┼────┼────┼─┤\n│  │  │          │변경사항 법제심사                       │  │  │○      │        │  │\n│  │  │          ├────────────────────┼─┼─┼────┼────┼─┤\n│  │  │          │국회ㆍ당정협의 및 공청회 개최           │  │  │        │○      │  │\n│  │  │          ├────────────────────┼─┼─┼────┼────┼─┤\n│  │  │          │자료의 수집ㆍ연구ㆍ조사                 │  │  │○      │        │  │\n│  │  │          ├────────────────────┼─┼─┼────┼────┼─┤\n│  │  │          │현지확인 및 기초조사                    │  │  │○      │        │  │\n│  │  │          ├────────────────────┼─┼─┼────┼────┼─┤\n│  │  │          │관계기관과의 업무연락ㆍ조정             │  │  │○      │        │  │\n│  │  │          ├────────────────────┼─┼─┼────┼────┼─┤\n│  │  │          │공포안 관보게재 의뢰(부령)              │  │  │○      │        │  │\n│  │  │          ├────────────────────┼─┼─┼────┼────┼─┤\n│  │  │          │단순한 회의 기록                        │  │  │○      │        │  │\n│  │  ├─────┼────────────────────┼─┼─┼────┼────┼─┤\n│  │  │훈령,     │정책결정을 요하는 중요사항              │  │  │        │        │○│\n│  │  │예규,     ├─────────┬──────────┼─┼─┼────┼────┼─┤\n│  │  │고시,     │행정절차적인 사항 │중요한 사항         │  │  │        │○      │  │\n│  │  │공고의    │                  ├──────────┼─┼─┼────┼────┼─┤\n│  │  │제정,     │                  │경미한 사항         │  │  │○      │        │  │\n│  │  │개정,     ├─────────┴──────────┼─┼─┼────┼────┼─┤\n│  │  │폐지      │기본방침이 결정된 사항                  │  │  │○      │        │  │\n│  │  │          ├────────────────────┼─┼─┼────┼────┼─┤\n│  │  │          │관계기관과의 업무협의ㆍ조정             │  │○│        │        │  │\n│  │  ├─────┼────────────────────┼─┼─┼────┼────┼─┤\n│  │  │법규해석  │중요하거나 신규사항                     │  │  │        │○      │  │\n│  │  │및        ├────────────────────┼─┼─┼────┼────┼─┤\n│  │  │질의응답  │경미, 단순, 반복적이거나 선례에 의한 사 │  │○│        │        │  │\n│  │  │          │항                                      │  │  │        │        │  │\n└─┴─┴─────┴────────────────────┴─┴─┴────┴────┴─┘\n\n2. 행정지원팀\n┌─┬──────────────────────────────┬─────┬─┐\n│번│단      위      업      무                                  │ 전결권자 │원│\n│  │                                                            ├─┬─┬─┤  │\n│호├───────┬────────┬─────────────┤주│팀│조│장│\n│  │대표사무      │단위과제        │상세과제                  │무│장│사│  │\n│  │              │                │                          │관│급│관│  │\n├─┼───────┼────────┴─────────────┼─┼─┼─┼─┤\n│1 │인사          │5급이하 근무성적평정                        │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │심판관 임용추천ㆍ전보 건의                  │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │성과급 지급대상자 선정ㆍ통보                │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │승진심사위원회 개최 및 승진심사             │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │대우공무원ㆍ승진임용                        │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │정기승급 발령                               │  │○│  │  │\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │소요정원등 조직관리                         │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │정ㆍ현원 보고                               │  │○│  │  │\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │인사관리시스템 관리                         │○│  │  │  │\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │5급이하 인사발령(전보 등)                   │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │공무원 호봉획정 및 정기호봉 승급            │  │○│  │  │\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │신원조회 의뢰                               │  │○│  │  │\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │소속직원 약력카드 작성ㆍ관리                │○│  │  │  │\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │7급이하 및 기능직 승진후보자 명부 작성ㆍ조성│  │  │  │○│\n├─┼───────┼──────────────────────┼─┼─┼─┼─┤\n│2 │감사          │감사?감찰 계획수립                         │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │감사처분                                    │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │감사관련 통보사항                           │  │  │○│  │\n├─┼───────┼───────┬──────────────┼─┼─┼─┼─┤\n│3 │부패방지      │계획 수립 및  │부패방지 시행계획 수립      │  │  │  │○│\n│  │대책          │평가          │및 주요내용의 변경          │  │  │  │  │\n│  │              │              ├──────────────┼─┼─┼─┼─┤\n│  │              │              │부패방지 추진상황 점검      │  │○│  │  │\n│  │              │              │평가 및 보고                │  │  │  │  │\n├─┼───────┼───────┼──────────────┼─┼─┼─┼─┤\n│4 │공무원 행동   │행동강령 위반 │위반사항 조사               │  │  │  │○│\n│  │강령          │사항 조치     ├──────────────┼─┼─┼─┼─┤\n│  │              │              │위반사항 조사결과 조치      │  │  │○│  │\n├─┼───────┼───────┴──────────────┼─┼─┼─┼─┤\n│5 │교육          │직장교육 기본계획 수립 및 실시              │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │국내외 승선훈련실시계획 수립                │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │소속직원 교육훈련성적 평점 관리             │○│  │  │  │\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │소속직원 각종 교육대상자 추천               │  │○│  │  │\n├─┼───────┼──────────────────────┼─┼─┼─┼─┤\n│6 │상벌          │국무총리이상 포상 추천                      │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │장관급이하 포상 추천                        │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │기타 상훈 일반                              │  │○│  │  │\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │징계업무                                    │  │  │  │○│\n├─┼───────┼──────────────────────┼─┼─┼─┼─┤\n│7 │BSC           │성과지표 확정                               │  │  │  │○│\n│  │성과관리      ├──────────────────────┼─┼─┼─┼─┤\n│  │              │성과지표실적 입력                           │○│  │  │  │\n├─┼───────┼──────────────────────┼─┼─┼─┼─┤\n│8 │직무성과계약  │직무성과계약체결                            │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │계약체결 결과보고                           │  │○│  │  │\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │평가결과 보고                               │  │  │  │○│\n├─┼───────┼──────────────────────┼─┼─┼─┼─┤\n│9 │성과관리과제  │성과관리과제 선정 및 관리                   │  │  │  │○│\n├─┼───────┼──────────────────────┼─┼─┼─┼─┤\n│10│예산          │예산요구                                    │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │예산 재배정                                 │  │○│  │  │\n├─┼───────┼──────────────────────┼─┼─┼─┼─┤\n│11│수입          │징수결의                                    │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │보고서 및 계산서                            │  │○│  │  │\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │증거서류                                    │  │○│  │  │\n├─┼───────┼──────────────────────┼─┼─┼─┼─┤\n│12│지출          │지출한도액 요구 및 재배정                   │  │○│  │  │\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │보고서 및 계산서                            │  │○│  │  │\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │증거서류                                    │  │○│  │  │\n├─┼───────┼──────────────────────┼─┼─┼─┼─┤\n│13│국유재산      │국유재산관리계획 수립                       │  │  │  │○│\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │국유재산 취득ㆍ처분                         │  │○│  │  │\n│  │              ├──────────────────────┼─┼─┼─┼─┤\n│  │              │국유재산 증감 및 현재액 계산서              │  │○│  │  │\n│  │              ├─