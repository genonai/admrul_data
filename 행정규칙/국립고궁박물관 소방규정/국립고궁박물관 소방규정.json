      {
        "article_no": "제8조",
        "article_title": "비상동원",
        "chapter": "",
        "content": "제8조(비상동원) 전 직원은 화재에 의한 비상 동원 시 통합자위소방대편성표에 의거하여 별도의 명령 없이 각자 자기부서에 출두하여 상부의 지시를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
