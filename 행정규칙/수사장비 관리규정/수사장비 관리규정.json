      "content": "(별지 제1호 서식)\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n┃수사장비 관리 대장                                                                                      ┃\n┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\n┃ 장비 종류 :                                                                                   지검명 : ┃\n┣━━━━┳━━━━━┳━━━━━━━━━┳━━━━┳━━━┳━━━━┳━━━━━┳━━━━━━━┳━━━┫\n┃관리번호┃장  비  명┃규격 및 주요부대품┃취득가격┃취득일┃취득원인┃사용부서명┃관리책임자확인┃비 고 ┃\n┣━━━━╋━━━━━╋━━━━━━━━━╋━━━━╋━━━╋━━━━╋━━━━━╋━━━━━━━╋━━━┫\n┃        ┃          ┃                  ┃        ┃      ┃        ┃          ┃              ┃      ┃\n┣━━━━╋━━━━━╋━━━━━━━━━╋━━━━╋━━━╋━━━━╋━━━━━╋━━━━━━━╋━━━┫\n┃        ┃          ┃                  ┃        ┃      ┃        ┃          ┃              ┃      ┃\n┣━━━━╋━━━━━╋━━━━━━━━━╋━━━━╋━━━╋━━━━╋━━━━━╋━━━━━━━╋━━━┫\n┃        ┃          ┃                  ┃        ┃      ┃        ┃          ┃              ┃      ┃\n┣━━━━╋━━━━━╋━━━━━━━━━╋━━━━╋━━━╋━━━━╋━━━━━╋━━━━━━━╋━━━┫\n┃        ┃          ┃                  ┃        ┃      ┃        ┃          ┃              ┃      ┃\n┣━━━━╋━━━━━╋━━━━━━━━━╋━━━━╋━━━╋━━━━╋━━━━━╋━━━━━━━╋━━━┫\n┃        ┃          ┃                  ┃        ┃      ┃        ┃          ┃              ┃      ┃\n┣━━━━╋━━━━━╋━━━━━━━━━╋━━━━╋━━━╋━━━━╋━━━━━╋━━━━━━━╋━━━┫\n┃        ┃          ┃                  ┃        ┃      ┃        ┃          ┃              ┃      ┃\n┣━━━━╋━━━━━╋━━━━━━━━━╋━━━━╋━━━╋━━━━╋━━━━━╋━━━━━━━╋━━━┫\n┃        ┃          ┃                  ┃        ┃      ┃        ┃          ┃              ┃      ┃\n┣━━━━╋━━━━━╋━━━━━━━━━╋━━━━╋━━━╋━━━━╋━━━━━╋━━━━━━━╋━━━┫\n┃        ┃          ┃                  ┃        ┃      ┃        ┃          ┃              ┃      ┃\n┣━━━━╋━━━━━╋━━━━━━━━━╋━━━━╋━━━╋━━━━╋━━━━━╋━━━━━━━╋━━━┫\n┃        ┃          ┃                  ┃        ┃      ┃        ┃          ┃              ┃      ┃\n┣━━━━╋━━━━━╋━━━━━━━━━╋━━━━╋━━━╋━━━━╋━━━━━╋━━━━━━━╋━━━┫\n┃        ┃          ┃                  ┃        ┃      ┃        ┃          ┃    