  "addenda": [
    {
      "promulgation_date": "20130614",
      "promulgation_no": "1499",
      "content": "부   칙(2013. 6. 14. 제1499호)이 예규는 2013년 7월 1일부터 시행한다."
    },
    {
      "promulgation_date": "20180525",
      "promulgation_no": "1649",
      "content": "부   칙(2018. 5. 25. 제1649호)제1조(시행일) 이 예규는 2018년 8월 1일부터 시행한다.제2조(장부의 보존에 관한 경과조치) 이 예규 시행 전의 등기사항증명서 발급신청서류 편철장에 대한 보존기간에 대해서는 종전의 규정에 따른다."
    },
    {
      "promulgation_date": "20200821",
      "promulgation_no": "1705",
      "content": "부   칙(2020. 8. 21. 제1705호)이 예규는 즉시 시행한다."
    },
    {
      "promulgation_date": "20220418",
      "promulgation_no": "1741",
      "content": "부   칙(2022. 4. 18. 제1741호)제1조(시행일) 이 예규는 2022년 4월 21일부터 시행한다.제2조(다른 예규의 개정) 「저당권부채권에 대한 채권담보권의 부기등기에 관한 업무처리지침」(등기예규 제1462호) 일부를 다음과 같이 개정한다.제2조 중 “상업등기법에 따라 상호등기를 한 사람”을 “「부가가치세법」에 따라 사업자등록을 한 사람”으로 한다."
    },
    {
      "promulgation_date": "20221118",
      "promulgation_no": "1757",
      "content": "부   칙(2022. 11. 18. 제1757호)이 예규는 즉시 시행한다."
    },
    {
      "promulgation_date": "99991231",
      "promulgation_no": "9999",
      "content": "부   칙이 예규는 2012년 6월 11일부터 시행한다."
    }
  ],
