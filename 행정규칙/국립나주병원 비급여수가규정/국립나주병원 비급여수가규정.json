  "appendices": [
    {
      "no": "0001",
      "branch": "00",
      "kind": "별표",
      "title": "비급여 항목 및 금액",
      "enforcement_date": "",
      "content": "[별표1] 비급여 항목 및 금액\n┏━━━━━┯━━━━━━━━━━━━━━━━━━━━━┯━━━━━━━┯━━┓\n┃구 분     │비급여 항목                               │금 액         │비고┃\n┠─────┼─────────────────────┼───────┼──┨\n┃심리검사  │숫자 따라하기  검사(Digit Span Test)      │5,000         │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │시각 단기기억 검사(Visual Span Test)      │5,000         │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │언어지속 검사                             │5,000         │    ┃\n┃          │(Auditory Continuous Performance Test)    │              │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │시각지속 검사                             │5,000         │    ┃\n┃          │(Visual Continuous Performance Test)      │              │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │조건 언어지속 검사                        │5,000         │    ┃\n┃          │(Auditory Controlled CPT)                 │              │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │조건 시각지속 검사                        │5,000         │    ┃\n┃          │(Visual Controlled CPT)                   │              │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │단어?색채 검사                           │5,000         │    ┃\n┃          │(Stroop Test(Word-Color Test)             │              │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │선로잇기 검사(Trail-Making Test)          │5,000         │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │카드분류 검사                             │5,000         │    ┃\n┃          │(Wisconsin Card Sorting Test)             │              │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │언어기억 검사                             │5,000         │    ┃\n┃          │(Verbal Learning (Memory) Test)           │              │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │전산화 신경 인지기능 검사(SCNT)           │50,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │기억평가검사(Memory Assessment Scale;MAS) │40,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │성격평가척도검사                          │20,000        │    ┃\n┃          │(Personality Assessment Inventroy;PAI)    │              │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │뉴로 피드백  검사                         │20,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │한국판 캘리포니아                         │50,000        │    ┃\n┃          │언어학습검사(k-CVLT)                      │              │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │종합인지기능검사(CAS)                     │50,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │스트룹아동 색상 단어검사(STOROOP)         │10,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │힌국판 치매 평가검사(K-DRS)               │40,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │종합 주의력 검사                          │120,000       │    ┃\n┃          │(Comprehensive Attention Teat ; CAT)      │              │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │단순선택주의력(시각)                      │20,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │단순선택주의력(청각)                      │20,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │간섭선택주의력                            │20,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │억제선택주의력                            │20,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │분할주의력                                │20,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │작업기억력(주의력)                        │20,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │웩슬러 기억 평정 척도(K-WMS)              │150,000       │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │성인용Rey-Kim 기억검사                    │50,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │영유아 언어발달 검사                      │30,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │심리적 재활중재치료(개인)                 │20,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │심리적 재활중재치료(집단)                 │12,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │심리적 재활중재치료(집단세트)             │50,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │성인용 Kims 전두엽관리기능 신경심리검사Ⅱ │50,000        │    ┃\n┠─────┼─────────────────────┼───────┼──┨\n┃뇌파검사  │자율신경계검사(HRV)-G                     │15,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │자율신경계검사(HRV)                       │5,000         │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │경두개자극술(TMS)                         │25,000        │    ┃\n┠─────┼─────────────────────┼───────┼──┨\n┃병리검사  │마약정성검사(10종)                        │50,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │인플루엔자 A?B바이러스 항원검사          │15,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │COVID-19 신속항원검사                     │13,000        │    ┃\n┠─────┼─────────────────────┼───────┼──┨\n┃기타검사  │체성분검사                                │5,000         │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │옴니핏(외래 초검)                         │30,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │옴니핏(외래 재검)                         │20,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │옴니핏(직장인 초검)                       │40,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │옴니핏(직장인 재검)                       │35,000        │    ┃\n┠─────┼─────────────────────┼───────┼──┨\n┃치과 처치 │불소도포                                  │10,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │레진                                      │50,000～80,000│    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │스켈링(간단)                              │30,000        │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │구치부 금관 치관                          │400,000       │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │전치부 금속  도재관                       │300,000       │    ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │치과치료대(POST)                          │100,000       │    ┃\n┠─────┼─────────────────────┼───────┼──┨\n┃약제      │삐콤정                                    │18            │신설┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │메이킨큐장용정                            │160           │”  ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │그린관장약30ml                            │320           │”  ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │안티푸라민에스로션100ml                   │2,520         │”  ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │파메콘정                                  │55            │”  ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │액티페린정                                │80            │”  ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │후시딘연고10g                             │5,440         │”  ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │아비나파스타(오라메디연고)                │2,106         │”  ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │메디락디에스장용캡슐                      │32            │”  ┃\n┃          ├─────────────────────┼───────┼──┨\n┃          │타미락신연고50g                           │1,460         │”  ┃\n┗━━━━━┷━━━━━━━━━━━━━━━━━━━━━┷━━━━━━━┷━━┛\n(단위: 원)",
