      "content": "<수용·사용할 토지의 권리명세서 : 압량관리소>\n┌─┬────┬───┬─┬──────┬─────────────────┬───────────┬─┐\n│번│소재지  │지 번 │지│지 적(㎡)   │토 지 소 유 자                    │관 계 인              │비│\n│호│        │      │목├───┬──┼────┬────────────┼───┬───┬───┤고│\n│  │        │      │  │공부상│편입│성 명   │주 소                   │성 명 │주 소 │내 용 │  │\n│  │        │      │  │면적  │면적│(명칭)  │                        │(명칭)│      │      │  │\n├─┼────┼───┼─┼───┼──┼────┼────────────┼───┼───┼───┼─┤\n│1 │경상북도│30-1  │답│513   │513 │유숙자  │경산시 중방동 319-80    │      │      │      │  │\n│  │경산시  │      │  │      │    ├────┼────────────┼───┼───┼───┼─┤\n│  │압량읍  │      │  │      │    │추경희  │경산시 중방동 319-80    │      │      │      │  │\n│  │당리리  │      │  │      │    ├────┼────────────┼───┼───┼───┼─┤\n│  │        │      │  │      │    │추점희  │경주시 황성동 508-1     │      │      │      │  │\n│  │        │      │  │      │    │        │신안그린카프맨션 101동  │      │      │      │  │\n│  │        │      │  │      │    │        │1011호                  │      │      │      │  │\n│  │        │      │  │      │    ├────┼────────────┼───┼───┼───┼─┤\n│  │        │      │  │      │    │추영희  │안양시 동안구 평촌동    │      │      │      │  │\n│  │        │      │  │      │    │        │899 향촌아파트 309동    │      │      │      │  │\n│  │        │      │  │      │    │        │1002호                  │      │      │      │  │\n│  │        │      │  │      │    ├────┼────────────┼───┼───┼───┼─┤\n│  │        │      │  │      │    │추준호  │서울 강남구 논현동      │      │      │      │  │\n│  │        │      │  │      │    │        │147-22 202호            │      │      │      │  │\n└─┴────┴───┴─┴───┴──┴────┴────────────┴───┴───┴───┴─┘\n┌─┬────┬───┬─┬───────┬────────────────┬───────────────┬─┐\n│번│소재지  │지 번 │지│지 적(㎡)     │토 지 소 유 자                  │관 계 인                      │비│\n│호│        │      │목├───┬───┼───┬────────────┼────┬─────┬────┤고│\n│  │        │      │  │공부상│편입  │성 명 │주 소                   │성 명   │주 소     │내 용   │  │\n│  │        │      │  │면적  │면적  │(명칭)│                        │(명칭)  │          │        │  │\n├─┼────┼───┼─┼───┼───┼───┼────────────┼────┼─────┼────┼─┤\n│2 │경상북도│30-2  │답│1,633 │1,633 │추선화│경상북도 경산시 압량면  │진량    │경상북도  │근저당권│  │\n│  │경산시  │      │  │      │      │      │당리리 319              │새마을  │경산시    │        │  │\n│  │압량읍  │      │  │      │      ├───┼────────────┤금고    │진량읍    │        │  │\n│  │당리리  │      │  │      │      │추미라│경상북도 경산시 압량면  │        │공단로    │        │  │\n│  │        │      │  │      │      │      │당리리 319              │        │471       │        │  │\n│  │        │      │  │      │      ├───┼────────────┤        │          │        │  │\n│  │        │      │  │      │      │추연관│경상북도 경산시 압량면  │        │          │        │  │\n│  │        │      │  │      │      │      │당리리 319              │        │          │        │  │\n│  │        │      │  │      │      ├───┼────────────┤        │          │        │  │\n│  │        │      │  │      │      │임채경│경상북도 경산시 압량면  │        │          │        │  │\n│  │        │      │  │      │      │      │당리길4길 1-1           │        │          │        │  │\n├─┤        ├───┼─┼───┼───┼───┼────────────┼────┼─────┼────┼─┤\n│3 │        │30-7  │답│499   │499   │김차곤│경상북도 경산시 중산동  │        │          │        │  │\n│  │        │      │  │      │      │      │35-3 경남아파트         │        │          │        │  │\n│  │        │      │  │      │      │      │102-903                 │        │          │        │  │\n├─┤        ├───┼─┼───┼───┼───┼────────────┼────┼─────┼────┼─┤\n│4 │        │31    │답│1747  │1747  │정도석│대구 수성구 옥수동 179  │        │          │        │  │\n│  │        │      │  │      │      │      │덕일빌라 101호          │        │          │        │  │\n├─┤        ├───┼─┼───┼───┼───┼────────────┼────┼─────┼────┼─┤\n│5 │        │32    │답│1,771 │1,771 │안승걸│대구 달서구 두류동      │압량농업│경상북도  │근저당권│  │\n│  │        │      │  │      │      │      │149-4                   │협동조합│경산시    │        │  │\n│  │        │      │  │      │      │      │                        │        │압량면    │        │  │\n│  │        │      │  │      │      │      │                        │        │대학로7   │        │  │\n│  │        │      │  │      │      │      │                        │        │5길2      │        │  │\n├─┴────┼───┼─┼───┼───┼───┼────────────┼────┼─────┼────┼─┤\n│합계        │5필지 │  │6,163 │6,163 │      │                        │        │          │        │  │\n└──────┴───┴─┴───┴───┴───┴────────────┴────┴─────┴────┴─┘",
