    │\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\n? 건설폐기물처리          │    │    │    │    │    │    │분리발주공사 작성 제외\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\n???                        │    │    │    │    │    │    │\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\n? 사업장폐기물처리        │    │    │    │    │    │    │\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\n???                        │    │    │    │    │    │    │\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\n? 지정폐기물처리          │    │    │    │    │    │    │철거대상시설에서 발생하는\n│    │    │    │    │    │    │폐석면 등\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\n???                        │    │    │    │    │    │    │\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\n환경관리비(간접공사비)        │    │    │    │    │    │    │\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\na. 환경관리활동             │    │    │    │    │    │    │\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\n???                        │    │    │    │    │    │    │\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\nb. 시험검사비               │    │    │    │    │    │    │\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\n???                        │    │    │    │    │    │    │\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\nc. 교육?지도?훈련비       │    │    │    │    │    │    │\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\n???                        │    │    │    │    │    │    │\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\nd. 기타                     │    │    │    │    │    │    │\n────────────────┼──┼──┼──┼──┼──┼──┼──────────────\n???                        │    │    │    │    │    │    │\n────────────────┴──┴──┴──┴──┴──┴──┴──────────────\n\n\n210㎜×297㎜[백상지(80g/㎡)]\n",
