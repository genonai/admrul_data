      "content": "[별지2] 경고 등 처분대장\n경 고 등  처 분 대 장\n┏━━┯━━┯━━━━━━━━━━━━━━━┯━━━━━━━┯━━┓\n┃일련│처분│처  분  대  상  자            │처  분  사  유│비고┃\n┃번호│일자├───┬───┬───┬───┤              │    ┃\n┃    │    │소  속│직  위│직  명│성  명│              │    ┃\n┣━━┿━━┿━━━┿━━━┿━━━┿━━━┿━━━━━━━┿━━┫\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┠──┼──┼───┼───┼───┼───┼───────┼──┨\n┃    │    │      │      │      │      │              │    ┃\n┗━━┷━━┷━━━┷━━━┷━━━┷━━━┷━━━━━━━┷━━┛",
