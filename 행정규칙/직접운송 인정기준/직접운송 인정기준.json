        "images": [],
        "provision_id": "admrul:직접운송인정기준#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "재검토 기한",
        "chapter": "",
        "content": "제3조(재검토 기한) 국토교통부장관은 「훈령·예규 등의 발령 및 관리에 관한 규정」에 따라 이 고시에 대하여 2016년 7월 1일 기준으로 매 3년이 되는 시점(매 3년째의 6월 30일까지를 말한다)마다 그 타당성을 검토하여 개선 등의 조치를 하여야 한다.",
        "enforcement_date": "",
