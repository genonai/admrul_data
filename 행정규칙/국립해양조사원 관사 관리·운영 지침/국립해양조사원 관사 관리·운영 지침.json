      "title": "인계인수서",
      "enforcement_date": "",
      "content": "(별지 제6호 서식)\n┌────────────────────────────┐\n│인 계 인 수 서                                          │\n│┌───┬──────────────────────┐│\n││주소  │                                            ││\n││및    ├──────────────────────┤│\n││위치  │             동       호     (방    호)     ││\n│├───┼──────────────────┬───┤│\n││구분  │점검사항                            │상 태 ││\n│├───┼──────────────────┼───┤│\n││거실  │ 출입문, 창문 개폐상태              │      ││\n││      ├──────────────────┼───┤│\n││      │ 전기, 전화 등 콘센트 부착 및 작동상│      ││\n││      │태                                  │      ││\n││      ├──────────────────┼───┤│\n││      │ 온도조절기 작동 상태               │      ││\n│├───┼──────────────────┼───┤│\n││방    │ 출입문, 창문 개폐상태              │      ││\n││      ├──────────────────┼───┤│\n││      │ 전기, 전화 등 콘센트 부착 및 작동상│      ││\n││      │태                                  │      ││\n││      ├──────────────────┼───┤│\n││      │ 출입문, 창문 개폐상태              │      ││\n│├───┼──────────────────┼───┤│\n││화장실│ 위생기구 부착 및 작동상태          │      ││\n││      ├──────────────────┼───┤│\n││      │ 욕조 파손여부 및 타일 부착상태     │      ││\n│├───┼──────────────────┼───┤│\n││기 타 │ 베란다 수도꼭지 작동상태           │      ││\n││      ├──────────────────┼───┤│\n││      │주방기기 부착 및 작동상태           │      ││\n││      ├──────────────────┼───┤│\n││      │난방용 밸브 작동상태                │      ││\n││      ├──────────────────┼───┤│\n││      │ 전등 파손여부 등                   │      ││\n│├───┼──────────────────┴───┤│\n││특기  │                                            ││\n││사항  │                                            ││\n│└───┴──────────────────────┘│\n│인계자 :  소속         직         성명                  │\n│인수자 :  소속         직         성명                  │\n│입회자 :  소속         직         성명                  │\n│                                                        │\n│ 관사관리운영위원회 위원장 귀하                         │\n└────────────────────────────┘",
