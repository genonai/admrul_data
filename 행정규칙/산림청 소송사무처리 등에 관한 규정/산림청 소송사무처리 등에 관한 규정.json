    │    │    │  │    ├──┼──┼──┼──┼──┼──┼──┤    │    ├────┼────┤    │    │    │\n│      │    │        │    │    │      │    │    │  │    │    │    │    │    │    │    │    │    │    │        │        │    │    │    │\n│      │    ├────┤    │    │      │    │    │  │    ├──┼──┼──┼──┼──┼──┼──┤    │    ├────┼────┤    │    │    │\n│      │    │        │    │    │      │    │    │  │    │    │    │    │    │    │    │    │    │    │        │        │    │    │    │\n└───┴──┴────┴──┴──┴───┴──┴──┴─┴──┴──┴──┴──┴──┴──┴──┴──┴──┴──┴────┴────┴──┴──┴──┘\n\n\n297mm×210mm[백상지(80g/㎡)〕\n",
