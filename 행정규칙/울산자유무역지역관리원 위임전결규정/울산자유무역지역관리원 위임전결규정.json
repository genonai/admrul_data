    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 행정업무의 효율적 운영에 관한 규정 제10조제2항 및 지식경제부와 그 소속기관 위임전결규정 제6조에 의하여 울산자유무역지역관리원의 위임전결사항과 그 절차를 정하여 권한과 책임을 분명히 하고 업무처리에 신속을 기함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "citation",
            "delegation_type": null,
            "target_category": "행정규칙",
            "source_article_no": "제1조",
            "source_clause": "제1조",
            "link_text": "제6조",
            "line_text": "",
            "target_law_name": "위임전결규정",
            "target_article_no": "제6조",
            "target_article_title": "",
            "target_mst": "",
            "target_url": "https://www.law.go.kr/행정규칙/위임전결규정/제6조",
            "resolve_method": "text_supplement",
            "source_provision_id": "admrul:울산자유무역지역관리원위임전결규정#JO0001",
            "reference_id": "admrul:위임전결규정#JO0006"
          }
        ],
        "images": [],
        "provision_id": "admrul:울산자유무역지역관리원위임전결규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용례",
        "chapter": "",
        "content": "제2조(적용례) 울산자유무역지역관리원 위임전결사항은 다른 법령에 별도규정이 있는 것을 제외하고는 이 규정에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산자유무역지역관리원위임전결규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "전결권자의 구분",
        "chapter": "",
        "content": "제3조(전결권자의 구분) 이 규정에서의 전결권자는 원장, 과장, 담당자로 구분한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산자유무역지역관리원위임전결규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "전결사항",
        "chapter": "",
        "content": "제4조(전결사항) ①전결권자의 위임전결사항은 \"별표\"와 같다.②별표에 열거하지 아니한 사항은 이 규정에 의해 당해 업무와 종류나 성격이 유사한 사항이 있는 경우에는 그에 준하여 전결하고, 유사사항이 없는 경우에는 당해업무의 주관 과장 등의 판단으로 전결권자를 정하여 처리할 수 있다. 다만, 전결권자를 판단하기 어려운 사항에 대하여는 원장의 지시에 따라 처리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산자유무역지역관리원위임전결규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "전결의 책임",
        "chapter": "",
        "content": "제5조(전결의 책임) 위임전결사항에 대하여는 그 전결권자가 원장에 대하여 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산자유무역지역관리원위임전결규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "협의사항",
        "chapter": "",
        "content": "제6조(협의사항) 위임전결사항 중 다른 과와 관련되는 사항은 해당 과와 협의하여야 하며, 협의되지 않은 경우에는 원장의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산자유무역지역관리원위임전결규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "중요사항 등의 결재",
        "chapter": "",
        "content": "제7조(중요사항 등의 결재) ①전결권자는 그의 전결사항이라 하더라도 그 내용이 특히 중요하거나 성질상 필요하다고 인정되는 때에는 원장의 결재를 받아야 한다②원장이 특히 필요하다고 인정하여 지시하는 사항에 대하여는 이 규정에도 불구하고 원장의 지시에 따라 전결권자를 별도로 지정하여 처리 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산자유무역지역관리원위임전결규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "전결권의 부재",
        "chapter": "",
        "content": "제8조(전결권의 부재) 전결권자가 결원, 출장, 휴가 기타의 사유로 부재 중이거나 사정에 의하여 결재할 수 없을 때에는 그 직무를 대리하는 자가 결재할 수 있으며, 그 내용이 중요한 사항은 결재권자에게 사후에 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산자유무역지역관리원위임전결규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "보고",
        "chapter": "",
        "content": "제9조(보고) 전결권자는 상급자가 알아야 한다고 판단되는 사항에 대하여 사전 또는 사후에 그 처리내용을 보고할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:울산자유무역지역관리원위임전결규정#JO0009"
      }
    ]
  },
