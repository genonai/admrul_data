      "enforcement_date": "",
      "content": "<별표 1>\n1. 공통사항\n┌──┬─────────────────────┬──────────┬──┐\n│일련│업     무     내     용                   │기안?전결권자      │원장│\n│번호├───────┬─────────────┼───────┬──┤    │\n│    │단 위 업 무   │세 부 내 용               │담 당 자      │과장│    │\n│    │              │                          ├───┬───┤    │    │\n│    │              │                          │실무급│4∼5급│    │    │\n┝━━┿━━━━━━━┷━━━━━━━━━━━━━┿━━━┿━━━┿━━┿━━┥\n│1   │대통령, 국무총리, 장관지시사항 추진계획   │      │기안  │    │○  │\n│    │수립                                      │      │      │    │    │\n├──┼───────┬─────────────┼───┼───┼──┼──┤\n│2   │기본운영계획  │기본계획수립 및 변경      │      │기안  │    │○  │\n│    │              ├──────┬──────┼───┼───┼──┼──┤\n│    │              │세부시행    │중요사항    │      │기안  │    │○  │\n│    │              │계획수립 및 ├──────┼───┼───┼──┼──┤\n│    │              │집행 감독   │일반사항    │기안  │      │○  │    │\n│    │              ├──────┴──────┼───┼───┼──┼──┤\n│    │              │현지확인 및 자료수집      │기안  │      │○  │    │\n├──┼───────┴─────────────┼───┼───┼──┼──┤\n│3   │방침이 결정된 사항의 통보, 회보 및 독촉   │기안  │      │○  │    │\n├──┼─────────────────────┼───┼───┼──┼──┤\n│4   │법령 및 훈령, 예규 등 행정규칙의 제정, 개 │      │기안  │    │○  │\n│    │폐                                        │      │      │    │    │\n├──┼───────┬──────┬──────┼───┼───┼──┼──┤\n│5   │자료수집, 분석│정책자료의  │관계기관    │기안  │      │○  │    │\n│    │평가 및 종합  │종합 및 준비│조사협조    │      │      │    │    │\n│    │              │            │및 조회     │      │      │    │    │\n│    │              │            ├──────┼───┼───┼──┼──┤\n│    │              │            │부서간      │기안  │○    │    │    │\n│    │              │            │자료수집    │      │      │    │    │\n│    │              │            │및 협조     │      │      │    │    │\n│    │              ├──────┴──────┼───┼───┼──┼──┤\n│    │              │기본운영계획 수립을       │기안  │      │○  │    │\n│    │              │위한 자료수집 및 분석     │      │      │    │    │\n│    │              │평가                      │      │      │    │    │\n│    │              ├─────────────┼───┼───┼──┼──┤\n│    │              │기타업무계획 수립을       │      │○    │    │    │\n│    │              │위한 준비 및 협조         │      │      │    │    │\n├──┼───────┼─────────────┼───┼───┼──┼──┤\n│6   │관계부처와의  │중요정책사항              │      │기안  │    │○  │\n│    │업무 협조     ├─────────────┼───┼───┼──┼──┤\n│    │              │일반사항                  │기안  │      │○  │    │\n│    │              ├─────────────┼───┼───┼──┼──┤\n│    │              │경미한 사항               │기안  │      │○  │    │\n├──┼───────┼─────────────┼───┼───┼──┼──┤\n│7   │각종정례 보고 │중요사항                  │      │기안  │    │○  │\n│    │및 통계처리   ├─────────────┼───┼───┼──┼──┤\n│    │              │일반사항                  │기안  │      │○  │    │\n│    │              ├─────────────┼───┼───┼──┼──┤\n│    │              │경미한 사항               │기안  │      │○  │    │\n├──┼───────┼─────────────┼───┼───┼──┼──┤\n│8   │민원사무처리  │중요사항                  │      │기안  │    │○  │\n│    │              ├─────────────┼───┼───┼──┼──┤\n│    │              │일반사항                  │기안  │      │○  │    │\n│    │              ├─────────────┼───┼───┼──┼──┤\n│    │              │단순반복적인 의견 질의    │기안  │○    │    │    │\n│    │              │및 사실조사, 각종확인에   │      │      │    │    │\n│    │              │관련된 사항               │      │      │    │    │\n└──┴───────┴─────────────┴───┴───┴──┴──┘\n┌──┬───────────────────┬──────────┬──┐\n│일련│업     무     내     용               │기안?전결권자      │원장│\n│번호├────────┬──────────┼───────┬──┤    │\n│    │단 위 업 무     │세 부 내 용         │담 당 자      │과장│    │\n│    │                │                    ├───┬───┤    │    │\n│    │                │                    │실무급│4∼5급│    │    │\n┝━━┿━━━━━━━━┿━━━━━━━━━━┿━━━┿━━━┿━━┿━━┥\n│9   │국내출장 및 복  │각 과장             │기안  │      │    │○  │\n│    │명              ├──────────┼───┼───┼──┼──┤\n│    │                │과장 외             │기안  │      │○  │    │\n│    ├────────┼──────────┼───┼───┼──┼──┤\n│    │휴가 및 조퇴,   │각 과장             │기안  │      │    │○  │\n│    │외출 등 승인    ├──────────┼───┼───┼──┼──┤\n│    │                │과장 외             │기안  │      │○  │    │\n│    ├────────┼──────────┼───┼───┼──┼──┤\n│    │초과근무명령    │5급 이하            │기안  │      │○  │    │\n│    │                ├──────────┼───┼───┼──┼──┤\n│    │                │비정규직            │기안  │      │○  │    │\n│    ├────────┼──────────┼───┼───┼──┼──┤\n│    │공익근무요원    │직무수행 및 휴가,   │기안  │○    │    │    │\n│    │복무관리        │병가 등 복무관리    │      │      │    │    │\n├──┼────────┴──────────┼───┼───┼──┼──┤\n│10  │해외파견, 훈련 및 출장                │기안  │      │    │○  │\n├──┼────────┬──────────┼───┼───┼──┼──┤\n│11  │업무 분담지정   │과내                │기안  │      │○  │    │\n├──┼────────┼──────────┼───┼───┼──┼──┤\n│12  │각종 간행물 발  │중요사항            │      │기안  │    │○  │\n│    │간              ├──────────┼───┼───┼──┼──┤\n│    │                │경미한 사항         │기안  │      │○  │    │\n├──┼────────┼──────────┼───┼───┼──┼──┤\n│13  │물품의 조달 요  │중요사항            │      │기안  │    │○  │\n│    │구와 관리 및 수 ├──────────┼───┼───┼──┼──┤\n│    │불에 관한 사항  │경미한 사항         │기안  │      │○  │    │\n├──┼────────┼────┬─────┼───┼───┼──┼──┤\n│14  │예산집행 및     │물품제조│1건당     │기안  │      │    │○  │\n│    │물품관리        │구매    │3,000만원 │      │      │    │    │\n│    │                │        │이상      │      │      │    │    │\n│    │                │        ├─────┼───┼───┼──┼──┤\n│    │                │        │1건당     │기안  │      │○  │    │\n│    │                │        │3,000만원 │      │      │    │    │\n│    │                │        │미만      │      │      │    │    │\n│    │                ├────┼─────┼───┼───┼──┼──┤\n│    │                │시설공사│1건당     │기안  │      │    │○  │\n│    │                │        │5,000만원 │      │      │    │    │\n│    │                │        │이상      │      │      │    │    │\n│    │                │        ├─────┼───┼───┼──┼──┤\n│    │                │        │1건당     │기안  │      │○  │    │\n│    │                │        │5,000만원 │      │      │    │    │\n│    │                │