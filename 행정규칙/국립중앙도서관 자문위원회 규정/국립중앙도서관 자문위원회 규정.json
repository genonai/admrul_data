      {
        "article_no": "제8조",
        "article_title": "의견의 청취",
        "chapter": "",
        "content": "제8조(의견의 청취) 위원회는 필요시 관계 인사를 초청하여 의견을 들을 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "admrul:국립중앙도서관자문위원회규정#JO0008"
