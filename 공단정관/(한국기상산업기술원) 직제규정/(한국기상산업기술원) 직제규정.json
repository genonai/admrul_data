      {
        "article_no": "제4조",
        "article_title": "하부조직",
        "chapter": "제2장 조직",
        "content": "제4조(하부조직) 주요조직 및 주요조직에 준하는 조직의 업무를 수행하기 위해 실ㆍ팀 단위의 하부조직을 둘 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
