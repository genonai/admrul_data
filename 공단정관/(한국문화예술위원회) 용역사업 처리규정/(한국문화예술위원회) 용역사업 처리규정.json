      {
        "article_no": "제9조",
        "article_title": "직접인건비의 범위",
        "chapter": "",
        "content": "제9조(직접인건비의 범위) 직접인건비라 함은 당해 업무에 직접 투입되는 기술(또는 연구)자의 노임단가를 적용한 인건비를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국문화예술위원회)용역사업처리규정#JO0009"
