  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 지침은 한국여성과학기술인육성재단(이하 \"재단\"이라 한다)에서 최신정보수집과 신속한 업무처리를 위한 업무용 통신기기의 활용을 지원함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국여성과학기술인육성재단)업무용통신비지원지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "지원대상",
        "chapter": "",
        "content": "제2조(지원대상) ① 통신비의 지원대상자는 이사장으로 한다.② 제1항에도 불구하고 재단에서 대외적으로 처리하는 업무의 특성을 감안하여 이사장이 필요하다고 인정되는 경우에는 추가로 지원대상자를 선정할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국여성과학기술인육성재단)업무용통신비지원지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "지원기간",
        "chapter": "",
        "content": "제3조(지원기간) 업무용 통신비의 지원은 대상자에 대한 지원 사유 발생일로부터 종료일까지로 한다. 다만, 지원 사유가 종료된 경우 발령일 기준으로 월 지원금액을 일할 계산하여 산정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국여성과학기술인육성재단)업무용통신비지원지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "청구 및 지급",
        "chapter": "",
        "content": "제4조(청구 및 지급) 이 지침에서 정한 지원대상자는 이용 내역을 확인할 수 있는 월청구요금내역서 등 증빙서류를 구비하여 매월 20일까지 담당부서에 청구하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국여성과학기술인육성재단)업무용통신비지원지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "지급금액",
        "chapter": "",
        "content": "제5조(지급금액) ① 지급금액은 월 10만원 이하 실비로 지급한다.② 제1항에도 불구하고 대외적으로 처리하는 업무의 양을 감안하여 이사장이 필요하다고 인정하는 경우에는 사용료를 조정하여 지원할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국여성과학기술인육성재단)업무용통신비지원지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "지급의 제한",
        "chapter": "",
        "content": "제6조(지급의 제한) 실비로 인정되는 사용료는 통신서비스 요금에 한하며, 소액결제, 통신기기 할부금 등은 지원액에서 제외한다. 단, 국외출장시 사용한 로밍비용은 별도로 지원할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국여성과학기술인육성재단)업무용통신비지원지침#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "기타사항",
        "chapter": "",
        "content": "제7조(기타사항) 이 지침에서 규정한 사항 이외의 통신비 지원에 관한 사항은 이사장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국여성과학기술인육성재단)업무용통신비지원지침#JO0007"
      }
    ]
  },
