      {
        "article_no": "제9조",
        "article_title": "운영비보조금의 사용",
        "chapter": "",
        "content": "제9조(운영비보조금의 사용) 운영비보조금은 전조의 규정에 불구하고 사용잔액이 발생하였을 경우에는 그 잔액을 익년도로 이월하여 해당 연도 운영비로 사용할 수 있다.<신설 1984. 3. 13., 2025. 11. 1.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:대한적십자사보조금관리시행규칙#JO0009"
      }
