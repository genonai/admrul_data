    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총칙",
        "content": "제1조(목적) 이 규칙은 한국교육과정평가원(이하 \"평가원\"이라 한다)의 임원 및 직원이 공무로 외국에 여행할 때에 지급하는 여비에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국교육과정평가원)국외여비규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "여비의 종류",
        "chapter": "제1장 총칙",
        "content": "제2조(여비의 종류) 여비는 운임, 일비, 숙박비, 식비, 준비금 등으로 구분한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국교육과정평가원)국외여비규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "여비의 계산",
        "chapter": "제1장 총칙",
        "content": "제3조(여비의 계산) 여비는 통상의 경로와 방법에 의하여 이를 계산한다. 다만, 공무의 형편상 또는 천재지변 기타 부득이한 사유로 인하여 통상의 경로와 방법에 의한 여행을 하기 곤란한 경우에는 실제로 행한 경로 및 방법에 의하여 계산한다. <개정 2010. 5. 7.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국교육과정평가원)국외여비규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "여비의 변경",
        "chapter": "제1장 총칙",
        "content": "제4조(여비의 변경) 여비에 관한 지급 규정이나 승진 또는 전직 등에 따른 직급 변경 등에 의하여 여비를 다시 계산하여야 할 사유가 발생할 때에는 그 사유가 발생한 후 최초의 목적지에 도달한 날로부터 구분하여 계산한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국교육과정평가원)국외여비규칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "여비의 산정",
        "chapter": "제1장 총칙",
        "content": "제5조(여비의 산정) 같은 날에 출장경유지 등 변경사유로 여비의 정액을 달리하여야 할 필요가 있는 경우에는 많은 액으로써 이를 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국교육과정평가원)국외여비규칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "거주지로부터 직접 여행시의 여비",
        "chapter": "제1장 총칙",
        "content": "제6조(거주지로부터 직접 여행시의 여비) 근무지 또는 출장지 이외의 곳에 거주 또는 체재하는 자가 그곳에서 목적지에 바로 여행할 경우에는 그곳에서 목적지에 이르는 여비를 지급한다. 다만, 그 여비는 근무지 또는 출장지에서 목적지까지의 여비를 초과하지 못한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국교육과정평가원)국외여비규칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "여비의 감액 등",
        "chapter": "제1장 총칙",
        "content": "제7조(여비의 감액 등) ① 원장은 여비를 지급하지 아니할 이유가 있다고 인정될 때에는 여비의 전부 또는 일부를 지급하지 아니할 수 있다.② 외국정부 또는 국제기구 등으로부터 여비의 전액 또는 일부를 지급받을 경우에는 이 규칙에 의한 여비 중에서 그 액을 공제한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국교육과정평가원)국외여비규칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "운임의 구분",
        "chapter": "제2장 운임",
        "content": "제8조(운임의 구분) ① 운임은 철도운임, 선박운임, 항공운임 및 자동차운임으로 구분하되, 철도운임은 철도여행에, 선박운임은 수로여행에, 항공운임은 항공여행에, 자동차운임은 철도 외의 육로여행에 각각 지급한다.② 제1항의 운임에는 통행세를 포함한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국교육과정평가원)국외여비규칙#JO0008"
