      {
        "article_no": "제3조",
        "article_title": "신의ㆍ성실의 의무",
        "chapter": "제1장 총칙",
        "content": "제3조(신의ㆍ성실의 의무) 공단과 조합은 상호 신의를 바탕으로 성실하게 임하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(국립공원공단)노사협의회규칙#JO0003"
