      {
        "article_no": "제11조",
        "article_title": "연봉제의 구분 및 적용대상",
        "chapter": "제3장 연봉제",
        "content": "제11조(연봉제의 구분 및 적용대상) 연봉제의 구분 및 그 적용대상자는 별표 1에 의한다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "appendix_ref",
