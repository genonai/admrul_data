      },
      {
        "article_no": "제13조",
        "article_title": "장비 등의 관리",
        "chapter": "",
        "content": "제13조(장비 등의 관리) ① 상황근무자는 상황실 운영에 필요한 시설ㆍ장비 및 시스템 등을 주기적으로 점검하고, 그 결과를 기록ㆍ유지하여야 한다.② 상황근무자는 제1항에 따른 점검결과 이상이 있는 경우에는 신속히 복구될 수 있도록 관련부서에 통보하는 등 필요한 조치를 취하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(국립공원공단)국립공원종합상황실운영규칙#JO0013"
      },
      {
        "article_no": "제14조",
        "article_title": "보안관리",
        "chapter": "",
        "content": "제14조(보안관리) ① 상황실은 출입제한구역으로 지정ㆍ관리하여야 한다.② 제1항에 따른 지정ㆍ관리는 상황실장이 총괄한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(국립공원공단)국립공원종합상황실운영규칙#JO0014"
      },
      {
        "article_no": "제15조",
        "article_title": "결원보충",
        "chapter": "",
        "content": "제15조(결원보충) 상황실 근무인력의 결원이 생긴 경우에는 주요 임무의 공백을 방지하기 위하여 우선적으로 인원을 보충해야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(국립공원공단)국립공원종합상황실운영규칙#JO0015"
      },
      {
        "article_no": "제16조",
        "article_title": "수당 등",
        "chapter": "",
        "content": "제16조(수당 등) 상황근무자에 대하여는 「보수규정」 및 이사장이 따로 정하는 바에 따른 수당 등을 예산범위 내에서 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(국립공원공단)국립공원종합상황실운영규칙#JO0016"
      },
      {
        "article_no": "제17조",
        "article_title": "근무환경 조성",
        "chapter": "",
        "content": "제17조(근무환경 조성) 상황실장은 상황근무자가 상시 근무하는데 불편함이 없도록 근무환경을 항상 쾌적하게 유지하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(국립공원공단)국립공원종합상황실운영규칙#JO0017"
      },
      {
        "article_no": "제18조",
        "article_title": "교육ㆍ훈련",
        "chapter": "",
        "content": "제18조(교육ㆍ훈련) 상황실장은 상황근무자에 대하여 상황관리를 위해 필요한 자체 교육ㆍ훈련계획을 수립하여 실시할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(국립공원공단)국립공원종합상황실운영규칙#JO0018"
      }
