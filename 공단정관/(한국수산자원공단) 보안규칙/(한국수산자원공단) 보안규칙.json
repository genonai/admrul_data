      },
      {
        "article_no": "제10조",
        "article_title": "청사방호책임자",
        "chapter": "",
        "content": "제10조(청사방호책임자) ① 본사 및 해역별 본부의 청사방호책임자는 이사장 및 해역별 본부장으로 한다. 다만, 본사는 보안업무 담당부서장이 이사장을 대행한다.② 각 청사방호책임자는 청사방호계획을 수립하여 시행하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국수산자원공단)보안규칙#JO0010"
