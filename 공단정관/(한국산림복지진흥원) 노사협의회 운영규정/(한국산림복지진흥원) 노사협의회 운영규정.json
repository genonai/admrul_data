        "article_no": "제3조",
        "article_title": "신의성실의 의무",
        "chapter": "제1장 총칙",
        "content": "제3조(신의성실의 의무) 근로자와 사용자는 상호신뢰를 바탕으로 성실하게 협의에 임하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국산림복지진흥원)노사협의회운영규정#JO0003"
