      {
        "article_no": "제5조",
        "article_title": "예산 및 회계의 총괄",
        "chapter": "제1장 총칙",
        "content": "제5조(예산 및 회계의 총괄) 원장은 평가원의 예산 및 회계를 총괄한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국교육과정평가원)회계규정#JO0005"
