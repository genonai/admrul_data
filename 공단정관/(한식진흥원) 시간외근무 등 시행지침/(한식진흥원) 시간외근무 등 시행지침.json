    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 지침은 복무규정 제16조에서 정한 시간외근무 및 휴일 등 근무(이하 \"시간외근무\"라 한다) 시행 및 수당의 지급에 관한 세부사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "citation",
            "delegation_type": null,
            "target_category": "학칙공단",
            "source_article_no": "제1조",
