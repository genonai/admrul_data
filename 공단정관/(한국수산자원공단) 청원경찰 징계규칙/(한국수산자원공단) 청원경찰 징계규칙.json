    "article_count": 4,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규칙은 한국수산자원공단(이하 \"공단\"이라 한다)에 배치한 청원경찰의 징계에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국수산자원공단)청원경찰징계규칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "징계의 관할",
        "chapter": "",
        "content": "제2조(징계의 관할) 청원경찰의 징계사건은 공단 인사위원회에서 관할한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국수산자원공단)청원경찰징계규칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "징계처분",
        "chapter": "",
        "content": "제3조(징계처분) 이사장은 청원경찰이 다음 각 호의 어느 하나에 해당한 때 또는 관할 경찰서장으로부터 징계요청을 받은 때에는 공단 인사위원회에 징계의결을 요구하여 그 의결에 따라 징계 처분한다.1. 직무상의 의무에 위반하거나 직무를 태만히 한 때2. 품위를 손상하는 행위를 한 때",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국수산자원공단)청원경찰징계규칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "준용규정",
        "chapter": "",
        "content": "제4조(준용규정) 이 규칙에 명시한 사항 이외의 청원경찰의 징계에 관하여는 「청원경찰법」 제5조의2 및 공단 「인사규정」 을 준용한다.",
        "enforcement_date": "",
