            "target_mst": "",
            "target_url": "https://www.law.go.kr/LSW/admRulBylInfoPLinkR.do?admRulSeq=2200000155483&bylNo=0002&bylBrNo=00",
            "resolve_method": "render",
            "source_provision_id": "pi:(한국수산자원공단)직제규정#JO0005",
