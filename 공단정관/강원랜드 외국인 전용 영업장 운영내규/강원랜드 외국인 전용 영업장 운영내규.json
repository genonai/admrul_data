  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 본 규정은 주식회사 강원랜드 카지노의 외국인 전용 영업장에 대한 운영 및 영업방법에 관한 사항을 정함에 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:강원랜드외국인전용영업장운영내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "다른 법령과의 관계",
        "chapter": "",
        "content": "제2조(다른 법령과의 관계) 외국인 전용 영업장 운영 및 영업방법과 관련하여 카지노 관계법령 및 다른 규정에서 특별히 정한 것을 제외하고는 이 규정에서 정하는 바에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:강원랜드외국인전용영업장운영내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "전용 영업장 운영",
        "chapter": "",
        "content": "제3조(전용 영업장 운영) ① 외국인 전용 영업장은 내국인이 이용하는 영업장과 분리하여 운영한다.② 외국인 전용 영업장은 주식회사 강원랜드(이하 \"회사\"라 한다) 영업정책에 따라 게임구역을 분리(Private Room 및 Public Area)해서 운영할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:강원랜드외국인전용영업장운영내규#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "출입대상",
        "chapter": "",
        "content": "제4조(출입대상) 외국인 전용 영업장은 외국인(「해외이주법」 제2조에 따른 해외이주자를 포함하며, 이하 같다.)만 출입이 가능하며, 내국인 출입은 허용되지 않는다.",
        "enforcement_date": "",
        "relations": [
          {
