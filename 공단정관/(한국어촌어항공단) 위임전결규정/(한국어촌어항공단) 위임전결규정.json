  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 직제규정 제11조제2항에 의하여 한국어촌어항공단(이하 \"공단\"이라 한다)의 업무처리에 관한 전결사항과 그 절차를 정하여 권한과 책임의 소재를 명백히 하고 업무처리의 능률을 기함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "citation",
            "delegation_type": null,
            "target_category": "학칙공단",
            "source_article_no": "제1조",
            "source_clause": "제1조",
            "link_text": "제11조제2항",
            "line_text": "",
            "target_law_name": "직제규정",
            "target_article_no": "제11조",
            "target_article_title": "",
            "target_mst": "",
            "target_url": "https://www.law.go.kr/학칙공단/직제규정/제11조",
            "resolve_method": "text_supplement",
            "source_provision_id": "pi:(한국어촌어항공단)위임전결규정#JO0001",
            "reference_id": "law:직제규정#JO0011"
          }
        ],
        "images": [],
        "provision_id": "pi:(한국어촌어항공단)위임전결규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 공단의 업무에 관한 위임전결기준은 다른 규정에서 특별히 정한 경우를 제외하고는 이 규정에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국어촌어항공단)위임전결규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "권한과 책임",
        "chapter": "",
        "content": "제3조(권한과 책임) 전결권자는 그 위임받은 업무의 처리에 필요한 권한을 갖는 동시에 그 권한을 행사 또는 행사하지 않음으로써 발생되는 결과에 대하여 그 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국어촌어항공단)위임전결규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "전결사항",
        "chapter": "",
        "content": "제4조(전결사항) ① 전결권자에게 위임하여 처리할 사항은 별표와 같다.② 제1항의 \"별표\"에 열거되지 아니한 사항은 그 중요도에 따라 이 규정에 준하여 처리할 수 있으며, 필요시 이 규정의 취지에 맞게 별도의 지침을 운영할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국어촌어항공단)위임전결규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "예외사항",
        "chapter": "",
        "content": "제5조(예외사항) ① 이사장은 특별히 필요하다고 인정한 사항에 대하여는 이 규정이 정한 위임에 불구하고 따로 지시하여 처리하게 할 수 있다.② 전결권자의 전결사항이라 할지라도 중요한 사항에 대하여는 이사장 또는 상위 결재권자의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국어촌어항공단)위임전결규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "궐위 또는 부재시의 결재",
        "chapter": "",
        "content": "제6조(궐위 또는 부재시의 결재) ① 전결권자가 궐위 또는 부재중인 때에는 직무대행자 또는 차하위자가 대결하며, 그 내용이 중요한 문서는 차상위자의 결재를 받아야 한다.② 제1항에 의하여 전결권을 행사한 직무대행자 또는 차하위자는 전결권자가 복귀하였을 경우 지체 없이 그 처리결과를 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국어촌어항공단)위임전결규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "업무협의",
        "chapter": "",
        "content": "제7조(업무협의) ① 전결사항 중 타부서와 관련되는 사항이나 이사장이 별도 지정하는 업무에 대하여는 관련부서 또는 지정부서와 협의나 경유를 하여야 한다. 다만, 내부업무전산망이나 정보처리장치 등에 의한 처리로 협의나 경유가 불필요하다고 이사장이 인정하는 경우에는 이를 생략할 수 있다.② 제1항에 의한 협의를 얻지 못하였을 때에는 차상위자의 결재를 얻어야 한다.③ 이사장 결재사항은 이사장 결재 전 상임이사의 확인을 받아야 한다. 다만, 감사실 소관업무는 그러하지 아니하다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국어촌어항공단)위임전결규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "전결문서의 효력",
        "chapter": "",
        "content": "제8조(전결문서의 효력) 이 규정에 의하여 전결 처리된 문서는 이사장이 결재한 문서와 동일한 효력을 갖는다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "pi:(한국어촌어항공단)위임전결규정#JO0008"
      }
    ]
  },
