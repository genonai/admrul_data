  "body": {
    "format": "articles",
    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 규정은 학칙 제57조의 규정에 의한 연구생에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교명예학사학위수여규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "용어의 정의",
        "chapter": "",
        "content": "제2조 (용어의 정의) 이 규정에서 \"연구생\"이라 함은 본교의 석사 및 박사과정에서 특별한 교과목의 수강을 허가받은 자를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교명예학사학위수여규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "지원자격",
        "chapter": "",
        "content": "제3조 (지원자격) 석사 및 박사과정의 연구생은 당해 과정의 입학자격이 있는 자 로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교명예학사학위수여규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "입학",
        "chapter": "",
        "content": "제4조 (입학) 연구생 지원자는 소정의 서류를 제출하여야 하며, 지원학과의 동의와 대학원위원회의 심의를 거쳐 총장이 입학을 허가한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교명예학사학위수여규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "수강허가",
        "chapter": "",
        "content": "제5조 (수강허가) 입학을 허가받은 자의 수강은 소속 학과의 요청에 의하여 대학원장이 허가하되 학위 과정별로 2학기 이내에 허가할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교명예학사학위수여규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "정원",
        "chapter": "",
        "content": "제6조 (정원) 연구생의 정원은 당해 학과 정원의 10% 이내로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교명예학사학위수여규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "성적증명서",
        "chapter": "",
        "content": "제7조 (성적증명서) 연구생이 수강한 과목에 대해서는 <별지서식>에 의한 성적증명서를 교부할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교명예학사학위수여규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "수강과목 등",
        "chapter": "",
        "content": "제8조 (수강과목 등)①수강이 허가된 자는 당해 학기에 등록을 필하여야 한다.②수강료는 당해 학기 재학생의 납입금을 기준하여 다음과 같이 산정한다. 다만, 본교와 교류협정에 의하여 상호 학비 면제를 시행하고 있는 자매 대학의 연구생은 수강료를 면제할 수 있다.1. 수업료 = 수업료×수강학점수/수강신청기준학점수(대학원과정: 9학점)③수강과목은 당해 학과 교과과정의 교과목 중에서 한 학기당 6학점 이내로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교명예학사학위수여규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "수강허가 취소",
        "chapter": "",
        "content": "제9조 (수강허가 취소) 연구생으로서 학칙을 위반할 때에는 수강허가를 취소할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교명예학사학위수여규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "준용 규정",
        "chapter": "",
        "content": "제10조 (준용 규정) 연구생에 관하여는 다른 규정이 있는 경우를 제외하고는 목포대학교학칙을 준용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교명예학사학위수여규정#JO0010"
      }
    ]
  },
  "addenda": [
