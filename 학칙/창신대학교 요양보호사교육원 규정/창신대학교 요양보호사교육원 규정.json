    "articles": [
      {
        "article_no": "제1조",
        "article_title": "명칭",
        "chapter": "제1장 총칙",
        "content": "제1조(명칭) 이 교육원은 창신대학교 부설 요양보호사교육원(이하 \"교육원\"이라 한다)이라 칭한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교요양보호사교육원규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "목적",
        "chapter": "제1장 총칙",
        "content": "제2조(목적) 교육원은 노인성 질환으로 독립적인 일상생활을 수행하기 어려운 노인들을 위해 노인요양시설 및 재가시설에서 신체 및 가사지원 서비스를 제공하는 전문 인력인 요양보호사 양성을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교요양보호사교육원규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "소재지",
        "chapter": "제1장 총칙",
        "content": "제3조(소재지) 교육원은 창신대학교(이하 “본 대학교”라 한다) 내에 둔다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교요양보호사교육원규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "원장",
        "chapter": "제2장 조직",
        "content": "제4조(원장) ① 교육원에 원장을 두며, 본 대학교 조교수 이상의 교원 중에서 총장이 임명한다.② 원장은 교육원의 업무를 총괄하며, 소속 교직원을 지휘·감독한다.③ 원장의 임기는 「창신대학교 교원의 보직임용 규정」에 따른다",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교요양보호사교육원규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "강사",
        "chapter": "제2장 조직",
        "content": "제5조(강사)  교육원에는 보건복지부 요양보호사 양성지침에서 정한 강사기준에 적합한 강사를 두며, 원장의 추천으로 총장이 임명한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교요양보호사교육원규정#JO0005"
