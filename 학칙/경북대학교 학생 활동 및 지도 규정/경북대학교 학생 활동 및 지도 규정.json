    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장  총칙",
        "content": "제1조(목적) 이 규정은 경북대학교학칙 제59조, 제60조, 제63조에 규정된 학생활동 및 지도에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경북대학교학생활동및지도규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "지도방침",
        "chapter": "제1장  총칙",
        "content": "제2조(지도방침) 학생이 학칙에 규정된 권리와 의무를 성실히 이행하여 건전한 학생활동을 하게 함으로써 학생들의 자치활동 능력을 함양하도록 지도한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경북대학교학생활동및지도규정#JO0002"
