  "body": {
    "format": "articles",
    "article_count": 13,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 재학생 및 교직원 중 예비군을 대학직장예비군에 편성하여 예비군교육의 내실을 기함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교예비군운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "편성대상 및 관리부대",
        "chapter": "",
        "content": "제2조(편성대상 및 관리부대) 예비군의 편성은 재학생 및 교직원 중 예비군을 편성대상으로 하며, 충주캠퍼스와 증평캠퍼스는 예비군연대(충주)에서 편성·관리하고 의왕캠퍼스는 예비군중대(의왕)에서 편성·관리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교예비군운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "편성기간",
        "chapter": "",
        "content": "제3조(편성기간) 학생예비군의 편성기간은 6년을 초과하지 못한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교예비군운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "대원신청",
        "chapter": "",
        "content": "제4조(대원신청) ① 교직원은 임용된 날을 기준으로, 학생은 등록과 동시에 소속 편성부대에 예비군 대원 신청을 하여야 한다.② 신(편)입생은 입학일 기준 14일 이내에 예비군 대원 신청서를 작성, 소속 편성부대에 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교예비군운영규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "신상변동신고",
        "chapter": "",
        "content": "제5조(신상변동신고) 예비군대원은 주소지 이동 및 병적사항 변동 시에는 그 변동사항을 소속 편성부대에 신고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교예비군운영규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "자격상실",
        "chapter": "",
        "content": "제6조(자격상실) 예비군대원이 휴직, 면직, 휴학, 자퇴, 졸업 등으로 신분을 상실한 때에는 직장예비군 대원 자격이 상실되며, 주거지역 예비군부대로 전출된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교예비군운영규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "교육훈련",
        "chapter": "",
        "content": "제7조(교육훈련) ① 학생예비군 향방기본훈련 8시간을 예비군 자원 관리 부대의 학생예비군 교육훈련 주기에 의거 실시한다.② 교직원 보류 대상자를 제외한 일반직장예비군 대상자는 연차별 교육시간을 적용하여 교육을 실시한다.③ 당해년도 전역자 및 소집해제자, 7~8년차 예비군은 교육훈련을 면제한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교예비군운영규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "훈련연기 및 보류",
        "chapter": "",
        "content": "제8조(훈련연기 및 보류) 교육훈련연기 및 보류를 원하는 대원은 교육훈련 연기 및 보류사유서(진단서, 관보, 기타 증빙서류 첨부)를 훈련개시 1일전까지 소속 편성부대에 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교예비군운영규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "훈련통지",
        "chapter": "",
        "content": "제9조(훈련통지) 교육소집통지서는 보충교육대상자에게 전달하고 기본교육은 홍보수단(공고, 방송 등)으로 부여하며 수령증은 해당학부(과)에서 회수하여 소속 편성부대에 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교예비군운영규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "훈련홍보",
        "chapter": "",
        "content": "제10조(훈련홍보) 교육훈련의 자율참석을 위하여 교내 게시판 및 학보사 또는 방송을 최대로 활용하여 홍보한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교예비군운영규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "불참처리",
        "chapter": "",
        "content": "제11조(불참처리) 교육훈련 불참자는 향토사단에서 매년 발간하는 교육훈련지시 보충교육 계획에 의거 불참자교육을 실시한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교예비군운영규정#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "해외출국 및 귀국신고",
        "chapter": "",
        "content": "제12조(해외출국 및 귀국신고) 직장예비군이 해외여행 시 출국 전에 훈련연기원을 작성하여 소속 편성부대에 제출하고 귀국 시는 유선으로 통보하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교예비군운영규정#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "동원",
        "chapter": "",
        "content": "제13조(동원) ① 예비군 동원은 전시사변 또는 이에 준하는 비상사태에 동원하며, 전시 개별 동원자원을 관리한다.② 동원지정자는 병력동원 소집통지서를 받으면 수령증은 기재사항을 기록한 후 소속 편성부대에 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교예비군운영규정#JO0013"
      }
    ]
  },
