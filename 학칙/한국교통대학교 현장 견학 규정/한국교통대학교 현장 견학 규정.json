  "body": {
    "format": "articles",
    "article_count": 4,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 교육기간 중 학생들의 현장 견학 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교현장견학규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "범위 및 기간",
        "chapter": "",
        "content": "제2조(범위 및 기간) 현장 견학은 해당 학과(부)의 교육내용과 유사한 업체 또는 관련부서에 한하며, 그 기간은 각 학과(부)의 실정에 맞게 설정하여 운영한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교현장견학규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "승인 및 보고",
        "chapter": "",
        "content": "제3조(승인 및 보고) ① 현장 견학을 실시할 학과(부)에서는 출발 예정일 7일 전에 현장 견학 계획서(서식 제1호)를 작성하여 총장의 승인을 받은 후 시행한다.② 현장견학 운영에 필요한 사항이 발생할 경우 대학일자리개발원 운영위원회 심의를 거쳐 총장 승인을 받아 운영할 수 있다.③ 현장견학 완료 후 3일 이내에 현장 견학 결과보고서(서식 제2호)를 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교현장견학규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "기타사항",
        "chapter": "",
        "content": "제4조(기타사항) 이 규정에 명시되지 아니한 사항은 대학일자리개발원장과 협의 처리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교현장견학규정#JO0004"
      }
    ]
  },
