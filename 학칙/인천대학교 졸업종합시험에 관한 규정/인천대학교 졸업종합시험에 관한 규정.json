  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 졸업종합시험(이하 “시험”이라 한다)의 시행에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교졸업종합시험에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 이 규정은 교육과정의 성질상 졸업논문제출이 부적합하거나 실험실습보고, 실기발표로서도 대체할 수 없는 학과에 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교졸업종합시험에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "관리위원회",
        "chapter": "",
        "content": "제3조(관리위원회) ① 시험의 시행을 위하여 대학별 종합시험관리위원회(이하 “위원회”라 한다)를 둔다.② 위원회는 위원장을 학장으로 하고, 학장이 위촉하는 약간 명의 위원으로 구성한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교졸업종합시험에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "위원회의 기능",
        "chapter": "",
        "content": "제4조(위원회의 기능) 위원회는 다음 사항을 심의한다.1. 시험실시계획2. 시험교과목·출제의 범위와 방법·채점방법3. 합격자 사정4. 기타 시험에 관한 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교졸업종합시험에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "시험시기 및 요강공고",
        "chapter": "",
        "content": "제5조(시험시기 및 요강공고) 위원장은 졸업학기 강의 종료 1월전에 시험시기와 요강을 공고한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교졸업종합시험에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "시험방법",
        "chapter": "",
        "content": "제6조(시험방법) 시험은 필답시험으로 하되, 시험시간은 4시간 내지 8시간으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교졸업종합시험에관한규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "시험과목",
        "chapter": "",
        "content": "제7조(시험과목) 시험과목은 학과별 전공과목을 종합적으로 평가할 수 있도록 통합하여 시행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교졸업종합시험에관한규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "합격자 결정",
        "chapter": "",
        "content": "제8조(합격자 결정) 시험 총점의 60%이상 득점자를 합격으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교졸업종합시험에관한규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "주관부서",
        "chapter": "",
        "content": "제9조(주관부서) 시험에 관한 일반사무는 교무과에서 주관한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교졸업종합시험에관한규정#JO0009"
      }
    ]
