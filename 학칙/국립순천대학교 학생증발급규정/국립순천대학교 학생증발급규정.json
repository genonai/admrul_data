  "body": {
    "format": "articles",
    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 국립순천대학교 교학규정 제71조에 의거 학생증 발급에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교학생증발급규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "발급",
        "chapter": "",
        "content": "제2조(발급) 대학(원)생의학생증은 총장이 발급한다.(개정 1995. 11. 27, 2013. 05. 07)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교학생증발급규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "학적 확인",
        "chapter": "",
        "content": "제3조(학적 확인) 학생증은 학적부에 기재된 사항을 확인한 후에 발급하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교학생증발급규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "재발급",
        "chapter": "",
        "content": "제4조(재발급) 학생증을 분실 또는 훼손하였을 때에는 학생증재발급신청서(별지 제1호 서식)에 분실사유를 기재(훼손 하였을 때에는 훼손학생증을 첨부), 학과장 또는 전공주임교수의 날인을 받아 학생지원과에 제출한다. (개정1995. 11. 27, 2013. 05. 07)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교학생증발급규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "학생증의 서식",
        "chapter": "",
        "content": "제5조(학생증의 서식) 학생증의 서식은 학생증 카드 내에 집적회로(IC)칩을 내장한 별지 제2호 서식과 같다.(개정 1995. 11. 27)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교학생증발급규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "삭제 2013. 05. 07",
        "chapter": "",
        "content": "제6조 (삭제 2013. 05. 07)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교학생증발급규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "대장비치",
        "chapter": "",
        "content": "제7조(대장비치) 학생증의 발급을 위하여 다음 대장을 비치한다.1. 학생증 발급 대장2. 학생증 재발급 대장",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교학생증발급규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "무효",
        "chapter": "",
        "content": "제8조(무효) 다음 각호에 해당하는 학생증은 무효로 한다. <개정 2018.9.12.>1. 직인 및 소지자 사진이 첨부되어 있지 않을 때2. 학생증의 기재사항을 임의로 변조 하였을 때3. 삭제(1995. 11. 27)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교학생증발급규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "학생증의 휴대",
        "chapter": "",
        "content": "제9조(학생증의 휴대) 학생은 항상 학생증을 휴대하여야 하며 교직원의 제시 요구가 있을 때에는 이에 응하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교학생증발급규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "반환",
        "chapter": "",
        "content": "제10조(반환) 졸업·퇴학, 그 밖의 사유로 이 대학교의 학적을 이탈하는 학생은 학생처 학생지원과에 학생증을 반환하여야 한다. <개정 2018.9.12.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교학생증발급규정#JO0010"
      }
    ]
  },
