  "body": {
    "format": "articles",
    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적)  이 규정은 &#65378;학칙&#65379; 제106조에 따라 학생포상에 필요한 세부사항을 규정함을 목적으로 한다.[개정 2002.1.7.]",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학생포상에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "포상의 종류",
        "chapter": "",
        "content": "제2조(포상의 종류)  포상은 졸업&#8901;특별포상으로 구분한다.[개정 2011.12.27.]제3조〔삭제 2011.12.27.〕",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학생포상에관한규정#JO0002"
      },
      {
        "article_no": "제4조",
        "article_title": "졸업포상",
        "chapter": "",
        "content": "제4조(졸업포상)   졸업포상은 전기와 후기 졸업으로 구분하여 시행하며, 재학 중 학업성적이 우수한 학사과정 졸업자와 치의학대학원, 의학대학원, 법학전문대학원 석사과정 졸업자에게 다음과 같이 포상한다. 다만, 징계처분을 받은 자와 편입학자(수의과대학&#8901;의과대학은 제외)에게는 포상하지 아니한다.[개정 2004.5.12.,2011.12.27.]구    분         평점평균&#56194;&#56335;&#56194;&#56335;&#56194;&#56335;&#56194;&#56335;&#56194;&#56335;&#56194;&#56335;&#56194;&#56335;&#56194;&#56335;         &#56194;&#56335;&#56194;&#56335;&#56194;&#56335;&#56194;&#56335;&#56194;&#56335;&#56194;&#56335;&#56194;&#56335;&#56194;&#56335;최우등급         3.9 이상우 등 급         3.6 이상",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학생포상에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "특별포상",
        "chapter": "",
        "content": "제5조(특별포상)  다른 학생에게 모범이 되는 특별한 선행이 있거나 학생자치활동 등 학교발전에 현저한 공로가 있는 학생에게 특별 포상한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학생포상에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "포상자 선정",
        "chapter": "",
        "content": "제6조(포상자 선정)①포상대상자는 학(원)장이 지도교수의 의견을 참작하여 교수회의 심의를 거쳐 총장에게 추천하고 총장은 이를 심사하여 선정한다.②〔삭제 2011.12.27.〕③ 졸업포상자를 추천할 때에는 별지 제1호 서식의 연명부를 첨부한다.④ 특별포상자를 추천할 때에는 별지 제2호 서식의 공적조서를 첨부한다.⑤ 포상대상자는 다음 기일까지 추천하여야 한다.1.〔삭제 2011.12.27.〕2. 졸업포상자 매학기 종료 20일 전3. 특별포상자 매학기 종료 20일 전",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학생포상에관한규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "시상",
        "chapter": "",
        "content": "제7조(시상)①〔삭제 2011.12.27.〕②졸업포상은 전기와 후기 졸업식일에 시상하며, 졸업포상대상자 중 최우등급자에게는 제4호서식의 상장을 수여하고, 우등급자에게는 학적부 및 졸업증서의 기재로 포상에 갈음한다.③ 각 대학(원)의 졸업대상자 중 최우수자에게는 따로 별지 제5호 서식의 상장과 제6호 서식의 상패를 수여한다. 다만, 해당 학생의 평점평균은 3.9이상이어야 한다.④ 특별포상자에게는 상장과 부상을 수여한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학생포상에관한규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "이중포상 금지",
        "chapter": "",
        "content": "제8조(이중포상 금지)  동일한 공적에 대하여 이중으로 포상하지 아니한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학생포상에관한규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "학적부 등재",
        "chapter": "",
        "content": "제9조(학적부 등재)  포상은 별지 제7호 서식에 의하여 학적부에 등재한다. 다만, 졸업포상은 졸업증서에도 기재한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학생포상에관한규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "포상자 공고",
        "chapter": "",
        "content": "제10조(포상자 공고)  포상자에 대하여는 그 포상사항을 공고한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학생포상에관한규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "세부사항",
        "chapter": "",
        "content": "제11조(세부사항)  이 규정 시행에 필요한 사항은 총장의 승인을 얻어 학생처장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학생포상에관한규정#JO0011"
      }
    ]
  },
