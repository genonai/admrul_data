  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 제주대학교의 학력증명서 발급에 관한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교학력증명서발급규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "증명서의 종류",
        "chapter": "",
        "content": "제2조(증명서의 종류) ① 제주대학교의 학력증명서(이하 “증명서”라 한다)는 재학증명서, 휴학증명서, 복학예정증명서, 재적증명서, 제적증명서, 수료(예정)증명서, 졸업(예정)증명서, 성적증명서, 학위수여(예정)증명서, 학적부사본, 교직과정 이수증명서로 구분하며 국문 또는 영문으로 발급한다. 다만, 필요하다고 인정된 경우에는 다른 외국문으로도 발급할 수 있다.② 증명서의 서식은 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교학력증명서발급규정#JO0002"
      },
      {
        "article_no": "제2조의2",
        "article_title": "공학교육인증자에 대한 증명서",
        "chapter": "",
        "content": "제2조의2(공학교육인증자에 대한 증명서) 공학교육인증자에게는 증명서를 별표1·별표2와 같이 별도로 표시한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교학력증명서발급규정#JO0002_02"
      },
      {
        "article_no": "제3조",
        "article_title": "증명서의 발급 명의",
        "chapter": "",
        "content": "제3조(증명서의 발급 명의) 증명서는 총장 명의로 발급하되, 민원업무용 특수 관인을 사용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교학력증명서발급규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "증명서 발급신청",
        "chapter": "",
        "content": "제4조(증명서 발급신청) 증명서를 발급받으려는 사람은 방문(창구), 민원우편, 민원팩스, 온라인을 이용하여 신청할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교학력증명서발급규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "증명서 발급절차",
        "chapter": "",
        "content": "제5조(증명서 발급절차) ① 증명서는 학적부 및 졸업대장에 기재된 사실을 기록·대조하여 발급한다.② 증명서 발급기간은 「민원사무 처리에 관한 법률 시행령」에 따른다. 다만, 영문성적증명서(수기분)는 접수시간부터 48시간 이내에 발급한다.③ 졸업예정증명서(학사과정)와 수료예정증명서(대학원과정)는 수업연한 마지막 학기 이상 재학 중인 학생에게 발급한다.④ 증명서는 그 기재내용의 일부만을 발급할 수 없다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교학력증명서발급규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "증명서 발급대장의 비치",
        "chapter": "",
        "content": "제6조(증명서 발급대장의 비치) 증명서 발급에 관한 사항을 기록·유지하기 위하여 증명서발급대장을 비치하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교학력증명서발급규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "증명수수료",
        "chapter": "",
        "content": "제7조(증명수수료) 증명수수료의 금액, 납부방법, 수수료의 면제에 관하여는 「국립학교 각종 증명 수수료 규칙」에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교학력증명서발급규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "기타",
        "chapter": "",
        "content": "제8조(기타) 이 규정에 명시되지 않은 사항은 「제주대학교 학칙」 및 학사 관련 규정에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교학력증명서발급규정#JO0008"
      }
    ]
  },
