    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총칙",
        "content": "제1조(목적) 이 규정은 인천대학교(이하 “본교”라 한다) 교원양성혁신센터(이하 “센터”라 한다)의 조직과 운영에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교교원양성혁신센터운영규정#JO0001"
