      },
      {
        "article_no": "제26조",
        "article_title": "복학자 등록",
        "chapter": "",
        "content": "제26조(복학자 등록) 휴학한 학생이 복학할 때의 등록금 납부 및 등록에 관한 사항은 학칙 제38조를 준용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
