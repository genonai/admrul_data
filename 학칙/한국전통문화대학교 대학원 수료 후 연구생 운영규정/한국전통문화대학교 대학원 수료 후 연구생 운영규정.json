  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 「한국전통문화대학교 대학원 학사운영규정」제87조에 따라 대학원의 각 학위과정을 수료 후 논문준비 등을 위해 등록하는 학생(이하 “수료 후 연구생”이라 한다)에 관한 자격, 신분 및 등록 등에 관한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교대학원수료후연구생운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "자격",
        "chapter": "",
        "content": "제2조(자격) 수료 후 연구생은 대학원 각 학위과정 수료생 중 논문제출연한을 경과하지 않은 사람으로서 본인의 희망에 따라 지도교수의 추천을 받은 사람이다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교대학원수료후연구생운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "제출서류 및 절차",
        "chapter": "",
        "content": "제3조(제출서류 및 절차) ① 수료 후 연구생은 지도교수의 추천을 받아 학기마다 정하는 기간 내에 별지 제1호서식의 수료 후 연구생 신청서를 학과장에게 제출하여야 한다.② 학과장은 신청자격을 심사한 후 신청서를 총장에게 제출한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교대학원수료후연구생운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "등록",
        "chapter": "",
        "content": "제4조(등록) 수료 후 연구생은 학기마다 정해진 기한까지 등록금을 납부하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교대학원수료후연구생운영규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "등록금 수납 및 활용",
        "chapter": "",
        "content": "제5조(등록금 수납 및 활용) ① 등록금은 해당 학기 등록금의 10% 금액으로 하되, 천원 미만은 절사한다.② 수료 후 연구생으로부터 징수한 등록금은 대학회계 예산으로 편입한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교대학원수료후연구생운영규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "등록증 등의 발급",
        "chapter": "",
        "content": "제6조(등록증 등의 발급) 수료 후 연구생에 대하여는 별지 제2호 서식의 수료 후 연구생 등록증 발급 신청서에 따라 별지 제3호 서식의 수료 후 연구생 등록증 및 별지 제4호 서식의 수료 후 연구생 등록 확인서를 발급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교대학원수료후연구생운영규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "시설물 등의 이용",
        "chapter": "",
        "content": "제7조(시설물 등의 이용) 수료 후 연구생은 다음 각 호에 해당하는 사항을 이용할 수 있다.1. 도서관 이용 및 도서대출2. 통학차량 이용3. 재학생에 상응하는 각종 상해보험 등의 가입4. 그 밖의 총장이 인정하는 학교시설 이용",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교대학원수료후연구생운영규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "자격상실",
        "chapter": "",
        "content": "제8조(자격상실) 다음 각 호의 어느 하나에 해당될 경우에는 수료 후 연구생의 자격을 박탈할 수 있다.1. 수료 후 연구생의 본분에 어긋난 행위를 하였을 경우2. 지도교수가 그 추천을 철회하였을 경우3. 등록기한까지 등록금을 납부하지 않았을 경우",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교대학원수료후연구생운영규정#JO0008"
      }
    ]
  },
  "addenda": [
    {
      "promulgation_date": "20250423",
      "promulgation_no": "00040",
      "content": "부칙(제24호, 2025. 5. 1.)제1조(시행일) 이 규정은 발령한 날부터 시행한다.제2조(규정의 폐지) 종전의 「한국전통문화대학교 대학원 수료 후 연구생 운영규정」(예규 제319호, 2024. 8. 19.)은 폐지한다.제3조(경과조치) 이 규정 시행 전의 「한국전통문화대학교 대학원 수료 후 연구생 운영규정」에 따라 행한 행위, 절차 및 그에 따른 효력은 이 규정에 따라 행한 것으로 본다."
    }
  ],
