    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 지침은 「창신대학교 학사 운영 규정」에 따라  조기취업자의 출석 및 성적처리에 관한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교조기취업자출석및성적처리지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "content": "제2조(정의) 이 규정에서 사용하는 “조기취업자”란 졸업예정 학기에 취업으로 인하여 출석 및 수업 참여를 정상적으로 할 수 없는 학생을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교조기취업자출석및성적처리지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "출석 및 성적처리 기준",
        "chapter": "",
        "content": "제3조(출석 및 성적처리 기준)  ① 조기취업자의 출석 및 성적처리는 수강 교과목의 담당교원이 수업계획서에 명시한 평가기준에 따라 처리함을 원칙으로 한다.② 조기취업으로 인하여 수업계획서 상의 학점이수 기준을 충족할 수 없는 경우 담당 교원의 재량으로 보고서나 대체과제를 제출하게 하거나 보강 등을 실시하여 추가적으로 학점을 부여하도록 하며, 관련 기록 및 자료를 보관한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교조기취업자출석및성적처리지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "대상 및 신청 시기",
        "chapter": "",
        "content": "제4조(대상 및 신청 시기) 대상 학생은 4학년 마지막 학기 재학생으로 하고, 신청 시기는 개강일부터 학기 종료일까지로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교조기취업자출석및성적처리지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "출석 인정기간",
        "chapter": "",
        "content": "제5조(출석 인정기간) 제출한 증빙서류에 명시된 취업기간에 한정하여 출석을 인정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교조기취업자출석및성적처리지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "인정범위 및 제출서류",
        "chapter": "",
        "content": "제6조(인정범위 및 제출서류) 인정범위 및 제출서류는 [별표1]과 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교조기취업자출석및성적처리지침#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "신청 및 처리절차",
        "chapter": "",
        "content": "제7조(신청 및 처리절차) 제6조에 따른 처리절차는 다음과 같다.1. 채용확인 서류를 전자공문 또는 FAX로 교무처에 송부(취업예정기관)2. 강의 개설학과(부)에 학생의 취업사실 통보(교무처)3. 담당교원에게 출석 및 성적평가에 대하여 판단하도록 안내(개설학과(부))4. 이 지침에 따라 출석 및 성적평가 시행(담당교원)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교조기취업자출석및성적처리지침#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "부정행위에 대한 조치",
        "chapter": "",
        "content": "제8조(부정행위에 대한 조치) 허위 증빙자료 제출 등 부정행위 적발 시, 부정행위자의 해당 교과목성적은 F처리한다.",
        "enforcement_date": "",
