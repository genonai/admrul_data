    "article_count": 11,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 경상국립대학교 LG개척관 운영에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교LG개척관운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "고시반 편성",
        "chapter": "",
        "content": "제2조(고시반 편성) 경상국립대학교 LG개척관(이하 “개척관”이라 한다)에는 국가고시 등을 위한 고시반을 둘 수 있으며, 반의 종류는 운영위원회에서 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교LG개척관운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "운영 및 관리",
        "chapter": "",
        "content": "제3조(운영 및 관리) ① 개척관 운영을 위하여 관장을 두며 관장은 학생생활관장으로 한다.② 관장은 개척관의 운영에 관한 전반적인 사항을 총괄한다.③ 개척관 운영의 기본방침과 주요사항을 심의 의결하기 위하여 운영위원회(이하 “위원회”라 한다)를 둔다.④ 삭제⑤ 고시반에는 임기 1년의 지도교수를 둘 수 있으며, 관장이 임명한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교LG개척관운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "위원회의 구성",
        "chapter": "",
        "content": "제4조(위원회의 구성) ① 위원회는 관장, 학생생활관부관장, 학생생활관실장, 학생과장, 인재개발원 행정실장, 지도교수로 구성한다.② 위원장은 관장으로 하고 부위원장은 학생생활관부관장으로 한다.③ 위원회 사무 처리를 위하여 간사 1명을 두며, 간사는 학생생활관 팀장으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교LG개척관운영규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "위원회 기능",
        "chapter": "",
        "content": "제5조(위원회 기능) 위원회는 다음 각호의 사항을 심의·의결한다.1. 개척관 운영의 기본계획에 관한 사항2. 개척관운영규정의 제정 및 개정 또는 폐지3. 개척관생 자격 및 정원배정에 관한 사항4. 개척관생의 변상명령과 퇴실5. 관장이 심의를 요청하는 사항6. 그 밖에 개척관의 운영에 위원회의 심의가 필요한 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교LG개척관운영규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "위원회의 소집과 의결",
        "chapter": "",
        "content": "제6조(위원회의 소집과 의결) ① 위원회는 위원장 또는 재적위원 3분의 1 이상의 요구로 소집한다.② 위원회의 회의는 재적위원 과반수의 출석으로 개의하고 출석위원 과반수의 찬성으로 의결한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교LG개척관운영규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "지도교수",
        "chapter": "",
        "content": "제7조(지도교수) 지도교수는 개척관생들의 수험에 관한 사항을 지도하며, 지도교수에게는 예산의 범위에서 수당을 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교LG개척관운영규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "개척관생의 선발과 지원",
        "chapter": "",
        "content": "제8조(개척관생의 선발과 지원) 개척관생 선발은 경상국립대학교 재학생 중에서 각종 국가고시 등을 준비하는 학생을 대상으로 평가를 통하여 선발하고, 성적우수자에게는 별도의 기준을 정하여 장학금을 지원할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교LG개척관운영규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "변상과 퇴실 명령",
        "chapter": "",
        "content": "제9조(변상과 퇴실 명령) 개척관생은 개척관내에서 기물의 파손과 면학분위기를 방해하는 일체의 행위를 금하며, 위반 시에 관장은 변상과 퇴실을 명할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교LG개척관운영규정#JO0009"
      },
