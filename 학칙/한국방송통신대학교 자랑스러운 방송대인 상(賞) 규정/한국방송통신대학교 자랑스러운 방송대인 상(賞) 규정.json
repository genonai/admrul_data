    "article_count": 12,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 자랑스러운 방송대인 상에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국방송통신대학교자랑스러운방송대인상(賞)규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "수상대상",
        "chapter": "",
        "content": "제2조(수상대상) 자랑스러운 방송대인 상(이하 “방송대인 상”이라 한다) 수상대상은 한국방송통신대학교 동문 또는 한국방송통신대학교에서 장기간 봉직한 사람으로서 인격과 덕망을 겸비하고 국가와 인류사회 발전에 기여하여 한국방송통신대학교를 빛낸 사람으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국방송통신대학교자랑스러운방송대인상(賞)규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "수상 후보자 추천",
        "chapter": "",
        "content": "제3조(수상 후보자 추천) ① 방송대인 상 후보자는 본인을 제외한 개인이나 단체가 추천한다.② 추천자는 방송대인 상 후보자 추천 공고에 따라 〔별지 서식〕의 추천서를 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국방송통신대학교자랑스러운방송대인상(賞)규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "공적심사위원회",
        "chapter": "",
        "content": "제4조(공적심사위원회) ① 방송대인 상 후보자의 심사 및 선정을 위하여 공적심사위원회(이하 “위원회”라 한다.)를 둔다.② 위원회는 다음 각 호와 같이 구성한다.1. 당연직 위원 : 교무처장, 학생처장, 기획처장, 사무국장, 기획부처장2. 총장이 임명하는 전임교원 4명③ 위원회의 위원장은 기획처장이 되고, 부위원장은 교무처장이 된다.④ 위원회는 방송대인 상 후보자에 대해 심사하여 수상후보자를 선정하며, 적합한 수상후보자가 없을 때에는 선정하지 않을 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국방송통신대학교자랑스러운방송대인상(賞)규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "위원장 등의 직무",
        "chapter": "",
        "content": "제5조(위원장 등의 직무) ① 위원장은 위원회를 대표하고 위원회의 업무를 총괄한다.② 부위원장은 위원장을 보좌하며 위원장이 부득이한 사유로 직무를 수행할 수 없을 때에 그 직무를 대행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국방송통신대학교자랑스러운방송대인상(賞)규정#JO0005"
      },
      {
