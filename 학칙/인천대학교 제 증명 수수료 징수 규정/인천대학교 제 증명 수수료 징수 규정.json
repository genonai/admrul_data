  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 인천대학교(이하 “대학교”라 한다)가 발급하는 제 증명 등에 대한 수수료의 징수에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교제증명수수료징수규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 제 증명 등의 수수료는 다른 법령이나 조례에 특별히 정한 것을 제외하고는 이 규정이 정하는 바에 의하여 징수한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교제증명수수료징수규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "요율",
        "chapter": "",
        "content": "제3조(요율) 제 증명 등의 수수료는 총장이 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교제증명수수료징수규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "기준",
        "chapter": "",
        "content": "제4조(기준) 제 증명 등으로서 동일한 것을 2통 이상 청구할 때나 수인을 명기하여 증명을 청구할 때에는 1통 또는 1인마다 1건으로 하여 수수료를 징수한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교제증명수수료징수규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "징수방법",
        "chapter": "",
        "content": "제5조(징수방법) ① 수수료는 대학교 증명서 자동발급기에 의해 징수하거나 납입고지서(별지 제1호서식)에 의해 대학교 금고에 납부하게 함으로서 징수한다.② 증명서 자동발급기에 의해 수수료를 징수한 수입금 출납원은 납입서(별지 제2호서식)에 의해 익일까지 대학교 금고에 납부하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교제증명수수료징수규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "수납절차",
        "chapter": "",
        "content": "제6조(수납절차) 대학교 금고에서는 납입고지서에 의한 납입의무자 또는 수입금 출납원으로부터 세입금을 수납하였을 때에는 영수증을 납입자에게 교부하고 영수필 통지서를 징수관에게 송부하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교제증명수수료징수규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "수입일계표의 작성",
        "chapter": "",
        "content": "제7조(수입일계표의 작성) 징수관은 제6조의 규정에 따라 영수필통지서를 받았을 때에는 수입일계표(별지 제3호서식)를 작성하고 징수부를 정리하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교제증명수수료징수규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "기납수수료의 불반환",
        "chapter": "",
        "content": "제8조(기납수수료의 불반환) 이미 납부한 수수료는 청구사항을 변경하거나 취소하여도 이를 반환하지 아니한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교제증명수수료징수규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "수수료의 감면",
        "chapter": "",
        "content": "제9조(수수료의 감면) ① 다음 각 호의 1에 해당하는 제 증명 등에 대하여는 수수료를 징수하지 아니한다.1. 국가기관이나 지방자치단체가 행정시책상 필요에 의하여 발급을 신청하는 제 증명2. 대학교 교직원, 퇴직교직원 및 시간강사가 본인의 증명을 신청하는 제 증명② 제1항의 규정에 의하여 수수료를 징수하지 아니하는 제 증명에 대하여는 별표의 고무인을 날인하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교제증명수수료징수규정#JO0009"
      }
    ]
  },
