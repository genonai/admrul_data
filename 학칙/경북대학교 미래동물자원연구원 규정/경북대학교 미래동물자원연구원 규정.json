    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장  총칙",
        "content": "제1조(목적) 동물관련 산업, 교육, 산학관협력 등 제 분야의 연구 및 자문을 통해 지역과 국가 발전에 기여함을 목적으로 설립된 경북대학교 미래동물자원연구원의 조직과 운영에 관한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
