  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 규정은 본 대학교와 전신학교의 학력증명서(이하 “증명서”라 한다) 발급에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:부산교육대학교학력증명서발급규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "증명서의 종류",
        "chapter": "",
        "content": "제2조 (증명서의 종류) 증명서는 졸업·수료·졸업예정·제적·재학·휴학·성적증명서로 구분하여 국문 또는 외국문으로 발급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:부산교육대학교학력증명서발급규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "증명발급의 명의",
        "chapter": "",
        "content": "제3조 (증명발급의 명의) 증명서는 총장명의로 발급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:부산교육대학교학력증명서발급규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "증명서발급 신청",
        "chapter": "",
        "content": "제4조 (증명서발급 신청) ① 증명서를 발급받고자 하는 자는 별지 제1호 서식의 증명서교부원을 기재하여 수수료와 함께 신청하여야 한다.② 우편으로 신청할 때는 소정의 수수료를 동봉하여 신청할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:부산교육대학교학력증명서발급규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "증명서발급 절차",
        "chapter": "",
        "content": "제5조 (증명서발급 절차) ① 증명서는 학적부 및 졸업대장에 기재된 사실을 조사대조한 후에 발급한다.② 제1항의 업무를 담당하는 자는 증명서 해당란에 각각 날인하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:부산교육대학교학력증명서발급규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "증명서발급대장의 비치",
        "chapter": "",
        "content": "제6조 (증명서발급대장의 비치) 증명서발급에 관한 사항을 보존하기 위하여 별지 제2호 서식의 증명서 발급대장을 비치하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:부산교육대학교학력증명서발급규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "수수료",
        "chapter": "",
        "content": "제7조 (수수료) 증명수수료는 국립학교 각종증명수수료 징수 규정에 의하여 징수한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:부산교육대학교학력증명서발급규정#JO0007"
      }
    ]
  },
