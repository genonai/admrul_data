  "body": {
    "format": "articles",
    "article_count": 15,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 청주교육대학교 논문집(이하 “논문집”이라 한다)의 발간에 있어서 논문의 투고, 심사, 기타 발간에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "편집위원회",
        "chapter": "",
        "content": "제2조(편집위원회) 논문집 발간에 필요한 사항을 심의하기 위하여 편집위원회(이하 “위원회”라 한다)를 둔다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "위원회의 구성",
        "chapter": "",
        "content": "제3조(위원회의 구성) ① 위원회는 위원장 1인과 약간명의 위원으로 구성한다.② 위원장은 교무처장이 되며, 위원은 본 대학의 조교수 이상의 교원 중에서 위원장의 추천에 의하여 총장이 위촉한다. (개정 2020.5.11.)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "위원장의 직무",
        "chapter": "",
        "content": "제4조(위원장의 직무) ① 위원장은 위원회를 대표하고 회무를 총괄한다.② 위원장 유고시에는 위원 중에서 호선하여 그 직무를 대행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "위원회의 기능",
        "chapter": "",
        "content": "제5조(위원회의 기능) 위원회는 다음사항을 심의한다.1. 게재 대상 논문 심사2. 논문집 편집에 관한 사항3. 기타 논문집 발간에 필요한 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "위원회의 의결",
        "chapter": "",
        "content": "제6조(위원회의 의결) 위원회는 재적위원 3분의 2이상의 출석과 출석위원 과반수이상의 찬성으로 의결한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "발간방법",
        "chapter": "",
        "content": "제7조(발간방법) 본 논문집은 연 1회 발간함을 원칙으로 하고 번호로 표기한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "투고자격",
        "chapter": "",
        "content": "제8조(투고자격) 원고의 투고자격은 본 대학의 조교 및 조교수 이상의 교원이 제1저자, 또는 교신저자, 또는 공저자로 참여하는 것을 원칙으로 하되, 예외적인 것은 위원회에서 결정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "게재대상 논문",
        "chapter": "",
        "content": "제9조(게재대상 논문) 본 논문집에는 다음 각 호의 논문 중에서 1인 1편의 미발표 논문에 한하여 게재한다. 다만, 집필자가 2편 이상 또는 기발표 논문의 게재를 원할 경우에는 위원회의 심의를 거쳐 게재할 수 있다.1. 연구보조비에 의한 연구논문2. 학술연구조성비에 의한 연구논문(과학교육연구소 지원 연구논문 제외)3. 기타 위원회에서 게재할 필요가 있다고 인정하는 논문",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "게재순서",
        "chapter": "",
        "content": "제10조(게재순서) 논문의 게재순서는 인문·사회과학, 자연과학, 예·체능 및 조교 순으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "투고요령",
        "chapter": "",
        "content": "제11조(투고요령) 본 논문집에 게재하고자 하는 논문은 본 대학 논문투고요강의 정한 바에 따라 기한 내에 교무과에 제출하여야 한다.제12조 논문 투고시 저자는 논문이 논문투고요강 제1항에 위배되지 않는다는 별지 <서식 1>의 저자 확인서를 함께 제출해야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0011"
      },
      {
        "article_no": "제13조",
        "article_title": "원고의 첨삭",
        "chapter": "",
        "content": "제13조(원고의 첨삭) 투고된 논문은 위원회에서 그 체재와 내용에 대하여 집필자와 합의하여 첨삭할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0013"
      },
      {
        "article_no": "제14조",
        "article_title": "교정",
        "chapter": "",
        "content": "제14조(교정) 집필자는 해당 논문의 초교에서 최종 교정까지를 책임져야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0014"
      },
      {
        "article_no": "제15조",
        "article_title": "비용부담",
        "chapter": "",
        "content": "제15조(비용부담) 본 논문집에 게재할 논문은 인문·사회계는 200자 150매, 자연과학계 및 예·체능계는 200자 원고지 100매를 초과할 경우와 도표, 사진 등으로 특별한 비용이 소요되는 경우에는 초과분 및 소요되는 특별한 비용을 집필자에게 부담시킬 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0015"
      },
      {
        "article_no": "제16조",
        "article_title": "별책",
        "chapter": "",
        "content": "제16조(별책) 게재된 논문에 대하여는 별책 20부를 필자에 증정하나, 그 이상 부수는 필자가 실비를 부담한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교논문집발간규정#JO0016"
      }
    ]
  },
