    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적)  이 규정은 인천대학교 대학원 학칙 제42조에 따른 인천대학교 대학원 (이하 “본 대학원”이라 한다)과 외국대학과의 교육과정 공동운영 및 학생 교류를 통한 공동학위 수여에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:인천대학교대학원공동학위제운영규정#JO0001"
