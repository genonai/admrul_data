  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 제주대학교 명예졸업증서 수여에 관한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교명예졸업증서수여규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "수여원칙",
        "chapter": "",
        "content": "제2조(수여원칙) 명예졸업증서는 사망한 사람 등 재입학이 어려운 사람에게 수여한다．",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교명예졸업증서수여규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "수여대상",
        "chapter": "",
        "content": "제3조(수여대상) 명예졸업증서는 제주대학교 학사과정 입학 후 부득이한 사유로 졸업에 필요한 과정을 이수하지 못한 다음 각 호의 어느 하나에 해당하는 사람에 대하여 수여한다．1．국가수호와 국민을 위하여 희생하였거나 공헌한 사람2．국가와 사회발전에 크게 기여하였다고 인정되는 사람3．그 밖에 명예졸업증서를 수여 받을 자격을 갖추었다고 인정되는 사람",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교명예졸업증서수여규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "수여대상자의 추천",
        "chapter": "",
        "content": "제4조(수여대상자의 추천) 명예졸업증서 수여대상자는 학생이 재적 당시의 소속 단과대학의 장이 별지 제1호 서식으로 추천한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교명예졸업증서수여규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "심의 및 확정",
        "chapter": "",
        "content": "제5조(심의 및 확정) 명예졸업증서 수여대상자는 학무회의 심의를 거쳐 총장이 확정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교명예졸업증서수여규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "수여 시기",
        "chapter": "",
        "content": "제6조(수여 시기) 명예졸업증서는 정규 학위수여일 이외에도 수여할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교명예졸업증서수여규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "증서",
        "chapter": "",
        "content": "제7조(증서) 명예졸업증서의 서식은 별지 제2호 서식과 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교명예졸업증서수여규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "학적 관리",
        "chapter": "",
        "content": "제8조(학적 관리) 명예졸업자는 학적부에 명예졸업 사항을 등재한다．",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:제주대학교명예졸업증서수여규정#JO0008"
      }
    ]
  },
