  "body": {
    "format": "articles",
    "article_count": 15,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 규정은 경상대학교교지발간에 관하여 필요한 사항을 규정함을 목적으로 한다.(개정 2010.07.30)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "위원회",
        "chapter": "",
        "content": "제2조 (위원회) 경상대학교교지(이하 \"교지\"라 한다)발간을 위하여 운영위원회, 편집위원회를 둔다.(개정 2010.07.30)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "운영위원회",
        "chapter": "",
        "content": "제3조 (운영위원회) 운영위원회는 학생처장, 학생처 학생과장, 본 규정 제10조에 따른 편집위원회 지도교수, 총학생회장, 제6조의 편집위원장으로 구성하고 위원장은 학생처장이 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "운영위원회의 기능",
        "chapter": "",
        "content": "제4조 (운영위원회의 기능) 운영위원회는 다음 각호의 사항을 심의한다.1. 예산 및 결산에 관한 사항2. 그 밖에 교지발간에 관한 중요사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "운영위원회의 소집 및 의결",
        "chapter": "",
        "content": "제5조 (운영위원회의 소집 및 의결) 운영위원회는 필요에 따라 위원장이 소집하고 재적의원 3분의 2이상의 출석과 출석위원 과반수의 찬성으로 의결한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "편집위원회",
        "chapter": "",
        "content": "제6조 (편집위원회) ① 편집위원은 각 대학장의 추천에 의하여 총장이 임명하는 각 대학당 1명의 학생과 총학생회 학술부장으로 구성하고, 위원장은 위원 중에서 호선한다.② 편집위원의 자격기준은 학생회 간부의 자격에 준한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "편집위원회 기능",
        "chapter": "",
        "content": "제7조 (편집위원회 기능) 편집위원회는 다음 사항을 관장한다.1. 편집에 관한 사항2. 교정에 관한 사항3. (삭제 2010.07.30)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "편집위원회 소집 및 의결",
        "chapter": "",
        "content": "제8조 (편집위원회 소집 및 의결) 편집위원회는 제10조에 따른 지도교수 또는 위원장이 소집하고 재적위원 3분의 2 이상의 출석과 출석위원 과반수의 찬성으로 의결한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "견습편집위원",
        "chapter": "",
        "content": "제9조 (견습편집위원) 편집위원회는 학장의 추천을 받은 5명 이내의 견습편집위원을 둘 수 있다.(개정 2010.07.30)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "편집위원회 지도교수",
        "chapter": "",
        "content": "제10조 (편집위원회 지도교수) 편집을 지도하기 위하여 편집위원회에 총장이 임명하는 1명의 지도교수를 둔다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "발간 및 심사",
        "chapter": "",
        "content": "제11조 (발간 및 심사) 교지는 연 1회 발간을 원칙으로 하며, 원고는 편집위원회 지도교수의 심사를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "경비",
        "chapter": "",
        "content": "제12조 (경비) 교지발간 경비는 학생회비로 충당한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "경비의 집행",
        "chapter": "",
        "content": "제13조 (경비의 집행) ① 운영위원 편집위원 및 지도교수에게는 예산의 범위에서 총장이 따로 정하는 기준의 수당을 지급할 수 있다.② 투고자에 대하여는 예산의 범위에서 총장이 따로 정하는 기준의 원고료를 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0013"
      },
      {
        "article_no": "제14조",
        "article_title": "준용",
        "chapter": "",
        "content": "제14조 (준용) 본 규정에 정하지 아니한 사항에 대하여는 본교 학생활동에 관한 규정을 준용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0014"
      },
      {
        "article_no": "제15조",
        "article_title": "세부사항",
        "chapter": "",
        "content": "제15조 (세부사항) 본 규정 시행에 필요한 세부사항은 학생처장이 총장의 승인을 받아 시행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교교지발간규정#JO0015"
      }
    ]
  },
