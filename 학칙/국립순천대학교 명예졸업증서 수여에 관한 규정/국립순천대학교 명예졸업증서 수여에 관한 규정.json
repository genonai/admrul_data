  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 국립순천대학교(이하 “이 대학교”라 한다) 명예졸업증서 수여에 관한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교명예졸업증서수여에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "수여대상",
        "chapter": "",
        "content": "제2조(수여대상) 명예졸업증서는 이 대학교 학사과정 입학 후 부득이한 사유로 소정의 과정을 이수하지 못하였거나, 이 대학교 학사과정에 입학하지 않았더라도 특별한 사유가 있는 사람에게 다음 각 호의 어느 하나에 해당하는 경우 수여할 수 있다.1. 국가수호와 국민을 위하여 희생하였거나 공헌한 사람2. 국가와 사회발전에 크게 기여하였다고 인정되는 사람3. 그 밖에 명예졸업증서를 수여할 상당한 자격을 갖추었다고 인정되는 사람",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교명예졸업증서수여에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "수여절차",
        "chapter": "",
        "content": "제3조(수여절차) 이 대학교 학사과정에 입학한 사람은 스쿨학장 또는 단과대학장의 추천[별지 제1호의 서식]으로, 이 대학교 학사과정에 입학하지 않은 사람은 교무처장의 추천[별지 제1호의 서식]으로 학무회의 심의를 거쳐 총장이 명예졸업증서[별지 제2호 또는 별지 제3호의 서식]를 수여한다. <개정 2026. 1. 6.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교명예졸업증서수여에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "수여시기",
        "chapter": "",
        "content": "제4조(수여시기) 명예졸업증서의 수여는 이 대학교 학위 수여일에 함을 원칙으로 하되 특별한 사유가 있는 경우 예외로 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교명예졸업증서수여에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "수여자 관리",
        "chapter": "",
        "content": "제5조(수여자 관리) ① 명예졸업증서 수여자에 대하여 수여번호 및 수여근거 등을 명예졸업증서 수여 대장[별지 제4호의 서식]에 기록하여 관리한다.② <삭제>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교명예졸업증서수여에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "수여자 대우",
        "chapter": "",
        "content": "제6조(수여자 대우) 명예졸업증서 수여자에게는 이 대학교 총동문회 가입자격 부여 등 정규졸업생에 준하는 대우를 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교명예졸업증서수여에관한규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "수여취소",
        "chapter": "",
        "content": "제7조(수여취소) 명예졸업증서 수여자가 이 대학교의 명예를 실추하였거나 사회적으로 물의를 일으킨 경우에는 명예졸업증서 수여 사실을 취소할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교명예졸업증서수여에관한규정#JO0007"
      }
    ]
  },
