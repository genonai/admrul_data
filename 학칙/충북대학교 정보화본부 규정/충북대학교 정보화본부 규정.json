  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 충북대학교 정보화본부의 조직과 운영에 필요한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충북대학교정보화본부규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "기능",
        "chapter": "",
        "content": "제2조(기능) 충북대학교 정보화본부는 대학 정보화의 기획·조정·관리, 학사·행정·연구 정보시스템의 운영과 관리, 정보통신망 구축과 정보보안 등의 업무를 수행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충북대학교정보화본부규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "업무",
        "chapter": "",
        "content": "제3조(업무) 정보화본부는 다음 각 호의 업무를 수행한다.1. 대학 정보화 기본 계획 수립 및 추진2. 대학 정보시스템 구축 및 운영3. 정보통신망 구축 및 이용 기술 보급4. 정보보호 강화 및 보안성 검토5. 데이터베이스 설계 및 통합 운영·관리6. 정보화 교육 및 실습 지원7. 대학 공용 소프트웨어 관리8. 정보화추진위원회 운영9. 그 밖에 대학 정보화에 관한 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충북대학교정보화본부규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "본부장",
        "chapter": "",
        "content": "제4조(본부장) ① 정보화본부에는 본부장을 두며, 본부장은 이 대학교 부교수 이상의 전임교원 중에서 총장이 임명하고 임기는 2년으로 한다.② 본부장은 정보화본부의 업무를 총괄한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충북대학교정보화본부규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "조직",
        "chapter": "",
        "content": "제5조(조직) ① 정보화본부에 정보화과를 둔다. <개정 2026.1.29.>② 정보화과에는 과장을 두며, 과장은 전산사무관으로 한다. <개정 2026.1.29.>③ 정보화 업무를 효율적으로 수행하기 위하여 팀을 두어 사무를 분장한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충북대학교정보화본부규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "정보화추진위원회",
        "chapter": "",
        "content": "제6조(정보화추진위원회) ① 대학 정보화 사업에 관한 중요 사항을 심의하기 위하여 정보화추진위원회를 둔다.② 위원회 운영에 대한 세부 사항은 정보화추진위원회 규정으로 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충북대학교정보화본부규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "기타",
        "chapter": "",
        "content": "제7조(기타) 이 규정에서 정하지 아니한 기타 사항은 본부장이 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충북대학교정보화본부규정#JO0007"
      }
    ]
