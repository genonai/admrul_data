  "body": {
    "format": "articles",
    "article_count": 5,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 본 규정은 이 대학교 부속 또는 부설기관의 전임연구원 임용에 필요한 사항을 규정함에 목적이 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교전임연구원임용에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "용어의 정의",
        "chapter": "",
        "content": "제2조 (용어의 정의) 본 규정에서 전임연구원이라 함은 이 대학교 부속 또는 부설기관이 필요로 하는 연구전담교원을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교전임연구원임용에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "임용기간",
        "chapter": "",
        "content": "제3조 (임용기간) 전임연구원의 임용기간은 2년으로 한다. 다만, 특별한 경우에는 1차에 한하여 재임용할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교전임연구원임용에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "신규임용자격",
        "chapter": "",
        "content": "제4조 (신규임용자격) 전임연구원은 석사학위 이상의 소지자로서 이 대학교 부속 또는 부설기관이 필요로 하는 해당분야의 전문성이 뛰어난 자로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교전임연구원임용에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "직급 및 대우",
        "chapter": "",
        "content": "제5조 (직급 및 대우) 전임연구원의 직급은 조교수로 한정하고, 그 대우에 관한 사항은 총장이 따로 정한다(개정 2012.7.20).",
        "enforcement_date": "",
