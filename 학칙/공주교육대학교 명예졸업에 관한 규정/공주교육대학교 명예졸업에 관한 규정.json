  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 특별한 사유로 인하여 공주교육대학교(이하“본교”라 한다)를 졸업하지 못하게 된 자 또는 본교 발전에 기여한 자에게 명예졸업증서를 수여하기 위하여 필요한 사항을 정하는 것을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:공주교육대학교명예졸업에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "명예졸업 수여 요건",
        "chapter": "",
        "content": "제2조(명예졸업 수여 요건) 명예졸업증서의 수여요건은 다음 각 호의 어느 하나에 해당하는 경우를 말한다.1. 본교에 입학하여 학적을 두었다가 특별한 사유로 졸업하지 못하게 되었으나 명예졸업자격이 있다고 인정되는 자2. 기타 총장이 명예졸업의 자격이 있다고 인정한 경우",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:공주교육대학교명예졸업에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "명예졸업의 신청",
        "chapter": "",
        "content": "제3조(명예졸업의 신청) 명예졸업증서를 받고자 하는 자는 본인(본인이 사망한 경우에는 가족)이 다음 각 호의 어느 하나에 해당하는 서류를 구비하여 정규 학위수여일 30일 전에 소속 학과장에게 신청하여야 한다.1. 명예졸업증서 신청서[별지 제1호서식] 1부2. 본인이 아닌 경우 가족임을 증명할 수 있는 서류 1부",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:공주교육대학교명예졸업에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "명예졸업자의 추천 및 선정 절차",
        "chapter": "",
        "content": "제4조(명예졸업자의 추천 및 선정 절차) 명예졸업 대상자가 있을 경우 별지 제2호서식의 추천서에 따른 소속 학과장의 추천으로 교무위원회에서 심의하여 총장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:공주교육대학교명예졸업에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "졸업증서의 수여 및 수여시기",
        "chapter": "",
        "content": "제5조(졸업증서의 수여 및 수여시기)  ① 명예졸업자로 확정된 자에게는 별지 제3호서식의 서식에 따른 명예졸업증서를 수여한다.② 명예졸업증서는 매 학년도 전·후기 학위수여식 수여 시 수여함을 원칙으로 하되, 부득이한 경우 이를 달리하여 수여할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:공주교육대학교명예졸업에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "명예졸업증서 수여 근거의 기록",
        "chapter": "",
        "content": "제6조(명예졸업증서 수여 근거의 기록) 명예졸업증서 수여자는 별지 제4호서식에 따른 명예졸업증서 수여대장에 기록하여 관리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:공주교육대학교명예졸업에관한규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "명예졸업의 취소",
        "chapter": "",
        "content": "제7조(명예졸업의 취소) 이 규정에 의하여 명예졸업증서를 받은 자가 본교의 명예를 실추시켰거나 사회적으로 지탄을 받는 등 명예졸업자로서의 품위를 상실하였을 경우 총장은 교무위원회의 심의에 따라 명예졸업을 취소할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:공주교육대학교명예졸업에관한규정#JO0007"
      }
    ]
  },
