  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 본 대학교 명예총장의 자격기준과 위촉절차에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교명예총장위촉에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "자격",
        "chapter": "",
        "content": "제2조(자격) 인품과 덕망이 높을 뿐만 아니라, 대학발전에 지대한 공헌을 하였거나 할의지가 있는 자를 명예총장으로 위촉 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교명예총장위촉에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "추천",
        "chapter": "",
        "content": "제3조(추천) 명예총장은 교무과장이 대학인사위원회의 심의를 거쳐 추천한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교명예총장위촉에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "위촉",
        "chapter": "",
        "content": "제4조(위촉) 교무과장이 추천한 인사는 교무회의 심의를 거쳐 총장이 위촉한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교명예총장위촉에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "위촉기간",
        "chapter": "",
        "content": "제5조(위촉기간) 명예총장의 위촉기간은 2년으로 하되, 연임할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교명예총장위촉에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "기능",
        "chapter": "",
        "content": "제6조(기능) 명예총장은 비상임으로 하며, 다음 각호의 사항에 관하여 총장의 자문에 응한다. ① 대학 발전에 관한 사항② 산학협력 및 취업 등에 관한 사항③ 기타 총장이 필요하다고 인정하는 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교명예총장위촉에관한규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "예우",
        "chapter": "",
        "content": "제7조(예우) ① 명예총장에게는 의식에 있어 적절한 예우를 한다.② 명예총장이 그 임무를 수행할 때 소요되는 여비는 공무원 여비규정이 정하는 바에 따라 총장에 준하는 여비를 예산의 범위 내에서 지원할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교명예총장위촉에관한규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "해촉",
        "chapter": "",
        "content": "제8조(해촉) 명예총장을 해촉 할 때에는 교무회의 심의를 거쳐 해촉 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교명예총장위촉에관한규정#JO0008"
      }
    ]
