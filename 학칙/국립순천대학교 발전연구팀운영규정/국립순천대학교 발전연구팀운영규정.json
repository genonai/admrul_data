    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 국립순천대학교(이하 “이 대학교”라 한다) 발전을 위한 정책연구와 총장의 자문요청에 응하기 위하여 설치하는 국립순천대학교발전연구팀(이하 “발전팀”이라 한다)의 운영에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교발전연구팀운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "기능",
        "chapter": "",
        "content": "제2조(기능) 발전팀은 다음 각 호의 직무를 수행한다.1. 대학 행정의 효율화를 위한 종합적인 정책 연구2. 대학 중ㆍ장기 발전계획 수립 및 학사제도 개선 연구3. 각종 대학평가 업무 지원4. 기타 대학 발전에 필요한 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교발전연구팀운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "구성",
        "chapter": "",
        "content": "제3조(구성) ①발전팀은 총장이 임명하는 15인 이내의 이 대학교 교원과 교무학사과장 및 기획담당관으로 구성한다.②발전팀에 팀장 1인을 두며, 팀장은 팀원 중에서 총장이 임명한다.③발전팀에는 사무처리를 위하여 간사 1인을 두며, 간사는 팀원 중에서 팀장이 지명한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교발전연구팀운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "임기",
        "chapter": "",
        "content": "제4조(임기) 발전팀장과 팀원의 임기는 1년으로 하되 연임할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교발전연구팀운영규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "팀장 등의 직무",
        "chapter": "",
        "content": "제5조(팀장 등의 직무) ①팀장은 발전팀의 업무를 총괄하며 발전팀을 대표한다.②팀원은 팀장의 명을 받아 과업을 수행한다.③간사는 팀장을 보좌하고 발전팀의 사무를 처리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교발전연구팀운영규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "업무 지원",
        "chapter": "",
        "content": "제6조(업무 지원) ①팀장은 발전팀의 업무를 효율적으로 수행할 수 있도록 필요한 예산과 사무환경 및 인력지원 등을 관련 부서의 장에게 요청할 수 있다.②발전팀에게 정책과제 연구 또는 기타 사업추진을 의뢰할 때는 연구비 또는 사업비를 지급할 수 있다.④총장은 발전팀장의 안정적인 업무수행에 필요하다고 인정할 때에는 학칙 제7조제4항의 교수시간을 감면할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교발전연구팀운영규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "재정",
        "chapter": "",
        "content": "제7조(재정) 발전팀의 재정은 정책과제 수행 또는 기타 사업추진에 지원되는 연구비 또는 사업비로 충당한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교발전연구팀운영규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "보  칙",
        "chapter": "",
        "content": "제8조(보  칙) 발전팀 운영에 관한 세부사항은 팀장이 총장의 승인을 얻어 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교발전연구팀운영규정#JO0008"
      }
    ]
