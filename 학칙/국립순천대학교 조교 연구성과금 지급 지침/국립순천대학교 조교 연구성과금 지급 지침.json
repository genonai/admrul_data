  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 지침은 교육부「국·공립대학 연구보조비 지급 규정」에 따라 국립순천대학교 조교의 연구성과금 지급에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교연구성과금지급지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "기본방침",
        "chapter": "",
        "content": "제2조(기본방침) 조교 근무성적평정 결과와 근무실적 등 총장이 정하는 기준에 의하여 평가하고 등급에 따라 연구성과금을 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교연구성과금지급지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "지급 대상",
        "chapter": "",
        "content": "제3조(지급 대상) 지급기준일(직전학년도 말일) 현재 재직 중인 조교로 지급대상기간(직전학년도) 중 실제로 2개월 이상 근무한 조교를 대상으로 평가하여 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교연구성과금지급지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "등급별 인원비율 및 지급비율",
        "chapter": "",
        "content": "제4조(등급별 인원비율 및 지급비율) 등급별 인원비율 및 지급비율은 총장이 따로 정한다. 다만, 최상위 및 최하위 등급 간 지급액이 1.5배 이상 유지되도록 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교연구성과금지급지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "지급액",
        "chapter": "",
        "content": "제5조(지급액) 매년 교육부 장관이 배정하는 조교 연구성과금 총액을 제4조에서 정하는 등급별 인원비율 및 지급비율에 따라 산정한 금액을 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교연구성과금지급지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "지급시기",
        "chapter": "",
        "content": "제6조(지급시기) 매년 상반기에 평가를 실시하고 그 결과에 따라 상반기에 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교연구성과금지급지침#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "평가단위",
        "chapter": "",
        "content": "제7조(평가단위) 학과(전공) 조교 및 본부·부속기관 조교로 나누어 평가할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교연구성과금지급지침#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "위원회 구성",
        "chapter": "",
        "content": "제8조(위원회 구성) 조교 연구성과금 지급에 관한 사항을 심사하기 위해 교무처장(위원장), 학생처장, 기획처장, 총장이 임명한 전임교원 3명, 교무학사과장으로 “조교 연구성과금 지급심의위원회”를 구성한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교연구성과금지급지침#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "기타",
        "chapter": "",
        "content": "제9조(기타) 이 지침에 명시되지 않은 사항은 총장이 따로 정하는 기준에 의한다.",
        "enforcement_date": "",
        "relations": [],
