  "body": {
    "format": "articles",
    "article_count": 5,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 강원대학교 춘천캠퍼스와 삼척캠퍼스간의 학과 통·폐합 및 이전 등에 관한 원칙을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교학과통폐합및이전등에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "학과 통·폐합, 이전의 필요성 판단",
        "chapter": "",
        "content": "제2조(학과 통·폐합, 이전의 필요성 판단) 학과 통·폐합 및 이전의 필요성은 총장, 당해 학과 또는 단과대학에서 판단한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교학과통폐합및이전등에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "학과의 통·폐합 및 이전",
        "chapter": "",
        "content": "제3조(학과의 통·폐합 및 이전) 학과의 통·폐합 및 이전이 필요하다고 판단하여 이를 추진하려면 총장은 반드시 양 캠퍼스 당해 학과 및 소속 단과대학의 동의를 얻어야 한다. 이 경우 당해 학과 및 소속 단과대학 중 일방이라도 이에 동의하지 아니하면 학과의 통·폐합 및 이전은 추진하지 아니한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교학과통폐합및이전등에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "동의 절차",
        "chapter": "",
        "content": "제4조(동의 절차) 학과의 통·폐합 및 이전은 당해 학과 재적교수 전원의 찬성과, 당해 단과대학 재적교수 2/3이상의 찬성을 얻어야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교학과통폐합및이전등에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "운영세칙",
        "chapter": "",
        "content": "제5조(운영세칙) 강원대학교의 학과 통·폐합 및 이전 등에 관하여 필요한 경우 운영세칙을 둘 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교학과통폐합및이전등에관한규정#JO0005"
      }
    ]
