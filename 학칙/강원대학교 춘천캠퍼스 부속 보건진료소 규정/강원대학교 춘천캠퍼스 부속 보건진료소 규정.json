  "body": {
    "format": "articles",
    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 강원대학교 춘천캠퍼스 부속 보건진료소(이하 \"진료소\"라 한다)의 조직과 운영 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스부속보건진료소규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "직무",
        "chapter": "",
        "content": "제2조(직무) 진료소는 학생 및 교직원의 건강관리와 진료에 관한 사항을 관장한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스부속보건진료소규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "조직",
        "chapter": "",
        "content": "제3조(조직) ①진료소에 소장을 두되, 의과대학학장 또는 관련 학과장이 겸직한다.②진료소에 환경위생부, 건강관리부, 진료부, 약국과 행정실을 둔다.③환경위생부는 학교의 환경 및 식품위생에 관한 사항을 분장한다.④건강관리부는 학생보건 향상을 위한 건강상담, 집단검진과 기타 건강관리에 관한 사항을 분장한다.⑤진료부는 환자진료 및 처리와 질병상담에 관한 사항을 분장한다.⑥ 약국은 약제에 관한 사항을 분장한다.⑦행정실은 보안, 관인관수, 서무회계와 기타 다른 부에 속하지 아니하는 사항을 분장한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스부속보건진료소규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "부장",
        "chapter": "",
        "content": "제4조(부장) ①각 부에 부장, 약국장, 행정실장을 교직원중에서 소장의 제청으로 총장이 임명한다.②부장, 국장, 실장은 소장의 명을 받아 소속업무를 관장하고 소속직원을 감독한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스부속보건진료소규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "교의",
        "chapter": "",
        "content": "제5조(교의) 진료 및 건강상담을 위하여 교의를 둔다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스부속보건진료소규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "운영위원회설치",
        "chapter": "",
        "content": "제6조(운영위원회설치) 진료소의 운영을 위하여 운영위원회 (이하 \"위원회\"라 한다)를 둔다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스부속보건진료소규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "위원회 구성",
        "chapter": "",
        "content": "제7조(위원회 구성) ①위원회의 위원장은 소장이 된다.②위원은 당연직으로 학생처장, 교의를 두며 소장의 추천으로 총장이 임명하는 5인 이내의 이 대학교 전임 교직원으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스부속보건진료소규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "위원회의 위원장",
        "chapter": "",
        "content": "제8조(위원회의 위원장) 위원장은 회무를 통집하며 위원회의 회의를 소집하고 그 의장이 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스부속보건진료소규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "위원회의 기능",
        "chapter": "",
        "content": "제9조(위원회의 기능) 위원회는 다음 각호의 사항을 심의한다.1. 진료소 운영의 기본계획2. 진료소의 제규정 제정 및 개폐3. 기타 소장이 필요하다고 인정하는 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스부속보건진료소규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "위원회의 회의",
        "chapter": "",
        "content": "제10조(위원회의 회의) 위원회의 회의는 재직위원 과반수의 출석으로 개회하고 출석위원 과반수의 찬성으로 의결한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스부속보건진료소규정#JO0010"
      }
    ]
  },
