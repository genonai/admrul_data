    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 다음 각호의 증명서 발급에 관한 사항을 규정함을 목적으로 한다.1. 졸업증명서2. 수료증명서3. 졸업증명서 및 학위수여예정증명서4. 재적증명서 및 제적 증명서5. 재학증명서 및 휴학 증명서6. 성적증명서7. 학위증명서",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교학력증명서발급규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "증명서 발급명의",
        "chapter": "",
        "content": "제2조(증명서 발급명의) 모든 증명서는 총장 명의로 발급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교학력증명서발급규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "증명서 발급신청",
        "chapter": "",
        "content": "제3조(증명서 발급신청) 증명서를 발급하고자 하는 자는 별지 제1호서식의 증명서 교부신청원을 제출하여야 한다. 다만, 자동증명 발급기를 이용할 경우에는 신청원을 생략한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교학력증명서발급규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "증명서 발급절차",
        "chapter": "",
        "content": "제4조(증명서 발급절차) ①증명서는 학적부 및 졸업대장에 기재된 사실에 의거 발급한다.②각종 증명서 발급기간은 민원사무처리규정에 의한다.③재학증명서 발급에 있어서 학년 구분은 강원대학교 학칙에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교학력증명서발급규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "학적부 기재사항 정정",
        "chapter": "",
        "content": "제5조(학적부 기재사항 정정) 본적, 성명, 생년월일이 변경되어 학적부의 기재사항을 변경하고자 하는 자는 호적등·초본 또는 주민등록등·초본을 첨부하여 정정절차를 밟아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교학력증명서발급규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "민원업무처리부 비치",
        "chapter": "",
        "content": "제6조(민원업무처리부 비치) 증명서 발급에 관한 사항을 기록 유지하기 위하여 별지 제2호서식의 증명발급대장을 비치하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교학력증명서발급규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "수수료",
        "chapter": "",
        "content": "제7조(수수료) ①증명수수료는 국립대학교 제증명 수수료 징수규정에 의하여 담당부서에서 징수한다.②소정서식 이외의 외국문 증명서를 발급받고자 하는 자가 외국문으로 신청하지 아니한 경우에는 번역에 필요한 실비를 따로 납부하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교학력증명서발급규정#JO0007"
      }
    ]
  },
