    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총 칙",
        "content": "제1조(목적) 이 규정은 우리 대학교 교원의 교육 및 연구의 질을 향상시키고 대학 및 사회에 대한 기여활동을 활성화하기 위해 교원업적의 평가와 관리에 관한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교교원업적평가규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용",
        "chapter": "제1장 총 칙",
        "content": "제2조(적용) 교원업적의 평가는 다른 법령에 특별한 규정이 있는 경우를 제외하고는 이 규정이 정하는 바에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교교원업적평가규정#JO0002"
      },
      {
