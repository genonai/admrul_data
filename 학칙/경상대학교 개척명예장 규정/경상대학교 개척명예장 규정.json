  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적 및 명칭",
        "chapter": "",
        "content": "제1조(목적 및 명칭) 이 규정은 경상대학교의 발전에 공로가 뚜렷한 인사에 대한 개척명예장 수여에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교개척명예장규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "수여의 원칙",
        "chapter": "",
        "content": "제2조(수여의 원칙) 개척명예장은 교육, 연구, 사회봉사, 재정확충, 학교의 위상제고 등 대학교 발전에 탁월한 공적을 세운 자에게 수여함을 원칙으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교개척명예장규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "추천",
        "chapter": "",
        "content": "제3조(추천) 개척명예장의 추천은 처·국장, 각 대학(원)장, 부속기관장(단과대학의 부속기관장은 제외한다)이 공적조서 및 그 증거서류를 첨부하여 총장에게 추천한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교개척명예장규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "공적심의",
        "chapter": "",
        "content": "제4조(공적심의) 제3조에 의하여 추천된 자의 공적은 학무회의에서 심의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교개척명예장규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "이중수여의 금지",
        "chapter": "",
        "content": "제5조(이중수여의 금지) 개척명예장은 동일한 공적에 대하여 이중으로 수여할 수 없다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교개척명예장규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "제식과 부상",
        "chapter": "",
        "content": "제6조(제식과 부상) 개척명예장을 받는 자에게는 [별표 1]의 서식에 의한 개척명예장과 [별표 2]의 부상을 수여한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교개척명예장규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "특전",
        "chapter": "",
        "content": "제7조(특전) 개척명예장을 받은 자에게는 학교의 주요 행사초청, 학교 간행물 송부, 학교시설 이용자격 부여 등의 특전을 제공한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교개척명예장규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "수여기록부의 비치",
        "chapter": "",
        "content": "제8조(수여기록부의 비치) 경상대학교총장은 개척명예장 수여자에 대한 기록부를 비치· 관리하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상대학교개척명예장규정#JO0008"
      }
    ]
  },
