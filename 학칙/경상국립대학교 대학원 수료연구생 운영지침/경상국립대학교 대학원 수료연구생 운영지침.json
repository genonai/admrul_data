    "article_count": 5,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 지침은 「경상국립대학교 대학원 학위수여규정」 제18조의 규정에 따라 대학원 수료연구생에 대하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교대학원수료연구생운영지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "자격",
        "chapter": "",
        "content": "제2조(자격) 수료연구생은 학위과정을 수료하고 학위청구논문을 준비중인 자로 해당 학기의 정해진 기간 내에 지도교수의 추천으로 학부(과)장을 거쳐 대학원장에게 신청서를 제출하여 총장의 승인을 받은 사람으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교대학원수료연구생운영지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "등록",
        "chapter": "",
        "content": "제3조(등록) ① 「경상국립대학교 대학원 학위수여규정」 제18조에 따른 학위청구논문 제출기한이 경과한 후에 논문을 제출하는 경우에는 해당 학기에 반드시 수료연구생으로 등록하여야 한다.② 수료연구생으로 등록하려는 사람은 매 학기 정해진 등록금을 납부하여야 한다.③ 수료연구생의 등록금은 당해 학기 인문사회계열은 수업료의 8%, 그 밖에 계열은 수업료의 8.5% 해당금액 중 천원 미만을 절사한 금액으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교대학원수료연구생운영지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "혜택",
        "chapter": "",
        "content": "제4조(혜택) ① 수료연구생은 재적생에 준하여 학교의 모든 시설을 이용할 수 있다.② 수료연구생에게 별지 제2호 서식의 수료연구생 등록증명서를 발급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교대학원수료연구생운영지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "징계",
        "chapter": "",
        "content": "제5조(징계) 수료연구생이 학생으로서의 본분을 이탈하거나 면학 분위기를 저해하는 행위를 하였을 경우에는 대학원위원회의 의결을 거쳐 자격을 박탈할 수 있다.",
        "enforcement_date": "",
