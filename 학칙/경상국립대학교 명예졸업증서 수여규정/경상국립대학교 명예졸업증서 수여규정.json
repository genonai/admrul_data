  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 경상국립대학교 학칙 제86조 제4항에 따라 명예졸업증서 수여에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교명예졸업증서수여규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "수여대상",
        "chapter": "",
        "content": "제2조(수여대상) 경상국립대학교(이하 “이 대학교”라 한다)의 명예졸업증서는 다음 각 호의 어느 하나에 해당하는 사람에게 수여한다.1. 국가와 국민을 위하여 희생하였거나 공헌한 사람2. 국가와 사회의 발전에 크게 기여하였다고 인정되는 사람3. 그 밖에 이 대학교의 명예 및 위상을 크게 높인 사람",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교명예졸업증서수여규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "수여대상자 추천 및 선정",
        "chapter": "",
        "content": "제3조(수여대상자 추천 및 선정) 명예졸업증서 수여대상자는 별지 제1호서식에 의하여 교무처장 또는 단과대학장의 추천으로 학무회의 심의를 거쳐 총장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교명예졸업증서수여규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "수여시기",
        "chapter": "",
        "content": "제4조(수여시기) 명예졸업증서는 학위수여일에 수여한다. 다만, 총장이 필요하다고 인정하는 경우에는 따로 정하여 수여할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교명예졸업증서수여규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "수여자의 관리",
        "chapter": "",
        "content": "제5조(수여자의 관리) ① 명예졸업증서 수여자에 대하여 명예졸업증서 수여번호 및 수여근거 등을 별지 제2호 서식의 명예졸업증서 수여 대장에 기록하여 관리한다.② 명예졸업증서 수여자에게는 제증명서를 발급하지 아니한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교명예졸업증서수여규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "수여자의 대우",
        "chapter": "",
        "content": "제6조(수여자의 대우) 명예졸업증서 수여자에게는 정규졸업생에 준하는 대우를 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교명예졸업증서수여규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "명예졸업의 취소",
        "chapter": "",
        "content": "제7조(명예졸업의 취소) 명예졸업증서를 수여받은 사람이 이 대학교의 명예를 실추시키거나 사회적 지탄을 받은 경우 총장은 학무회의 심의를 거쳐 명예졸업을 취소 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교명예졸업증서수여규정#JO0007"
      }
    ]
  },
