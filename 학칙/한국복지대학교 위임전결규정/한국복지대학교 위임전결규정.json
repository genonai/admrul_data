  "body": {
    "format": "articles",
    "article_count": 5,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 한국복지대학교 사무분장 규정에 의한 제반문서 결재에 관한 전결사항과 절차를 정하여 행정의 능률을 도모하고, 업무처리의 신속을 기함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교위임전결규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위)  교무처장, 학생처장, 총무처장과 부속시설의 장은 따로 규정한 것을 제외하고는 이 규정에 의하여 소관 사무를 전결한다. <개정 2020.5.28.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교위임전결규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "전결사항",
        "chapter": "",
        "content": "제3조(전결사항) ① 전결사항은［별표］“한국복지대학교 위임전결구분표”와 같다② 전결사항의 전결권자는 그 전결 집행사항을 위임한 총장에 대하여 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교위임전결규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "중요사항",
        "chapter": "",
        "content": "제4조(중요사항) ① 전결권자는 전결사항이라 할지라도 업무의 내용 또는 성질상 중요하다고 판단되는 경우에는 총장의 지침을 받아 처리하거나, 업무처리 후 보고하여야 한다.② 전결사항 중 타 행정과 또는 부속기관과의 협의를 요하는 사항은 그 행정과 또는 부속기관과의 협의를 거쳐야 하며, 합의를 보지 못한 경우에는 총장의 지시를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교위임전결규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "전결권자의 부재",
        "chapter": "",
        "content": "제5조(전결권자의 부재) 전결권자가 출장 또는 부재중인 경우에는 직무대리 규정 및 사무관리 규정에 의하여 처리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국복지대학교위임전결규정#JO0005"
      }
    ]
