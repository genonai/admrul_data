    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 ?국립공주대학교 학칙? 제82조제4항에 따라 교과목을 수강하지 않고 시험만으로 학점을 취득케 하는 특별시험에 필요한 세부사항을 규정함을 목적으로 한다. <개정 2024. 2. 22.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립공주대학교학점취득특별시험규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "content": "제2조(정의) 특별시험은 학기 시작 전에 학교에서 정하는 교양교과목에 대하여 특별히 실시한 시험에 합격한 사람에게 성적을 인정하는 것을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립공주대학교학점취득특별시험규정#JO0002"
      },
      {
