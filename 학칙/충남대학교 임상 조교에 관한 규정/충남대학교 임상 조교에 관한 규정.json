  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 규정은 충남대학교의과대학의 교수 및 연구활동의 증진과 학생들의 임상실습의 효율화를 위한 임상조교 선발 및 복무에 관한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교임상조교에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "content": "제2조 (정의) 이 규정에서 \"임상조교\"라 함은 충남대학교병원에서 전공의로 근무하는 자 중에서 임상조교로 선발된 자를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교임상조교에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "보수",
        "chapter": "",
        "content": "제3조 (보수) 임상조교의 보수는 무급으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교임상조교에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "인원배정",
        "chapter": "",
        "content": "제4조 (인원배정) 임상조교의 인원은 의과대학장의 요청으로 매 학년도 총장이 배정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교임상조교에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "대상자 선발 및 임용",
        "chapter": "",
        "content": "제5조 (대상자 선발 및 임용) ①임상조교는 충남대학교병원 전공의 중에서 매 학년도 배정인원 범위 내에서 의과대학장이 선발하여 임용하고 총장에게 보고한다.②총장은 제1항에 의한 보고를 근거로 경력증명서를 발급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교임상조교에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "임무",
        "chapter": "",
        "content": "제6조 (임무) 임상조교는 다음 각호의 업무를 성실히 이행하여야 한다.1. 교수 및 연구활동 보조2. 학생의 임상실습 교육지원",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교임상조교에관한규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "해임",
        "chapter": "",
        "content": "제7조 (해임) ①임상조교로서 다음 각호의 1에 해당할 때는 해임된다.1. 전공의 자격을 상실하였을 때2. 제6조의 임무를 성실히 수행하지 않았을 때3. 국가공무원법 제33조의 규정에 해당될 때②제1항의 사유가 발생하였을 때는 의과대학장은 즉시 총장에게 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교임상조교에관한규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "세부사항",
        "chapter": "",
        "content": "제8조 (세부사항) 이 규정에 명시되지 아니한 필요사항은 총장의 승인을 받아 시행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교임상조교에관한규정#JO0008"
      }
    ]
