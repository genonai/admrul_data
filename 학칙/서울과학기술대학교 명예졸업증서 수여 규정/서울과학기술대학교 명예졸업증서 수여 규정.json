  "body": {
    "format": "articles",
    "article_count": 5,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 서울과학기술대학교(전신학교 포함)의 명예졸업증서 수여에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울과학기술대학교명예졸업증서수여규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "수여대상",
        "chapter": "",
        "content": "제2조(수여대상) 명예졸업증서는 다음 각 호의 어느 하나에 해당하는 사람에게 수여한다.1. 서울과학기술대학교(이하 “본교”라 한다.) 재적기간 중 국가와 민족을 위하여 희생하였거나 민주발전에 공헌하다가 부득이 정해진 과정을 이수하지 못한 사람2. 전신학교(2년제 전문대학과정에 한함) 졸업자로서 본교 발전에 지대한 공적이 있거나 명예를 크게 빛낸 사람3. 본교 입학 후 정해진 과정을 이수하지 못한 사람으로서 본교 발전에 지대한 공적이 있거나 명예를 크게 빛낸 사람4. 그 밖에 명예졸업증서 수여가 필요하다고 총장이 인정하는 사람",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울과학기술대학교명예졸업증서수여규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "수여대상자의 결정",
        "chapter": "",
        "content": "제3조(수여대상자의 결정) 명예졸업증서 수여대상자는 총동창회장이나 관련 대학장의 추천에 따라 교무위원회의 심의를 마친 후 총장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울과학기술대학교명예졸업증서수여규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "증서의 서식",
        "chapter": "",
        "content": "제4조(증서의 서식) 명예졸업증서 수여 대상자 중 제2조제1호에 해당하는 사람은 별지 제1호서식의 증서를, 제2호부터 제4호까지 해당하는 사람은 별지 제2호서식의 증서를 수여하며, 내용 및 문안 등은 변경할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울과학기술대학교명예졸업증서수여규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "세부사항",
        "chapter": "",
        "content": "제5조(세부사항) 이 규정 시행에 필요한 사항은 총장이 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울과학기술대학교명예졸업증서수여규정#JO0005"
      }
    ]
