  "body": {
    "format": "articles",
    "article_count": 14,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 강원대학교 춘천캠퍼스 교직원 주택의 관리 및 사용에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "주택",
        "chapter": "",
        "content": "제2조(주택) 이 규정에서 주택이라 함은 강원대학교 춘천캠퍼스 교직원의 주거용으로 사용하는 건물을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "입주자격",
        "chapter": "",
        "content": "제3조(입주자격) 주택의 입주자격은 다음 각호의 1에 해당하는 자로 한다.1. 해외에서 귀국한 신임교수2. 외국인 초빙교수3. 무주택 재직교수4. 업무수행상 입주가 필요하거나, 특별한 사유로 총장이 필요하다고 인정된 자",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "거주기간",
        "chapter": "",
        "content": "제4조(거주기간) 거주기간은 2년으로 한다. 다만, 특별한 사유가 있는 경우에 그 기간을 6월 단위로 연장할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "관장부서",
        "chapter": "",
        "content": "제5조(관장부서) 주택의 관리운영에 관한 사무는 사무국 총무과에서 관장한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "주택의 사용료",
        "chapter": "",
        "content": "제6조(주택의 사용료) 주택의 사용료는 국유재산법 제4조 제2항의 규정에 의하여 무상으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "경비부담",
        "chapter": "",
        "content": "제7조(경비부담) ①가족용 주택의 입주자는 발생 경비 전액을 부담한다②독신용 주택의 입주자는 전기료, 수도료의 실사용료 및 가스료, TV시청료 등 개인이 사용한 경비와 방범비, 오물수거료 등의 공동경비를 부담한다.③독신용 주택의 입주자는 거주여부를 불문하고 난방비 전액을 부담한다. 다만, 총장이 난방비가 과다하다고 인정할 때 난방비 중 일부와 미입주분에 대한 부담금은 학교에서 부담할 수 있다.④입주자의 고의 또는 과실로 인하여, 시설물을 훼손하였을 경우 발생한 비용 및 소규모 수리비는 입주자가 부담하여야 한다.⑤주택의 기능을 유지하기 위한 필요경비는 학교에서 부담한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "입주자의 의무등",
        "chapter": "",
        "content": "제8조(입주자의 의무등) ①입주자는 이 규정이 정한 제반사항을 준수하여야 한다.②입주자는 공동생활의 질서를 지켜야 하며, 제반시설물을 선량하게 관리하여야 한다.③입주자는 입주와 관련된 신분변동 및 근무지 이동 등이 있을 때에는 지체없이 관장부서에 통보하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "금지사항",
        "chapter": "",
        "content": "제9조(금지사항) 입주자는 다음 각호의 행위를 하여서는 아니된다.1. 주택 사용권의 양도, 대여 또는 이와 유사한 행위2. 주택을 주거 이외의 목적에 사용하는 행위3. 주택의 용도 또는 형상을 변경하거나, 시설물을 증설 또는 제거하는 행위4. 주택내에서 가축을 사육하는 행위",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "입주신청 등",
        "chapter": "",
        "content": "제10조(입주신청 등) 입주를 희망하는 자는 별지 제1호서식에 의한 입주신청서를 총장에게 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "입주자의 결정",
        "chapter": "",
        "content": "제11조(입주자의 결정) 입주자의 결정은 이 규정 제3조에 정한 자격기준에 의하여 총장이 결정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "입주",
        "chapter": "",
        "content": "제12조(입주) 입주승인을 받은자는 별지 제2호서식의 서약서를 총장에게 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "퇴거",
        "chapter": "",
        "content": "제13조(퇴거) ①입주자는 본인의 의사에 따라 제14조의 규정에 의거하여 퇴거할 수 있다.②입주자는 다음 각호에 해당될 때에는 퇴거하여야 한다.1. 퇴직, 사망 등의 사유로 공무원의 신분을 상실한 경우2. 주택을 구입하였읕 경우3. 거주기간이 만료되었을 경우4. 입주승인 당시 입주신청서상에 기록된자 이외의 자가 거주하는 경우5. 이 규정에 정한 의무 및 금지사항을 위반하였을 경우6. 기타 퇴거사유가 발생하였을 겅우",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0013"
      },
      {
        "article_no": "제14조",
        "article_title": "퇴거절차",
        "chapter": "",
        "content": "제14조(퇴거절차) 주택에서 퇴거하고자 하는 자는 퇴거 예정일 15일전까지 별지 제3호 서식에 의한 퇴거신청서를 관장부서에 제출하여야 한다. 다만, 제13호 제2항에 해당하는 경우에는 퇴거신청과 관계없이 총장이 퇴거를 통보할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:강원대학교춘천캠퍼스교직원주택관리규정#JO0014"
      }
    ]
  },
