  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 충남대학교학칙 제12조 제1항 별표3에 의하여 설치된 충남대학교 사범대학 교직부(이하 \"교직부\"라 한다)의 조직과 운영에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교사범대학교직부운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "기능",
        "chapter": "",
        "content": "제2조(기능) 교직부는 다음 사항을 관장한다.1. 교직과정 운영의 기본계획2. 교직과정 이수예정자 선발2. 교직과정 개설 및 폐지에 관한 사항4. 교직 부전공 표시과목 결정승인에 관한 사항5. 교육실습 운영6. 교원자격 검정업무 지원9. 기타 교직과정 운영에 중요하다고 판단되는 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교사범대학교직부운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "부장",
        "chapter": "",
        "content": "제3조(부장) ①교직부에 부장을 두며, 부장은 부교수 이상의 교원중에서 사범대학장이 추천하여 총장이 임명하고 임기는 2년으로 한다.②부장은 교직부 업무를 총괄한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교사범대학교직부운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "직원",
        "chapter": "",
        "content": "제4조(직원) 교직부 사무를 처리하기 위하여 직원을 둘 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교사범대학교직부운영규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "위원회",
        "chapter": "",
        "content": "제5조(위원회) 교직부의 운영에 관한 사항을 심의하기 위하여 교직과정운영위원회(이하 '위원회'라 한다)를 둔다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교사범대학교직부운영규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "위원회의 구성",
        "chapter": "",
        "content": "제6조(위원회의 구성) ①위원회의 위원은 교직부장을 포함하여 9인 이내로 구성한다.②위원의 임기는 2년으로 하고 위원장은 교직부장이 된다.③위원은 교직부장의 추천으로 사범대학장이 임명한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교사범대학교직부운영규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "위원회의 심의사항",
        "chapter": "",
        "content": "제7조(위원회의 심의사항) 위원회는 제2조 각 호의 사항을 심의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교사범대학교직부운영규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "위원회의 회의",
        "chapter": "",
        "content": "제8조(위원회의 회의) ①위원회는 위원장이 필요하다고 인정하거나, 위원 3분이 1이상의 요청이 있을 때 소집한다.②위원회의 심의사항은 재적위원 과반수의 출석과 출석위원 과반수의 찬성으로 의결한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교사범대학교직부운영규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "운영세칙",
        "chapter": "",
        "content": "제9조(운영세칙) 교직부의 운영에 관하여 필요한 세부사항은 교직부장이 사범대학장의 승인을 얻어 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교사범대학교직부운영규정#JO0009"
      }
    ]
  },
