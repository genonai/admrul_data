  "body": {
    "format": "articles",
    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 한국전통문화대학교 학생증 발급에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교학생증발급규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 이 규정은 본교 재적하는 모든 학생에게 적용된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교학생증발급규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "학생증의 규격",
        "chapter": "",
        "content": "제3조(학생증의 규격) 학생증에 학과, 학번, 성명 등을 기재하고 그 규격 등은 별지 제1호 서식과 같이 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교학생증발급규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "학생증의 발급권자",
        "chapter": "",
        "content": "제4조(학생증의 발급권자) 학생증은 총장 명의로 발급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교학생증발급규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "학생증의 발급시기",
        "chapter": "",
        "content": "제5조(학생증의 발급시기) 학생증은 입학 후 첫 번째 학기에 발급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교학생증발급규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "학생증의 휴대",
        "chapter": "",
        "content": "제6조(학생증의 휴대) ① 학생은 항상 학생증을 휴대하여야 하며, 본교의 교직원으로부터 제시 요구가 있을 때에는 이에 응해야 한다.② 학생증을 분실하였을 때는 즉시 신고하여야하며, 분실신고의 지연 및 관리의 부실로 인하여 발생한 사고에 대하여는 본인이 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교학생증발급규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "학생증의 유효기간",
        "chapter": "",
        "content": "제7조(학생증의 유효기간) 학생증의 유효기간은 당해 학생의 재학기간까지로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교학생증발급규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "학생증의 무효 및 반납",
        "chapter": "",
        "content": "제8조(학생증의 무효 및 반납) ① 학생증은 다음 각 호에 해당할 때에는 이를 무효로 한다.1. 유효기간이 경과되었을 때2. 졸업, 퇴학, 휴학하였을 때와 제적되었을 때3. 기재, 날인사항을 임의로 정정 또는 가감하였거나 식별이 곤란할 정도로 훼손되었을 때② 전항의 규정에 의하여 학생증이 무효가 되었을 경우 당해 학생은 학생과에 반납하여야한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교학생증발급규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "발급대장의 비치",
        "chapter": "",
        "content": "제9조(발급대장의 비치) 학생증 발급에 관한 사항을 기록 유지하기 위하여 학생증 발급대장 별지 제2호 서식을 비치하여야한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교학생증발급규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "학생증의 재발급",
        "chapter": "",
        "content": "제10조(학생증의 재발급) 학생증의 분실 훼손 또는 기재사항의 변동으로 재발급을 받고자하는 학생은 별지 제3호 서식에 의한 학생증 재발급 신청서를 본교 학생과에 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국전통문화대학교학생증발급규정#JO0010"
      }
    ]
  },
  "addenda": [
    {
      "promulgation_date": "20250423",
      "promulgation_no": "00076",
      "content": "부 칙 <제60호, 2025. 5. 1.>제1조(시행일) 이 규정은 2025. 5. 1. 부터 시행한다.제2조(규정의 폐지) 종전의 「한국전통문화대학교 학생증발급 규정」(예규 제32호, 2013. 7. 25.)은 폐지한다.제3조(일반적 경과 조치) 본 규정 시행 당시 종전 예규 「한국전통문화대학교 학생증발급 규정」(한국전통문화대학교예규 제32호, 2013. 7. 25.)에 따라 행한 처분·절차 및 그 밖의 행위는 그에 해당하는 이 규정에 따라 행한 것으로 본다."
    }
  ],
