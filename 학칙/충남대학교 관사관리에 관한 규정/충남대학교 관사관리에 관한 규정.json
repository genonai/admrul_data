  "body": {
    "format": "articles",
    "article_count": 6,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 규정은 충남대학교가 소유 또는 사용하고 있는 관사의 유지관리 및 운영 등(이하 \"관사\"라 한다)에 관한 사용을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교관사관리에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "관사의 정의",
        "chapter": "",
        "content": "제2조 (관사의 정의) 이 규정에서 관사라 함은 다음 각 호의 1에 해당하는 시설로써 간부직 공무원의 주거용 시설 또는 주거용으로 사용하기로 결정된 시설과 그 부대시설을 말한다.1. 충남대학교에서 관리하고 있는 국유재산2. 충남대학교가 임차한 타인 소유의 주거용 시설3. 기관장이 주거하고 있는 시설",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교관사관리에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "관사의 구분",
        "chapter": "",
        "content": "제3조 (관사의 구분) 관사 종류를 다음과 같이 구분한다.1. 1급관사(공관) : 충남대학교 총장이 사용하는 관사2. 2급관사(준공관) : 학·처(원)장 사무국장이 사용하는 관사",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교관사관리에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "관리비의 구분",
        "chapter": "",
        "content": "제4조 (관리비의 구분) ①관사 관리에는 이를 재산의 유지관리에 따른 경비와 기본장식물의 유지관리 경비 및 일상경비로 구분한다.②전항의 경비구분에 따른 시설, 설치, 수선 등의 세부구분은 별표1과 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교관사관리에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "관리비의 부담",
        "chapter": "",
        "content": "제5조 (관리비의 부담) 관사 유지관리 및 운영에 필요한 경비의 부담은 별표2와 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교관사관리에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "관리책임",
        "chapter": "",
        "content": "제6조 (관리책임) 관사를 사용하는 자는 다음 각호의 관리책임을 진다.1. 사용자는 선량한 관리자로서의 주의를 다하여 재산을 보호 유지하여야 한다.2. 사용자의 과실로 인하여 파손 및 훼손하였을 경우 그 원상 복구의 책임을 지며 복구비는 사용자가 부담한다.3. 관사용 비품은 물품관리 규정에 따라 그 보관 관리의 철저를 기하여 이를 망실 또는 훼손하였을 경우에는 사용자가 책임 변상한다.4. 사용자가 전보시에는 반드시 비품 목록에 의한 인계인수를 이행케 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교관사관리에관한규정#JO0006"
      }
    ]
  },
  "addenda": [
    {
      "promulgation_date": "19760401",
      "promulgation_no": "00221",
      "content": "부칙 <제221호,1976.4.1>①(시행일) 이 규칙은 1976년 4월 1일부터 시행한다.②(경과규정) 이 규정은 시행당시의 총장공관은 본 규정에 의하여 관리한 것으로 본다."
    },
    {
      "promulgation_date": "20010828",
      "promulgation_no": "01027",
      "content": "부칙 <제1027호,2001.8.28>①(시행일) 이 규정은 공포한 날부터 시행한다.②(경과규정) 이 규정 시행당시의 1급관사(공관)는 현총장 취임일(2001. 3. 1), 2급관사는 임차 계약일로부터 본 규정에 의하여 관리된 것으로 본다."
    }
  ],
