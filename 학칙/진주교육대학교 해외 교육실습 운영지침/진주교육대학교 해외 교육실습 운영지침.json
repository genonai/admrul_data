  "body": {
    "format": "articles",
    "article_count": 11,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 지침은 진주교육대학교와 교류협정을 맺은 해외 초등학교에서의 교육실습을 통해 국제적인 안목과 능력을 갖춘 예비교사를 기르기 위한 프로그램의 참여효과를 높이기 위해 진주교육대학교 교육실습 규정에 관련된 사항 중 해외 교육실습 운영을 위한 세부사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교해외교육실습운영지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "해외 교육실습",
        "chapter": "",
        "content": "제2조(해외 교육실습) 해외 교육실습은 우리 대학에서 주관한 해외 교육실습 프로그램에 선발된 학생이 일정기간 동안 교류협정을 맺은 외국의 초등학교에서 교육실습 하는 것을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교해외교육실습운영지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "신청자격",
        "chapter": "",
        "content": "제3조(신청자격) 해외 교육실습 신청자격은 우리 대학교 학생으로 2학기 이상 이수하고 일정한 수준의 해당국가 외국어능력을 소지한 사람으로 해외 교육실습을 주관하는 부서에서 요구하는 참가신청서를 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교해외교육실습운영지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "해외 교육실습생의 선발",
        "chapter": "",
        "content": "제4조(해외 교육실습생의 선발) ①해외 교육실습 프로그램을 주관하는 부서 장(이하 “부서장”)은 해외 교육실습 대상 외국 초등학교, 실습일정 등을 확정하여 공고한다.②부서장은 해외 교육실습을 희망하는 학생을 선발하여 교육실습담당부서에 통보하여야 한다. ③선발은 해당 외국어 교수가 참여하여 학생지원처에서 시행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교해외교육실습운영지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "수강신청",
        "chapter": "",
        "content": "제5조(수강신청) 해외 교육실습생으로 선발된 학생에 대한 수강신청은 수강신청 기간 중 교육실습 프로그램을 주관하는 부서의 통보를 받아 교육실습 담당부서에서 일괄하여 신청한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교해외교육실습운영지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "지도",
        "chapter": "",
        "content": "제6조(지도) 해외 교육실습생에 대한 지도는 현지를 직접 방문하여 지도하거나 전산망이나 문서 등에 의하여 지도할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교해외교육실습운영지침#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "학점 인정",
        "chapter": "",
        "content": "제7조(학점 인정) ①부서장은 국내 교육실습 기간 이전에 해외 교육실습 결과 보고서와 실습생 평가결과(별첨 1)를 취합하여 교육실습담당부서에 제출하여야 한다.②교육실습담당부서는 실습생의 해외 교육실습 결과물을 바탕으로 성적을 부여한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교해외교육실습운영지침#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "해외 교육실습의 인정 범위",
        "chapter": "",
        "content": "제8조(해외 교육실습의 인정 범위) 3주 이상의 해외 교육실습을 이수한 학생은 수업실습Ⅰ 또는 수업실습Ⅱ의 이수를 인정받을 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교해외교육실습운영지침#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "주관부서",
        "chapter": "",
        "content": "제9조(주관부서) ①해외 교육실습에 관한 제반 업무는 해외 교육실습 프로그램을 주관하는 해당 부서에서 담당한다.②학점인정에 관한 업무는 교육실습담당부서에서 담당한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교해외교육실습운영지침#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "의무",
        "chapter": "",
        "content": "제10조(의무) 해외 교육실습생은 다음 각 호의 사항을 준수하여야 한다.1. 오리엔테이션 과정과 해외 교육실습 학교 주관 워크숍 등에 적극 참여하야 한다.2. 해외 교육실습 프로그램 인솔자의 지도에 적극 협조하여야 한다.3. 해외 교육실습 프로그램 종료 후 교육실습 결과 보고서와 실습생 평가서를 대학이 정한 기한 내에 반드시 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교해외교육실습운영지침#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "의무위반자 조치",
        "chapter": "",
        "content": "제11조(의무위반자 조치) 다음 각 호에 해당하는 자는 학점인정을 불허한다.1. 교육실습 결과 보고서 및 실습생 평가서의 성적이 저조하거나 대학이 정한 기한 내에 제출하지 않은 경우(단, 불가항력 사유 발생 시 예외로 한다.)2. 해외 교육실습 프로그램을 주관하는 부서에서 요구하는 서약서의 내용을 위반한 경우3. 학생의 신분을 벗어난 행위로 학교의 명예를 실추시킨 자",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교해외교육실습운영지침#JO0011"
      }
    ]
