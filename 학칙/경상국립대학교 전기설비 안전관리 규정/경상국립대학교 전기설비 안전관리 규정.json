  "body": {
    "format": "articles",
    "article_count": 14,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 경상국립대학교의 전기설비에 대한 효율적인 공사·유지 및 운영을 위하여 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "의무",
        "chapter": "",
        "content": "제2조(의무) 경상국립대학교(이하 “이 대학교”라 한다)의 교직원은 전기 관계 법령 및 이 규정을 준수하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "안전관리업무의 감독",
        "chapter": "",
        "content": "제3조(안전관리업무의 감독) ① 전기설비의 공사·유지에 관한 안전관리업무는 총장이 총괄하고, 전기안전관리자(이하 “안전관리자”라 한다)를 배치하여야 한다.② 안전관리자의 직무는 다음 호와 같다.1. 전기설비의 안전관리교육2. 전기설비의 공사3. 전기설비의 보수4. 방재 및 재해 대책5. 전기설비의 운전 조작6. 안전관리업무의 기록",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "설치자의 의무",
        "chapter": "",
        "content": "제4조(설치자의 의무) 전기설비에 관한 중요한 사항을 결정하거나 관할 관청에 제출하는 서류의 내용이 전기설비의 안전과 관련될 때에는 안전관리자의 의견을 들어야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "사용자의 의무",
        "chapter": "",
        "content": "제5조(사용자의 의무) 전기설비의 설치 및 사용자는 안전관리자의 지시에 따라야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "안전관리자 부재시의 운용",
        "chapter": "",
        "content": "제6조(안전관리자 부재시의 운용) ① 안전관리자가 질병 등 부득이한 사정으로 직무를 수행할 수 없을 때는 그 업무를 대행할 자(이하 “대행자”라 한다)를 반드시 지명 하여야 한다.② 대행자는 안전관리자의 직무를 성실하게 수행하여야 하고, 그 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "공사계획",
        "chapter": "",
        "content": "제7조(공사계획) ① 전기설비의 설치 및 공사계획을 수립할 때는 안전관리자의 의견을 들어야 한다.② 안전관리자는 전기설비의 중요한 공사는 총장의 승인을 얻어야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "공사실시",
        "chapter": "",
        "content": "제8조(공사실시) ① 전기설비에 관한 공사는 안전관리자의 감독 하에 시공하여야 한다.② 전기설비에 관한 공사는 책임소재를 명확히 하고, 완공 시에는 안전관리에 지장이 없다고 인정될 때 인수하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "순시, 점검, 측정",
        "chapter": "",
        "content": "제9조(순시, 점검, 측정) 순시, 점검 및 측정 결과가 법령에 정한 기준에 부적합할 때에는 그 사용을 일시 정지하거나 제한하는 등의 조치를 하여야 하고, 기준에 적합하도록 유지하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "사고재발 방지",
        "chapter": "",
        "content": "제10조(사고재발 방지) 전기시설에 대한 이상이 발견되거나 사고가 발생되었을 경우 정밀검사를 실시하여 그 원인을 규명하여야 하며, 기준에 적합하도록 운영하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "방재대책",
        "chapter": "",
        "content": "제11조(방재대책) ① 비상재해 발생 시 전기설비의 안전을 확보하기 위하여 비상연락 체계를 유지하여야 한다.② 안전관리자는 비상재해 발생시 전기시설물의 안전을 지휘, 감독하여야 한다.③ 안전관리자는 재해 등으로 전기시설에 위험이 있다고 인정 될 때는 총장의 승인을 얻어 즉시 송전을 정지할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "책임의 한계점",
        "chapter": "",
        "content": "제12조(책임의 한계점) 이 대학교의 안전관리상 책임 한계점은 한국전력공사가 설치한 자동고장구간개폐기 2차측 단자부터로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "위험표시",
        "chapter": "",
        "content": "제13조(위험표시) 고압이상의 전기설비가 되어 있는 장소로서 위험하다고 인정되는 곳에는 위험표시를 표기 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0013"
      },
      {
        "article_no": "제14조",
        "article_title": "그 밖의 사항",
        "chapter": "",
        "content": "제14조(그 밖의 사항) 이 규정에서 정한 것 외에 전기설비 안전관리에 필요한 사항은 총장이 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전기설비안전관리규정#JO0014"
      }
    ]
