  "body": {
    "format": "articles",
    "article_count": 4,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 규정은 학칙 제25조에 의거 목포대학교 교수회(이하 “교수회”라 한다) 운영에 관하여 필요한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교교수회운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "대의기구",
        "chapter": "",
        "content": "제2조 (대의기구) 교수회의 대의기구로 교수평의회를 둔다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교교수회운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "심의·의결사항",
        "chapter": "",
        "content": "제3조 (심의·의결사항) 교수회는 다음 각 호의 사항을 심의·의결한다.1. 총장임용추천 관련 규정의 제정 및 개정2. 교수평의회규정의 제정 및 개정3. 인사 및 재정에 관한 사항4. 기타 필요하다고 인정하는 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교교수회운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "임시의장",
        "chapter": "",
        "content": "제4조 (임시의장) 교수평의회에서 소집 요구한 교수회의는 교수평의회 의장이 임시의장이 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교교수회운영규정#JO0004"
      }
    ]
  },
