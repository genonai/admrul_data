  "body": {
    "format": "articles",
    "article_count": 12,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 대학간에 체결한 학술교류협정에 따라 협정대학교간 교류 및 협력을 통해 대학의 경쟁력을 강화하기 위하여 목포대학교에서 보유하고 있는 각종 시설물 및 기자재의 공동활용 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교시설물및기자재의대학간공동활용에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "용어의 정의",
        "chapter": "",
        "content": "제2조(용어의 정의) ① 이 규정에서 \"시설물\"이라 함은 목포대학교에서 보유하고 있는 건물, 운동장 등 모든 시설물을 말한다.② 이 규정에서 \"기자재\"라 함은 목포대학교에서 보유하고 있는 교육용, 연구용, 사무용 등의 모든 기자재를 말하며, 도서를 포함한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교시설물및기자재의대학간공동활용에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "주관부서",
        "chapter": "",
        "content": "제3조(주관부서) 목포대학교 시설물 및 기자재의 협정대학간 공동활용에 관한 업무는 기획처에서 담당한다.제 2 장 사 용",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교시설물및기자재의대학간공동활용에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "사용자격",
        "chapter": "",
        "content": "제4조(사용자격) 목포대학교의 시설물 및 기자재를 사용할 수 있는 자격은 협정 대학의 교원, 직원 및 대학원생으로 하며, 협정대학의 총장이 발급한 신분증을 소지한 자로 한다. 다만, 부득이 한 경우에는 총장이 그 자격을 제한할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교시설물및기자재의대학간공동활용에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "활용대상 및 범위",
        "chapter": "",
        "content": "제5조(활용대상 및 범위) 목포대학교에서 활용할 수 있는 시설물 및 기자재의 대상 및 범위는 제2조에서 정한 모든 시설물 및 기자재로 한다. 다만, 부득이한 경우에는 총장이 그 대상 및 범위를 제한할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교시설물및기자재의대학간공동활용에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "사용신청",
        "chapter": "",
        "content": "제6조(사용신청) ① 목포대학교의 시설물 및 기자재를 사용하고자 하는 경우에는 사용을 원하는 자가 사용예정일 3주일 전까지 시설물 및 기자재 사용신청서(별지1호 서식)를 목포대학교 기획처로 제출하여야 한다.② 목포대학교 기획처는 사용신청에 대한 허가 여부를 1주일 이내에 회신하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교시설물및기자재의대학간공동활용에관한규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "시설물 및 기자재목록 비치",
        "chapter": "",
        "content": "제7조(시설물 및 기자재목록 비치) 목포대학교 기획처에서는 목포대학교 및 협정대학교 시설물 및 기자재 목록을 비치하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교시설물및기자재의대학간공동활용에관한규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "사용시간",
        "chapter": "",
        "content": "제8조(사용시간) 시설물 및 기자재는 운동장 사용을 제외하고는 평일(월-금요일)에 한하여 10:00∼17:00까지 사용하는 것을 원칙으로 한다. 다만, 부득이 시간을 연장할 경우 해당 시설물 및 기자재를 관리하는 기관(부서)장의 허락을 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교시설물및기자재의대학간공동활용에관한규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "사용료",
        "chapter": "",
        "content": "제9조(사용료) 목포대학교 시설물 및 기자재의 사용료는 무상으로 함을 원칙으로 한다. 다만, 부득이한 경우에는 소정의 사용료를 징수할 수 있다.제 3 장 보 칙",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교시설물및기자재의대학간공동활용에관한규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "변상",
        "chapter": "",
        "content": "제10조(변상) 목포대학교 시설물 및 기자재를 사용하는 과정에서 사용자의 과실 등으로 인하여 훼손 및 망실된 경우에는 원상복구 또는 이에 상응하는 변상 조치를 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교시설물및기자재의대학간공동활용에관한규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "기자재 공동취득",
        "chapter": "",
        "content": "제11조(기자재 공동취득) 고가의 기자재 또는 공동으로 구입함이 타당하다고 인정된 기자재에 대하여는 협정 대학간의 합의에 의하여 공동으로 구매할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교시설물및기자재의대학간공동활용에관한규정#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "기타사항",
        "chapter": "",
        "content": "제12조(기타사항) 이 규정에 정하지 아니한 사항 및 이 규정 시행에 관하여 필요한 사항은 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교시설물및기자재의대학간공동활용에관한규정#JO0012"
      }
    ]
  },
