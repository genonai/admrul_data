  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 한국교통대학교 연구소(이하 “연구소”라 한다)의 설립절차와 운영에 관한 기본지침을 정하여 건전한 발전을 도모함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교연구소설치운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 연구소의 설치와 운영에 관하여 다른 법령, 학칙에 특별히 규정한 것을 제외하고는 이 규정이 정하는 바에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교연구소설치운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "설립",
        "chapter": "",
        "content": "제3조(설립) 연구소를 설립하고자 할 때에는 연구소명, 목적, 사업내용 등을 명시하여 산학협력단장에게 연구소 설립 신청을 하여야 하며 연구위원회의 심의를 거쳐 총장의 승인을 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교연구소설치운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "연구소장",
        "chapter": "",
        "content": "제4조(연구소장) ① 연구소에는 연구소장을 두며, 소정의 추천절차를 거쳐 산학협력단장의 제청으로 총장이 임명한다.② 연구소장의 임기는 2년으로 하되, 연임할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교연구소설치운영규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "사업보고 및 평가",
        "chapter": "",
        "content": "제5조(사업보고 및 평가) 연구소는 당해연도 사업보고서를 소정 기한 내에 대학에 제출하여야 하며, 연구위원회의 평가를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교연구소설치운영규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "지원",
        "chapter": "",
        "content": "제6조(지원) 평가결과에 따라 연구소 활성화를 위하여 예산의 범위 안에서 재정 지원할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교연구소설치운영규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "연구소 통·폐합 등",
        "chapter": "",
        "content": "제7조(연구소 통·폐합 등) ① 연구소는 평가결과에 따라 통·폐합 및 폐지할 수 있으며, 연구소간의 자발적인 통·폐합 신청이 있을 경우 이를 통·폐합할 수 있다.② 연구소는 해당 연구소를 해산하고자 할 경우 대학에 해산을 신청하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교연구소설치운영규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "해산후의 재산 귀속",
        "chapter": "",
        "content": "제8조(해산후의 재산 귀속) 연구소가 해산되는 경우 그 재산은 대학에 귀속된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교연구소설치운영규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "운영세칙",
        "chapter": "",
        "content": "제9조(운영세칙) 이 규정의 운영에 필요한 사항은 총장이 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:한국교통대학교연구소설치운영규정#JO0009"
      }
    ]
