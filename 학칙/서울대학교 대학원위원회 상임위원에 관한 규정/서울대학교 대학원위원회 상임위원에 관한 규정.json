  "body": {
    "format": "articles",
    "article_count": 5,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적)  이 규정은 「학칙」 제40조제4항에 따라 대학원위원회 상임위원에 관한 사항을 규정함을 목적으로 한다.〔개정 2012.7.12.〕",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교대학원위원회상임위원에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "상임위원수",
        "chapter": "",
        "content": "제2조(상임위원수)  대학원위원회의 업무를 효율적으로 수행하게 하기 위하여 대학원위원회에 3인 이내의 상임위원을 둔다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교대학원위원회상임위원에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "임명",
        "chapter": "",
        "content": "제3조(임명)  상임위원은 대학원위원회 위원 중에서 총장이 임명한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교대학원위원회상임위원에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "직무",
        "chapter": "",
        "content": "제4조(직무)  상임위원의 직무는 다음과 같다.1. 대학원위원회의 심의사항의 사전검토2. 대학원위원회에서 위탁한 사항의 처리3. 기타 대학원위원회 위원장이 필요하다고 인정하는 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교대학원위원회상임위원에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "수당지급",
        "chapter": "",
        "content": "제5조(수당지급)  상임위원에게는 예산의 범위 안에서 수당을 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교대학원위원회상임위원에관한규정#JO0005"
      }
    ]
  },
