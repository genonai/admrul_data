  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 세칙은 학생들에게 장학금을 지급하고자 기부하는 재산의 업무 처리에 필요한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울과학기술대학교장학기부재산처리에관한세칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "content": "제2조(정의) “장학기부”란 서울과학기술대학교 장학회 사업을 위하여 금전, 동산, 부동산, 유가증권, 그 밖의 재산을 기부하는 것을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울과학기술대학교장학기부재산처리에관한세칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "장학재산의 기부",
        "chapter": "",
        "content": "제3조(장학재산의 기부) 학생들을 위한 장학금으로 자기소유의 재산을 기부 하고자 하는 자는 장학기부신청서를 총장에게 제출한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울과학기술대학교장학기부재산처리에관한세칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "장학재산의 채납",
        "chapter": "",
        "content": "제4조(장학재산의 채납) 총장은 장학기부신청서의 내용을 검토하고 수락함이 적절하다고 판단되는 경우에는 서울과학기술대학교 장학회 재산으로 채납(採納)한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울과학기술대학교장학기부재산처리에관한세칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "기부재산의 관리",
        "chapter": "",
        "content": "제5조(기부재산의 관리) ① 장학금으로 기부된 재산의 운영처분은 서울과학기술대학교 장학위원회에서 심의하여 처리한다.② 보통 재산에 편입된 기부금의 관리, 운영처분에 관한 사항은 총장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울과학기술대학교장학기부재산처리에관한세칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "특정장학금 설치",
        "chapter": "",
        "content": "제6조(특정장학금 설치) 기부자가 장학재산의 수혜조건을 특별히 지정하였을 때에는 기부자의 뜻에 따라 총장은 특정장학금을 설치할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울과학기술대학교장학기부재산처리에관한세칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "장학금 지급",
        "chapter": "",
        "content": "제7조(장학금 지급) ① 특정장학금 지급은 지급당시의 금액 또는 재산 평가액으로부터 발생하는 과실 및 수익금액의 범위에서 지급한다.② 보통재산으로 편입된 장학금의 지급 기준은 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울과학기술대학교장학기부재산처리에관한세칙#JO0007"
      }
    ]
