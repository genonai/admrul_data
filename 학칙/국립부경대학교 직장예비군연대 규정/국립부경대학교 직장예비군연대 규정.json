  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은  예비군법 제3조 조직, 예비군법 시행령 제5조에 의거국립부경대학교 직장예비군연대(이하 “연대”라 한다)의 조직 및 운영에 관한사항을 규정함을 목적으로 한다. <개정 2023.12.27.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립부경대학교직장예비군연대규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "직무",
        "chapter": "",
        "content": "제2조(직무) 연대는 다음 각호의 사항을 관장한다.1. 유사시를 대비한 대학방호계획수립 및 시행2. 대학직장예비군(교직원·학생) 조직·편성·교육, 훈련 등 자원관리3. 전시병력동원소집자 자원관리4. 기타 예비군업무에 필요하다고 인정되는 제반 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립부경대학교직장예비군연대규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "조직",
        "chapter": "",
        "content": "제3조(조직) 연대에는 예비군훈령 별표12에 따라 연대장과 참모, 사무원 2명을 둘 수 있으며, 그 운영은 예비군관련법규를 준용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립부경대학교직장예비군연대규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "임무",
        "chapter": "",
        "content": "제4조(임무) ⓛ연대장은 연대를 대표하고 연대를 관리·운영한다.②참모와 사무원은 연대장의 명을 받아 제2조의 업무를 담당한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립부경대학교직장예비군연대규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "방위협의회",
        "chapter": "",
        "content": "제5조(방위협의회) 연대의 원활한 운영을 위하여 국립부경대학교 직장방위협의회(이하 “직장방위협의회”라 한다)를 두며, 직장방위협의회의 운영에 관한 세부사항은 예비군 육성·지원에 관한 규칙「국방부령996호」을 적용한다.<개정 2023.12.27.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립부경대학교직장예비군연대규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "업무협조",
        "chapter": "",
        "content": "제6조(업무협조) 연대장은 교직원 전·출입 및 학생의 입학, 복학, 졸업,제적 등 변동사항과 교육·훈련에 따른 업무협조를 각 부서장에게 요구할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립부경대학교직장예비군연대규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "직장예비군육성·지원",
        "chapter": "",
        "content": "제7조(직장예비군육성·지원) 대학에서 예비군 육성·지원에 관한 사항은예비군 육성·지원에 관한규칙 「국방부령 제996호」제3장 직장예비군의육성·지원을 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립부경대학교직장예비군연대규정#JO0007"
      }
    ]
  },
