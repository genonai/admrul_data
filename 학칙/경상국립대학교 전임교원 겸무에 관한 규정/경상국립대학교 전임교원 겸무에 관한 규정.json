  "body": {
    "format": "articles",
    "article_count": 6,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 경상국립대학교 전임교원의 겸무에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전임교원겸무에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "content": "제2조(정의) 이 규정에서 사용하는 용어의 뜻은 다음과 같다.1. “겸무”란 경상국립대학교 대학(원)의 학부(과), 본부 및 부속기관 등에 소속된 전임교원이 소속 외의 다른 기관 및 부서의 업무를 겸하는 것을 말한다.2. “본직부서”란 현 임용당시의 소속부서를 말하며, 겸무부서는 현 임용당시의 소속부서를 달리하여 업무를 수행하는 부서를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전임교원겸무에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "근무",
        "chapter": "",
        "content": "제3조(근무) ① 겸무하는 교원은 복무에 관한 사항은 본직부서장의 지휘·감독을 받는다.② 겸무하는 교원의 담당직무는 본직부서와 겸무부서의 협의에 따라 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전임교원겸무에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "기간",
        "chapter": "",
        "content": "제4조(기간) 겸무기간은 본직부서와 겸무부서와의 협의에 의하여 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전임교원겸무에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "권리와 의무",
        "chapter": "",
        "content": "제5조(권리와 의무) 겸무하는 교원은 강의 및 대학원 학생의 논문지도 또는 연구소 업무 등을 담당한다. 다만, BK(두뇌한국)21 플러스 사업에 참여하여 겸무하는 교원은 겸무부서의 전임교원과 동등한 권리와 의무를 가진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전임교원겸무에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "겸무임용",
        "chapter": "",
        "content": "제6조(겸무임용) 전임교원의 겸무는 겸무부서의 장이 본직부서의 장의 동의를 받아 총장에게 추천하고, 총장이 임용한다. 다만, 대학발전에 관련된 한시적인 특정사업을 위하여 겸무임용이 필요한 경우에는 부서간의 협의를 거쳐 총장이 임용할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교전임교원겸무에관한규정#JO0006"
      }
    ]
