  "body": {
    "format": "articles",
    "article_count": 20,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 경인교육대학교 교육전문대학원(이하 “본 대학원”이라 한다)에 입학하는 외국정부지원 외국인의 위탁과정(이하 “위탁과정”이라 한다)운영에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "과정",
        "chapter": "",
        "content": "제2조(과정) 위탁과정은 석사학위과정을 둘 수 있으며 개설 전공은 전공별 교수 및 수업운영 등 전공의 수용여부를 고려하여 조정할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "선발",
        "chapter": "",
        "content": "제3조(선발) 외국정부로부터 위탁받은 위탁생(이하 “위탁생”이라 한다)의 입학은 정원 외로 입학을 허가할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "지원자격",
        "chapter": "",
        "content": "제4조(지원자격) 위탁생으로 입학할 수 있는 자는 외국정부로부터 추천 위탁을 받은 자로서 국내·외 학사학위를 취득한 자 또는 이와 동등한 학력이 있다고 교육부장관이 인정한 자이어야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "선발방법",
        "chapter": "",
        "content": "제5조(선발방법) 위탁생 선발은 정원 외 특별전형에 의하여 선발한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "선발절차",
        "chapter": "",
        "content": "제6조(선발절차) 선발절차는 외국정부추천서 및 지원서류 심사에 의하며 필요시 면접을 거치도록 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "입학지원 서류",
        "chapter": "",
        "content": "제7조(입학지원 서류) 위탁생으로 입학하고자 하는 자는 다음 각 호의 지원 서류를 제출하여야 한다.1. 입학원서(별지서식) 1부.2. 추천서 1부.3. 대학교 졸업(예정)증명서 1부.4. 재정확인서 1부.5. 기타서류 등",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "입학등록금 납부",
        "chapter": "",
        "content": "제8조(입학등록금 납부) ⓛ 위탁생은 대학에서 정한 소정의 입학금 및 등록금을 납부하여야 한다.② 등록금 납부 시기는 관련국가와의 협의를 거쳐 대학원생 등록시기와 달리 정할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "수업연한",
        "chapter": "",
        "content": "제9조(수업연한) 석사과정의 수업연한은 4학기로 단축 운영할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "수업일수",
        "chapter": "",
        "content": "제10조(수업일수) 수업일수는 매학기 15주로 하되, 운영은 주간 또는 야간제 수업으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "교육과정 및 수업운영",
        "chapter": "",
        "content": "제11조(교육과정 및 수업운영) ① 각 과정별 교육과정 운영은 개설 전공간의 협의를 거쳐 공통과정, 교과교육전공, 교과내용학으로 운영하도록 한다.② 위탁생의 수업운영은 외국어로 진행하되 필요 시 한국어 강좌를 병행하여 진행할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "이수학점 및 학점인정",
        "chapter": "",
        "content": "제12조(이수학점 및 학점인정) ① 위탁생은 아래 영역의 학점을 이수하여야 한다.[그림]② 위탁생은 매 학기당 최대 9학점을 이수할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [
          {
            "type": "image",
            "url": "https://www.law.go.kr/LSW/flDownload.do?flSeq=110378845",
            "seq": "110378845"
          }
        ],
        "provision_id": "school:외국정부위탁과정운영규정#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "한국어 강좌 수강",
        "chapter": "",
        "content": "제13조(한국어 강좌 수강) 위탁생은 우리대학에서 운영하는 한국어 운영강좌에 등록하여 대학에서 정한 소정의 수업을 이수하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0013"
      },
      {
        "article_no": "제14조",
        "article_title": "학위자격시험",
        "chapter": "",
        "content": "제14조(학위자격시험) 위탁생의 학위자격시험은 국내 대학원생과는 달리 면제할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0014"
      },
      {
        "article_no": "제15조",
        "article_title": "논문심사",
        "chapter": "",
        "content": "제15조(논문심사) 위탁생은 우리대학원 학위수여규정에 의거 소정의 논문(프로젝트보고서)심사를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0015"
      },
      {
        "article_no": "제16조",
        "article_title": "학위수여",
        "chapter": "",
        "content": "제16조(학위수여) 본 대학원의 학칙과 규정에 따라 졸업 자격을 갖추었을 경우 본 대학의 학위를 수여한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0016"
      },
      {
        "article_no": "제17조",
        "article_title": "교직원",
        "chapter": "",
        "content": "제17조(교직원) ① 위탁과정 운영을 위해 필요한 전담 교직원을 둘 수 있다.② 전담직원에 대한 인건비는 예산의 범위내에서 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0017"
      },
      {
        "article_no": "제18조",
        "article_title": "지도교수",
        "chapter": "",
        "content": "제18조(지도교수) ⓛ 위탁과정 운영을 위해 각 전공별 지도교수를 둘 수 있다.② 지도교수는 위탁생의 수업 및 연구 등 학생지도를 담당하며 강의료 외 별도의 지도수당을 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0018"
      },
      {
        "article_no": "제19조",
        "article_title": "준수사항",
        "chapter": "",
        "content": "제19조(준수사항) ① 위탁생은 본 대학원의 학칙 및 제 규정을 준수하여야 한다. ② 우리나라의 출입국관리법 및 제반법규를 준수하여야 한다. ③ 본 대학원 수학기간 동안 질병, 사고 등 부득이하게 학업을 계속할 수 없는 경우 본국으로 귀국하여야 한다. ④ 위탁생이 위 제1항 및 제2항을 위반한 경우 대학원장은 대학원위원회의 심의를 거쳐 학위를 수여하지 않을 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0019"
      },
      {
        "article_no": "제20조",
        "article_title": "준용규칙",
        "chapter": "",
        "content": "제20조(준용규칙) 이 규정에 명시되지 않은 사항은 경인교육대학교 교육전문대학원 학칙 및 제 규정을 준용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:외국정부위탁과정운영규정#JO0020"
      }
    ]
  },
