  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 행정업무의 효율적 운영에 관한 규정 제10조제2항에 의하여 청주교육대학교 제반업무 중 보조기관에게 위임하여 전결할 사항과 절차를 정하여 책임행정체제를 확립하고 행정 능률을 도모하는데 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교위임전결규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 청주교육대학교 위임전결에 관하여는 따로 규정한 것을 제외하고는 이 규정이 정하는 바에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교위임전결규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "위임",
        "chapter": "",
        "content": "제3조(위임) ① 결재문서는 그 중요도에 따라 이를 각급 보조기관에게 결재권을 위임한다.② 각급 보조기관의 전결사항은 공통 위임전결 구분표[별표 1] 및 부서별 위임전결 구분표 [별표 2]와 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교위임전결규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "책임",
        "chapter": "",
        "content": "제4조(책임) 전결사항에 대하여 전결권자는 그 전결사항의 집행 권한을 위임한 자에 대하여 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교위임전결규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "중요사항",
        "chapter": "",
        "content": "제5조(중요사항) 전결권자는 전결사항이라 할지라도 그 정도가 교육에 관한 정책결정 또는 주민의 편익에 영향을 줄 수 있다고 판단되는 사항에 대하여는 구두 또는 문서로 위임한 자의 지침을 받아 처리할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교위임전결규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "경미한 사항",
        "chapter": "",
        "content": "제6조(경미한 사항) 이 규정에 규정되지 아니한 사항과 규정된 사항이라도 경미한 사항에 대하여는 그 정도에 따라 전결할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교위임전결규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "보고",
        "chapter": "",
        "content": "제7조(보고) 전결 처리한 사항 중 특히 중요하다고 인정되는 사항은 수시로 위임한 자에게 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교위임전결규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "합의",
        "chapter": "",
        "content": "제8조(합의) 전결사항 중 다른 보조기관과 관련되어 합의를 요하는 사항은 그 보조기관의 합의를 받아야 하며 합의를 받지 못한 경우에는 그 이유를 기재하여 합의를 하여야 할 쌍방 보조기관의 동일 상급자의 결재를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:청주교육대학교위임전결규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "결재권자의 부재",
        "chapter": "",
        "content": "제9조(결재권자의 부재) 결재권자가 결원, 출장 또는 사고가 있을 때에는 직무대리규정 및 행정업무의 효율적 운영에 관한 규정에 의하여 처리한다.",
        "enforcement_date": "",
