  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 충남대학교 기성회직원에 대하여 근무성적을 평정하여 공정한 인사 관리의 기초로하며 행정능률의 향상을 기하게 함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교기성회직원근무성적평정규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "근무성적평정의 기준",
        "chapter": "",
        "content": "제2조(근무성적평정의 기준) 근무성적평정은 평정대상자의 근무실적, 직무수행능력 및 직무 수행태도 등을 객관적으로 평가하여 신뢰성과 타당성이 보장되도록 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교기성회직원근무성적평정규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "근무성적평정서",
        "chapter": "",
        "content": "제3조(근무성적평정서) 근무성적평정서(이하 \"평정서\"라 한다)는 별지 서식에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교기성회직원근무성적평정규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "평정자와 확인자",
        "chapter": "",
        "content": "제4조(평정자와 확인자) 평정자와 확인자는 아래와 같이 지정한다.[그림]",
        "enforcement_date": "",
        "relations": [],
        "images": [
          {
            "type": "image",
            "url": "https://www.law.go.kr/LSW/flDownload.do?flSeq=41458373",
            "seq": "41458373"
          }
        ],
        "provision_id": "school:충남대학교기성회직원근무성적평정규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "근무성적평정의 시기",
        "chapter": "",
        "content": "제5조(근무성적평정의 시기) 근무성적평정은 4월말과 10월말에 각각 실시한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교기성회직원근무성적평정규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "평정방법",
        "chapter": "",
        "content": "제6조(평정방법) ①평정대상자가 평정서에 본인의 담당직무내용과 희망 및 건의사항을 기재 하도록 한다.②평정자와 확인자는 각 평정요소별로 평정점을 결정하여 ○표로 평정하고 점수를 합산 한다.③총평점은 평정자와 확인자가 각각 50점씩 평정하여 100점 만점으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교기성회직원근무성적평정규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "평정결과의 제출",
        "chapter": "",
        "content": "제7조(평정결과의 제출) 확인자는 평정의 결과를 기록한 평정서를 평정후 10일 이내에 총무 과에 제출한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교기성회직원근무성적평정규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "평정결과의 활용",
        "chapter": "",
        "content": "제8조(평정결과의 활용) 근무성적평정의 결과는 각종 인사관리에 반영시키며, 총 합계접수 가 40점 미만인 자는 근무성적불량자로 처리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교기성회직원근무성적평정규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "평정서의 공개제한",
        "chapter": "",
        "content": "제9조(평정서의 공개제한) 근무성적평정이 결과는 공개하지 아니한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:충남대학교기성회직원근무성적평정규정#JO0009"
      }
    ]
  },
