    "article_count": 5,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 「국립학교설치령」(대통령령 제31506호) 부칙 제3조 및 경상국립대학교 학칙(규정 제1호) 부칙 제3조에 따라 존속하는 경남과학기술대학교의 학사운영에 관한 기본사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경남과학기술대학교존속기간내의재적생학사운영에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용대상 및 기간",
        "chapter": "",
        "content": "제2조(적용대상 및 기간) 이 규정은 경남과학기술대학교에 입학한 학생이나 입학허가를 받은 사람 중 2027년 2월 28일까지(5년제인 건축학과 2028년 2월 29일까지) 재적하는 사람에 대하여 이 규정을 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경남과학기술대학교존속기간내의재적생학사운영에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "운영원칙",
        "chapter": "",
        "content": "제3조(운영원칙) ① 재적생의 학사운영에 관한 사항은 별표 1의 학칙 등 제 규정을 적용한다. 다만, 경상국립대학교의 규정을 적용받고자 하는 재적생은 경상국립대학교가 따로 정하는 규정에 따라 별도의 교육과정 등을 이수하여야 한다.② 별표 1의 학칙 등 제 규정을 운영함에 있어 심의, 의결 사항에 대하여는 학칙 등 제 규정에서 정한 위원회 기능과 유사한 기능을 가지고 있는 경상국립대학교의 관련 위원회가 수행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경남과학기술대학교존속기간내의재적생학사운영에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "제증명 발급",
        "chapter": "",
        "content": "제4조(제증명 발급) 재적생 및 경남과학기술대학교 졸업생 등의 제증명 발급권자는 경상국립대학교 총장으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경남과학기술대학교존속기간내의재적생학사운영에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "보칙",
        "chapter": "",
        "content": "제5조(보칙) 이 규정에 정하지 않은 사항에 관하여는 경상국립대학교 총장이 따로 정한다.",
        "enforcement_date": "",
