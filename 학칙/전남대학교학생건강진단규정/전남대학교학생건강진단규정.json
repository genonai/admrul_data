  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적)이 규정은 학교보건법 제 7조(건강검사의 실시 등) 및 교학규정\n제70조(신체검사)의 규정에 따라 이 대학교 학생의 건강진단에 관한 세부사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생건강진단규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "시행기관",
        "chapter": "",
        "content": "제2조 (시행기관) 이 건강진단은 이 대학교 보건진료소에서 실시한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생건강진단규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "건강진단의 내용",
        "chapter": "",
        "content": "제3조 (건강진단의 내용) 학생건강진단의 내용은 다음과 같다.1. 눈, 귀, 목, 피부, 치아, 혈압, 당뇨, 단백뇨, 빈혈검사, 간기능검사, B형 간염검사, 흉부방사선촬영2. 기타 소장이 필요하다고 인정하는 검사",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생건강진단규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "학생건강진단",
        "chapter": "",
        "content": "제4조 (학생건강진단) ①학생건강진단은 대학내의 질병예방과 학생의 지속적인 건강관리를 위해 매년 1회 정기적으로 실시한다.②지정된 기간 내에 건강진단을 받지 않아 다른 학생의 건강에 피해를 끼칠 우려가 있는 학생에 대하여는 다음 학기의 수강신청을 불허할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생건강진단규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "기타 건강진단",
        "chapter": "",
        "content": "제5조 (기타 건강진단) 보건진료소장이 필요하다고 인정하거나 학내 다른 기관의 요청이 있을 경우 특정 목적의 건강진단을 실시할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생건강진단규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "결과처리",
        "chapter": "",
        "content": "제6조 (결과처리) 보건진료소장은 건강진단의 결과에 따라 치료, 보호, 교정 등을 필요로 하는 자에 대하여는 휴학, 건강상담, 예방조치, 기타 적절한 조치를 취할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생건강진단규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "수수료 징수",
        "chapter": "",
        "content": "제7조 (수수료 징수)보건진료소장은 필요경비의 일부 또는 전부를 수검자로부터 징수할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생건강진단규정#JO0007"
      }
    ]
