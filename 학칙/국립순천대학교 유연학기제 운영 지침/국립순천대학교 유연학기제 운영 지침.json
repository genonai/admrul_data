  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 지침은 국립순천대학교학칙 제26조제3항에 의하여 유연학기 운영에 필요한 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교유연학기제운영지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "유연학기 정의",
        "chapter": "",
        "content": "제2조(유연학기 정의) \"유연학기\"라 함은 학기(방학 포함)중에 학사학위과정 이수학점 중 일부를 취득하게 할 목적으로 개설, 운영하는 학기를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교유연학기제운영지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "교과목 개설",
        "chapter": "",
        "content": "제3조(교과목 개설) 유연학기는 교육과정에 편성된 교과목(단과대학 또는 학과)에 한하며, 개설학기 개강 4주전 유연학기를 희망하는 단과대학 또는 학과의 신청에 의하여 소속 단과대학 학장을 거쳐 대학본부에 제출하고「학사운영위원회」의 심의를 거쳐 총장의 승인을 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교유연학기제운영지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "수강신청",
        "chapter": "",
        "content": "제4조(수강신청) ① 유연학기 수강신청은 학생이 수강신청 기간에 수업시간표에 따라 지정된 방법으로 신청하여야 한다. 다만, 필요한 경우 총장은 일괄적으로 처리할 수 있다.② 유연학기 수업은 수강취소를 허용하지 아니한다. 다만, 질병 및 군입대 등의 사유로 학업이 불가능하게 된 경우에는 예외로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교유연학기제운영지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "수업일수 및 학점",
        "chapter": "",
        "content": "제5조(수업일수 및 학점)  ① 수업일수는 2주 이상으로 한다.② 유연학기에서의 학점은 15시간 이상의 강의를 1학점으로 한다. 다만, 실험·실습·실기과목은 30시간 이상의 강의를 1학점으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교유연학기제운영지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "수강학점",
        "chapter": "",
        "content": "제6조(수강학점) 매 유연학기에 신청할 수 있는 학점은 9학점 이내로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교유연학기제운영지침#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "취소",
        "chapter": "",
        "content": "제7조(취소) 총장은 유연학기제 운영으로 인하여 학사운영에 차질이 예상되거나 민원이 예상되는 경우 학사운영위원회의 심의를 거쳐 승인을 취소할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교유연학기제운영지침#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "기타",
        "chapter": "",
        "content": "제8조(기타) 등록금 및 이 지침에 명시되는 않은 세부사항은 총장이 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교유연학기제운영지침#JO0008"
      }
    ]
