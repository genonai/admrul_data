  "body": {
    "format": "articles",
    "article_count": 12,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적)  이 규정은 서울대학교 계약직 시설공사 감독원(이하 “공사감독원”이라 한다)의 채용조건ㆍ임용절차ㆍ처우 등에 관하여 필요한 사항을 규정함을 목적으로한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교계약직시설공사감독원운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "content": "제2조(정의)  공사감독원은 시설사업 업무수행을 위하여 총장이 임명한 자를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교계약직시설공사감독원운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "구분",
        "chapter": "",
        "content": "제3조(구분)  공사감독원은 “공사감리원”과 “전산설계원”으로 구분한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교계약직시설공사감독원운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "채용자격",
        "chapter": "",
        "content": "제4조(채용자격)  공사감독원으로 채용될 수 있는 자의 자격기준은 별표 1과 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교계약직시설공사감독원운영규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "정원",
        "chapter": "",
        "content": "제5조(정원)  공사감독원의 연도별 정원은 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교계약직시설공사감독원운영규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "임용 및 기간",
        "chapter": "",
        "content": "제6조(임용 및 기간)① 공사감독원은 선정위원회의 추천에 의하여 총장이 임명한다.② 임용기간은 1년 이내로 하고, 시설사업 종료시까지 3년 이내에서 재임용 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교계약직시설공사감독원운영규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "채용결격사유",
        "chapter": "",
        "content": "제7조(채용결격사유)  국가공무원법 제33조 각 호의 1에 해당하는 자는 공사감독원으로 채용될 수 없다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교계약직시설공사감독원운영규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "채용계약의 해지",
        "chapter": "",
        "content": "제8조(채용계약의 해지)  공사감독원에게 다음 각 호의 1에 해당하는 사유가 있는 때에는 총장은 채용계약을 해지할 수 있다.1. 업무를 태만히 하거나 업무수행 능력이 부족한 때2.신체ㆍ정신상의 이상으로 계약기간 내에 계약사업을 수행하기 곤란한 때3. 계약사업을 계속할 필요성이 소멸한 때4. 복무상 의무에 위반한 때5.제7조의 결격사유에 해당하거나 형사사건으로 기소된 때, 다만 약식명령이 청구된 경우는 제외한다.6. 기타 채용계약상의 해지조건에 해당될 때",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교계약직시설공사감독원운영규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "임무",
        "chapter": "",
        "content": "제9조(임무)  공사감독원은 본교가 정하는 바에 따라 시설공사 감독 및 관련 업무에 종사하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교계약직시설공사감독원운영규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "처우",
        "chapter": "",
        "content": "제10조(처우)① 공사감독원의 보수는 따로 정한다.② 공사감독원이 공사감독업무 이외의 사유로 국외여행을 하거나, 기타 사유로 업무를 수행할 수 없는 경우에는 보수지급을 아니한다.③ 공사감독원의 의료보험 등은 “서울대학교 기성회직원규정”을 준용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교계약직시설공사감독원운영규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "재원",
        "chapter": "",
        "content": "제11조(재원)  공사감독원 보수 등 필요한 경비는 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교계약직시설공사감독원운영규정#JO0011"
      },
