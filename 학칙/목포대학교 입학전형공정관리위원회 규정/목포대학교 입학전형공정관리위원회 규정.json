  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 입학전형에 관한 공정한 관리를 위하여 목포대학교 입학전형공정관리위원회(이하 “위원회”라 한다)의 구성과 운영에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교입학전형공정관리위원회규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "구성",
        "chapter": "",
        "content": "제2조(구성) ①위원회는 총장 직속으로 설치하며, 위원은 5인 이내의 전임교원과 입학 공정성 제고에 기여할 수 있는 외부위원 1인 이상을 포함하여 총장이 임명한다.②위원장은 총장이 임명하고, 부위원장은 위원장이 지명한다.③위원회에는 간사 1인을 두며, 간사는 입학관리과 직원이 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교입학전형공정관리위원회규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "임기",
        "chapter": "",
        "content": "제3조(임기) 위원의 임기는 1년으로 하되, 연임할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교입학전형공정관리위원회규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "위원장 등의 직무",
        "chapter": "",
        "content": "제4조(위원장 등의 직무) ①위원장은 회무를 총괄하고 위원회를 대표한다.②부위원장은 위원장을 보좌하며, 위원장 유고시 그 직무를 대행한다.③간사는 위원장의 명을 받아 위원회의 제반 사무를 처리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교입학전형공정관리위원회규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "임무",
        "chapter": "",
        "content": "제5조(임무) 위원회는 다음 각 호의 임무를 수행한다.1. 대학입학 부정방지 대책 수립 시행2. 입학전형업무 담당자 및 시설의 관리 통제3. 수험생의 이의제기에 대한 내부 심사4. 대학입학 전형의 사전·중간·사후 자체감사 실시5. 기타 입시 부정방지와 관련한 모든 업무",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교입학전형공정관리위원회규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "회의",
        "chapter": "",
        "content": "제6조(회의) ①위원장은 회의를 소집하고, 그 의장이 된다.②회의는 재적위원 과반수 출석으로 개회하고 출석위원 과반수 찬성으로 의결한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교입학전형공정관리위원회규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "보고",
        "chapter": "",
        "content": "제7조(보고) 위원장은 위원회에서 의결된 사항을 총장에게 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교입학전형공정관리위원회규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "수당",
        "chapter": "",
        "content": "제8조(수당) 위원의 임기 중에는 예산의 범위 내에서 수당을 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교입학전형공정관리위원회규정#JO0008"
      }
    ]
