    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 본 규정은 본 대학교에 재직하는 공무원의 근무에 관한 사항을 규정하여 근무기강을 확립하고 사무의 능률화를 도모함에 목적이 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교공무원근무사항에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "근무상황카드 비치·관리",
        "chapter": "",
        "content": "제2조(근무상황카드 비치·관리) 소속 공무원의 근무사항 관리를 위하여 근무상황카드(서식 1), 근무상황부 등을 비치하여 관리한다.(개정2002.6.28)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교공무원근무사항에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "근무상황의 관리",
        "chapter": "",
        "content": "제3조(근무상황의 관리) ① 공무원의 근무상황은 근무상황부(서식2) 또는 근무상황카드에 의하여 관리한다.(개정 2002.6.28)② 공무원이 휴가를 실시할 경우는 근무상황카드에, 관내출장, 지참 · 조퇴, 외출의 경우에는 근무상황부에 의하여 결재권자의 허가를 받아야 한다.(개정 2002.6.28)③ 공무원이 허가를 받지 않고 출근하지 아니할 때에는 근무상황카드에 결근으로 처리한다.(개정 2002.6.28)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교공무원근무사항에관한규정#JO0003"
      },
      {
        "article_no": "제3조의2",
        "article_title": "근무상황의 전자적 관리",
        "chapter": "",
        "content": "제3조의2(근무상황의 전자적 관리)소속 공무원에 대한 근무상황을 「공무원 인사기록·통계 및 인사사무 처리 규정」 제6조의2의 규정에 의하여 전자적으로 관리할 수 있다.(조신설 2013.2.27)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교공무원근무사항에관한규정#JO0003_02"
      },
      {
        "article_no": "제4조",
        "article_title": "휴가의 절차",
        "chapter": "",
        "content": "제4조(휴가의 절차) ① 공무원이 휴가를 받고자 할 때에는 부서장 및 부속(설)기관장의 허가를 받아야 한다. 다만 부서장과 학과장 및 부속(설)기관장은 총장의 허가를 받아야 한다.(개정 2002.6.28)② 긴급한 경우에는 당일 정오까지 소정의 절차를 취하여야 하며 이 경우에 다른 공무원으로 하여금 이를 대행하게 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교공무원근무사항에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "삭제2002.6.28",
        "chapter": "",
        "content": "제5조(삭제2002.6.28)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교공무원근무사항에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "퇴직시의 사무인계",
        "chapter": "",
        "content": "제6조(퇴직시의 사무인계) 공무원이 전보·파견·전출·휴직·정직·직위해제·면직 등의 명령을 받은 때에는 지체없이 담당 미결사항 및 보관하던 문서·물품의 목록을 작성하고 필요한 것은 설명서를 첨부하여 소속기관의 장이 지정한 자에게 인계하고 직근 감독자에게 그 결과를 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교공무원근무사항에관한규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "장기 출장시의 문서처리",
        "chapter": "",
        "content": "제7조(장기 출장시의 문서처리) 공무원이 장기 출장 또는 휴가로 인하여 근무지를 이탈할 때에는 그 담당 사무를 소속 부서장이 지정한 자에게 인계하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교공무원근무사항에관한규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "퇴청시의 서류보관",
        "chapter": "",
        "content": "제8조(퇴청시의 서류보관) 공무원이 퇴청할 때에는 모든 서류는 지정한 서류함에 보관하여야 한다. 다만 유가증권이나 비밀문서 등 특별한 처리를 요하는 것은 따로 보관할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교공무원근무사항에관한규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "준용",
        "chapter": "",
        "content": "제9조(준용) 이 대학교 기성회직원의 근무사항관리는 본 규정의 국가공무원에 준용한다(신설 2002.6.28)",
