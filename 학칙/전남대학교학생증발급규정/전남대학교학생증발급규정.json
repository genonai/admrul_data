  "body": {
    "format": "articles",
    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 규정은 전남대학교 학생증 발급에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생증발급규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조 (적용범위) 이 규정은 이 대학교에 재학하는 학생에게 적용된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생증발급규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "규격",
        "chapter": "",
        "content": "제3조 (규격) ① 학생증 카드에 반도체 IC칩을 내장한 별지 서식 1호와 같은 카드로 한다.② 대학생의 학생증은 엷은 녹색바탕에 배경은 진한녹색으로 하며, 대학원생의 학생증은 베이지색바탕에 배경은 청색(하늘색)으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생증발급규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "발급권자",
        "chapter": "",
        "content": "제4조 (발급권자) 대학생의 학생증은 학생처장이, 대학원생의 학생증은 소속 대학원장이 발급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생증발급규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "발급",
        "chapter": "",
        "content": "제5조 (발급) ① 신입생의 학생증은 입학허가를 받은 학생에게 발급하고 복학 및 재입학은 복학 혹은 재입학 허가 일로부터 2주 이내에 발급 받아야 한다.② 학생증을 분실하거나 파손하였을 때는 별지 2호서식에 의한 학생증 재발급 신청서를 학과장을 경유하여 소속대학 학생과에 신청하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생증발급규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "유효기간",
        "chapter": "",
        "content": "제6조 (유효기간) 학생증의 유효기간은 등록을 필한 당해학기로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생증발급규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "검인",
        "chapter": "",
        "content": "제7조 (검인) 학생증은 매학기 소속대학 학생과장의 등록필 확인을 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생증발급규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "대장비치",
        "chapter": "",
        "content": "제8조 (대장비치) 소속대학 학생과는 학생증 발급을 위하여 별지 3호서식의 학생증발급대장을 비치하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생증발급규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "무효",
        "chapter": "",
        "content": "제9조 (무효) 학생증이 다음 사항에 해당하였을 때는 무효로 한다.1. 유효기간이 경과한 때2. 학생이 졸업, 제적, 기타 사유로 본교의 학적을 상실할 때3. 등록필 확인이 없을 때4. 학생증의 기재 사항을 임의로 정정하였을 때",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생증발급규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "반납",
        "chapter": "",
        "content": "제10조 (반납) 졸업 또는 퇴학, 기타의 사유로 본교의 학적을 이탈하는 학생은 학생증을 반납하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전남대학교학생증발급규정#JO0010"
      }
    ]
  },
