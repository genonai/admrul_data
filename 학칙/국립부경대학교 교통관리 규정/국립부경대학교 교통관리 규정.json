    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총칙",
        "content": "제1조(목적) 이 규정은 국립부경대학교(이하 “본 대학교”라 한다)의 교내 교통관리를 위하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립부경대학교교통관리규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "제1장 총칙",
        "content": "제2조(정의) 이 규정에서 “교통관리”라 함은 차량의 교내 출입과 주차 및 운행등에 관한 관리를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립부경대학교교통관리규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "적용범위",
        "chapter": "제1장 총칙",
        "content": "제3조(적용범위) 본 대학교를 출입하는 모든 차량은 이 규정의 적용을 받는다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립부경대학교교통관리규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "관리원칙",
        "chapter": "제1장 총칙",
        "content": "제4조(관리원칙) ① 주차장을 이용하는 자에게는 월별, 학기별 또는 일정기간별로 소정의 주차료를 징수하고, 일반 이용자에게는 교내 출입 시마다 주차료를 징수한다.② 교내 출입 차량이 주차면수에 비하여 현저히 증가하거나 감소할 경우에는 차량의 교내 출입허용 범위를 조정할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립부경대학교교통관리규정#JO0004"
