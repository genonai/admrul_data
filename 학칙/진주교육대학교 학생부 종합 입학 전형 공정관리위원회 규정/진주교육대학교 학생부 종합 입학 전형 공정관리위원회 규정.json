  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 진주교육대학교 학생부 종합 입학 전형의 공정성을 확보하기 위하여 진주교육대학교 학생부 종합 입학 전형 공정관리위원회(이하 ‘위원회’라 한다)의 구성 및 운영에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교학생부종합입학전형공정관리위원회규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "구성",
        "chapter": "",
        "content": "제2조(구성) ① 위원회는 위원장, 부위원장 1인을 포함하여 조교수 이상 교원, 외부 전문가 등 10인 이내로 구성한다.② 위원장은 총장이 임명하며, 부위원장은 위원 중에서 호선한다.③ 위원회의 사무를 처리하기 위하여 간사 1인을 둔다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교학생부종합입학전형공정관리위원회규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "임기",
        "chapter": "",
        "content": "제3조(임기) ① 위원의 임기는 임명된 날로부터 다음연도 2월 말일까지로 한다.② 위원장, 부위원장 및 위원은 연임할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교학생부종합입학전형공정관리위원회규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "기능",
        "chapter": "",
        "content": "제4조(기능) 위원회의 기능은 다음 각 호와 같다.  ① 학생부 종합 입학전형의 부정 방지 대책 수립 및 시행② 학생부 종합 입학전형의 주요과정 감시③ 기타 학생부 종합 입학전형의 부정 방지에 필요하다고 인정되는 사항",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교학생부종합입학전형공정관리위원회규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "회의",
        "chapter": "",
        "content": "제5조(회의) ① 위원회는 각 모집시기별 입학사정관위원회의 최종평가 후 학생부 종합 전형의 공정성 심의를 위해 회의를 개최한다.② 위원회는 재적위원 과반수의 출석으로 개회하고 출석위원 과반수의 찬성으로 의결한다.③ 기타 입학사정관제 전형의 공정성 심의를 위해 총장의 요청이 있을 때 위원장이 소집한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교학생부종합입학전형공정관리위원회규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "보고",
        "chapter": "",
        "content": "제6조(보고) 위원회는 위원회에서 의결된 사항을 총장에게 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교학생부종합입학전형공정관리위원회규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "수당",
        "chapter": "",
        "content": "제7조(수당) 위원회 위원 및 간사에게는 예산의 범위 내에서 수당을 지급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교학생부종합입학전형공정관리위원회규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "기타",
        "chapter": "",
        "content": "제8조(기타) 이 규정에 정하지 아니한 사항은 위원회의 의결을 거쳐 총장의 승인을 받아 시행한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:진주교육대학교학생부종합입학전형공정관리위원회규정#JO0008"
      }
    ]
