  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적)  이 규정은 대학별 또는 계열별(이하 ‘계열별’이라 한다)로 입학한 학생을 「학칙」 제15조에 따라 학과(부) 또는 전공(이하 ‘학과’라 한다)에 배정하는 기준, 절차, 방법 및 기타 필요한 사항을 규정함을 목적으로 한다.〔개정2012.7.12.〕",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학과배정규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "배정정원 책정",
        "chapter": "",
        "content": "제2조(배정정원 책정)  배정정원은 대학별로 정한 학과별 학년 정원을 기준으로 하여 학생의 지망상황, 각 학과의 수용능력, 해당분야에 대한 사회적 요구 등을 감안하여 소속대학장이 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학과배정규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "배정시기",
        "chapter": "",
        "content": "제3조(배정시기)  학과배정은 매학년도 말에 실시하는 것을 원칙으로 하되 필요한 경우 학기말에도 실시할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학과배정규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "배정대상",
        "chapter": "",
        "content": "제4조(배정대상)  계열별 입학자가 기초과정에서 30학점 이상 취득한 자를 대상으로 하되 소속 대학장이 별도로 정하여 시행할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학과배정규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "배정원칙",
        "chapter": "",
        "content": "제5조(배정원칙)  학과배정은 학생의 지망에 의한다. 다만 지망자가 배정정원을 초과할 경우에는 소속대학장이 정한 배정기준에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학과배정규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "배정기준 성적",
        "chapter": "",
        "content": "제6조(배정기준 성적)  배정기준으로 성적을 활용할 경우 기 이수한 기초과정 교과목의 성적으로 하고 필요한 교과목의 기준을 추가할 수 있으며 그 반영 방법은 소속대학에서 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학과배정규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "전공예약 입학자의 학과배정",
        "chapter": "",
        "content": "제7조(전공예약 입학자의 학과배정)  입학당시 전공을 예약하고 입학한 자는 예약된 전공 이외의 학과로 배정할 수 없다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학과배정규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "시행세칙",
        "chapter": "",
        "content": "제8조(시행세칙)  이 규정의 시행을 위하여 필요한 세부사항은 대학별로 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:서울대학교학과배정규정#JO0008"
      }
    ]
  },
