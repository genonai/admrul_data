  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 대구교육대학교 제반문서의 결재에 관한 전결사항과 그 절차를 정하여 행정의 능률을 도모하기 위하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교위임전결규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "책임",
        "chapter": "",
        "content": "제2조(책임) 전결권자는 전결사항에 관하여 집행권자인 총장에 대한 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교위임전결규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "위임",
        "chapter": "",
        "content": "제3조(위임) ①문서의 결재는 그 중요도에 따라 이를 각급 보조기관의 장에게 결재권을 위임한다.②각급 보조기관의 전결사항은 공통위임전결구분표(별표1) 및 부서별 위임전결구분표(별표2)와 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교위임전결규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "중요사항",
        "chapter": "",
        "content": "제4조(중요사항) ①전결권자는 전결사항이라도 중요한 사항은 미리 구두 또는 문서로 집행권자의 지침을 받아 전결사항을 처리하여야 한다. ②전결사항 중 특히 정책문제와 관련된 중요한 사항과 기타 필요하다고 인정되는 경우에는 본 규정에도 불구하고 집행권자는 따로 지시하여 처리하게 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교위임전결규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "경미한 사항",
        "chapter": "",
        "content": "제5조(경미한 사항) 이 규정에 규정되지 아니한 사항이라도 전결권자는 그 정도에 따라 전결할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교위임전결규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "보고",
        "chapter": "",
        "content": "제6조(보고) 전결 처리한 사항 중 정책수행상 필요하거나 특히 중요하다고 인정되는 사항은 집행권자인 총장에게 수시로 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교위임전결규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "협의",
        "chapter": "",
        "content": "제7조(협의) 전결사항 중 다른 보조기관과 관련되어 협의를 요하는 사항은 보조기관과 협의를 하여야 하며 협의를 하지 못하는 경우에는 그 이유를 기재한 서면으로 총장의 결재를 얻어야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교위임전결규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "결재권자의 부재",
        "chapter": "",
        "content": "제8조(결재권자의 부재) 전결권자가 결원, 출장 또는 사고가 있을 때에는 직무대리규정 또는 행정업무의 효율적 운영에 관한 규정에 의하여 처리한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교위임전결규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "적용",
        "chapter": "",
        "content": "제9조(적용) 위임전결 사항에 관하여 따로 규정이 있는 경우를 제외하고는 이 규정이 정하는 바에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:대구교육대학교위임전결규정#JO0009"
      }
    ]
  },
