    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총칙",
        "content": "제1조(목적) 이 규정은 초·중등교육법 및 교원자격검정령, 동령시행규칙에 의거 전문상담교사 양성과정 운영에 필요한 사항을 규정함을 목적으로 한다.(개정 2013.4.15)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전문상담교사양성과정운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "운영",
        "chapter": "제1장 총칙",
        "content": "제2조(운영) 초·중등교육법 및 교원자격검정령, 동령시행규칙에 의거 전문상담교사 양성과정(이하 “양성과정”이라 한다)의 수업은 계절제(하계방학, 동계방학)로 하며, 필요에 따라서는 야간에도 할 수 있다.(개정 2013.4.15)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전문상담교사양성과정운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "설치과정 및 정원",
        "chapter": "제1장 총칙",
        "content": "제3조(설치과정 및 정원) 양성과정은 비학위 전문상담교사양성과정으로 정원을 30명으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전문상담교사양성과정운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "입학시기",
        "chapter": "제2장 입학·등록·제적",
        "content": "제4조(입학시기) 양성과정의 입학시기는 방학(하계·동계)초로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전문상담교사양성과정운영규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "지원자격",
        "chapter": "제2장 입학·등록·제적",
        "content": "제5조(지원자격) 초·중등교육법 제2조의 각호에 의한 학교의 현직교원으로서 정교사(2급) 및 보건교사(2급) 이상의 자격증을 소지하고 동일 자격증에 의한 3년 이상의 교육경력이 있는 자로 한다. 다만, 기간제교사(전일제 강사 포함)의 경우 임명권자로부터 연수지명을 받은 경우에 한하며, 비학위과정의 모집 시점부터 이수 시점까지 기간제교사의 신분을 유지해야 한다(강사, 시간제 강사는 제외).",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전문상담교사양성과정운영규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "입학지원 서류",
        "chapter": "제2장 입학·등록·제적",
        "content": "제6조(입학지원 서류) 양성과정에 입학하고자 하는 자는 소정의 전형료를 납부하고 다음 각호의 서류를 제출하여야 한다.1. 입학원서 1부2. 최종학위증명서(졸업증명서) 1부3. 경력증명서 1부4. 교원자격증 사본 1부5. 기타 필요한 서류",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전문상담교사양성과정운영규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "선발방법",
        "chapter": "제2장 입학·등록·제적",
        "content": "제7조(선발방법) 양성과정의 학생 선발은 면접 및 서류전형으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:전문상담교사양성과정운영규정#JO0007"
      },
