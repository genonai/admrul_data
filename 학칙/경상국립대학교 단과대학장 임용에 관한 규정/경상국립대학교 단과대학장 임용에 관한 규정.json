  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 「교육공무원 임용령」 제9조의4에 따라 경상국립대학교 단과대학장을 임용하는데 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교단과대학장임용에관한규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "학장임용 방법",
        "chapter": "",
        "content": "제2조(학장임용 방법) 경상국립대학교 단과대학장(이하 “학장”이라 한다)은 내부공모의 방법으로 총장이 임용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교단과대학장임용에관한규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "학장후보자 공모",
        "chapter": "",
        "content": "제3조(학장후보자 공모) ① 총장은 학장임용 50일전까지 학장후보자 공모계획을 마련하여 해당 단과대학(이하 “대학”이라 한다)에 통보한다.② 학장이 되고자 하는 사람은 학장후보자 공모계획에 따라 다음 각 호의 서류를 갖추어 학장후보자 공모에 지원하여야 한다.1. 지원서(별지 1)2. 최근 5년간 연구실적(별지 2)3. 최근 5년간 교내외 봉사활동 실적(별지 3)4. 직무수행계획서(별지 4)5. 그 밖에 총장이 정하는 자료",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교단과대학장임용에관한규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "학장후보자 자격",
        "chapter": "",
        "content": "제4조(학장후보자 자격) 학장후보자는 해당 대학 소속 교수 또는 부교수로서, 다음 각 호의 어느 하나에 해당하지 않아야 한다.1. 징계 의결 요구중이거나 형사사건으로 기소 중인 사람2. 징계처분이 사면 또는 말소되지 아니한 사람3. 감사원 등 감사기관과 검찰·경찰 등 수사기관에서 비위조사 또는 수사 중인 사람4. 그 밖에 사회적 물의 등을 일으켜 보직에 적합하지 않다고 판단되는 사람",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교단과대학장임용에관한규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "학장후보자 공모관리위원회",
        "chapter": "",
        "content": "제5조(학장후보자 공모관리위원회) ① 총장은 해당 대학 교수회의 협조를 받아 학장후보자 공모관리위원회(이하 “관리위원회”라 한다)를 구성한다.② 관리위원회의 위원장은 해당 대학 교수회장이 되며, 위원은 교수회장 포함 3명 이상으로 구성한다. 다만, 해당 대학 교수회장이 학장후보자 공모에 지원하였을 경우에는 위원이 될 수 없고, 위원장은 위원 중에서 호선한다.③ 관리위원회 주관 하에 기표방식의 선호도 조사를 실시하고, 선호도 조사는 해당 대학에 재직 중인 대학 교수회 회원이 공모지원자를 대상으로 1인 1표 방식으로 진행한다.④ 관리위원회는 선호도 조사가 완료되면 그 결과를 확인하고, 상위 2명 이내로 총장에게 보고한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교단과대학장임용에관한규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "임용 절차 등",
        "chapter": "",
        "content": "제6조(임용 절차 등) ① 총장은 선호도 조사 결과를 참고하여 학장 후보자 1명을 지명하고, 대학인사위원회의 동의를 거쳐 해당 대학의 학장으로 임용한다.② 학장후보자 공모에 지원자가 없는 경우에는 총장이 직접 학장후보자를 지명하여 대학인사위회의 동의를 거쳐 해당 대학의 학장으로 임용할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교단과대학장임용에관한규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "그 밖의 사항",
        "chapter": "",
        "content": "제7조(그 밖의 사항) 학장후보자 공모와 위원회 운영에 필요한 사항으로서 본 규정에 명시되지 않은 사항은 총장이 정하는 바에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:경상국립대학교단과대학장임용에관한규정#JO0007"
      }
    ]
