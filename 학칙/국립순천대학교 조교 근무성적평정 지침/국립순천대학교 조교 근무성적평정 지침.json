  "body": {
    "format": "articles",
    "article_count": 6,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 지침은 「국립순천대학교 조교 규정」에 따른 국립순천대학교 조교의 근무성적평정에 관한 세부사항을 규정하여 조교 인사관리의 적정을 기함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교근무성적평정지침#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "시기",
        "chapter": "",
        "content": "제2조(시기) 조교의 근무성적평정은 연 2회(6월 말, 12월 말) 실시한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교근무성적평정지침#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "대상",
        "chapter": "",
        "content": "제3조(대상) 제2조의 평정기준일 현재 재직중인 모든 조교를 대상으로 한다. 다만, 평가대상 조교가 실제 근무한 기간이 1개월 미만인 경우에는 근무성적평가를 실시하지 아니한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교근무성적평정지침#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "방법",
        "chapter": "",
        "content": "제4조(방법) ① 조교의 근무성적평정기간은 평정 기준일로부터 최근 6개월로 별지 제1호 서식“조교 근무성적심사평정표”에 의거 객관적 자료에 의하여 평정한다.② 학부(과) 소속 조교의 심사 평가자는 소속 학부(과)장이, 확인자는 소속 단과대  학장이 되며, 본부 및 부속기관 소속 조교의 평가자는 소속 과장 또는 행정실장이, 확인자는 부서장 또는 부속기관장이 된다. 다만 소속 행정실장이 없는 부속기관에서는 평가자는 부속기관장이, 확인자는 교무처장이 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교근무성적평정지침#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "평정요소",
        "chapter": "",
        "content": "제5조(평정요소) ① 근무성적평가의 평가항목은 근무실적과 직무수행능력을 기본항목으로 하며 평가항목 배점의 총점은 100점으로 한다.② 근무실적의 평가요소는 업무처리능력과 업무기여도 등으로 정하고, 직무수행능력의 평가요소는 직무수행자질과 근무태도 등으로 정한다.③ 제1항에도 불구하고 포상 및 징계를 받은 조교에 대해서는 10점 범위 내에서 가감 부여할 수 있으며, 포상 인정실적은 기초지자체장 이상의 행정기관(공공기관포함)에서 수여한 포상을 대상으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교근무성적평정지침#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "평정결과의 활용",
        "chapter": "",
        "content": "제6조(평정결과의 활용) ① 근무성적평정 결과는 재임용 심사 및 성과급 지급 등에 반영할 수 있다.② 근무성적평정 결과가 연속 2회 80점 미만인 조교는 재임용 대상에서 제외하며, 조교의 재임용 추천 시 소속 학부(과)·부서에서는 재임용 추천서(별지 제2호 서식)를 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:국립순천대학교조교근무성적평정지침#JO0006"
      }
    ]
  },
  "addenda": [
    {
      "promulgation_date": "20240131",
