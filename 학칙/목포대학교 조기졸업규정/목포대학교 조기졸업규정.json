  "body": {
    "format": "articles",
    "article_count": 4,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 학칙 제91조제3항의 조기졸업에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교조기졸업규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "신청",
        "chapter": "",
        "content": "제2조(신청) 조기졸업을 하고자 하는 자는 졸업예정학기 개시 2주 이내에 조기졸업신청서(별지서식)를 소속 학과를 경유하여 소속 대학장에게 제출하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교조기졸업규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "대상자 추천",
        "chapter": "",
        "content": "제3조(대상자 추천) 소속대학장은 조기졸업신청서를 심사하여 조기졸업자를 졸업예정학기초 4주 이내에 총장에게 추천한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교조기졸업규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "자격상실",
        "chapter": "",
        "content": "제4조(자격상실) 조기졸업대상자중 다음 각 호의 어느 하나에 해당하는 자는 조기졸업자격을 상실한다.1. 학칙 제99조에 의한 정학 이상의 징계를 받은 학생2. 조기졸업 신청 후 휴학한 학생3. 조기졸업을 포기한 학생",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:목포대학교조기졸업규정#JO0004"
      }
    ]
  },
