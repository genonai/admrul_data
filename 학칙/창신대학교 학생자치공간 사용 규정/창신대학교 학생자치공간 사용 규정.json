  "body": {
    "format": "articles",
    "article_count": 13,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 학생자치활동에 필요한 공간 사용에 관한 사항을 정하는 것을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교학생자치공간사용규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "학생자치 공간 범위",
        "chapter": "",
        "content": "제2조(학생자치 공간 범위) 학생자치 공간은 학생회관과 학생휴게실로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교학생자치공간사용규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "관리체제",
        "chapter": "",
        "content": "제3조(관리체제) 관리와 업무 관장은 학생취창업처 학생지원팀에서 전담하며 사무처와 상호 협조하여 질서유지, 청소, 보안등을 담당한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교학생자치공간사용규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "점검",
        "chapter": "",
        "content": "제4조(점검) 학생의 안전과 보호를 위하여 연 2회 정기점검을 실시한다. 다만, 필요하다고 인정될 경우에는 수시로 점검할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교학생자치공간사용규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "비품",
        "chapter": "",
        "content": "제5조(비품) 학생은 학생 본분에 맞는 품위를 유지하여 비품을 깨끗이 사용하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교학생자치공간사용규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "사용허가",
        "chapter": "",
        "content": "제6조(사용허가) 학생자치공간을 행사용으로 사용할 경우에는 학생 단체의 대표가 소정의 서류를 갖추어서 지도교수의 허락을 득한 후 학생취창업처에 제출하여 행사 7일전에 학생취창업처장의 허가를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교학생자치공간사용규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "사용자격",
        "chapter": "",
        "content": "제7조(사용자격) 학생자치공간은 창신대학교(이하 “본 대학교”라 한다) 재학생만 사용할 수 있다. 다만, 시설물 사용이 교육의 목적에 부합할 경우에는 총장의 승인을 받아 외부인도 사용할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교학생자치공간사용규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "변조 및 파손",
        "chapter": "",
        "content": "제8조(변조 및 파손) 비품, 실내장치 기구 등을 학생취창업처장의 허가 없이는 변조할 수 없으며, 이를 변조, 파손, 망실하는 경우에는 그 당사자가 즉시 원상회복하거나 변상하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교학생자치공간사용규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "사용 시간",
        "chapter": "",
        "content": "제9조(사용 시간) 사용 시간은 08:00부터 22:00까지로 한다. 다만, 부득이하게 규정된 시간 이후까지 사용해야할 경우에는 시설물사용신청 후 사전 승인을 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교학생자치공간사용규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "비품반출",
        "chapter": "",
        "content": "제10조(비품반출) 비품을 반출해서는 아니되며 부득이하게 비품을 반출해야 할 경우에는 소정의 절차에 따라 총장의 허가를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교학생자치공간사용규정#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "시설보수",
        "chapter": "",
        "content": "제11조(시설보수) 시설을 보수하고자 할 경우 학생취창업처장의 허가를 받아야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교학생자치공간사용규정#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "금지행위",
        "chapter": "",
        "content": "제12조(금지행위) 학생자치공간 안에서 난방기구, 취사, 임의 기숙, 음주, 고성방가, 소란행위 및 시설물을 파괴하는 등 비교육적인 행위를 하여서는 아니 된다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교학생자치공간사용규정#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "고의, 과실책임",
        "chapter": "",
        "content": "제13조(고의, 과실책임) 학생자치공간을 사용하는 단체는 모든 사고를 미연에 방지해야 하며, 학생의 고의, 과실에 의한 사고 발생은 당사자에게 그 책임이 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "school:창신대학교학생자치공간사용규정#JO0013"
      }
    ]
  },
