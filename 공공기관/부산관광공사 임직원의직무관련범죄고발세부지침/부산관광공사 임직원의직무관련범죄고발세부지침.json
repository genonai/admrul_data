      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 소속직원(퇴직자 포함 및 처벌규정의 적용에 있어 공사  임직원으로 의제되는 자를 포함한다.)에 적용한다.",
        "enforcement_date": "",
        "relations": [],
