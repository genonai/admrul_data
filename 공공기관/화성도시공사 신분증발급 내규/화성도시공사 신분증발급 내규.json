  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 화성도시공사(이하 “공사”라 한다)의 직원 신분을 표시하는 신분증의 규격, 제식 및 발급 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:화성도시공사신분증발급내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 이 내규는 공사에 근무하는 모든 임·직원에게 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:화성도시공사신분증발급내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "신분증의 규격·제식",
        "chapter": "",
        "content": "제3조(신분증의 규격·제식) ① 신분증의 규격·제식 및 기재사항은 별표1과 같다.<개정, 2022.04.11.>② 신분증의 색채, 신분증 제작·관리 등 기타 자세한 사항은 사장이 따로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:화성도시공사신분증발급내규#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "신분증의 발급권자",
        "chapter": "",
        "content": "제4조(신분증의 발급권자) 사장은 공사의 임·직원에 대하여 신분증을 발급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:화성도시공사신분증발급내규#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "신분증의 휴대 및 패용",
        "chapter": "",
        "content": "제5조(신분증의 휴대 및 패용) ① 공사 임직원은 항시 신분증을 휴대하여야 하며,공사 업무 집행상 제시를 요구받은 때에는 이를 제시하여야 한다.② 공사 업무진행에 있어서 필요시 신분증은 왼쪽 가슴에 패용한다.(목에 거는 것을 포함한다.)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:화성도시공사신분증발급내규#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "신분증의 발급 및 재발급",
        "chapter": "",
        "content": "제6조(신분증의 발급 및 재발급) ① 신분증을 발급할 때에는 별지 제1호 서식에  의한 신분증 발급대장(이하 “대장”이라 한다)에 등록한 후에 행하여야 한다.② 신분증과 대장에 첨부한 사진은 동일한 것으로 발급일전 6월 이내에 촬영  한 것이어야 한다.③ 신분증을 분실 또는 훼손되거나 기재사항의 변동으로 재발급 받고자 하는 임·직원은 그 사유가 발생한 날로부터 5일 이내에 별지 제2호 서식에 의한 신분증 재발급 신청서를 신분증 발급권자에게 제출하여야 한다.④ 신분증 발급권자는 신분증 재발급 사유가 훼손 및 기재사항의 변경으로 기인한 때에는 이미 발급된 신분증은 회수하고 신규 신분증을 발급 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:화성도시공사신분증발급내규#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "신분증의 반납",
        "chapter": "",
        "content": "제7조(신분증의 반납) 임·직원이 퇴직할 때에는 신분증 발급권자에게 신분증을   반납하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:화성도시공사신분증발급내규#JO0007"
      }
    ]
  },
