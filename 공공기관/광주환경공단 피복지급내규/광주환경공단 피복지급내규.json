            "link_text": "제10조",
            "line_text": "",
            "target_law_name": "광주환경공단복리후생규정",
            "target_article_no": "제10조",
            "target_article_title": "",
            "target_mst": "",
            "target_url": "https://www.law.go.kr/학칙공단/광주환경공단복리후생규정/제10조",
            "resolve_method": "text_supplement",
            "source_provision_id": "public:광주환경공단피복지급내규#JO0001",
