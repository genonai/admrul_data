    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 직제규정 제14조 제2항의 규정에 의하여 부산관광공사(이하      “공사”라 한다) 업무의 일부를 임원 또는 직위자별로 위임 전결케 함으로써 업무능률의 향상과 사무처리의 간소화를 도모하고 사무위임에 따른 권한과 책임을 다하    게 함을 목적으로 한다. <개정 2022. 2. 23.>",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "citation",
            "delegation_type": null,
            "target_category": "학칙공단",
            "source_article_no": "제1조",
            "source_clause": "제1조",
            "link_text": "제14조",
