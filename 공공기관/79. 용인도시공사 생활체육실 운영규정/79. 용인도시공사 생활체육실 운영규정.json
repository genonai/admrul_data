        "images": [],
        "provision_id": "public:79.용인도시공사생활체육실운영규정#JO0026"
      },
      {
        "article_no": "제27조",
        "article_title": "응급조치",
        "chapter": "제7장  사고 및 손해배상",
        "content": "제27조(응급조치) 체육시설 사용자 및 회원에게 질병, 사고 또는 재해 등으로 인하여 위급한 경우 근무자는 응급조치를 취하고 사고의 경중에 따라 해당 사용자 및 회원을 응급의료기관으로 신속히 이송하고 보호자에게 연락한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:79.용인도시공사생활체육실운영규정#JO0027"
