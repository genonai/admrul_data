  "body": {
    "format": "articles",
    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 시흥도시공사(이하 “공사”라 한다)의 임·직원에 대한 피복의 지급기준과 착용 및 관리 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사피복시행내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 공사의 임직원으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사피복시행내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "피복의 종류",
        "chapter": "",
        "content": "제3조(피복의 종류) ①“피복”이라 함은 동복과 하복으로써 상의, 모자, 방한복, 우의 등 근무복을 말한다.②현업직원의 작업복은 소모품으로 분류하고 이 내규의 적용을 받지 않는다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사피복시행내규#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "제조구입등",
        "chapter": "",
        "content": "제4조(제조구입등) ①피복은 예산의 범위 내에서 제조 구입하여 현물로 지급한다.②지급하는 피복의 종류, 지급대상, 수량, 색상 등은 공사에서 지정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사피복시행내규#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "지급관리",
        "chapter": "",
        "content": "제5조(지급관리) ①피복의 지급 관리책임자는 각 부서의 장으로 한다.②각 부서의 장은 피복지급대장을 비치하고 피복 지급에 관한 기록유지 및 관리를 하여야 한다.③피복을 지급 받은 자가 지급일부터 3개월 이내에 퇴직 또는 기타의 사유로 착용할 필요가 없게 된 경우에는 이를 회수하여 보수 또는 세탁한 후 보관 관리하여야 하며, 피복지급이 필요한 직원에게 이를 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사피복시행내규#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "착용자의 의무",
        "chapter": "",
        "content": "제6조(착용자의 의무) 피복을 지급 받은 자는 임의로 모형 및 제식을 변형하거나 부착물을 제거하여서는 안 되며, 사용 기간 중 세탁 또는 보수관리를 철저히 하여 항상 단정하게 착용하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사피복시행내규#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "중도 채용자에 대한 지급",
        "chapter": "",
        "content": "제7조(중도 채용자에 대한 지급) 피복의 지급을 완료한 후 채용된 직원에게는 보관품에서 지급하거나 신규로 제조·구입하여 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사피복시행내규#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "변상",
        "chapter": "",
        "content": "제8조(변상) 피복을 지급받은 자는 피복의 훼손 또는 망실로 인하여 착용할 수 없게 되었을 때에는 자비로 제조·구입하여 착용하여야 한다. 다만, 직무수행상 훼손 또는 망실하였을 경우에는 그러하지 아니한다. <개정 2020.11.16.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사피복시행내규#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "사용연한 경과피복",
        "chapter": "",
        "content": "제9조(사용연한 경과피복) ①사용연한이 경과하여 착용할 수 없게 된 피복은 피복지급 책임자에게 반납하여야 한다. <개정 2020.11.16.>②피복지급책임자는 피복을 반납 받은 때에는 사용 정도를 판단하여 재지급 등 조치를 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사피복시행내규#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "피복의 착용기간",
        "chapter": "",
        "content": "제10조(피복의 착용기간) 지급된 피복은 특별한 사유가 없는 한 근무시간 중 항시 착용하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사피복시행내규#JO0010"
      }
    ]
  },
