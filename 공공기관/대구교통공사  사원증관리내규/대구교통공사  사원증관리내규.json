      {
        "article_no": "제10조",
        "article_title": "휴대 및 제시의무",
        "chapter": "제3장  관리책임",
        "content": "제10조(휴대 및 제시의무)  직원은 사원증을 항상 휴대하여야 하며, 출입제한이 있는 지역에 대한 출입시 관계 직원으로부터 사원증 제시요구가 있을 때에는 항상 이에 응하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:대구교통공사사원증관리내규#JO0010"
