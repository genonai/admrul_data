    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 취업 및 복무규정 제8조의2제2항의 규정에 의하여 공단 임직원의 신분을 표시하는 공단 신분증의 규격, 제식 및 발급등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
