      {
        "article_no": "제19조",
        "article_title": "대리인의 선임",
        "chapter": "제2장 임원 및 직원",
        "content": "제19조(대리인의 선임) 이사장은 공단의 효율적인 업무수행을 위하여 필요한 경우에 이사회의 의결을 거쳐 공단 업무를 대행할 수 있는 대리인을 선임할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
