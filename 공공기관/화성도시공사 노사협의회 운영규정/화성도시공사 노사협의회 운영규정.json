      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총  칙",
        "content": "제1조(목적) 본 규정은 화성도시공사의 사용자와 근로자의 쌍방의 이해와 협조를 통하여 노사공동의 이익을 증진함으로써 화성도시공사의 발전과 근로자 복지증진에 기여함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:화성도시공사노사협의회운영규정#JO0001"
      },
