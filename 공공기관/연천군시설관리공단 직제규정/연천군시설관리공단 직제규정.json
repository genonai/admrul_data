    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총칙",
        "content": "제1조(목적) 이 규정은 연천군시설관리공단(이하 “공단”이라 한다)의 직제 및 사무분장에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:연천군시설관리공단직제규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "제1장 총칙",
        "content": "제2조(적용범위) 공단의 직제에 관하여는 조례 및 정관에 정한 것을 제외하고는 이 규정에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:연천군시설관리공단직제규정#JO0002"
      },
      {
