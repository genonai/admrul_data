      {
        "article_no": "제3조",
        "article_title": "대여대상",
        "chapter": "",
        "content": "제3조(대여대상)학자금대여 대상은 교육부장관의 인가를 받은 대학 및 이에 준하는 각종학교(국내 및 국외대학)에 입학하거나 또는 재학중인 자녀와 대학 및 대학원에 재학중인 본인(임·직원)으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:광주환경공단학자금대여내규#JO0003"
