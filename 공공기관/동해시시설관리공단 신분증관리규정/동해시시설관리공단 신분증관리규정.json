  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 동해시시설관리공단(이하 “공단”이라 한다.)임원 및 직원(이하 “임·직원”이라 한다.)의 신분을 표시하는 공단신분증(이하 “신분증”이라 한다.)의 규격, 제식 및 발급 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단신분증관리규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 이 규정은 다른 법령 관계규정 등에 특별한 규정이 없는 한 공단에 근무하는 모든 임·직원에게 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단신분증관리규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "신분증의 규격·제식·색채및패용방법",
        "chapter": "",
        "content": "제3조(신분증의 규격·제식·색채및패용방법) ① 신분증에는직원증번호,소속부서명과 인적사항 등을 기재하고 사진을 첨부하되 그 규격, 제식, 색체및기재사항은 별표와 같다. <개정 2011. 9. 8>② 공단 신분증은 목에 걸거나 왼쪽 가슴에 패용한다. <개정 2015. 9. 23>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단신분증관리규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "신분증의 발급권자",
        "chapter": "",
        "content": "제4조(신분증의 발급권자) 이사장은소속임·직원에 대하여 신분증을 발급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단신분증관리규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "신분증의 휴대",
        "chapter": "",
        "content": "제5조(신분증의 휴대) 공단직원은 항상 신분증을 휴대하여야 하며 업무집행상 제시를 요구받은 때에는 이를 제시하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단신분증관리규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "신분증의 발급 및 재발급",
        "chapter": "",
        "content": "제6조(신분증의 발급 및 재발급) ① 신분증발급권자가 신분증을 발급할때주무팀장은 별지제1호서식에 의한 신분증 발급대장(이하 “대장”이라 한다.)에 등록한 후에 발급하여야 한다. <개정2005. 12. 28>② 신분증과 대장에 첨부한 사진은 동일한 것으로서 발급일전 60일 이내에 촬영한 사진이어야 한다.③ 신분증을 분실 또는 파손하거나 기재사항의 변동으로 재발급 받고자 하는 직원은 그 사유가 발행한 날로부터 5일 이내에 별지 제2호 서식에 의한 신분증 재발급 신청서를 소속 책임자를 거쳐 신분증 발급권자에게 제출하여야 한다.",
        "enforcement_date": "",
