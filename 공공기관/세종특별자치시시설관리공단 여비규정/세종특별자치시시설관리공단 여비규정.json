    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 세종특별자치시시설관리공단(이하 “공단”이라 한다)의 임직원이 공단의 업무수행을 위하여 출장할 경우에 지급하는 여비에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:세종특별자치시시설관리공단여비규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "여비의 종류",
        "chapter": "",
        "content": "제2조(여비의 종류) 여비는 운임, 일비, 숙박비 및 식비를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:세종특별자치시시설관리공단여비규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "여비의 구분",
        "chapter": "",
        "content": "제3조(여비의 구분) 여비는 국내여비와 국외여비로 구분하며, “별표 1”의 여비지급표에 의하여 지급한다.",
        "enforcement_date": "",
