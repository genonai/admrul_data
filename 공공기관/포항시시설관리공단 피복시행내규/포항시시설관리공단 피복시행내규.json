  "body": {
    "format": "articles",
    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 포항시시설관리공단(이하 “공단”이라 한다)의 임·직원에 대한 피복의 지급기준과 착용·관리 등에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:포항시시설관리공단피복시행내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 공단의 모든 임·직원(상용직 및 계약직을 포함한다)에 대한 피복지급 등에 관하여는 이 규정이 정하는 바에 의한다.<개정 2011. 10. 31>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:포항시시설관리공단피복시행내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "피복의 종류",
        "chapter": "",
        "content": "제3조(피복의 종류) ①“피복”이라 함은 동복과 하복으로써 상의·모자·방한복·우의 등 근무복을 말한다.②현업직원의 작업복은 소모품으로 분류하며, 이 내규를 적용하지 아니한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:포항시시설관리공단피복시행내규#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "피복관리",
        "chapter": "",
        "content": "제4조(피복관리) ①피복은 예산의 범위 안에서 제조·구입하여 현물로 지급한다.②지급하는 피복의 종류·지급대상·수량 및 색상 등은 공단에서 지정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:포항시시설관리공단피복시행내규#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "피복지급 관리책임자",
        "chapter": "",
        "content": "제5조(피복지급 관리책임자) ①각 부서의 장은 물품담당자를 피복지급 관리책임자로 임명한다.②피복지급 관리책임자는 “별표”의 피복지급대장을 비치하고, 피복지급에 관한 기록유지 및 관리를 하여야 한다.③피복지급 관리책임자는 피복을 지급받은 자가 지급일부터 3월 이내에 퇴직 또는 기타의 사유로 인하여 피복을 착용할 필요가 없게 된 경우에는 이를 회수하여 보수 또는 세탁한 후 보관관리하여야 하며, 피복이 필요한 직원에게 이를 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:포항시시설관리공단피복시행내규#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "착용자의 의무",
        "chapter": "",
        "content": "제6조(착용자의 의무) 피복을 지급받은 자는 임의로 모형 및 제식을 변형하거나 부착물을 제거하여서는 아니되며, 사용기간 중 세탁 또는 보수관리를 철저히 하여 항상 단정하게 착용하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:포항시시설관리공단피복시행내규#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "중도채용자에 대한 지급",
        "chapter": "",
        "content": "제7조(중도채용자에 대한 지급) 피복의 지급을 완료한 후 채용된 직원에게는 보관품에서 지급하거나 신규로 제조·구입하여 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:포항시시설관리공단피복시행내규#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "변상",
        "chapter": "",
        "content": "제8조(변상) 피복을 지급받은 자는 피복이 훼손 또는 망실되어 착용할 수 없게 된 때에는 자비로 제조·구입하여 착용하여야 한다. 다만, 직무수행상 훼손 또는 망실된 경우에는 그러하지 아니하다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:포항시시설관리공단피복시행내규#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "사용연한경과 피복",
        "chapter": "",
        "content": "제9조(사용연한경과 피복) ①사용연한이 경과하여 착용할 수 없게 된 피복은 피복지급 책임자에게 반납하여야 한다.②피복지급 관리책임자는 피복을 반납받은 때에는 사용정도를 판단하여 재지급 등 필요한 조치를 취하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:포항시시설관리공단피복시행내규#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "피복의 착용기간",
        "chapter": "",
        "content": "제10조(피복의 착용기간) 지급된 피복은 특별한 사유가 없는 한 근무시간 중 항시 착용하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:포항시시설관리공단피복시행내규#JO0010"
      }
    ]
  },
