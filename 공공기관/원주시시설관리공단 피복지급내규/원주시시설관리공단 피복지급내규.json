  "body": {
    "format": "articles",
    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 원주시시설관리공단의 임직원에 대한 피복의 지급기준과 착용 및 관리 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:원주시시설관리공단피복지급내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "content": "제2조(정의) “피복”이라 함은 근무 수행에 필요하여 임직원에게 지급하는 근무복, 작업복, 작업화 및 그 밖의 장구류를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:원주시시설관리공단피복지급내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "지급기준",
        "chapter": "",
        "content": "제3조(지급기준) 피복은 예산의 범위에서 별표 1에 따라 구입한 후 현물로 지급함을 원칙으로 한다.",
        "enforcement_date": "",
        "relations": [
