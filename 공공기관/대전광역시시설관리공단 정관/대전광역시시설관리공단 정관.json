      {
        "article_no": "제16조",
        "article_title": "임·직원의 복무",
        "chapter": "제3장  임원 및 직원",
        "content": "제16조(임·직원의 복무) 임·직원의 복무에 필요한 사항은 규정으로 정한다. <개정 2016.12.14 정관 제29호>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:대전광역시시설관리공단정관#JO0016"
