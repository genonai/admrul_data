      {
        "article_no": "제13조",
        "article_title": "임원의 징계",
        "chapter": "제4장  상벌",
        "content": "제13조(임원의 징계) 임원을 징계처분 하고자 할 때에는 이사회의 안건으로 부의하여 이사회의 의결에 따라 징계 처분한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사임원인사규정시행내규#JO0013"
