    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장  총  칙",
        "content": "제1조(목적) 이 규정은 거제해양관광개발공사 정관 제15조의 규정에 의해 감사의 직무수행의 기준과 절차를 정함으로써 공사의 내부감사기능을 강화하여 자율적인 경영합리화에 기여함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:(거제해양관광개발공사)감사규정#JO0001"
