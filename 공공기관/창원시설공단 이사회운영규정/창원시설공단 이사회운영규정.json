      {
        "article_no": "제12조",
        "article_title": "의안설명",
        "chapter": "",
        "content": "제12조 (의안설명) 의안은 제안부서의 장이 설명한다. 다만, 부득이한 경우에는 차하급자가 설명할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:창원시설공단이사회운영규정#JO0012"
