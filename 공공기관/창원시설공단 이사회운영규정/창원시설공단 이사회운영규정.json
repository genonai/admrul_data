      {
        "article_no": "제16조",
        "article_title": "의결사항 통보",
        "chapter": "",
        "content": "제16조 (의결사항 통보) 이사회의 의결사항은 간사가 7일 이내에 제안부서 및 기타 관계부서에 별지 제5호 서식에 의거 서면으로 통보하여야 한다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "appendix_ref",
            "delegation_type": null,
            "target_category": "별지",
            "source_article_no": "제16조",
            "source_clause": "제16조",
