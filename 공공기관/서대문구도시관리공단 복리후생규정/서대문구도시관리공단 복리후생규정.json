    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총    칙",
        "content": "제1조(목적) 이 규정은 서울특별시 서대문구 도시관리공단(이하 \"공단\"이라 한다)의 임직원의 건강과 복리후생 및 업무수행 중 발생한 재해보상에 관한 사항을 규정함으로써 직원의 사기앙양과 건강증진 및 생활안정을 도모함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:서대문구도시관리공단복리후생규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "제1장 총    칙",
        "content": "제2조(적용범위) 이 규정은 공단의 임직원에 대하여 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:서대문구도시관리공단복리후생규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "보수와의 관계",
        "chapter": "제1장 총    칙",
        "content": "제3조(보수와의 관계) 이 규정에 의하여 지급되는 제반 복리후생비는 보수규정에 규정된 보수에 포함되지 않는다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:서대문구도시관리공단복리후생규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "안전 및 보건관리",
        "chapter": "제2장 안전과 보건",
        "content": "제4조(안전 및 보건관리) 임원과 직원의 안전 및 보건관리에 관한 사항은 관계 법령이 정하는 바에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:서대문구도시관리공단복리후생규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "건강진단",
        "chapter": "제2장 안전과 보건",
        "content": "제5조(건강진단) ①임직원에 대한 건강진단은 1년에 매년 1회 실시하되, 국민건강보험공단에서 격년제로 실시하는 건강진단으로 이를 갈음할 수 있고, 그 결과에 따라 건강유지에 필요한 조치를 취해야 하며, 소요되는 경비는 공단이 전액 부담한다.②제1항의 규정에 의한 건강진단을 의무적으로 전 임직원이 받아야 하며, 건강진단 당해연도 2월부터 10월 사이에 실시함을 원칙으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:서대문구도시관리공단복리후생규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "의료시설",
        "chapter": "제2장 안전과 보건",
        "content": "제6조(의료시설) 임직원의 건강관리를 위하여 공단에 의료시설을 설치운영 할 수 있으며, 필요에 따라 외부 의료기관을 지정 이용할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:서대문구도시관리공단복리후생규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "후생시설운영",
        "chapter": "제3장 후    생",
        "content": "제7조(후생시설운영) 임직원의 복지증진을 위하여 공단이 필요하다고 인정하는 경우에는 구내휴게소, 구내식당, 기타 후생시설을 설치 운영할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:서대문구도시관리공단복리후생규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "후생비 지급",
        "chapter": "제3장 후    생",
        "content": "제8조(후생비 지급) ①임직원의 복리후생을 위하여 예산의 범위 내에서 다음 각 호의 후생비를 지급할 수 있다.1. 능률수당2. 급식보조비3. 직급보조비4. 교통비5. 명절휴가비6. 직책수행비②복리후생비의 지급기준은 \"별표 1\"과 같으며, 그 지급일은 매월 20일로 한다. 단, 20일이 토요일 또는 공휴일인 경우에는 그 전일로 한다.[개정 2004.12.21, 2006.03.14, 2007.01.08, 2007.02.15, 2008.02.21, 2013.08.22]③신분변동시의 복리후생비의 지급은 보수규정 제8조를 준용한다.",
        "enforcement_date": "",
