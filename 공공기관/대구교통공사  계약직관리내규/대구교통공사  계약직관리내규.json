      {
        "article_no": "제19조",
        "article_title": "복리후생제도",
        "chapter": "제5장 퇴직금 및 복지후생",
        "content": "제19조(복리후생제도) 계약직 근로자의 복리후생제도는 계약시 정하는 바에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:대구교통공사계약직관리내규#JO0019"
      },
      {
        "article_no": "제20조",
        "article_title": "안전보건",
        "chapter": "제5장 퇴직금 및 복지후생",
        "content": "제20조(안전보건) 계약직 근로자는 안전보건에 관한 제반 규정을 준수하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:대구교통공사계약직관리내규#JO0020"
      },
      {
        "article_no": "제21조",
        "article_title": "재해보상",
        "chapter": "제5장 퇴직금 및 복지후생",
        "content": "제21조(재해보상) 계약직 근로자가 업무로 인하여 부상 또는 사망한 경우에는 관계 법령이 정하는 바에 따라 보상한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
