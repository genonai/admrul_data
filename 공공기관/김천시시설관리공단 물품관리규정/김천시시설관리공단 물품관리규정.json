    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장  총   칙",
        "content": "제1조(목적) 이 규정은 김천시  시설관리공단(이하 “공단”라 한다) 물품의 취득·보관·사용 및 처분 등에 관한 기본적 사항을 규정함으로써 물품을 효율적이고 적절한 관리를 도모함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:김천시시설관리공단물품관리규정#JO0001"
      },
