    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장  총   칙",
        "content": "제1조(목적) 이 규정은 인천시설공단(이하 \"공단\"이라 한다)이 물품을 취득, 보관, 사용 및 처분함에 관한 사항을 규정함으로써 물품의 효율적이고 적정한 관리를 도모함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:인천시설공단물품관리규정#JO0001"
      },
