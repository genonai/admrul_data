      {
        "article_no": "제9조",
        "article_title": "변상",
        "chapter": "제1장 총 칙",
        "content": "제9조 (변상) 근무자가 지급받은 피복을 훼손 또는 망실하여 이를 착용할 수 없게 된 때에는 변상하여야 한다. 다만, 불가항력적인 사유로 인한 경우에는 그러하지 아니한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:창원시설공단피복지급규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "사용년한 경과후 조치",
        "chapter": "제1장 총 칙",
        "content": "제10조 (사용년한 경과후 조치) 사용년한이 경과된 피복은 지급받은 자가 임의로 처분할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
