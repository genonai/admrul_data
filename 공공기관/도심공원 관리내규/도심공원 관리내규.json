      {
        "article_no": "제16조",
        "article_title": "화장실 관리",
        "chapter": "제3장 재난 및 시설물 관리",
        "content": "제16조(화장실 관리) ① 화장실은 1일 1회 이상 점검하고 필요한 조치를 하여야 한다.② 화장실에는 이용객이 사용할 수 있도록 화장지 등의 편의용품을 비치·관리하고, 범죄예방을 위한 안심벨 등을 설치하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:도심공원관리내규#JO0016"
      },
