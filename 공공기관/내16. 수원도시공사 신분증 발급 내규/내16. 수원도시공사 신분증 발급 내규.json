  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 수원도시공사(이하 “공사”라 한다.) 임직원의 신분을 표시하는 공사신분증(이하 “신분증”이라 한다.)의 규격, 제식 및 발급 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:내16.수원도시공사신분증발급내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 이 내규는 다른 법령이나 관계규정 등에 특별한 규정이 없는 한 공사에 근무하는 모든 임직원에게 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:내16.수원도시공사신분증발급내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "신분증의 규격·제식·색채",
        "chapter": "",
        "content": "제3조(신분증의 규격·제식·색채) 신분증에는 발급번호, 소속 부서명 및 인적사항 등을 기재하고 사진을 첨부하되 그 규격, 제식, 색채 및 기재사항은 별표 1과 같다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "appendix_ref",
