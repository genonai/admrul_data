    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총칙",
        "content": "제1조(목적) 이 내규는 파주도시공사의 임금피크제 시행에 관하여 인사규정, 보수규정, 기간제등 비정규직근로자 관리규정에 의해 위임받아 필요한 세부사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:내규05.파주도시공사임금피크제운영내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "제1장 총칙",
        "content": "제2조(적용범위) 임금피크제가 적용되는 직원에 대하여 법령, 정관 및 규정에서 따로 정한 것을 제외하고는 이 내규로 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:내규05.파주도시공사임금피크제운영내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "적용대상자",
        "chapter": "제2장 임금피크제의 적용",
        "content": "제3조(적용대상자) ① 임금피크제 적용대상은 전 직원으로 한다. 다만, 임금피크제 적용 기간 중 기본급이 최저임금 150%수준 이하의 직원은 제외한다.② 임금피크제 적용기간은 정년퇴직 직전년 총 3년까지로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:내규05.파주도시공사임금피크제운영내규#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "임금지급률",
        "chapter": "제2장 임금피크제의 적용",
        "content": "제4조(임금지급률) ① 임금피크제가 적용되는 직원의 해당연도 임금에 대하여 다음 각 호의 지급률을 적용하여 산정한다.1. 정년퇴직 도래 3년 전부터 1년간 기본급의 10%2. 정년퇴직 도래 2년 전부터 1년간 기본급의 15%3. 정년퇴직 도래 1년 전부터 1년간 기본급의 20%② 임금피크제 연차 구분 기준은 정년퇴직일을 기준으로 전환 초일(매년 7월 1일 및 12월 31일)부터 1년 단위로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:내규05.파주도시공사임금피크제운영내규#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "임금피크제 적용 대상자의 직군 및 직급",
        "chapter": "제3장 인사관리",
        "content": "제5조(임금피크제 적용 대상자의 직군 및 직급) 임금피크제 대상 직원의 직군 및 직급은 임금피크제 적용 직전의 직군 및 직급을 유지하는 것을 원칙으로 한다. 다만, 적용 대상자의 요청 또는 인사 관리상 필요에 따라 사장이 별도 직군 및 직급으로 관리할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:내규05.파주도시공사임금피크제운영내규#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "임금피크제 적용 대상자의 직무 및 전직 지원",
        "chapter": "제3장 인사관리",
        "content": "제6조(임금피크제 적용 대상자의 직무 및 전직 지원) 임금피크제 적용 대상자의 직무는 능력과 경험이 공사의 생산성 향상에 기여할 수 있도록 개발하여야 하며, 사장은 원활한 전직을 위하여 적극 지원하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:내규05.파주도시공사임금피크제운영내규#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "임금피크제 적용 대상자의 평가 및 보상",
        "chapter": "제3장 인사관리",
        "content": "제7조(임금피크제 적용 대상자의 평가 및 보상) 임금피크제 적용 대상자의 평가(평정) 및 보상 방법 등에 대한 사항은 인사규정 규정\n제24조(평정의 원칙)의 원칙 및 타 직원들의 근로 의욕을 해치지 않는 범위 안에서 사장이 따로 정할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:내규05.파주도시공사임금피크제운영내규#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "퇴직급여금 중간정산",
        "chapter": "제4장 퇴직금",
        "content": "제8조(퇴직급여금 중간정산) 임금피크제 대상 직원은 임금피크제 적용 직전에 퇴직금 중간정산을 실시하고 이후 임금피크제 기간 동안 연단위로 퇴직급여금을 정산할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:내규05.파주도시공사임금피크제운영내규#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "제도의 보완",
        "chapter": "제5장 보칙",
        "content": "제9조(제도의 보완) 임금피크제 운영 기준은 연령별 인원분포, 임금피크제 대상자 간 임금격차 수준 등을 고려하여 3년 단위 재설정을 원칙으로 한다. 다만, 정부 정책 변경 등 제도 운영상 중대한 변경 요인이 발생할 경우 노사 합의를 통하여 수시 재설정할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:내규05.파주도시공사임금피크제운영내규#JO0009"
      },
