    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 복리후생규정(이하 “규정”이라 한다)의 시행에 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:광주환경공단복리후생규정시행내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "복리후생비",
        "chapter": "",
        "content": "제2조(복리후생비) 규정 제6조의 매월 지급되는 복리후생비는 지급일 현재 근무자에 대하여 지급하되 신규채용자와 신분변동자는 일할 계산하여 지급하고 퇴직시는 회수하지 아니하며, 휴직 및 직위해제 정직 감봉자는 당해월 1일자가 아닌 경우 익월부터 해당 기간동안 일할 감액한다.",
        "enforcement_date": "",
