  "body": {
    "format": "articles",
    "article_count": 6,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 서구재가노인지원서비스센터(이하 “센터”라 한다)의 모든업무 처리에 관한 권한을 각 직위별로 부여함으로써 업무의 효율화와 책임의 소재를 명백히 함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:11-4-3.인천광역시서구시설관리공단서구재가노인지원서비스센터위임전결내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 업무에 관한 위임전결사항은 다른 규정에서 따로 정한 것이 있는 경우를 제외하고는 이 내규에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:11-4-3.인천광역시서구시설관리공단서구재가노인지원서비스센터위임전결내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "중요사항 등의 직상위자 결재 등",
        "chapter": "",
        "content": "제3조(중요사항 등의 직상위자 결재 등) ① 전결권자는 그의 전결에 속하는 사항인 경우에도 특히 중요하거나 이례적인 사항이라고 인정될 때에는 직 상위자의 결재를 받아야 한다.② 상위직은 하위직이 전결 위임된 사항을 부당하게 처리하는 경우에는 그 변경을 명할 수 있다.③ [별표 1]에 열거되지 않은 사항인 경우에도 열거된 사항과 성질상 유사하거나 그보다 경미한 사항은 열거된 사항에 준하여 전결할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:11-4-3.인천광역시서구시설관리공단서구재가노인지원서비스센터위임전결내규#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "책임",
        "chapter": "",
        "content": "제4조(책임) 전결권자는 전결권 행사 및 불행사의 결과에 대한 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:11-4-3.인천광역시서구시설관리공단서구재가노인지원서비스센터위임전결내규#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "업무협의",
        "chapter": "",
        "content": "제5조(업무협의) 위임전결 사항 중 다른 부서와 업무상 관련이 있는 사항은 그 부서와 협의 후 처리하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:11-4-3.인천광역시서구시설관리공단서구재가노인지원서비스센터위임전결내규#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "보고",
        "chapter": "",
        "content": "제6조(보고) 전결권자가 전결 시행한 사항 중 중요하다고 인정되는 사항은 지체없이 그 처리내용을 직상위자에게 보고하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:11-4-3.인천광역시서구시설관리공단서구재가노인지원서비스센터위임전결내규#JO0006"
      }
    ]
  },
