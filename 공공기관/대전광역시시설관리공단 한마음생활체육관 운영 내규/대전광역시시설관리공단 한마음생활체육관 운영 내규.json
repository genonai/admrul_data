      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장  총  칙",
        "content": "제1조(목적) 이 내규는 한마음생활체육관(이하 “체육관”이라 한다)의 운영에 관한 사항과 이용자가 준수해야 할 사항 등을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:대전광역시시설관리공단한마음생활체육관운영내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "운영시간",
        "chapter": "제1장  총  칙",
        "content": "제2조(운영시간) 한마음생활체육관 운영시간은 06:00∼22:00로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:대전광역시시설관리공단한마음생활체육관운영내규#JO0002"
