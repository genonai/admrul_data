      {
        "article_no": "제27조",
        "article_title": "평가자 면담신청",
        "chapter": "제7장 재심청구 및 처리",
        "content": "제27조(평가자 면담신청) ① 연봉정책과 관련한 이의가 있는 경우에는 이의제기자는 연봉결과를 통보받은 7일 이내에 1차 평가자에게 구두로 이의를 제기하고 면담을 실시하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:연봉제규정#JO0027"
      },
      {
        "article_no": "제28조",
        "article_title": "연봉재심청구",
        "chapter": "제7장 재심청구 및 처리",
        "content": "제28조(연봉재심청구) ① 이의제기자가 면담결과에 불복 시 연봉결과 통보 후 10일 이내에 별지 2의 연봉재심청구서를 작성하여 인사담당 부서의 장에게 연봉재심청구를 할 수 있다.② 제1항에서 정한 기한 내 연봉재심청구가 없는 경우 연봉계약은 성립된 것으로 본다.",
        "enforcement_date": "",
