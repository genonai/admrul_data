      {
        "article_no": "제2조",
        "article_title": "재원",
        "chapter": "",
        "content": "제2조(재원) 학자금대여는 예산(장기대여금)의 범위 내에서 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:인천시설공단학자금대여운영내규#JO0002"
