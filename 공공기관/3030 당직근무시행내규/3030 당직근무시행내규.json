      {
        "article_no": "제8조",
        "article_title": "책임",
        "chapter": "",
        "content": "제8조(책임) 당직근무자는 이 내규에 명시된 임무 등을 성실히 수행할 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
