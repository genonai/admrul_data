    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 울산시설공단(이하 \"공단\" 이라 한다)의 고령자고용촉진장려금 시행에 관하여 필요한 사항을 규정함을 목적으로 한다. <개정 2015·10·1>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:울산시설공단고령자고용촉진장려금내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "용어의 정의",
        "chapter": "",
        "content": "제2조(용어의 정의) 고령자고용촉진진장려금은 고용보험법에 의거 고령자를 다수 고용한 사업주에게 지원되는 장려금을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:울산시설공단고령자고용촉진장려금내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제3조(적용범위) 고령자고용촉진장려금 운용에 관하여는 다른 규정에 특별히 정한 것 이외에는 이 내규에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:울산시설공단고령자고용촉진장려금내규#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "장려금관리",
        "chapter": "",
        "content": "제4조(장려금관리) 노동부장관으로부터 수령한 고령자고용촉진장려금은 익년도에 정산후 울산광역시장에게 우선 납입조치하고, 울산광역시장으로부터 전년도 납입액 범위 내에 교부받아 당해년도 행사등잡비 예산과목에 편성하여 사용한다.[전문개정 2001·3·24]",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:울산시설공단고령자고용촉진장려금내규#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "장려금 지출",
        "chapter": "",
        "content": "제5조(장려금 지출) 고령자고용촉진장려금은 고령자고용촉진법시행령 제2조제1항에서 정한 고령자에 해당하는 55세 이상의 공단직원 및 관리원들의 체육진흥, 복리증진, 사기앙양 등 고령근로자들의 근무의욕 고취와 관련된 사항에 지출하여야 한다.",
        "enforcement_date": "",
