  "body": {
    "format": "articles",
    "article_count": 13,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장  총칙",
        "content": "제1조(목적) 이 내규는 의정부도시공사(이하 “공사”라 한다) 임직원의 신분을 표시하는 사원증의 규격, 제식, 발급 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사원증관리내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "제1장  총칙",
        "content": "제2조(적용범위) 사원증에 관한 기준은 다른 특별한 규정이 있는 경우를 제외하고는 이 내규에서 정하는 바에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사원증관리내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "정의",
        "chapter": "제1장  총칙",
        "content": "제3조(정의) 이 내규에서 사용되는 용어의 뜻은 다음과 같다.1. “사원증 관리부서”란 공사 내의 사원증 발급, 관리 등 사원증에 관한 업무를 주관하는 부서를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사원증관리내규#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "발급대상 및 기능",
        "chapter": "제1장  총칙",
        "content": "제4조(발급대상 및 기능) ① 사원증은 공사 임직원임을 증명하는 신분 증표로 공사에 재직하는 임직원에게 발급한다.② 사원증은 출·퇴근 및 사무실 보안기능 등을 가질 수 있다. 다만, 발급 시 부여되지 않으며 해당 기능이 필요하다고 인정되는 임직원이 있으면 사원증관리부서에서 개별 승인한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사원증관리내규#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "사원증의 통용기간",
        "chapter": "제1장  총칙",
        "content": "제5조(사원증의 통용기간) 사원증은 퇴직 시까지 영구적 통용을 원칙으로 한다. 다만, 사장이 필요하다고 인정할 때에는 통용기간을 조정할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사원증관리내규#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "규격 등",
        "chapter": "제2장  제작과 발급",
        "content": "제6조(규격 등) 사원증의 규격, 제식 및 기재사항은 “별표 1”과 같다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사원증관리내규#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "제작",
        "chapter": "제2장  제작과 발급",
        "content": "제7조(제작) ① 사원증 제작수량은 인사발령사항 등에 기초하여 사원증관리부서에서 확정한다.② 사원증관리부서는 제1항에 의하여 확정한 수량에 대해 “별표 1”의 사원증을 제작한다. 다만, 직접 제작이 어려울 때에는 다른 제작회사에 의뢰하여 제작할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사원증관리내규#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "발급",
        "chapter": "제2장  제작과 발급",
        "content": "제8조(발급) 사원증관리부서는 제작한 사원증을 “별지 제1호서식”의 사원증 발급대장에 기록하고 해당 임직원에게 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사원증관리내규#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "부정사용금지",
        "chapter": "제3장  관리책임",
        "content": "제9조 (부정사용금지) 사원증은 본인 이외의 타인에게 양도·대여 및 위조, 변조할 수 없으며, 부당청구일 때에는 지급받을 수 없다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사원증관리내규#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "휴대 및 제시의무",
        "chapter": "제3장  관리책임",
        "content": "제10조(휴대 및 제시의무) ① 직원은 항상 사원증을 휴대하여야 한다.② 직원은 업무수행에 있어서 사원증 제시요구가 있을 때에는 항상 이에 응하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사원증관리내규#JO0010"
      },
      {
        "article_no": "제11조",
        "article_title": "관리책임",
        "chapter": "제3장  관리책임",
        "content": "제11조(관리책임) 사원증의 관리책임은 지급받은 직원에게 있으며, 사원증을 분실, 훼손되지 않도록 관리에 유의하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사원증관리내규#JO0011"
      },
      {
        "article_no": "제12조",
        "article_title": "재발급",
        "chapter": "제4장  재발급·반납 등",
        "content": "제12조(재발급) ① 사원증의 훼손, 분실 등의 사유로 재발급받고자 할 때는 “별지 제2호서식”의 사원증 재발급 신청서를 사원증관리부서에 제출하여야 한다. 다만, 훼손으로 인하여 재발급 신청할 때에는 당해 사원증을 첨부하여야 한다.② 사원증관리부서에서는 사원증재발급 신청이 있을 때에는 즉시 당해 사원증이 통용될 수 없도록 조치를 취해야 하며, 재발급을 위해 첨부된 사원증은 폐기 처분하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사원증관리내규#JO0012"
      },
      {
        "article_no": "제13조",
        "article_title": "반납",
        "chapter": "제4장  재발급·반납 등",
        "content": "제13조(반납) ① 퇴직하는 직원은 사원증관리부서에 사원증을 반납하여야 한다.② 퇴직자 발생 시 사원증관리부서에서는 퇴직일부터 당해 사원증이 통용되지 않도록 조치해야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사원증관리내규#JO0013"
      }
    ]
  },
