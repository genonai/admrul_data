    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적)이 내규는 인사규정 제43조의 규정에 의한 징계사유에 이르지 아니하는 경미한 비위나 잘못에 대하여 주의 각성을 촉구하고 인사관리의 적정을 기하기 위한 훈계 등 처분의 근거와 구체적인 기준 및 절차 등을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "citation",
            "delegation_type": null,
            "target_category": "학칙공단",
            "source_article_no": "제1조",
            "source_clause": "제1조",
            "link_text": "제43조",
            "line_text": "",
            "target_law_name": "인사규정",
            "target_article_no": "제43조",
            "target_article_title": "",
            "target_mst": "",
            "target_url": "https://www.law.go.kr/학칙공단/인사규정/제43조",
            "resolve_method": "text_supplement",
            "source_provision_id": "public:부산도시공사훈계등처분에관한내규#JO0001",
            "reference_id": "law:인사규정#JO0043"
