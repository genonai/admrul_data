  "body": {
    "format": "articles",
    "article_count": 7,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 내규는 창원시설공단 임·직원의 신분을 표시하는 신분증의 규격, 제식 및 발급에 관한 사항을 정함을 목적으로 한다.<개정 2018.3.21, 2020. 3. 31>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:창원시설공단신분증발급내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조 (적용범위) 이 내규는 창원시설공단(이하 “공단”이라 한다) 임·직원에게 적용한다.<개정 2020. 3. 31>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:창원시설공단신분증발급내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "신분증의 규격과 제식 및 기재사항등",
        "chapter": "",
        "content": "제3조 (신분증의 규격과 제식 및 기재사항등) 신분증에는 발급번호, 소속기관명과 인적사항 등을 기재하고 사진을 첨부하되, 신분증과 명찰의 규격, 제식 및 기재사항은 “별표1“과 같다. <개정 2005. 4. 27, 2018.3.21>",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "appendix_ref",
            "delegation_type": null,
            "target_category": "별표",
            "source_article_no": "제3조",
