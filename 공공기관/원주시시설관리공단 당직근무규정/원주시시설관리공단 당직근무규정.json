        "images": [],
        "provision_id": "public:원주시시설관리공단당직근무규정#JO0013"
      },
      {
        "article_no": "제14조",
        "article_title": "숙직 근무자의 휴무",
        "chapter": "제4장  휴무 및 수당",
        "content": "제14조(숙직 근무자의 휴무) 숙직 근무자에 대하여는 그 다음 근무일의 근무를 면한다. <개정 2020. 8. 27.>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:원주시시설관리공단당직근무규정#JO0014"
