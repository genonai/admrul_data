        "content": "제11조의2(조직 및 정원)공단의 조직 및 정원은 직제규정에 따른다. 〈신설 1994.10.4, 개정 1998.1.1, 1999.1.1, 1999.12.10, 2000.7.11, 2001.1.20, 2001.10.9, 2002.9.6, 2003.1.13, 2004.5.31, 2004.9.4, 2005.6.17, 2006.1.23, 2006.6.23, 2006.7.6, 2007.12.3, 2008.7.3, 2009.7.22, 2010.7.22, 2010.12.31, 2012.11.21, 2013.12.23, 2014.2.26, 2014.5.23, 2014.12.3, 2015.1.15, 2015.12.15, 2016.4.5, 2017.9.27, 2018.5.21, 2018.12.27, 2019.4.18, 2020.6.1, 2020. 12.1〉",
