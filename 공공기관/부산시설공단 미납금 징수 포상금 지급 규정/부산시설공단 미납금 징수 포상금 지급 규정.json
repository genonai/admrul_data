            "target_url": "https://www.law.go.kr/학칙공단/부산광역시 세입 징수포상금 지급 조례",
            "resolve_method": "render",
            "source_provision_id": "public:부산시설공단미납금징수포상금지급규정#JO0001",
            "reference_id": "law:부산광역시세입징수포상금지급조례#DOC"
          }
        ],
        "images": [],
