  "body": {
    "format": "articles",
    "article_count": 10,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총칙",
        "content": "제1조(목적) 이 규정은 동해시시설관리공단(이하 “공단”이라 한다.)임원 및 직원(이하 “임·직원”이라 한다.)의 건강과 복리후생및업무수행중 발생한 재해보상에 관한사항을 규정함으로서 직원의 건강증진과 생활안정을 도모함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단복리후생규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "제1장 총칙",
        "content": "제2조(적용범위) 이 규정은 동해시시설관리공단 임·직원에 대하여 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단복리후생규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "안전 및 보건관리",
        "chapter": "제2장 안전과 보건",
        "content": "제3조(안전 및 보건관리) 직원의 안전 및 보건관리에 관한 사항은 관계법령이 정하는 바에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단복리후생규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "건강진단",
        "chapter": "제2장 안전과 보건",
        "content": "제4조(건강진단) 직원에 대한 건강진단은 격년 정기적으로 1회 이상 실시하고 그 결과에 따라 건강유지에 필요한 조치를 하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단복리후생규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "의료시설",
        "chapter": "제2장 안전과 보건",
        "content": "제5조(의료시설) 직원의 건강관리를 위하여 공단에 의료시설을 설치 운영할 수 있으며, 필요에 따라 외부의료기관을 지정 이용 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단복리후생규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "후생시설의 운영",
        "chapter": "제3장 복리후생",
        "content": "제6조(후생시설의 운영) 직원의 복지증진을 위하여 공단은 필요하다고 인정되는 경우에는 신용협동조합법에 의한 직장새마을 금고와 구내휴게소, 구내식당 및 기타 후생시설을 설치할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단복리후생규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "피복지급",
        "chapter": "제3장 복리후생",
        "content": "제7조(피복지급) 공단은 규정으로 정하는 바에 따라 업무수행에 적합한 피복을 임·직원에게 지급하여 착용하게 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단복리후생규정#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "직장 체육진흥",
        "chapter": "제3장 복리후생",
        "content": "제8조(직장 체육진흥) 임·직원의 체육진흥을 위하여 필요한 사항은 국민체육진흥에 관한 관계법령에 정하는 바에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단복리후생규정#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "체육행사 등",
        "chapter": "제3장 복리후생",
        "content": "제9조(체육행사 등) ① 임·직원의 건전한 신체와 정신을 배양하기 위하여 예산의 범위 안에서 필요한 시설 및 행사를 할 수 있다.② 임·직원 정서함양을 위하여 필요시 취미클럽을 육성 발전토록 지원한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단복리후생규정#JO0009"
      },
      {
        "article_no": "제10조",
        "article_title": "임신·출산 축하금",
        "chapter": "제3장 복리후생",
        "content": "제10조(임신·출산 축하금) 근로자의 임신 및 출산 사유 발생시 별표1의 기준에 의하여 임신 및 출산 축하금을 지급한다.<신설 2024.08.05.>",
        "enforcement_date": "",
