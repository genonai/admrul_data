      {
        "article_no": "제11조",
        "article_title": "의안설명",
        "chapter": "",
        "content": "제11조(의안설명) 의안은 제안부서의 부서장이 설명한다. 다만, 부득이한 경우에는 차하급자가 설명할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:성남도시개발공사이사회운영규정#JO0011"
