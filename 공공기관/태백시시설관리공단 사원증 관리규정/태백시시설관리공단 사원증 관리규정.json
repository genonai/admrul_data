  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총  칙",
        "content": "제1조(목적) 이 규정은 태백시시설관리공단(이하 “공단”이라 한다.) 임원 및 직원(이하 “임·직원”이라 한다.)의 신분을 표시하는 사원증의 규격, 제식 및 발급 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:태백시시설관리공단사원증관리규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "제1장 총  칙",
        "content": "제2조(적용범위) 이 규정은 다른 법령 등에 특별한 규정이 없는 한 공단에 근무하는 모든 임·직원에게 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:태백시시설관리공단사원증관리규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "사원증의 규격·제식·색채",
        "chapter": "제1장 총  칙",
        "content": "제3조(사원증의 규격·제식·색채) 사원증에는 소속, 인적사항 등을 기재하고 사진을 첨부하되 그 규격, 제식, 색채 및 기재사항은 이사장이 별도로 정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:태백시시설관리공단사원증관리규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "사원증의 발급권자",
        "chapter": "제1장 총  칙",
        "content": "제4조(사원증의 발급권자) 이사장은 소속임·직원에게 사원증을 발급한다. 다만, 필요하면 전문 위탁업체에 위탁하여 발급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:태백시시설관리공단사원증관리규정#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "사원증의 휴대패용",
        "chapter": "제1장 총  칙",
        "content": "제5조(사원증의 휴대패용) ① 공단 임·직원은 업무 수행 시 사원증을 휴대하여야 하며, 제시를 요구받은 때에는 제시하여야 한다.② 직원은 소속기관 및 근무지에서 사원증을 패용하여야 한다.③ 이사장은 보안을 위하여 출입제한이 필요한 경우에는 출입증을 따로 발급할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:태백시시설관리공단사원증관리규정#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "관리의무",
        "chapter": "제2장 사원증의 관리",
        "content": "제6조(관리의무) 사원증을 발급받은 임·직원은 사원증이 분실 또는 훼손되지 않도록 관리에 유의하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:태백시시설관리공단사원증관리규정#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "사원증의 발급 및 재발급",
        "chapter": "제2장 사원증의 관리",
        "content": "제7조(사원증의 발급 및 재발급) ① 사원증 발급권자가 사원증을 발급할 때에는 별지 제1호서식에 의한 사원증 발급대장(이하 “대장”이라 한다.)에 등록한 후에 발급하여야 하며, 대장은 전자적으로 관리할 수 있다.② 사원증에 첨부할 사진은 발급일 전 6개월 이내에 촬영한 것으로 한다.③ 사원증의 분실, 훼손, 카드 불량, 내용변경 등 임직원의 귀책 사유에 의하여 사원증을 재발급받고자 하는 임직원은 사원증 재발급에 필요한 비용을 부담하여야 한다.④ 제3항에 따라 부담할 비용은 발급일 기준 최근 주문 제작한 금액으로 하되100원 미만은 절사한다.⑤ 재발급받고자 하는 임·직원은 그 사유가 발생한 날로부터 5일 이내에 별지 제2호서식에 의한 사원증 재발급신청서를 소속 부서장을 거쳐 사원증 발급권자에게 제출하여야 한다.⑥ 이사장은 실무수습 직원 등 공단 직원에 준하는 신분으로 지속적으로 청사 출입 및 출·퇴근 관리가 필요한 직원을 대상으로 사원증 대신 출입증을 발급할 수 있으며, 이 경우 발급절차는 제5항과 같다.",
        "enforcement_date": "",
