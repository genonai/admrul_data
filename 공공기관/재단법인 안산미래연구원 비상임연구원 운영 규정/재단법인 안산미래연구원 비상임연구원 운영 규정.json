    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 안산미래연구원의 비상임연구원의 운영에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:재단법인안산미래연구원비상임연구원운영규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 안산미래연구원(이하 “연구원”이라 한다)의 위촉 및 운영에 관하여는 별도의 규정이 없는 한 이 규정을 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:재단법인안산미래연구원비상임연구원운영규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "정의",
        "chapter": "",
        "content": "제3조(정의) 비상임연구원이라 함은 특정 연구과제의 수행 또는 연구기관의 연구 역량 강화를 위하여 일정 기간 동안 외부에서 위촉되어 연구 활동에 참여하는 전문가를 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:재단법인안산미래연구원비상임연구원운영규정#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "위촉자격 및 수당 지급 기준",
        "chapter": "",
        "content": "제4조(위촉자격 및 수당 지급 기준) ① 비상임연구원의 위촉자격 및 수당지급 기준은 [별표 1]과 같다. 다만, 비상임연구원의 전문성과 사회적 저명도 등에 따라 연구심의위원회의 심의를 거쳐 100% 범위 내에서 추가로 지급할 수 있다.② 비상임연구원을 위촉할 때에는 원장, 각 부서장, 연구과제 책임연구원, 연구기획부장의 추천으로 원장이 위촉하되, 연구심의위원회의 심의를 거쳐야 한다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "appendix_ref",
            "delegation_type": null,
            "target_category": "별표",
            "source_article_no": "제4조",
