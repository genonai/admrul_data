    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조 (목적) 이 내규는 창원시설공단 「복리후생 규정」의 시행에 필요한 사항을 정함을 목적으로 한다.<개정 2018.3.21, 2020. 3. 31>",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:창원시설공단복리후생규정시행내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "급식보조비",
        "chapter": "",
        "content": "제2조 (급식보조비) 「복리후생 규정」(이하 “규정”이라 한다) 제7조의 급식보조비는 지급일 현재 창원시설공단(이하 “공단”이라 한다)에 근무 중인 임·직원에게 지급한다. 다만, 신규채용자 및 신분변동자는 일할계산 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:창원시설공단복리후생규정시행내규#JO0002"
      },
