    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장  총  칙",
        "content": "제1조(목적) 이 내규는 수원도시공사(이하 “공사”라 한다)의 제안규정을 시행하기 위해 필요한 세부사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:내18.수원도시공사제안규정시행내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "제1장  총  칙",
        "content": "제2조(적용범위) 공사의 제안활동에 관하여 법령 또는 규정에 특별히 정한 경우를 제외하고는 이 내규가 정하는 바에 따른다.",
        "enforcement_date": "",
