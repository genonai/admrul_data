    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총칙",
        "content": "제1조(목적) 이 내규는 임금피크제 시행에 관하여 인사규정에서 위임된 임금피크제의 시행에 관한 세부적인 사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:고양도시관리공사임금피크제운영내규#JO0001"
