      {
        "article_no": "제4조",
        "article_title": "신청서류의 보완",
        "chapter": "제2장 공무국외여행 허가",
        "content": "제4조(신청서류의 보완) ① 공무국외여행 허가신청 첨부서류의 미비 등으로 허가 요건을 갖추지 못한 경우에 총무인사파트장은 상당한 기간을 정하여 주관부서의 장에게 보완을 요구할 수 있다.② 총무인사파트장은 주관부서의 장이 제1항에 따른 기간 내에 보완을 하지 아니하면 그 이유를 명시하여 접수된 신청서를 되돌려 보낼 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:부산시설공단공무국외여행운영내규#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "여행계획의 변경신청",
        "chapter": "제2장 공무국외여행 허가",
        "content": "제5조(여행계획의 변경신청) 주관부서의 장은 허가 통보된 여행기간 또는 시기 등을 변경하여야 할 특별한 사유가 있는 경우에는 그 사유를 명시하여 총무인사파트장에게 여행계획의 변경을 신청하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:부산시설공단공무국외여행운영내규#JO0005"
