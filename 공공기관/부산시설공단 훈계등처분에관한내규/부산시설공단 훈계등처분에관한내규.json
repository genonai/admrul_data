  "body": {
    "format": "articles",
    "article_count": 6,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 「부산시설공단 인사규정」제43조의 규정에 의한 징계사유에 이르지 아니하는 경미한 비위나 잘못 등에 대하여 주의 각성을 촉구하고 인사관리의 적정을 기하기 위한 훈계 등 처분의 근거와 구체적인 기준 및 방법 등을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:부산시설공단훈계등처분에관한내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용대상",
        "chapter": "",
        "content": "제2조(적용대상) 공단에 근무하는 모든 직원에게 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:부산시설공단훈계등처분에관한내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "처분의 종류",
        "chapter": "",
        "content": "제3조(처분의 종류) 훈계 등 처분의 종류는 훈계와 주의로 구분하되 비위나 잘못의 정도가 무거우면 훈계, 그 정도가 가벼우면 주의로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:부산시설공단훈계등처분에관한내규#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "처분사유",
        "chapter": "",
        "content": "제4조(처분사유) 직원이 다음 각호의 1에 해당할 때에는 훈계 등 처분을 할 수 있다.1. 공단의 제 규정 등을 위반했을 때2. 직원의 위신을 실추케 한 때3. 비위나 잘못이 징계사유에 상당하나 인사위원회에서 징계 의결 요구를 기각한 때4. 시효의 완성으로 징계사유가 소멸되어 다른 조치가 곤란할 때5. 징계책임이 없는 자의 경미한 위반사유가 발생한 때6. 기타 직원이 책임과 의무를 다하지 못한 때 등",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:부산시설공단훈계등처분에관한내규#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "처분방법 및 효력",
        "chapter": "",
        "content": "제5조(처분방법 및 효력) ① 훈계 등의 처분은 이사장이 처분 대상자에게 별지 제1호의 서식에 의한 처분장을 교부함으로써 효력을 발생한다. 다만, 소속부서의 장으로 하여금 처분장을 교부하게 할 수 있다.② 훈계 등 처분사항에 대하여는 근무성적 평정 및 전보 등 인사관리에 반영할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:부산시설공단훈계등처분에관한내규#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "기록유지",
        "chapter": "",
        "content": "제6조(기록유지) ① 훈계 등을 처분하였을 때에는 별지 제2호 서식에 의한 훈계(주의) 처분대장을 비치하고, 처분사항을 기록·유지하여야 한다.② 제1항의 훈계(주의) 처분대장은 인사담당부서에서 관리하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:부산시설공단훈계등처분에관한내규#JO0006"
      }
    ]
  },
