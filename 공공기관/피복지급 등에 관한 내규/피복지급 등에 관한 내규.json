    "article_count": 9,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 속초시시설관리공단(이하 “공단”이라 한다)의 직원(공무직근로자 포함)에 대한 피복의 지급기준과 착용 및 관리 등에 관한 사항을 규정함을 목적으로 한다.(개정 2008.3.13., 2020.3.31.)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:피복지급등에관한내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "정의",
        "chapter": "",
        "content": "제2조(정의) “피복”이라 함은 직원에게 지급하는 근무에 필요한 근무복, 제모, 방한복, 우의 등을 말한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:피복지급등에관한내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "제조구입등",
        "chapter": "",
        "content": "제3조(제조구입등) ① 피복은 예산의 범위에서 제조, 구입한 현물로 지급함을 원칙으로 한다.② 지급하는 피복의 종류, 지급대상, 수량 색상 등은 사정에 따라 공단에서 지정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:피복지급등에관한내규#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "지급관리",
        "chapter": "",
        "content": "제4조(지급관리) ① 피복의 지급관리책임자는 해당팀장(관장)으로 한다.(개정 2020.3.31.)② 지급관리책임자는 피복지급대장을 비치하고 이를 기록, 유지하여야 한다.③ 피복을 지급받은 자가 지급일로부터 3개월이내에 퇴직 또는 전보 등으로 착용할 필요가 없게 된 경우에는 이를 회수하여 보수 또는 세탁한 후 후임자에게 규격을 선별하여 적의 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:피복지급등에관한내규#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "착용자의 의무",
        "chapter": "",
        "content": "제5조(착용자의 의무) 피복을 지급받은 자는 임의로 모형 및 제식을 변경하거나 부착물(공단 명칭이나 표시등)을 제거할 수 없으며 이 규정이 정하는 소정 사용기간중 세탁 또는 보수관리를 철저히 하여 항상 단정하게 착용하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:피복지급등에관한내규#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "중도채용자에 대한 지급",
        "chapter": "",
        "content": "제6조(중도채용자에 대한 지급) 피복의 지급기간을 경과하여 채용된 지급대상자에게는 회수보관품에서 지급하거나 신규로 제조, 구입 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:피복지급등에관한내규#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "변상",
        "chapter": "",
        "content": "제7조(변상) ① 지급된 피복이 훼손 또는 망실로 인하여 사용할 수 없게 되었을 때에는 사용자가 자비로 제조, 구입 착용한다. 다만, 직무상 혹은 기타 불가항력의 사유로 인한 경우에는 그러하지 아니한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:피복지급등에관한내규#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "사용년한 경과피복",
        "chapter": "",
        "content": "제8조(사용년한 경과피복) 사용년한이 경과된 피복은 지급받은 자가 임의로 처분 할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:피복지급등에관한내규#JO0008"
      },
      {
        "article_no": "제9조",
        "article_title": "착용기간",
        "chapter": "",
        "content": "제9조(착용기간) 지급된 피복은 특별한 사유가 없는 한 근무시간중 항상 착용하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:피복지급등에관한내규#JO0009"
      }
    ]
