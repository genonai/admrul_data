      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "제1장  총  칙",
        "content": "제2조(적용범위) 임ㆍ직원이 휴직, 직위해제 또는 근무상 변동이 있을 때 및 기타 사유로 그 직무를 담당할 수 없을 경우에 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
