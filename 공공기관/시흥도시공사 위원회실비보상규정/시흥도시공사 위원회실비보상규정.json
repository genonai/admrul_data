  "body": {
    "format": "articles",
    "article_count": 3,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 규정은 시흥도시공사(이하 “공사”라 한다)에 설치된 각종 위원회의에 참석하는 위원의 실비보상에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사위원회실비보상규정#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용",
        "chapter": "",
        "content": "제2조(적용) 공사에 설치된 위원회에 참석하는 위원의 실비보상에 관하여 다른 법령, 조례 또는 공사의 규정에 특별히 정한 것을 제외하고는 이 규정에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사위원회실비보상규정#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "실비보상",
        "chapter": "",
        "content": "제3조(실비보상) ①공사 소속 임직원이 아닌 위원이 위원회에 참석한 때에는 예산의 범위 안에서 참석수당, 일비, 여비 및 그 밖의 직무수행에 필요한 경비를 지급 할 수 있다.②공사에서 운영하는 위원회에 참석하는 위원의 참석 수당 등은 지방공기업 예산편성기준에 의거 지급한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:시흥도시공사위원회실비보상규정#JO0003"
      }
    ]
  },
  "addenda": [
    {
      "promulgation_date": "20191011",
      "promulgation_no": "00001",
      "content": "부칙 <제1호,2019.10.11.>제1조(시행일) 이 규정은 공사가 설립되는 날부터 시행한다.제2조(경과조치) 이 규정 시행 당시 이미 처리된 사무는 이 규정에 따라 처리된 것으로 본다."
    }
