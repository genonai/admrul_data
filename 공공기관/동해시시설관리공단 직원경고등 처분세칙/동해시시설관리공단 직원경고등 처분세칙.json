    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 세칙은 동해시시설관리공단(이하 “공단”이라 한다.) 인사규정에 의한 징계사유에 이르지 아니하는 경미한 비위나 잘못에 대하여 주의와 각성을 촉구하고 인사관리 적정을 기하기 위한 경고등 처분의 구체적인 기준 및 절차 등을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단직원경고등처분세칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용대상",
        "chapter": "",
        "content": "제2조(적용대상) 이 세칙은 공단에 근무하는 모든 직원에게 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단직원경고등처분세칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "처분등의 종류",
        "chapter": "",
        "content": "제3조(처분등의 종류) ① 처분의 종류는 경고, 훈계, 주의로 구분한다.② 경고는 이사장에게 훈계및주의는 이사장외의 모든직원에게 적용하며, 경고와 훈계는 동일한 효력을갖고 주의는 훈계처분보다 경미한 사항에대하여 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단직원경고등처분세칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "처분사유",
        "chapter": "",
        "content": "제4조(처분사유) 다음 각 호의 1에 해당할 때에는 경고등 처분을 할 수 있다.1. 시민, 관광객에게 친절 불량으로 지적을 받을 때2. 비위내용이 징계사유에 상당하거나 징계사건을 징계위원회 또는 인사위원회에서 징계의결 요구를 기각한 때3. 시효의 완성으로 징계사유가 소멸되어 다른 조치가 곤란한 때4. 인사규정에 의한 징계사유에 해당하나 그 정도가 경미한 때",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단직원경고등처분세칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "처분권자",
        "chapter": "",
        "content": "제5조(처분권자) 경고등 처분은 이사장이 행함을 원칙으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:동해시시설관리공단직원경고등처분세칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "처분방법",
        "chapter": "",
        "content": "제6조(처분방법) 경고등 처분은 처분권자가 처분대상자에게 별지 제1호 서식에 의한 처분장을 교부함으로써 한다.",
        "enforcement_date": "",
