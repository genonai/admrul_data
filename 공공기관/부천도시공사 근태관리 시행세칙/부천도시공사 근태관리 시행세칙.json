    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 세칙은 취업규정 제21조의 출근 및 퇴근 등 근태관리에 관하여 필요한 사항을 정함으로써 원활하고 효율적인 근태관리를 목적으로 한다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "citation",
            "delegation_type": null,
            "target_category": "학칙공단",
