    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 지하도상가 관리운영규정(이하 \"규정\"이라 한다)의 시행에 관하여 필요한 세부사항을 정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:부산시설공단지하도상가관리운영규정시행내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 지하도상가의 관리운영에 관하여 다른 규정에서 정하는 것을 제외하고는 이 내규가 정하는 바에 의한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:부산시설공단지하도상가관리운영규정시행내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "계약",
        "chapter": "",
        "content": "제3조(계약) ① 점포를 임대하기 위해서는 \"별지 제1호\"에 의한 점포임대신청을 하고(계약 체결시에는 계약서 작성), \"별표1\"의 구비서류를 첨부하여 제출하여야 한다.② 임대차 계약대상자로 선정된 자는 공단이 정한 기간 내에 임대차계약을 체결하여야 하며, 불이행시 임차인 자격은 상실된다.",
        "enforcement_date": "",
