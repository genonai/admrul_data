      {
        "article_no": "제5조",
        "article_title": "영업시간 및 휴일",
        "chapter": "",
        "content": "제5조(영업시간 및 휴일) 영업시간과 휴일의 지정은 이사장과 상인대표회의 협의에 의해 결정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:부산시설공단지하도상가관리운영규정시행내규#JO0005"
