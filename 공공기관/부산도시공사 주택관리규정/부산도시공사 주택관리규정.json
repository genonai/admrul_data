      },
      {
        "article_no": "제2조",
        "article_title": "타 법규와의 관계",
        "chapter": "제1장 총칙",
        "content": "제2조 (타 법규와의 관계)  이 규정에 없는 사항은 주택법,임대주택법, 주택임대차보호법에 의한다",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:부산도시공사주택관리규정#JO0002"
