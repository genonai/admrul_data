      {
        "article_no": "제15조",
        "article_title": "재단에 대한 책임",
        "chapter": "제3장   복     무",
        "content": "제15조(재단에 대한 책임) 임원이 법령 및 정관 또는 재단의 규정에 위반한 행위를 하거나 그 임무를 해태한 때에는 그 임원은 재단에 손해를 배상할 책임이 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:성남시청소년청년재단임원인사규정#JO0015"
      },
      {
        "article_no": "제16조",
        "article_title": "보수",
        "chapter": "제3장   복     무",
        "content": "제16조(보수) 임원의 보수는 「성남시청소년청년재단 보수규정」이 정하는 바에 따라 지급한다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "citation",
            "delegation_type": null,
            "target_category": "학칙공단",
            "source_article_no": "제16조",
