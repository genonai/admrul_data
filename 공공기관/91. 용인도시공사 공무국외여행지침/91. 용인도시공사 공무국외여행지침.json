    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 지침은 용인도시공사(이하 “공사”라 한다) 임직원의 공무국외출장, 그 밖의 업무수행(이하 “공무국외출장등”이라 한다)을 위한 공무국외여행에 관하여 필요한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:91.용인도시공사공무국외여행지침#JO0001"
      },
