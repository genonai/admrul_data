    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적)  이 내규는 부산지방공단스포원 직원의 신분을 표시하는 신분증의 규격, 제식 및 발급 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:3010신분증발급내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위)  이 내규는 다른 규정에 특별한 규정이 없는 한 공단 임원 및 직원에게 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:3010신분증발급내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "신분증의 규격과 제식 및 패용방법",
        "chapter": "",
        "content": "제3조(신분증의 규격과 제식 및 패용방법)  신분증의 규격, 제식 및 기재 사항은 “별표 1”과 같다.",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "appendix_ref",
