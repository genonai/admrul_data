    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 의왕도시공사(이하 “공사”라 한다)의 직원 신분을 표시하는 신분증의 규격, 제식 및 발급 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:신분증발급내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 이 내규는 공사에 근무하는 모든 임ㆍ직원에게 적용한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:신분증발급내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "신분증의 규격ㆍ제식",
        "chapter": "",
        "content": "제3조(신분증의 규격ㆍ제식) ① 신분증의 규격ㆍ제식 및 기재사항은〔별표 1〕과 같다.② 신분증의 색채, 신분증 제작ㆍ관리 등 기타 자세한 사항은 사장이 따로 정한다.",
        "enforcement_date": "",
