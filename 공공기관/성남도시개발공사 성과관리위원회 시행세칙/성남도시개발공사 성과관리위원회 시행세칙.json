    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 세칙은 경영목표의 달성 및 성과 중심의 조직 운영을 위하여 성과관리위원회의 효율적인 운영에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:성남도시개발공사성과관리위원회시행세칙#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "성과평가 대상",
        "chapter": "",
        "content": "제2조(성과평가 대상) 성과평가는 공사 각 팀을 대상으로 실시한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:성남도시개발공사성과관리위원회시행세칙#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "성과평가기간 및 방법",
        "chapter": "",
        "content": "제3조(성과평가기간 및 방법) ① 성과평가는 연간1회 실시함을 원칙으로 한다. 다만, 필요시에는 성과관리위원회에서 평가주기를 조정할 수 있다.② 성과평가 기간은 평가대상연도 1월 1일부터 12월 31일을 기준으로 한다.③ 성과평가 방법에 대한 자세한 사항은 매년 성과평가계획에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:성남도시개발공사성과관리위원회시행세칙#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "성과관리위원회 구성 및 운영",
        "chapter": "",
        "content": "제4조(성과관리위원회 구성 및 운영) ① 위원회는 기획본부장을 위원장으로 하고 위원은 각 부서장 등 7인 이내로 하되, 위원장이 부득이한 사유로 직무를 수행할 수 없는 때에는 공사 임직원의 직제 순에 의하여 그 직무를 대행한다.② 제1항의 위원은 사장이 위촉하며, 전문성과 효율성 강화 및 공정하고 객관적 성과평가를 위해 외부 관련전문가를 2인 이내로 위촉할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:성남도시개발공사성과관리위원회시행세칙#JO0004"
      },
      {
        "article_no": "제5조",
        "article_title": "외부위원 위촉",
        "chapter": "",
        "content": "제5조(외부위원 위촉) ① 외부 관련전문가는 모집 공고를 통해 대학교수, 경영 컨설턴트, 공기업 관련 행정 및 경영 전문가 등 중에서 사장이 위촉한다.② 외부 위원을 위촉할 경우 위원의 임기는 2년으로 하되 연임할 수 있다. 단, 필요하다고 인정하는 경우에는 임기 만료전이라도 위촉직 위원을 해촉할 수 있다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:성남도시개발공사성과관리위원회시행세칙#JO0005"
      },
      {
        "article_no": "제6조",
        "article_title": "수당",
        "chapter": "",
        "content": "제6조(수당) 위원회에 출석한 위원에 대해서는 지방공기업 예산편성기준에 따라 예산의 범위 내에서 수당을 지급할 수 있다. 다만, 공사의 임직원은 제외한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:성남도시개발공사성과관리위원회시행세칙#JO0006"
      },
      {
        "article_no": "제7조",
        "article_title": "성과측정실무반 구성 및 운영",
        "chapter": "",
        "content": "제7조(성과측정실무반 구성 및 운영) ① 성과평가에 관한 주요사항을 실무적으로 시행 및 처리하기 위하여 성과측정 실무반을 둔다.② 성과측정실무반은 성과관리의 주관부서의 장을 총괄로 하여 각 팀별 담당자 1인으로 한다.③ 성과측정실무반은 각 부서에서 제출한 지표별 실적자료와 증빙서류를 바탕으로 성과를 평가한다.④ 지표별 득점은 성과관리 편람 상의 계산법에 따라 산출하고, 소수점 셋째 자리에서 반올림하여 소수점 둘째자리에서 확정한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:성남도시개발공사성과관리위원회시행세칙#JO0007"
      },
      {
        "article_no": "제8조",
        "article_title": "자료의 보존",
        "chapter": "",
        "content": "제8조(자료의 보존) 성과평가와 관련한 자료는 인사관리 등에 활용할 수 있도록 5년 이상 보존하여야 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:성남도시개발공사성과관리위원회시행세칙#JO0008"
      }
