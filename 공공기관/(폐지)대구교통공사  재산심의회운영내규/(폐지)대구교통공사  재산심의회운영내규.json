    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적)  이 내규는 대구도시철도공사(이하 “공사”라 한다) 재산관리규정 제5조에 의거 공사재산을 합리적으로 관리하기 위한 공사재산심의회(이하 “심의회”라 한다)의 조직과 운영에 관한 사항을 규정함을 목적으로 한다. <개정 ’08. 9. 25>",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "citation",
            "delegation_type": null,
            "target_category": "학칙공단",
            "source_article_no": "제1조",
            "source_clause": "제1조",
            "link_text": "제5조",
            "line_text": "",
            "target_law_name": "재산관리규정",
            "target_article_no": "제5조",
            "target_article_title": "",
            "target_mst": "",
            "target_url": "https://www.law.go.kr/학칙공단/재산관리규정/제5조",
            "resolve_method": "text_supplement",
            "source_provision_id": "public:(폐지)대구교통공사재산심의회운영내규#JO0001",
            "reference_id": "law:재산관리규정#JO0005"
          }
