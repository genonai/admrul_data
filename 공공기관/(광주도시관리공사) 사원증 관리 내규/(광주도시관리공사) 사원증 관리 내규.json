    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 광주도시관리공사(이하 “공사”라 한다) 임직원의 신분을 표시하는 사원증의 사양, 발급 및 관리 등에 관한 사항을 규정함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:(광주도시관리공사)사원증관리내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위 및 기능",
        "chapter": "",
        "content": "제2조(적용범위 및 기능) 이 내규는 공사에 재직 중인 임직원에게 적용하며, 임직원 사원증은 소속 임직원의 신분확인의 기능을 가진다.(개정 2022. 07. 25.)",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:(광주도시관리공사)사원증관리내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "사원증의 사양 및 기재사항 등",
        "chapter": "",
        "content": "제3조(사원증의 사양 및 기재사항 등) 임직원 사원증(이하 “사원증”이라 한다)의 사양 및 규격 등은 별표1과 같다.",
        "enforcement_date": "",
