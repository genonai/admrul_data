    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장  총  칙",
        "content": "제1조(목적) 이 규정은 수원도시공사(이하 “공사”라 한다) 임·직원의 건강과 복리후생 및 업무 수행 중 발생한 재해보상에 관한 사항을 규정함으로써 임·직원의 건강증진과 생활안정을 도모함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:13.수원도시공사복리후생규정#JO0001"
      },
      {
