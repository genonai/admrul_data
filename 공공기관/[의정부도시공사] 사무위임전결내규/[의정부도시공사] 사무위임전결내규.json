  "body": {
    "format": "articles",
    "article_count": 8,
    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "",
        "content": "제1조(목적) 이 내규는 의정부도시공사(이하?공사?라 한다)의 제반 문서 결재에 관한 전결사항과 그 절차를 규정함으로써 사무처리의 신속과 능률을 도모함을 목적으로 한다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사무위임전결내규#JO0001"
      },
      {
        "article_no": "제2조",
        "article_title": "적용범위",
        "chapter": "",
        "content": "제2조(적용범위) 사무위임전결에 관하여 법령 기타 다른 규정에 특별한 규정이 있는 경우를 제외하고는 이 내규에서 정하는 바에 따른다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사무위임전결내규#JO0002"
      },
      {
        "article_no": "제3조",
        "article_title": "권한과 책임",
        "chapter": "",
        "content": "제3조(권한과 책임) 사무위임을 받은 자는 위임받은 해당업무의 처리에 필요한 권한을 가지며 동시에 그에 대한 책임을 진다.",
        "enforcement_date": "",
        "relations": [],
        "images": [],
        "provision_id": "public:[의정부도시공사]사무위임전결내규#JO0003"
      },
      {
        "article_no": "제4조",
        "article_title": "전결사항",
        "chapter": "",
        "content": "제4조(전결사항) ① 공사의 전결사항은 “별표1”과 같다. 다만, 사장이 특히 필요하다고 인정하는 사항에 대하여는 이 내규와 다르게 처리하게 할 수 있다.② 별표의 전결사항에 열거되지 아니한 사항은 이와 유사한 전결사항에 준하여 해당 전결권자가 결재할 수 있다. 다만, 결재권자를 판단하기 어려운 사항에 대하여는 직상급자의 결재를 받아야 한다.",
        "enforcement_date": "",
