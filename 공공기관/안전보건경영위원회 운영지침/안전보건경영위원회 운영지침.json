    "articles": [
      {
        "article_no": "제1조",
        "article_title": "목적",
        "chapter": "제1장 총칙",
        "content": "제1조(목적) 이 지침은 인천관광공사(이하 “공사”라 한다) 안전보건관리 규정 제10조에 따라 안전보건경영위원회(이하 “위원회”라 한다) 운영에 필요한 사항을 규정함을 목적으로 한다. <개정 2021.07.19.>",
        "enforcement_date": "",
        "relations": [
          {
            "relation_type": "internal_ref",
